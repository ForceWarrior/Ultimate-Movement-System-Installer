	["*.OutFromWall"] = { Summary = "How far off the wall the effect starts.", Accepts = "studs" },
	["*.GroundBlend"] = { Summary = "How much the effect takes the ground's colour.", Accepts = "0 to 1" },
	["*.GroundCheckDistance"] = { Summary = "How far down the ground is looked for.", Accepts = "studs" },
	["*.MaxSize"] = { Summary = "The biggest a piece can be.", Accepts = "studs" },
