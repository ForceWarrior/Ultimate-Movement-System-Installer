return {
	GridTitle = "SAVED PRESETS",
	NamePlaceholder = "Preset name",
	NotePlaceholder = "What is it for",
	Save = "Save the live config",
	Paste = "Paste a code",
	Replace = "Replace live",
	Insert = "Insert here",
	Share = "Share",
	DeleteTitle = function(Name: string): string return "Delete \"" .. Name .. "\"?" end,
	DeleteBody = function(Name: string): string return "\"" .. Name .. "\" is removed from the plugin. The place is not touched. No undo." end,
	DeleteYes = "Yes, delete it",
	DeleteNo = "Keep it",
	NoNote = "no notes",
	Empty = "Nothing saved yet. Tune the config, name it, and press Save.",
	Saved = function(Name: string, Outcome: string): string return Name .. " " .. Outcome end,
	Deleted = function(Name: string): string return "deleted \"" .. Name .. "\"" end,
	FullFacts = function(Settings: number): string return "the whole config, " .. Settings .. " settings" end,
	PartialFacts = function(Settings: number): string return "changes " .. Settings .. " settings" end,
	MadeOn = function(Version: string): string return "V" .. Version end,
	MadeOnUnknown = "version unknown",

	ConfirmNo = "Not now",
	ReplaceTitle = function(Name: string): string return "Replace the live config with \"" .. Name .. "\"?" end,
	ReplaceYes = "Yes, replace the live config",
	ReplaceFacts = function(Changed: number, Animations: number, Unknown: number): string return Changed .. " settings change in the live MovementConfig, " .. Animations .. " of them animation ids, and " .. Unknown .. " in the preset are not in this config. The config as it is now is copied to ServerStorage first, and this is one undo step." end,
	InsertTitle = function(Name: string): string return "Insert \"" .. Name .. "\" here?" end,
	InsertYes = "Yes, insert it",
	InsertFacts = function(Changed: number, Animations: number, Unknown: number, Where: string): string return Changed .. " settings differ from the live MovementConfig, " .. Animations .. " of them animation ids, and " .. Unknown .. " in the preset are not in this config. The new MovementConfig module goes into " .. Where .. "." end,
	RefusedFacts = function(Reason: string): string return "This preset cannot be written into the config: " .. Reason .. ". Saying yes will change nothing." end,
	VersionSame = function(Version: string): string return "Made on the same version, V" .. Version .. "." end,
	VersionDifferent = function(Made: string, Live: string): string return "Made on V" .. Made .. ", this place runs V" .. Live .. "." end,
	VersionUnknown = "Could not check the version.",
	CodeWarning = function(Found: string): string return "Something in this preset reads like code, and a config runs when the game requires it. Only go on if you trust who sent it. Found: " .. Found end,
	CodeWarningMore = function(More: number): string return ", and " .. More .. " more" end,

	ShareTitle = "Share a preset",
	ShareOne = function(Name: string): string return "Share \"" .. Name .. "\"" end,
	IncludeAnimations = "Include animation ids",
	CodeFacts = function(Changed: number, Characters: number): string return Changed .. " settings differ from the shipped defaults  |  " .. Characters .. " characters" end,
	CopyHint = "Ctrl+C copies it. Over about 1900 characters it will not fit in one chat message, send it as a file.",
	SelectAll = "Select all",

	PasteTitle = "Paste a preset code",
	PasteHint = "Paste the code. Text around it and line breaks from chat are ignored.",
	PastePlaceholder = "UMSP1:...",
	ReadIt = "Read it",
	Imported = function(Name: string): string return "read \"" .. Name .. "\", it is in the list now" end,
