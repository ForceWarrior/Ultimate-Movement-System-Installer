	VersionDifferent = function(Made: string, Live: string): string return "Made on V" .. Made .. ", this place runs V" .. Live .. "." end,
	VersionUnknown = "Could not check the version.",
	CodeWarning = function(Found: string): string return "Something in this preset reads like code, and a config runs when the game requires it. Only go on if you trust who sent it. Found: " .. Found end,
