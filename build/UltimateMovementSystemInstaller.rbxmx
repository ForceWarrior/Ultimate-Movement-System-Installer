<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Folder" referent="RBX1">
    <Properties>
      <string name="Name">UltimateMovementSystemInstaller</string>
      <ProtectedString name="Source" />
    </Properties>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">Content</string>
        <ProtectedString name="Source">--// [Variables]
local Content = {}

--// [Do not go past this point]

Content.WindowTitle = "Ultimate Movement System Installer"
Content.ToolbarName = "Ultimate Movement System"
Content.ButtonLabel = "UMS Installer"
Content.ButtonTooltip = "Open the Ultimate Movement System installer"
Content.TabOrder = { "About", "Install", "Presets", "Config", "API", "Library" }

Content.About = require(script.About)
Content.Animations = require(script.Animations)
Content.Config = require(script.Config)
Content.Gate = require(script.Gate)
Content.Install = require(script.Install)
Content.Landing = require(script.Landing)
Content.Presets = require(script.Presets)
Content.Requirements = require(script.Requirements)
Content.Api = require(script.Api)
Content.Library = require(script.Library)

return Content
</ProtectedString>
      </Properties>
      <Item class="ModuleScript" referent="RBX3">
        <Properties>
          <string name="Name">Api</string>
          <ProtectedString name="Source">--// [Variables]
local Api = {
	GridTitle = "API REFERENCE",
	Search = "Filter topics",
	Back = "Return",
	Facts = function(Entries: number): string return Entries .. " entries" end,
	NoEntryDoc = "No explanation written for this one yet.",
	Accepts = function(Takes: string): string return "Takes: " .. Takes end,
	ExpandHint = "Click an entry to read what it does.",
	Notes = "WORTH KNOWING",
	Summary = function(Shown: number, Topics: number, Entries: number): string return Shown .. " of " .. Topics .. " topics  |  " .. Entries .. " entries in total" end,
}

--// [Do not go past this point]

Api.Version = "Api version 1  |  system 1.0  |  oldest accepted RequiresApi: 1"

Api.Sections = {
	require(script.Start),
	require(script.Contract),
	require(script.Block),
	require(script.Flags),
	require(script.Kinds),
	require(script.Names),
	require(script.Identity),
	require(script.State),
	require(script.World),
	require(script.Animation),
	require(script.Sound),
	require(script.Stamina),
	require(script.Cooldown),
	require(script.Movement),
	require(script.Camera),
	require(script.Input),
	require(script.Frame),
	require(script.Effects),
	require(script.Outside),
	require(script.Rules),
	require(script.Example),
}

function Api.For(Name)
	for _, Entry in Api.Sections do
		if Entry.Name == Name then
			return Entry
		end
	end
	return nil
end

function Api.Count(Entry)
	return Entry.Rows and #Entry.Rows or 0
end

return Api
</ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX4">
          <Properties>
            <string name="Name">Animation</string>
            <ProtectedString name="Source">return {
	Name = "Animation",
	Title = "Animations",
	Blurb = "Rig correct ids straight out of your own config",
	Summary = "Animation ids live in R6 and R15 branches of your block. These three pick the right branch for the rig you are on.",
	Notes = {
		"A slot may hold a single id or a list of them. A list is a set the kit picks from, which is how idle variations work.",
		"Load a track once and keep it. Loading one per Enter leaks tracks and costs a frame every time.",
		"MovementTemplate ships with no animation slot on purpose. Add R6 and R15 branches to your own block when you have clips.",
	},
	Rows = {
		{ Key = "Api.AnimationId(Name)", Value = "-&gt; number | {number} | nil",
			Summary = "The raw id, or list of ids, for that name in your own config block, already resolved to your rig. Use this when you want the number rather than a loaded track.",
			Code = "-- with Config.MyMove = { R15 = { SurgeAnimationId = 0 }, R6 = { SurgeAnimationId = 0 } }\nlocal Id = Api.AnimationId(\"Surge\")\nif not Id or Id == 0 then\n\tApi.Log.Warn(\"no surge animation uploaded yet\")\nend" },
		{ Key = "Api.Animation(Name)", Value = "-&gt; AnimationTrack?",
			Summary = "The same lookup, loaded and ready to Play. This is the one you usually want. Load it once in Init and keep it.",
			Code = "local Track = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tTrack = Api.Animation(\"Surge\")\nend\n\nfunction MyMove:Enter()\n\tif Track then Track:Play(0.15) end\nend\n\nfunction MyMove:Exit()\n\tif Track then Track:Stop(0.2) end\nend" },
		{ Key = "Api.NewClipPlayer(FadeTime)", Value = "-&gt; ClipPlayer",
			Summary = "One animation at a time with a crossfade: Set(Track) fades the last clip out and this one in, Set with the same track keeps it going, Clear(FadeOut) stops it. Set also takes an optional fade for that one change, Set(Track, nil, 0.3). For a move that swaps between a few clips as it goes.",
			Code = "local Clips = Api.NewClipPlayer(0.15)\n\nfunction MyMove:Update(DeltaTime)\n\tClips.Set(Api.OnGround() and Api.Tracks.Run or Api.Tracks.Fall)\nend\n\nfunction MyMove:Exit()\n\tClips.Clear(0.2)\nend" },
		{ Key = "Api.AnimationSpeed()", Value = "-&gt; number",
			Summary = "How much faster the clip that follows your speed plays right now, 1 when its AnimationSpeed setting is off or you are slow. For your own move that is the clip AnimationSpeedTrack hands back, use this for anything else you time to it.",
			Code = "function MyMove:Update(DeltaTime)\n\tStepSound.PlaybackSpeed = Api.AnimationSpeed()\nend" },
		{ Key = "Api.LoadAnimation(Id)", Value = "-&gt; AnimationTrack?",
			Summary = "Loads an id you already have from somewhere else. Hand it a list and one of them is chosen for you.",
			Code = "local Track = Api.LoadAnimation(1234567890)\n\n-- a list picks one at random, which is how idle variations work\nlocal Idle = Api.LoadAnimation({ 1234567890, 9876543210 })" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX5">
          <Properties>
            <string name="Name">Camera</string>
            <ProtectedString name="Source">return {
	Name = "Camera",
	Title = "Camera and feel",
	Blurb = "Offset, shake, field of view, rumble and what the camera is doing",
	Summary = "Several moves can ask for a camera offset without overwriting each other. Shakes are named in the config, so a game can retune them without touching your module.",
	Rows = {
		{ Key = "Api.SetCameraOffset(Offset, Seconds)", Value = "no return",
			Summary = "Sets a camera offset for your move. Seconds is optional: give it and the third person camera glides there over that time, leave it out and it moves at once. Pass nil to give it back. Always give it back in Exit.",
			Code = "function MyMove:Enter()\n\t-- drop the camera as if the player crouched\n\tApi.SetCameraOffset(Vector3.new(0, -1.5, 0), 0.15)\nend\n\nfunction MyMove:Exit()\n\tApi.SetCameraOffset(nil, 0.3)\nend" },
		{ Key = "Api.SetCharge(Seconds)", Value = "no return",
			Summary = "Shows your move's charge on MovementChargeBar, given the seconds left until it is full. Pass nil to hide it. It also hides when your move stops or the character resets.",
			Code = "function MyMove:Enter()\n\tApi.SetCharge(Api.Config.ChargeTime)\nend\n\nfunction MyMove:Exit()\n\tApi.SetCharge(nil)\nend" },
		{ Key = "Api.ApplyFOV(Settings)", Value = "no return",
			Summary = "A field of view push held while your move runs, from a table shaped like the FOV block: Enabled, Change, InTime, OutTime. The kit already does this at start from your block's FOV, this is for a push that depends on what the move is doing.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Speed &gt; 40 then\n\t\tApi.ApplyFOV({ Enabled = true, Change = 10, InTime = 0.2, OutTime = 0.4 })\n\tend\nend" },
		{ Key = "Api.ReleaseFOV()", Value = "no return",
			Summary = "Lets the field of view go. Call it in Exit when you applied one yourself.",
			Code = "function MyMove:Exit()\n\tApi.ReleaseFOV()\nend" },
		{ Key = "Api.Haptic(Intensity, Duration)", Value = "no return",
			Summary = "A controller rumble, 0 to 1 for Duration seconds, on the pad that is playing. Nothing happens on keyboard or touch.",
			Code = "function MyMove:Enter()\n\tApi.Haptic(0.5, 0.2)\nend" },
		{ Key = "Api.FirstPerson()", Value = "-&gt; boolean",
			Summary = "Is the camera in first person right now, as the kit's camera sees it.",
			Code = "if Api.FirstPerson() then\n\tApi.SetCameraOffset(Vector3.new(0, -0.3, 0))\nend" },
		{ Key = "Api.CameraSteers()", Value = "-&gt; boolean",
			Summary = "Should the camera direction steer the move rather than the move input: true under shift lock or in first person, the rule the glide and the slide follow.",
			Code = "local Direction = Api.CameraSteers() and workspace.CurrentCamera.CFrame.LookVector or Api.Humanoid.MoveDirection" },
		{ Key = "Api.Shake(EventName)", Value = "-&gt; boolean",
			Summary = "Fires a named shake from your module's own shake config. Returns false when that event is not configured or shake is off, so it is safe to call blindly.",
			Code = "-- with Config.MyMove = { CameraShake = { Enabled = true, Intensity = 0.3, Duration = 0.2, Land = { Intensity = 0.6, Duration = 0.4 } } }\nfunction MyMove:Enter()\n\tApi.Shake(\"Land\")\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX6">
          <Properties>
            <string name="Name">Contract</string>
            <ProtectedString name="Source">return {
	Name = "Contract",
	Title = "The module contract",
	Blurb = "The fields and hooks the engine looks for",
	Summary = "Your module is a plain table with a few fields and methods. Everything is optional except Name and RequiresApi. A hook you do not write is never called.",
	Notes = {
		"Init runs once at spawn. The rest are called only while your move is relevant.",
		"Update only runs while your move owns the body.",
		"Every hook is called through pcall, so a mistake in yours does not take the movement system down with it.",
	},
	Rows = {
		{ Key = "Name", Value = "string", Accepts = "the script's own name",
			Summary = "The name the kit and the config know your move by. Using script.Name keeps it in step with the script.",
			Code = "MyMove.Name = script.Name" },
		{ Key = "RequiresApi", Value = "number", Accepts = "1",
			Summary = "The Api version this module was written for. A version this build does not have refuses to load.",
			Note = "Read by MovementMain when the module loads.",
			Code = "MyMove.RequiresApi = 1" },
		{ Key = "Config.&lt;Name&gt;", Value = "a block in MovementConfig", Accepts = "every key your code reads",
			Summary = "Your tuning lives in MovementConfig, in a block named after your module. No block, no move, and a key your code reads that is not there is nil. Api.Config is that block.",
			Note = "Checked by MovementMain.CustomAdmits. Enabled = false switches the move off without removing it.",
			Code = "-- in MovementConfig, after the shipped blocks\nConfig.MyMove = {\n\tEnabled = true,\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n\tSpeed = 70,\n\tCooldown = 2,\n}\n\n-- in the module\nlocal Speed = Api.Config.Speed" },
		{ Key = "Requires", Value = "table", Accepts = "Grounded, Moving, Free, JumpHeld, FallSpeed",
			Summary = "Declaring this makes your move start by itself when these cheap conditions hold, after which Confirm is asked. Leave it out and your move starts only when you ask.",
			Note = "Read by EligibilitySignals. Grounded, Moving, Free and JumpHeld take booleans, FallSpeed takes a number.",
			Code = "-- \"start looking at me only while airborne, moving, and falling fast\"\nMyMove.Requires = {\n\tGrounded = false,\n\tMoving = true,\n\tFree = true,\n\tFallSpeed = 5,\n}" },
		{ Key = "StepWhileAirborne", Value = "boolean", Accepts = "true",
			Summary = "Runs your Update while the body is in the air and once more on landing, without owning the body. For watching a fall rather than owning it.",
			Code = "MyMove.StepWhileAirborne = true\n\nlocal Fell = 0\n\nfunction MyMove:Update(DeltaTime)\n\tFell += DeltaTime\n\tif Api.OnGround() then\n\t\tprint(\"was in the air for\", Fell)\n\t\tFell = 0\n\tend\nend" },
		{ Key = "Init", Value = "function(self, Api)", Accepts = "your setup",
			Summary = "Called once at startup with the Api. Bind keys and stash the Api here. Do not assume any other module has loaded yet.",
			Note = "Called by MovementMain when the module loads.",
			Code = "local Api = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.BindKey(function(_, InputState)\n\t\tif InputState == \"Begin\" then\n\t\t\tApi.Start()\n\t\tend\n\tend)\nend" },
		{ Key = "CanEnter", Value = "function(self) -&gt; boolean", Accepts = "true, or Api.Refuse(...)",
			Summary = "Asked before your move is allowed to start. Return false, or better, return Api.Refuse with a reason so you can see why it did not happen.",
			Note = "Called from StateMachine.CanStartState, after the cooldown and the transition table said yes.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\treturn true\nend" },
		{ Key = "Confirm", Value = "function(self) -&gt; boolean", Accepts = "true or false",
			Summary = "The expensive check, asked only after the cheap Requires gates pass. A raycast belongs here, not in CanEnter, because this runs far less often.",
			Code = "function MyMove:Confirm()\n\t-- only now is it worth paying for a raycast\n\tlocal Ahead = Api.RootPart.CFrame.LookVector * 4\n\tlocal Hit = Api.Raycast(Api.RootPart.Position, Ahead)\n\treturn Hit ~= nil\nend" },
		{ Key = "Sample", Value = "function(self)", Accepts = "no arguments",
			Summary = "Called on the tick so a gated move can keep a cheap reading current between events, without owning the body.",
			Code = "local Speed = 0\n\nfunction MyMove:Sample()\n\tSpeed = Api.RootPart.AssemblyLinearVelocity.Magnitude\nend\n\nfunction MyMove:Confirm()\n\treturn Speed &gt; 30\nend" },
		{ Key = "Enter", Value = "function(self)", Accepts = "no arguments",
			Summary = "Your move has started. Spend the stamina, start the cooldown, set up whatever Update needs. Calling Api.Stop() in here refuses the start after all: the block's cooldown and stamina cost are not charged and nothing reports it as started.",
			Note = "Called from StateMachine.StartState.",
			Code = "local TimeLeft = 0\n\nfunction MyMove:Enter()\n\tTimeLeft = Api.Config.Duration\n\tApi.SpendStamina(Api.Config.StaminaCost)\n\tApi.StartCooldown(Api.Config.Cooldown)\nend" },
		{ Key = "Update", Value = "function(self, DeltaTime)", Accepts = "seconds since the last tick",
			Summary = "Every tick, but only while your move owns the body. Drive the movement here and call Api.Stop() when it is finished.",
			Code = "function MyMove:Update(DeltaTime)\n\tTimeLeft -= DeltaTime\n\tif TimeLeft &lt;= 0 then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Root = Api.RootPart\n\tRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * Api.Config.Speed + Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)\nend" },
		{ Key = "Exit", Value = "function(self)", Accepts = "no arguments",
			Summary = "Your move has stopped, for any reason including one it did not choose. Put back everything Enter borrowed. This runs even when another move interrupted you.",
			Note = "Called from StateMachine.StopState.",
			Code = "function MyMove:Exit()\n\tTimeLeft = 0\n\tApi.RestoreWalkSpeed()\n\tApi.SetCameraOffset(nil)\n\tApi.Humanoid.AutoRotate = true\nend" },
		{ Key = "QuietExit", Value = "function(self) -&gt; boolean", Accepts = "true to keep the exit sound quiet",
			Summary = "Asked right after Exit. Return true when this stop was not a real end, the way a wall run that only hit a gap does, and your block's ExitSoundId does not play.",
			Note = "Called from StateMachine.StopState.",
			Code = "local HandedOn = false\n\nfunction MyMove:QuietExit()\n\treturn HandedOn\nend" },
		{ Key = "AnimationSpeedTrack", Value = "function(self) -&gt; (settings, track, sideways)", Accepts = "a setting from your block and the looping track playing now",
			Summary = "Makes your move's looping clip play faster the faster the body moves. Return a setting table from your block (Enabled, MinSpeed, MaxSpeed, MaxMultiplier), the track playing now, and true to count sideways speed only. Return nil when nothing should speed up.",
			Note = "Asked by the engine every tick while your move runs.",
			Code = "-- in the block: SurgeAnimationSpeed = { Enabled = true, MinSpeed = 70, MaxSpeed = 92, MaxMultiplier = 1.3 },\nlocal Loop = nil\n\nfunction MyMove:AnimationSpeedTrack()\n\treturn Api.Config.SurgeAnimationSpeed, Loop, true\nend" },
		{ Key = "Cleanup", Value = "function(self)", Accepts = "no arguments",
			Summary = "The character is going away, usually because the player died or respawned. Disconnect anything you connected and destroy anything you made.",
			Note = "Called by MovementLifecycle when the character goes.",
			Code = "local Trail = nil\n\nfunction MyMove:Cleanup()\n\tif Trail then\n\t\tTrail:Destroy()\n\t\tTrail = nil\n\tend\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX7">
          <Properties>
            <string name="Name">Cooldown</string>
            <ProtectedString name="Source">return {
	Name = "Cooldown",
	Title = "Cooldowns",
	Blurb = "One timer per module, kept for you",
	Summary = "The manager keeps a cooldown per module name, so it survives your move stopping and "
		.. "starting and you never have to track a timestamp yourself.",
	Rows = {
		{ Key = "Api.StartCooldown(Duration, Label)", Value = "no return",
			Summary = "Starts it, in seconds. Usually the last line of Enter. The optional Label is a "
				.. "word for the on screen cooldown indicator (StarterGui &gt; CooldownIndicator) to look up in "
				.. "its Messages table, for a move that shares one timer between several forms the way the "
				.. "dash does; without it the indicator names the module.",
			Code = "function MyMove:Enter()\n\tApi.StartCooldown(Api.Config.Cooldown)\nend" },
		{ Key = "Api.OnCooldown()", Value = "-&gt; boolean",
			Summary = "Is it still running. Usually the first line of CanEnter.",
			Code = "function MyMove:CanEnter()\n\tif Api.OnCooldown() then\n\t\treturn Api.Refuse(\"on cooldown\")\n\tend\n\treturn true\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX8">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">return {
	Name = "Effects",
	Title = "Effects from the config",
	Blurb = "Writing the body of an effect, not just its numbers",
	Summary = "The effect slots in MovementConfig each carry a Function that is the effect itself. Change it and the effect changes. Context.Vfx is the toolkit, Context.Settings the table the Function sits in, and a returned function is the cleanup.",
	Notes = {
		"Context.Default() runs the original body, so you can add to the shipped effect instead of replacing it.",
		"Read Context.Settings rather than looking the block up again, or you get whichever entry the lookup resolves first.",
		"A preset never carries a Function. Code is not a value, and a shared preset must not splice somebody else's effect body into your config.",
	},
	Rows = {
		{ Key = "Context.Vfx", Value = "the toolkit", Accepts = "19 members",
			Summary = "Play, GetEffect, Template, VfxConfig, WorldBurst, BurstNow, ApplyRate, AttachToParts, AttachToSurface, SurfaceStepBurst, Release, ReleaseSet, Limbs, GetLimb, RigOffset.",
			Code = "Function = function(Context)\n\tlocal Vfx = Context.Vfx\n\tlocal Template = Vfx.Template(\"Jumping\")\n\tVfx.WorldBurst(\"Jump\", Template, Context.RootPart.Position, 1, nil, 10)\nend," },
		{ Key = "Context.Settings", Value = "table",
			Summary = "The slot's own settings, the table written just above the Function. Enabled, EmitCount, Time and the rest.",
			Code = "JumpVfx = {\n\tEnabled = true, EmitCount = 10, Time = .5,\n\tFunction = function(Context)\n\t\tlocal Settings = Context.Settings\n\t\tif Settings.Enabled == false then return end\n\t\t-- Settings.EmitCount is 10, Settings.Time is .5\n\tend,\n}," },
		{ Key = "Context.Effect", Value = "string",
			Summary = "The name of the authored effect. Vfx.Template turns it into the Attachment the effect is built from.",
			Code = "local Template = Context.Vfx.Template(Context.Effect)\nif not Template then return end" },
		{ Key = "Context.RootPart", Value = "BasePart",
			Summary = "The character's root, for anything that needs a position to burst at.",
			Code = "local Where = Context.RootPart.Position + Vector3.new(0, -2.5, 0)" },
		{ Key = "Context.IsR6", Value = "boolean",
			Summary = "Which rig, for choosing between OffsetR6 and OffsetR15.",
			Code = "local Offset = Context.IsR6\n\tand Context.Settings.OffsetR6\n\tor Context.Settings.OffsetR15" },
		{ Key = "Context.Default()", Value = "function",
			Summary = "Runs the effect the kit ships. Call it to keep the original and add your own on top.",
			Code = "Function = function(Context)\n\tContext.Default()\n\t-- and one extra burst of your own\n\tlocal Vfx = Context.Vfx\n\tVfx.WorldBurst(\"Extra\", Vfx.Template(\"Landing\"),\n\t\tContext.RootPart.Position, 0.4, nil, 6)\nend," },
		{ Key = "Context.Offset, Parts, Surface", Value = "ride slots only",
			Summary = "Where the effect sits, which limbs it welds to, and the surface under the move. Handed over so your Function can do the same job the built in one does.",
			Code = "local Set\nif Context.Surface and Context.Settings.OnSurface ~= false then\n\tSet = Vfx.AttachToSurface(Template, Context.Surface, Context.Offset())\nelse\n\tSet = Vfx.AttachToParts(Template, Context.Parts(), Context.Offset())\nend" },
		{ Key = "Context.Gate, AlwaysBurst, ScheduleStop", Value = "ride slots only",
			Summary = "Whether the effect is allowed right now, whether it bursts as it starts, and the timer. ScheduleStop takes seconds or the word Duration to end with the move.",
			Code = "if Context.Gate and not Context.Gate() then return end\nif Context.AlwaysBurst then\n\tVfx.BurstNow(Set, Context.Settings.EmitCount)\nend\nContext.ScheduleStop(Context.Settings.Time or \"Duration\")\nreturn function() Vfx.Release(Set) end" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX9">
          <Properties>
            <string name="Name">Example</string>
            <ProtectedString name="Source">return {
	Name = "Example",
	Title = "The template, end to end",
	Blurb = "What MovementTemplate does and every Api call it makes",
	Summary = "MovementTemplate is a working move: a short surge forward on H. It refuses in the air, on cooldown, without stamina or with a wall ahead, holding the key extends it, jumping or the cancel key ends it. It needs no animation or sound and ships off. Copy it, rename it, give the new name a block, strip what you do not need.",
	Notes = {
		"Every value it reads is in Config.MovementTemplate. A custom move has no defaults inside it: no block, no move, and a key missing from the block is nil.",
		"The three animation calls are the only Api members it does not use, so it ships no animation slot. The Animation page shows them.",
		"Api.Log.Debug lines only print while Core.Debug is true, so the template is silent in a shipped game.",
	},
	Rows = {
		{ Key = "1. Identity", Value = "Name, RequiresApi, four flags",
			Summary = "Name follows the script. RequiresApi is the Api version. The four flags say what the move takes over: here it steers the body and nothing else.",
			Code = "local MovementTemplate = {}\nMovementTemplate.Name = script.Name\nMovementTemplate.RequiresApi = 1\nMovementTemplate.LocksMovement = false\nMovementTemplate.OwnsFacing = true\nMovementTemplate.OwnsHead = false" },
		{ Key = "2. Its block", Value = "Config.MovementTemplate",
			Summary = "The block is the whole of its tuning: toggles, keys, speeds and times, the chain settings, the camera offset and shake, and two sound slots at 0.",
			Code = "Config.MovementTemplate = {\n\t--// [Toggles]\n\tEnabled = false,\n\tHoldToExtend = true,\n\tFollowSlopes = true,\n\tAllowJumpOut = true,\n\tEndInAir = true,\n\t--// [Keys]\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n\tCancelKey = Enum.KeyCode.X,\n\t--// [Values]\n\tSurgeSpeed = 70,\n\tSurgeDuration = 0.25,\n\tCooldown = 2,\n\tSurgeStaminaCost = 10,\n\tChainMoves = { \"DashModule\", \"SlideModule\" },\n\t--// [Sounds]\n\tSurgeSoundId = 0,\n\tEndSoundId = 0,\n}" },
		{ Key = "3. Init", Value = "Sound, Utils, OnMoveStarted, BindKey, ClaimJump, ClaimKey",
			Summary = "Runs once per spawn. It resolves the sounds, watches which moves start so a dash or slide can arm the chain bonus, binds the key, and claims the jump and cancel presses by priority.",
			Code = "function MovementTemplate:Init(NewApi: MovementTypes.Api)\n\tself:Cleanup()\n\tApi = NewApi\n\tApi.Log.Debug(Api.Name, \"on Api v\" .. Api.Version, \"system\", Api.SystemVersion)\n\n\tSurgeSound = Api.Sound(Api.Config.SurgeSoundId, \"Surge\")\n\tEndSound = Api.Sound(Api.Config.EndSoundId, \"End\")\n\tProbeDistance = Api.Utils.MovementUtil.RootStandHeight(Api.IsR6, Api.Humanoid, Api.RootPart) + Api.Config.GroundCheckDistance\n\n\tLifetime = Api.OnMoveStarted(OnMoveStarted)\n\tApi.BindKey(OnInput)\n\tApi.ClaimJump(Api.Config.JumpOutPriority, CanJumpOut, JumpOut)\n\tApi.ClaimKey(Api.Config.CancelKey, Api.Config.CancelPriority, Api.IsActive, Api.Stop)\nend" },
		{ Key = "4. The key press", Value = "Start, ActiveMove, HasFlag, StopAll",
			Summary = "Tries Api.Start. If another move refused it and InterruptOtherMoves is on, a move that locks the body is left alone and anything else is stopped so the surge can start.",
			Code = "local function OnInput(_, InputState: string)\n\tif InputState ~= \"Begin\" then return end\n\tif Api.Start() then return end\n\tlocal Active = Api.ActiveMove()\n\tif Active == nil or not Api.Config.InterruptOtherMoves then return end\n\tif Api.HasFlag(\"LocksMovement\") then\n\t\tApi.Log.Debug(Active, \"is holding the body\")\n\t\treturn\n\tend\n\tApi.StopAll()\n\tApi.Start()\nend" },
		{ Key = "5. CanEnter", Value = "OnGround, OnCooldown, StaminaEnabled, Stamina, Raycast, Refuse",
			Summary = "Every refusal names itself through Api.Refuse, so the debug output says why a press did nothing. WallAhead is one raycast ahead.",
			Code = "function MovementTemplate:CanEnter(): boolean\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\tif Api.StaminaEnabled() and Api.Stamina() &lt; Api.Config.SurgeStaminaCost then return Api.Refuse(\"not enough stamina\") end\n\tif WallAhead() then return Api.Refuse(\"wall ahead\") end\n\treturn true\nend" },
		{ Key = "6. Enter", Value = "BaseWalkSpeed, Momentum, SpendStamina, SetJumpEnabled, SetDefaultAnimations, SetCameraOffset, PlaySound, Shake",
			Summary = "Works out the speed from the surge speed, momentum and the chain boost, spends the stamina, takes the body over, applies the camera offset, plays the sound and fires the shake.",
			Code = "function MovementTemplate:Enter()\n\tlocal Base = Api.BaseWalkSpeed()\n\tSpeed = math.max(Api.Config.SurgeSpeed, Base) + Api.Momentum(Api.Config.MomentumFeature, Base)\n\tif os.clock() &lt; ChainUntil then\n\t\tSpeed += Api.Config.ChainSpeedBoost\n\tend\n\tTimeLeft = Api.Config.SurgeDuration\n\tHeldFor = 0\n\n\tApi.SpendStamina(Api.Config.SurgeStaminaCost)\n\tApi.Humanoid.WalkSpeed = 0\n\tApi.Humanoid.AutoRotate = false\n\tApi.SetJumpEnabled(Api.Config.AllowJumpOut)\n\tApi.SetDefaultAnimations(not Api.Config.StopDefaultAnimations)\n\tApi.SetCameraOffset(Api.Config.CameraOffset)\n\tApi.Character:SetAttribute(Api.Name, true)\n\n\tApi.PlaySound(SurgeSound)\n\tApi.Shake(\"Start\")\nend" },
		{ Key = "7. Update", Value = "IsActive, IsHeld, DrainStamina, GroundInfo, ProjectOntoSlope, DownhillFactor, Stop",
			Summary = "Runs while the surge owns the body: counts the time down unless the key is held and extending, ends in the air, on a steep slope or at a wall, and drives the body along the ground.",
			Code = "function MovementTemplate:Update(DeltaTime: number)\n\tif not Api.IsActive() then return end\n\tif Api.Config.HoldToExtend and Api.IsHeld() and HeldFor &lt; Api.Config.MaxHoldDuration and Api.DrainStamina(Api.Config.HoldDrainPerSecond, DeltaTime) then\n\t\tHeldFor += DeltaTime\n\telse\n\t\tTimeLeft -= DeltaTime\n\tend\n\tif TimeLeft &lt;= 0 then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, ProbeDistance)\n\tif not Grounded and Api.Config.EndInAir then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Direction = SurgeDirection(Normal, Angle)\n\tlocal Velocity = Direction * (Speed + Api.DownhillFactor(Direction, Normal, Angle) * Api.Config.DownhillBoost)\n\tApi.RootPart.AssemblyLinearVelocity = Vector3.new(Velocity.X, math.min(Velocity.Y, Api.Config.MaxVerticalSpeed), Velocity.Z)\nend" },
		{ Key = "8. Exit and Cleanup", Value = "StartCooldown, RestoreWalkSpeed, StopSound",
			Summary = "Exit runs however the surge ended and puts back everything Enter borrowed: cooldown, walk speed, jump, animations, camera, sound. Cleanup runs when the character goes.",
			Code = "function MovementTemplate:Exit()\n\tTimeLeft = 0\n\tHeldFor = 0\n\tApi.StartCooldown(Api.Config.Cooldown)\n\n\tApi.RestoreWalkSpeed()\n\tApi.Humanoid.AutoRotate = true\n\tApi.SetJumpEnabled(true)\n\tApi.SetDefaultAnimations(true)\n\tApi.SetCameraOffset(nil)\n\tApi.Character:SetAttribute(Api.Name, nil)\n\n\tApi.StopSound(SurgeSound)\n\tApi.PlaySound(EndSound)\n\tApi.Shake(\"End\")\nend\n\nfunction MovementTemplate:Cleanup()\n\tif Lifetime then\n\t\tLifetime:Disconnect()\n\t\tLifetime = nil\n\tend\n\tSurgeSound = nil\n\tEndSound = nil\n\tChainUntil = 0\nend" },
		{ Key = "9. Jump out and cancel", Value = "ClaimJump, ClaimKey, IsActive, Stop",
			Summary = "Both claims only answer while the surge is active. Jump ends the surge and jumps, the cancel key just ends it. The higher priority wins a shared press.",
			Code = "local function CanJumpOut(): boolean\n\treturn Api.IsActive() and Api.Config.AllowJumpOut\nend\n\nlocal function JumpOut()\n\tApi.Stop()\n\tApi.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\nend\n\n-- in Init\nApi.ClaimJump(Api.Config.JumpOutPriority, CanJumpOut, JumpOut)\nApi.ClaimKey(Api.Config.CancelKey, Api.Config.CancelPriority, Api.IsActive, Api.Stop)" },
		{ Key = "10. Making it yours", Value = "copy, rename, block, strip",
			Summary = "Duplicate the ModuleScript, rename it, add a block of that name with Enabled = true. Delete the keys your move does not read, and keep every key it does.",
			Code = "-- MovementMain &gt; Custom &gt; MyMove (a copy of MovementTemplate)\nMyMove.Name = script.Name\n\n-- MovementConfig\nConfig.MyMove = {\n\tEnabled = true,\n\t-- the keys MyMove still reads\n}" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX10">
          <Properties>
            <string name="Name">Flags</string>
            <ProtectedString name="Source">return {
	Name = "Flags",
	Title = "Capability flags",
	Blurb = "What they promise, and what the kit does about each",
	Summary = "Four flags say what your move takes over while it runs. LocksMovement and HandsLandingToRoll change what the engine does, OwnsFacing and OwnsHead tell the extras to keep out.",
	Notes = {
		"OwnsFacing and OwnsHead reach the extras through Api.Tick and are asked again every tick, so a flag written as a function may change its answer while the move runs.",
		"A flag is a promise. Declaring OwnsFacing and leaving AutoRotate on means two things steer the body, which looks like twitching.",
	},
	Rows = {
		{ Key = "LocksMovement", Value = "enforced", Accepts = "boolean",
			Summary = "While your move is active nothing else may take the body or its keys. This one really does something.",
			Note = "Read in StateMachine.CanStartState and in the jump arbiter.",
			Code = "-- nothing else can start, and no other move can win a key, until you Stop\nMyMove.LocksMovement = true" },
		{ Key = "OwnsFacing", Value = "yours to keep", Accepts = "boolean",
			Summary = "Says your move is steering the body itself. The shift lock stops turning the body, the body lean pauses and the camera follows the body's facing. Turn AutoRotate off yourself and back on when you leave.",
			Note = "Read through Api.Tick.OwnsFacing by ShiftLock, BodyLean and CameraModule.",
			Code = "MyMove.OwnsFacing = true\n\nfunction MyMove:Enter()\n\tApi.Humanoid.AutoRotate = false\nend\n\nfunction MyMove:Update(DeltaTime)\n\tlocal Root = Api.RootPart\n\tRoot.CFrame = CFrame.lookAt(Root.Position, Root.Position + Heading)\nend\n\nfunction MyMove:Exit()\n\tApi.Humanoid.AutoRotate = true\nend" },
		{ Key = "OwnsHead", Value = "yours to keep", Accepts = "boolean",
			Summary = "Says your move is driving the head. Head movement stops aiming the head at the camera while it is set.",
			Note = "Read through Api.Tick.OwnsHead by HeadMovementModule.",
			Code = "MyMove.OwnsHead = true\n\nfunction MyMove:Enter()\n\tApi.SetCameraOffset(Vector3.new(0, -1.5, 0))\nend\n\nfunction MyMove:Exit()\n\tApi.SetCameraOffset(nil)\nend" },
		{ Key = "HandsLandingToRoll", Value = "enforced", Accepts = "boolean",
			Summary = "When the body lands with a landing roll armed and the roll can start, your move is stopped and the roll takes over, which also cancels the fall damage. The dive and the crouch declare it, so a roll press on landing ends either in a roll.",
			Note = "Read in LocomotionModule when the body lands.",
			Code = "MyMove.HandsLandingToRoll = true" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX11">
          <Properties>
            <string name="Name">Frame</string>
            <ProtectedString name="Source">return {
	Name = "Frame",
	Title = "Per frame work",
	Blurb = "The one correct way to run every frame",
	Summary = "Your Update already runs every tick while your move is active. For work that must keep running, bind it to the kit's shared loop with FrameLoop.BindFrame, keep the handle, and disconnect it in Cleanup.",
	Notes = {
		"Update is not this. Update only runs while your move owns the body.",
		"BindFrame runs at Core.UpdatesPerSecond, on the same tick as the moves. BindRender runs every drawn frame, right after the camera, and is only for camera and visual work.",
		"Both ride on callbacks the kit already has: one Heartbeat that belongs to MovementController and one render step that belongs to MovementExtras. Your work never adds a callback to the Rate column of Script Activity.",
		"A binding outlives the character. Disconnect it in Cleanup, or the old callback keeps running after every respawn.",
	},
	Rows = {
		{ Key = "FrameLoop.BindFrame", Value = "the shared loop",
			Summary = "Name, Order, Callback. A lower Order runs first. Returns a handle with Disconnect. It is reachable from the Movement folder without going through the Api.",
			Code = "local FrameLoop = require(\n\tscript:FindFirstAncestor(\"Movement\").Engine.FrameLoop)\n\nlocal Watcher = nil\n\nfunction MyMove:Init(NewApi)\n\tself:Cleanup()\n\tApi = NewApi\n\tWatcher = FrameLoop.BindFrame(\"MyMoveWatcher\", 50, function(DeltaTime)\n\t\t-- runs every tick, whether or not the move is active\n\tend)\nend\n\nfunction MyMove:Cleanup()\n\tif Watcher then Watcher.Disconnect() end\n\tWatcher = nil\nend" },
		{ Key = "FrameLoop.BindRender", Value = "every drawn frame",
			Summary = "Same arguments and handle as BindFrame. Use it for work you can see on screen, like camera or first person visuals. It stops while the window is not being drawn.",
			Code = "Shaker = FrameLoop.BindRender(\"MyMoveShake\", 45, function(DeltaTime)\n\t-- runs once per drawn frame, after the camera\nend)" },
		{ Key = "RunService.Heartbeat", Value = "do not",
			Summary = "Your own connection is a second callback every frame on top of the kit's, and it keeps running after the system has been torn down, which is a leak per respawn.",
			Code = "-- no\nRunService.Heartbeat:Connect(function(DeltaTime)\n\tSomething()\nend)\n\n-- yes\nWatcher = FrameLoop.BindFrame(\"MyMoveWatcher\", 50, function(DeltaTime)\n\tSomething()\nend)" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX12">
          <Properties>
            <string name="Name">Identity</string>
            <ProtectedString name="Source">return {
	Name = "Identity",
	Title = "Identity and character",
	Blurb = "The fields the Api carries",
	Summary = "Plain fields, set once when the Api is built for your module. The character fields are safe to hold onto for the life of the module.",
	Rows = {
		{ Key = "Api.Version", Value = "number",
			Summary = "The contract version this build provides. Compare it if you want your module to behave differently on a newer kit.",
			Code = "if Api.Version &gt;= 2 then\n\t-- something only a newer kit has\nend" },
		{ Key = "Api.SystemVersion", Value = "string",
			Summary = "The kit's own version, currently 1.0. Kept separate from the Api version on purpose, so the kit can move without the contract breaking.",
			Code = "Api.Log.Debug(\"running on movement system\", Api.SystemVersion)" },
		{ Key = "Api.Name", Value = "string",
			Summary = "Your module's name, the same one the config uses.",
			Code = "if Api.ActiveMove() == Api.Name then\n\t-- the same thing Api.IsActive() answers\nend" },
		{ Key = "Api.Config", Value = "table",
			Summary = "Your block in MovementConfig, exactly as written. Read it live rather than copying values at startup, or editing the config mid game does nothing.",
			Code = "-- good, reads the value every time\nfunction MyMove:Update(DeltaTime)\n\tMove(Api.Config.Speed * DeltaTime)\nend\n\n-- bad, frozen at whatever it was when the file loaded\nlocal Speed = Api.Config.Speed" },
		{ Key = "Api.Character", Value = "Model",
			Summary = "The character this Api was built for. Use it to find parts and accessories.",
			Code = "local Head = Api.Character:FindFirstChild(\"Head\")\nlocal Left = Api.Character:FindFirstChild(\n\tApi.IsR6 and \"Left Leg\" or \"LeftFoot\")" },
		{ Key = "Api.Humanoid", Value = "Humanoid",
			Summary = "Its humanoid. Prefer the Api's own helpers for walkspeed and jumping, so two writers do not fight over the same property.",
			Code = "if Api.Humanoid:GetState() == Enum.HumanoidStateType.Freefall then\n\t-- in the air\nend" },
		{ Key = "Api.RootPart", Value = "BasePart",
			Summary = "The HumanoidRootPart. Writing AssemblyLinearVelocity on it is the simplest way to move a body, and it leaves nothing behind to clean up.",
			Code = "local Root = Api.RootPart\n\n-- push forward, keep whatever vertical speed gravity gave us\nRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * 80\n\t+ Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)" },
		{ Key = "Api.IsR6", Value = "boolean",
			Summary = "Which rig this is. Offsets, part names and animation ids all differ between R6 and R15, so most moves need it somewhere.",
			Code = "local Offset = Api.IsR6\n\tand Vector3.new(0, -2.8, 0)\n\tor Vector3.new(0, -2.5, 0)" },
		{ Key = "Api.Blocks", Value = "table",
			Summary = "Every block of MovementConfig, live and read only all the way down: another move's numbers can be read, writing any of them errors. Api.Config is yours. Loop it with for Name, Block in Api.Blocks do, pairs() sees nothing through it.",
			Code = "local Run = Api.Blocks.LocomotionModule.RunSpeed\nlocal Debugging = Api.Blocks.Core.Debug" },
		{ Key = "Api.Tick", Value = "table",
			Summary = "The frame snapshot the engine works from: Grounded, FloorMaterial, MoveDirection, Active for the move that owns the body, Held, OwnsFacing, OwnsHead. Read only, writing to it errors. Loop it with for in, pairs() sees nothing through it.",
			Code = "function MyMove:Confirm()\n\treturn Api.Tick.Grounded and Api.Tick.MoveDirection.Magnitude &gt; 0.1\nend" },
		{ Key = "Api.Tracks", Value = "table",
			Summary = "Your block's animations, loaded once at spawn from the branch of the rig you are on: SurgeAnimationId becomes Api.Tracks.Surge. The same tracks Api.Animation hands out, without the call.",
			Code = "local Surge = Api.Tracks.Surge\nif Surge then Surge:Play(0.1) end" },
		{ Key = "Api.Locomotion", Value = "table",
			Summary = "The walk, run and landing queries and controls the shipped moves share: IsSprinting, IsJumping, IsFalling, IsLanding, InAirState, HasAirJumpsLeft, FloorPart, AmbientForce, IsRollArmed, RollWillStart, IsRolling, IsWallSliding, HoldsFacing, CancelLanding, CancelJumpAnimation, PlayJumpAnimation, TriggerLanding, TriggerCustomLanding, Boost, SlowForCharge. A frozen copy, writing to it errors.",
			Code = "if Api.Locomotion.IsSprinting() then\n\tApi.Locomotion.CancelLanding()\nend" },
		{ Key = "Api.Vision", Value = "table",
			Summary = "The look ahead the wall moves share, one raycast per direction per frame however many moves ask: Ahead(Distance), AheadFlat(Distance), Side(Sign, Distance), SideWide(Sign, Distance, Radius). Cheaper than a raycast of your own in Confirm. A frozen copy, writing to it errors.",
			Code = "function MyMove:Confirm()\n\tlocal Wall = Api.Vision.Ahead(4)\n\treturn Wall ~= nil and not Api.SurfaceRefused(Wall)\nend" },
		{ Key = "Api.Log", Value = "{ Debug, Warn }",
			Summary = "A logger tagged with your module name. Debug only prints while Core.Debug is on, so you can leave the calls in.",
			Code = "Api.Log.Debug(\"started at speed\", Api.Config.Speed)\nApi.Log.Warn(\"no ledge part found, doing nothing\")" },
		{ Key = "Api.Utils", Value = "table",
			Summary = "The shared helpers the engine publishes, by module: MovementUtil carries RootStandHeight, GetTagged, LongestAxis, NewThrottle, NewTickContext, NewHoldRig, NewSurfaceTracker and ResolvePath, MovementVFXManager carries Play, GetEffect and SetEffectEmitting. Frozen, nothing in it can be replaced.",
			Code = "local Util = Api.Utils.MovementUtil\nlocal Probe = Util.RootStandHeight(Api.IsR6, Api.Humanoid, Api.RootPart) + Api.Config.GroundCheckDistance\n\nfor _, Part in Util.GetTagged(\"Climbable\") do\n\tprint(Part.Name)\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX13">
          <Properties>
            <string name="Name">Input</string>
            <ProtectedString name="Source">return {
	Name = "Input",
	Title = "Input",
	Blurb = "Winning a key press, and sharing one",
	Summary = "A key can only go to one move. Claims carry a priority, and the highest one whose CanClaim says yes gets the press.",
	Notes = {
		"A KeyCode in your config also gets a touch button on mobile, at no extra work.",
		"Higher priority wins. The shipped air jump sits at 10 and is deliberately last, so a claim above it eats every double jump.",
		"The action name is your module name with a trailing \"Module\" stripped. That is what BindKey and IsHeld answer to.",
	},
	Rows = {
		{ Key = "Api.BindKey(Callback)", Value = "no return",
			Summary = "Fires on the key named in your config. The callback receives the action name and the input state, which is either Begin or End. With DoublePressEnabled in your block, a press only reaches you when it is the second of two quick presses, or while your move is running.",
			Code = "-- with Config.MyMove = { KeyCode = Enum.KeyCode.H, ConsoleInput = Enum.KeyCode.DPadRight }\nApi.BindKey(function(ActionName, InputState)\n\tif InputState == \"Begin\" then\n\t\tApi.Start()\n\telseif InputState == \"End\" then\n\t\tApi.Stop()\n\tend\nend)" },
		{ Key = "Api.IsHeld(Name)", Value = "-&gt; boolean",
			Summary = "Is that action's key or touch button down right now. Defaults to your own action. In Toggle mode it is still the key, ask the move itself whether it is on, Api.Locomotion.IsSprinting() for the run.",
			Code = "function MyMove:Update(DeltaTime)\n\tif not Api.IsHeld() then\n\t\tApi.Stop()\n\t\treturn\n\tend\nend\n\n-- someone else's key\nif Api.IsHeld(\"Crouch\") then end" },
		{ Key = "Api.ShiftLocked()", Value = "-&gt; boolean",
			Summary = "Is shift lock on, the kit's own or Roblox's.",
			Code = "if Api.ShiftLocked() then\n\t-- the body already faces the camera\nend" },
		{ Key = "Api.MoveVector()", Value = "-&gt; Vector3",
			Summary = "The movement input as the controls report it, X sideways and Z forward on the screen, before the camera turns it into a world direction. For a move that cares which way the stick is pushed.",
			Code = "local Input = Api.MoveVector()\nif Input.Z &lt; -0.5 then\n\t-- pushing forward\nend" },
		{ Key = "Api.JumpHeld()", Value = "-&gt; boolean",
			Summary = "Is the jump key down right now, keyboard, controller or the touch button alike. For a move that lasts as long as jump is held, the way the glide does.",
			Code = "function MyMove:Update(DeltaTime)\n\tif not Api.JumpHeld() then\n\t\tApi.Stop()\n\tend\nend" },
		{ Key = "Api.ClaimJump(Priority, CanClaim, Claim)", Value = "no return",
			Summary = "Take the jump button at a priority. CanClaim is asked at the moment of the press, and Claim runs only if you won it. With DoublePressEnabled in your block, it takes two quick jump presses while your move is not running.",
			Code = "-- jump out of the move, but only while the move is running\nApi.ClaimJump(40,\n\tfunction()\n\t\treturn Api.IsActive()\n\tend,\n\tfunction()\n\t\tApi.RootPart.AssemblyLinearVelocity += Vector3.new(0, 60, 0)\n\t\tApi.Stop()\n\tend)" },
		{ Key = "Api.ClaimKey(Key, Priority, CanClaim, Claim)", Value = "no return",
			Summary = "The same thing for any other KeyCode, for when your key is shared with a shipped move. DoublePressEnabled counts here too.",
			Code = "-- share C with the crouch, and win it only while sliding\nApi.ClaimKey(Enum.KeyCode.C, 60,\n\tfunction()\n\t\treturn Api.IsActive()\n\tend,\n\tfunction()\n\t\tApi.Stop()\n\tend)" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX14">
          <Properties>
            <string name="Name">Kinds</string>
            <ProtectedString name="Source">return {
	Name = "Kinds",
	Title = "When a move may start",
	Blurb = "The four kinds of module, and how one is chosen",
	Summary = "Nothing polls. A key or a humanoid event wakes only the moves that care, and then your move is asked. Which kind your module is comes from the fields it declares.",
	Notes = {
		"Standing still, the only per-frame work in the whole system is the ambient lane. The engine step is not even scheduled.",
		"MovementConfig.StateTransitions decides what may follow what. A move that never seems to start is often filtered there rather than refusing in CanEnter.",
		"Manager.LastRefusalReason holds the last reason a move said no, which is why Api.Refuse takes a string.",
	},
	Rows = {
		{ Key = "Triggered", Value = "declares neither", Accepts = "no extra fields",
			Summary = "Runs only when you ask it to, usually from a key. This is what the template is, and what most custom moves want. Start here unless you have a reason not to.",
			Note = "Dash and Slide are triggered.",
			Code = "-- no Requires, no StepWhileAirborne\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.BindKey(function(_, InputState)\n\t\tif InputState == \"Begin\" then\n\t\t\tApi.Start()\n\t\tend\n\tend)\nend" },
		{ Key = "Gated", Value = "declares Requires", Accepts = "a Requires table",
			Summary = "Starts itself when the world is right, no key involved. The cheap conditions are checked first and Confirm only once they pass.",
			Note = "WallRun, Vault and Glide are gated.",
			Code = "MyMove.Requires = { Grounded = false, Moving = true }\n\nfunction MyMove:Confirm()\n\tlocal Side = Api.RootPart.CFrame.RightVector * 3\n\treturn Api.Raycast(Api.RootPart.Position, Side) ~= nil\nend\n\n-- no Api.Start() anywhere: the kit starts it for you" },
		{ Key = "Airborne", Value = "declares StepWhileAirborne", Accepts = "true",
			Summary = "Runs while the body is in the air and once on landing, without owning the body. For watching a fall.",
			Note = "FallDamage is airborne.",
			Code = "MyMove.StepWhileAirborne = true\n\nlocal Lowest = 0\n\nfunction MyMove:Update(DeltaTime)\n\tLowest = math.min(Lowest, Api.RootPart.AssemblyLinearVelocity.Y)\nend" },
		{ Key = "Ambient", Value = "named in the dispatcher", Accepts = "core modules only",
			Summary = "Runs all the time, for things that animate rather than move. Never owns the body. Custom modules cannot join this kind.",
			Note = "Locomotion, Footsteps, SpeedEffects, BodyLean, ZoneEffects, WindController, FirstPersonBody.",
			Code = "-- you cannot opt in from Custom. If you need work every frame,\n-- bind it yourself instead:\nlocal FrameLoop = require(\n\tscript:FindFirstAncestor(\"Movement\").Engine.FrameLoop)" },
		{ Key = "Requires keys", Value = "the whole vocabulary", Accepts = "Grounded, Moving, Free, JumpHeld, FallSpeed",
			Summary = "These five are all a Requires table may use. Grounded, Moving, Free and JumpHeld take true or false. FallSpeed takes a number the fall has to exceed.",
			Code = "-- on the ground and moving\nMyMove.Requires = { Grounded = true, Moving = true }\n\n-- in the air, holding jump, not busy with another move\nMyMove.Requires = { Grounded = false, JumpHeld = true, Free = true }\n\n-- falling faster than 5 studs a second\nMyMove.Requires = { Grounded = false, FallSpeed = 5 }" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX15">
          <Properties>
            <string name="Name">Movement</string>
            <ProtectedString name="Source">return {
	Name = "Movement",
	Title = "Speed and momentum",
	Blurb = "Borrowing humanoid properties without a fight",
	Summary = "Anything that writes a humanoid property goes through here, because two writers on WalkSpeed is the usual way to make movement twitch. The kit remembers what it borrowed and puts it back.",
	Notes = {
		"Always pair a borrow with RestoreWalkSpeed in Exit, including the Exit you did not choose.",
		"SetDefaultAnimations(false) turns off Roblox's own Animate script, which you want while your move drives the body itself.",
	},
	Rows = {
		{ Key = "Api.Momentum(FeatureKey, BaseSpeed)", Value = "-&gt; number",
			Summary = "The speed your move should run at, with the game's momentum settings applied. Pass your feature key so the right tuning is used.",
			Code = "function MyMove:Update(DeltaTime)\n\tlocal Speed = Api.Momentum(\"MyMove\", Api.Config.Speed)\n\tlocal Root = Api.RootPart\n\tRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * Speed\n\t\t+ Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)\nend" },
		{ Key = "Api.BaseWalkSpeed()", Value = "-&gt; number",
			Summary = "The walk speed the character had before anything borrowed it. Scale from this, not from the current value.",
			Code = "function MyMove:Enter()\n\tApi.Humanoid.WalkSpeed = Api.BaseWalkSpeed() * 0.4\nend" },
		{ Key = "Api.RestoreWalkSpeed()", Value = "no return",
			Summary = "Puts the walkspeed back to that baseline. Call it in Exit, every time. Once your move has stopped, the kit eases the player from their current speed back up to it.",
			Code = "function MyMove:Exit()\n\tApi.RestoreWalkSpeed()\nend" },
		{ Key = "Api.Boost(Multiplier, Seconds)", Value = "no return",
			Summary = "Scales the walk and run speed for a while, then lets it fall back on its own. Nothing to restore and no landing window, the same call a config hook makes through Manager.Locomotion.Boost.",
			Code = "function MyMove:Exit()\n\t-- a second and a half of extra pace after the move\n\tApi.Boost(1.4, 1.5)\nend" },
		{ Key = "Api.SetJumpEnabled(Enabled)", Value = "no return",
			Summary = "Turns jumping off and on. The kit tracks who turned it off, so your move cannot leave a player permanently unable to jump.",
			Code = "function MyMove:Enter()\n\tApi.SetJumpEnabled(false)\nend\n\nfunction MyMove:Exit()\n\tApi.SetJumpEnabled(true)\nend" },
		{ Key = "Api.SetDefaultAnimations(Enabled)", Value = "no return",
			Summary = "Enables or disables Roblox's stock Animate script. Turn it off while your own animation is playing, or the two fight over the same joints.",
			Code = "function MyMove:Enter()\n\tApi.SetDefaultAnimations(false)\n\tif Track then Track:Play(0.1) end\nend\n\nfunction MyMove:Exit()\n\tif Track then Track:Stop(0.1) end\n\tApi.SetDefaultAnimations(true)\nend" },
		{ Key = "Api.Claim(Property, Value)", Value = "no return",
			Summary = "Takes one body property for your move: AutoRotate, Anchored, WalkSpeed, Jump, CameraOffset or Animate. The kit remembers the old value and puts it back when your move stops.",
			Code = "function MyMove:Enter()\n\tApi.Claim(\"AutoRotate\", false)\n\tApi.Claim(\"WalkSpeed\", 6)\nend" },
		{ Key = "Api.Release(Property)", Value = "no return",
			Summary = "Gives a claimed property back while your move is still running. When the move stops the kit gives back everything it claimed anyway.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.Humanoid.FloorMaterial ~= Enum.Material.Air then Api.Release(\"AutoRotate\") end\nend" },
		{ Key = "Api.Push(Force)", Value = "-&gt; LinearVelocity",
			Summary = "A velocity mover on the root part that the kit deletes when your move stops. Force is the most force it may use on each axis, set VectorVelocity to drive it.",
			Code = "function MyMove:Enter()\n\tlocal Push = Api.Push(Vector3.new(50000, 0, 50000))\n\tPush.VectorVelocity = Api.RootPart.CFrame.LookVector * 60\nend" },
		{ Key = "Api.Outro(Seconds)", Value = "no return",
			Summary = "Keeps everything your move claimed for a few more seconds after it stops, for a recovery animation or a slide out. Moves with a BlockedDuring list wait for it, any move that does start ends it early.",
			Code = "function MyMove:Exit()\n\tApi.Outro(0.3)\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX16">
          <Properties>
            <string name="Name">Rules</string>
            <ProtectedString name="Source">return {
	Name = "Rules",
	Title = "Rules worth keeping",
	Blurb = "The mistakes the kit was refactored to stop",
	Summary = "These are not style preferences. Each one is a defect the kit already had and had "
		.. "removed, written down so it does not come back.",
	Rows = {
		{ Key = "One file is one move", Value = "no second file",
			Summary = "Everything a move is lives in one ModuleScript. A part that genuinely stands alone becomes a CHILD of your module, not a sibling somewhere else in the tree.",
			Code = "-- no\nCustom\n  MyMove\nEngine\n  MyMoveLogic     &lt;- a jump across the tree every time you read it\n\n-- yes\nCustom\n  MyMove\n    MyMoveGeometry  &lt;- a child, required by MyMove alone" },
		{ Key = "Moves never require each other", Value = "use the Api",
			Summary = "Shared code arrives as Api.Utils or by naming an Engine module directly. The only requires a move makes are its own children.",
			Code = "-- no\nlocal Dash = require(script.Parent.Parent.Core.DashModule)\n\n-- yes\nif Api.ActiveMove() == \"DashModule\" then\n\treturn\nend" },
		{ Key = "The camera only turns a body about Y", Value = "never the raw look vector",
			Summary = "Feed a raw camera LookVector into a body direction and looking down flips it, so the body aims backwards. Flatten it first.",
			Code = "-- no\nlocal Heading = Camera.CFrame.LookVector\n\n-- yes\nlocal Look = Camera.CFrame.LookVector\nlocal Heading = Vector3.new(Look.X, 0, Look.Z).Unit" },
		{ Key = "A flag is a promise", Value = "keep it in the same breath",
			Summary = "Declaring OwnsFacing without turning AutoRotate off gives you two writers on the same value, which is seen as twitching.",
			Code = "MyMove.OwnsFacing = true\n\nfunction MyMove:Enter()\n\tApi.Humanoid.AutoRotate = false   -- the promise, kept\nend\n\nfunction MyMove:Exit()\n\tApi.Humanoid.AutoRotate = true\nend" },
		{ Key = "Read config live", Value = "never cache at load",
			Summary = "Caching a config value into a local at load makes the setting uneditable while the game runs, which is half of what the kit is for.",
			Code = "-- no, frozen forever\nlocal Speed = Api.Config.Speed\n\n-- yes, follows the config\nfunction MyMove:Update(DeltaTime)\n\tMove(Api.Config.Speed)\nend" },
		{ Key = "Engine modules are called by name", Value = "no wrappers",
			Summary = "Call WorldQueries.Raycast with the manager passed in, never through a wrapper or alias. A wrapper that renames a function is a way to lose it.",
			Code = "-- inside the engine\nMovementWorld.Raycast(Manager, Origin, Direction)\n\n-- from your custom move, the Api is the wrapper you get\nApi.Raycast(Origin, Direction)" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX17">
          <Properties>
            <string name="Name">Sound</string>
            <ProtectedString name="Source">return {
	Name = "Sound",
	Title = "Sounds",
	Blurb = "Playing a sound other players can hear",
	Summary = "Sounds go through the kit's asset layer so the server relay can forward them to the "
		.. "other players. Playing a Sound instance yourself is heard by nobody else.",
	Rows = {
		{ Key = "Api.Sound(Value, FallbackName)", Value = "-&gt; Sound?",
			Summary = "Turns a config value into a Sound. The kit's own slots name their Sound under Movement &gt; SFX &gt; MovementSFX, give yours a folder in Custom the same way. A plain sound id works too, and a Sound with no id plays nothing.",
			Code = "-- with Config.MyMove = { WhooshSoundId = \"ReplicatedStorage.Modules.Movement.SFX.MovementSFX.Custom.MyMove.Whoosh\" }\n-- or an id: WhooshSoundId = \"rbxassetid://1234567890\"\nlocal Whoosh = Api.Sound(Api.Config.WhooshSoundId, \"Whoosh\")" },
		{ Key = "Api.PlaySound(Sound)", Value = "no return",
			Summary = "Plays it and tells the replicator, so other clients hear it on your character too.",
			Code = "function MyMove:Enter()\n\tApi.PlaySound(Whoosh)\nend" },
		{ Key = "Api.Sounds(Names)", Value = "-&gt; table",
			Summary = "Every &lt;Name&gt;SoundId of your block loaded at once, by name: SurgeSoundId becomes Sounds.Surge. Pass a table of names to load only some.",
			Code = "local Sounds = Api.Sounds()\n\nfunction MyMove:Enter()\n\tApi.PlaySound(Sounds.Surge)\nend" },
		{ Key = "Api.SetLoop(Sound, On)", Value = "no return",
			Summary = "Starts a sound looping or stops it, replicated like PlaySound, and does nothing when it is already in that state, so it is safe to call every tick.",
			Code = "function MyMove:Update(DeltaTime)\n\tApi.SetLoop(Sounds.Wind, Api.RootPart.AssemblyLinearVelocity.Magnitude &gt; 30)\nend" },
		{ Key = "Api.StopSound(Sound)", Value = "no return",
			Summary = "Stops it everywhere it was started. Use it in Exit for a looping sound.",
			Code = "function MyMove:Exit()\n\tApi.StopSound(Whoosh)\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX18">
          <Properties>
            <string name="Name">Stamina</string>
            <ProtectedString name="Source">return {
	Name = "Stamina",
	Title = "Stamina",
	Blurb = "Spending and draining, when the game has it turned on",
	Summary = "Stamina is a feature that can be turned off entirely. Ask StaminaEnabled first, or "
		.. "a move that costs stamina becomes impossible in a game that does not use it.",
	Rows = {
		{ Key = "Api.StaminaEnabled()", Value = "-&gt; boolean",
			Summary = "Is stamina on in this game at all. Check this before gating anything on it.",
			Code = "function MyMove:CanEnter()\n\tif Api.StaminaEnabled() and Api.Stamina() &lt; Api.Config.Cost then\n\t\treturn Api.Refuse(\"not enough stamina\")\n\tend\n\treturn true\nend" },
		{ Key = "Api.Stamina()", Value = "-&gt; number",
			Summary = "How much is left right now.",
			Code = "local Left = Api.Stamina()\nApi.Log.Debug(\"stamina left\", Left)" },
		{ Key = "Api.SpendStamina(Amount)", Value = "-&gt; boolean",
			Summary = "Takes a lump sum. Returns false and takes nothing when there is not enough, so it is safe to use as the test itself.",
			Code = "function MyMove:Enter()\n\tApi.SpendStamina(Api.Config.Cost)\nend\n\n-- or as the test, when you have no CanEnter\nif not Api.SpendStamina(10) then\n\treturn -- nothing was taken\nend" },
		{ Key = "Api.DrainStamina(PerSecond, DeltaTime)", Value = "-&gt; boolean",
			Summary = "Takes a rate over one tick, for a move that costs while it is held. Returns false once it has run out, which is your cue to stop.",
			Code = "function MyMove:Update(DeltaTime)\n\tif not Api.DrainStamina(Api.Config.DrainPerSecond, DeltaTime) then\n\t\tApi.Stop()\n\t\treturn\n\tend\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX19">
          <Properties>
            <string name="Name">Start</string>
            <ProtectedString name="Source">return {
	Name = "Start",
	Title = "Getting started",
	Blurb = "Where a custom move lives and how it gets loaded",
	Summary = "A custom move is one ModuleScript in MovementMain &gt; Custom. Copy MovementTemplate, rename it, keep Name = script.Name. Custom modules load after the shipped ones, so they can never replace one.",
	Notes = {
		"The table's Name must equal the script's name. The loader matches them and skips a module whose names disagree.",
		"RequiresApi is the contract version you wrote against. This build is Api version 1 and accepts 1 and up, so put 1.",
		"Nothing in Custom is touched when the kit updates.",
	},
	Rows = {
		{ Key = "The smallest move that works", Value = "start here",
			Summary = "A few lines, a key and a config block. Copy this into a new ModuleScript in Custom named SuperJump and add the block to MovementConfig. No block, no move.",
			Code = "local SuperJump = {}\n\nSuperJump.Name = script.Name\nSuperJump.RequiresApi = 1\n\nlocal Api = nil\n\nfunction SuperJump:Init(NewApi)\n\tApi = NewApi\n\tApi.BindKey(function(_, InputState)\n\t\tif InputState == \"Begin\" and Api.OnGround() then\n\t\t\tApi.RootPart.AssemblyLinearVelocity += Vector3.new(0, Api.Config.Power, 0)\n\t\tend\n\tend)\nend\n\nreturn SuperJump\n\n-- and in MovementConfig, after the shipped blocks\nConfig.SuperJump = { Enabled = true, KeyCode = Enum.KeyCode.H, ConsoleInput = Enum.KeyCode.DPadRight, Power = 90 }" },
		{ Key = "Where it goes", Value = "MovementMain &gt; Custom",
			Summary = "One ModuleScript per move. If part of it grows big enough to want its own file, that file becomes a CHILD of your module, never a sibling somewhere else.",
			Note = "MovementMain.LoadModules(Custom) runs after LoadModules(Core).",
			Code = "ReplicatedStorage\n  Modules\n    Movement\n      MovementMain\n        Core          &lt;- the shipped moves, leave these alone\n        Custom        &lt;- yours goes here\n          MovementTemplate\n          SuperJump   &lt;- your new ModuleScript" },
		{ Key = "The type", Value = "MovementTypes.Api&lt;Block&gt;",
			Summary = "Requiring MovementTypes gives your editor autocomplete on the Api. Every shipped block has a type named after it, read straight off MovementConfig, and Api&lt;Block&gt; makes Api.Config autocomplete too. For a block of your own, typeof(MovementConfig.MyMove) is its type.",
			Code = "local MovementTypes = require(script:FindFirstAncestor(\"Movement\").MovementTypes)\n\nlocal Api: MovementTypes.Api&lt;MovementTypes.MovementTemplateConfig&gt; = nil\n\nfunction SuperJump:Init(NewApi: MovementTypes.Api&lt;MovementTypes.MovementTemplateConfig&gt;)\n\tApi = NewApi\n\t-- type Api. now and your editor lists every function the Api has, Api.Config. lists every key of the block\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX20">
          <Properties>
            <string name="Name">State</string>
            <ProtectedString name="Source">return {
	Name = "State",
	Title = "Starting and stopping",
	Blurb = "Asking for the body",
	Summary = "Your move does not simply run. It asks, and the answer depends on what is already active, the transition rules and your own CanEnter. A refusal is normal.",
	Rows = {
		{ Key = "Api.Start()", Value = "-&gt; boolean",
			Summary = "Ask to start your move. Returns false if it was refused.",
			Code = "if not Api.Start() then\n\tApi.Log.Debug(\"could not start:\", Api.Config.Name)\nend" },
		{ Key = "Api.Stop()", Value = "-&gt; boolean",
			Summary = "Stop your move and hand the body back. Your Exit is called for you.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.Stamina() &lt;= 0 then\n\t\tApi.Stop()\n\tend\nend" },
		{ Key = "Api.IsActive()", Value = "-&gt; boolean",
			Summary = "Is your move the one that currently owns the body. Worth checking at the top of Update if you also do work from a key binding.",
			Code = "Api.BindKey(function(_, InputState)\n\tif InputState ~= \"Begin\" then return end\n\tif Api.IsActive() then\n\t\tApi.Stop()\n\telse\n\t\tApi.Start()\n\tend\nend)" },
		{ Key = "Api.ActiveMove()", Value = "-&gt; string?",
			Summary = "The name of whichever move owns the body, or nil when none does.",
			Code = "if Api.ActiveMove() == \"SlideModule\" then\n\t-- do not fight the slide\n\treturn\nend" },
		{ Key = "Api.HasFlag(Name)", Value = "-&gt; boolean",
			Summary = "Does the ACTIVE move declare that capability flag. Use it to stand down while something else has taken over the facing or the head.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.HasFlag(\"OwnsFacing\") then\n\t\treturn -- something else is steering, leave it alone\n\tend\nend" },
		{ Key = "Api.Refuse(Reason)", Value = "-&gt; false",
			Summary = "Records why your move said no and returns false, so CanEnter reads as one line per condition. The reason lands in Manager.LastRefusalReason.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\tif Api.Stamina() &lt; 10 then return Api.Refuse(\"not enough stamina\") end\n\treturn true\nend" },
		{ Key = "Api.OnMoveStarted(Callback)", Value = "-&gt; RBXScriptConnection",
			Summary = "Calls you with the name of every move that starts, your own included. Connect in Init, disconnect in Cleanup.",
			Code = "local Connection = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tConnection = Api.OnMoveStarted(function(Name)\n\t\tif Name ~= Api.Name then\n\t\t\tApi.Log.Debug(Name, \"started\")\n\t\tend\n\tend)\nend\n\nfunction MyMove:Cleanup()\n\tif Connection then Connection:Disconnect() end\nend" },
		{ Key = "Api.OnMoveStopped(Callback)", Value = "-&gt; RBXScriptConnection",
			Summary = "The other half: the name of every move that ends, your own included. The same rule, connect in Init, disconnect in Cleanup.",
			Code = "local Connection = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tConnection = Api.OnMoveStopped(function(Name)\n\t\tif Name == \"DashModule\" then\n\t\t\t-- the dash just ended, a follow up may start now\n\t\tend\n\tend)\nend\n\nfunction MyMove:Cleanup()\n\tif Connection then Connection:Disconnect() end\nend" },
		{ Key = "Api.Move(Name)", Value = "-&gt; table?",
			Summary = "A frozen copy of another move, for the questions it answers about itself: IsGliding, IsDashing, IsCrouching and the like. Its methods work, writing to it errors. nil when no such move is loaded.",
			Code = "local Glide = Api.Move(\"GlideModule\")\nif Glide and Glide:IsGliding() then\n\treturn Api.Refuse(\"not while gliding\")\nend" },
		{ Key = "Api.StopAll()", Value = "-&gt; nothing",
			Summary = "Stops whichever move owns the body, for when something outside the kit already decided.",
			Code = "if not Api.Start() then\n\tApi.StopAll()\n\tApi.Start()\nend" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX21">
          <Properties>
            <string name="Name">World</string>
            <ProtectedString name="Source">return {
	Name = "World",
	Title = "The world",
	Blurb = "Ground, slopes and raycasts, through the shared filter",
	Summary = "The raycasts carry the kit's own collision filter: your character, other players and the kit's effects are excluded for you. The slope calls are the maths every ground move in the kit runs on.",
	Notes = {
		"Use these instead of workspace:Raycast, or your move will happily hit the very effect parts the kit spawned for it.",
		"An expensive raycast belongs in Confirm, not CanEnter. Confirm is only asked once the cheap gates already passed.",
	},
	Rows = {
		{ Key = "Api.OnGround()", Value = "-&gt; boolean",
			Summary = "Is the body standing on something. The same ground test the rest of the kit uses.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then\n\t\treturn Api.Refuse(\"needs to be on the ground\")\n\tend\n\treturn true\nend" },
		{ Key = "Api.AirTime()", Value = "-&gt; number",
			Summary = "How many seconds the body has been off the ground, 0 while it stands. The glide and the dive gate themselves on it, an air move of yours can too.",
			Code = "function MyMove:CanEnter()\n\tif Api.AirTime() &lt; Api.Config.MinAirTime then\n\t\treturn Api.Refuse(\"not in the air long enough\")\n\tend\n\treturn true\nend" },
		{ Key = "Api.GroundInfo(Origin, Distance)", Value = "-&gt; boolean, Vector3, number, RaycastResult?",
			Summary = "Looks down from a point: whether there is ground within Distance, its normal, its angle in degrees, and the hit itself. The normal is straight up and the angle 0 when nothing is found, so the values are always safe to use.",
			Code = "local Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, 6)\nif not Grounded then\n\tApi.Stop()\n\treturn\nend\nif Angle &gt; Api.Config.MaxSlopeAngle then\n\tApi.Stop()\nend" },
		{ Key = "Api.ProjectOntoSlope(Direction, Normal, Angle, MaxAngle)", Value = "-&gt; Vector3",
			Summary = "Turns a flat direction into one that runs along the ground it is on, so a push does not dig into a ramp or lift off it. Past MaxAngle the flat direction comes back untouched.",
			Code = "local Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, 6)\nlocal Along = Api.ProjectOntoSlope(Api.RootPart.CFrame.LookVector, Normal, Angle, Api.Config.SlopeProjectionLimit)\nApi.RootPart.AssemblyLinearVelocity = Along * Api.Config.Speed" },
		{ Key = "Api.DownhillFactor(Direction, Normal, Angle)", Value = "-&gt; number",
			Summary = "How much of a slope a direction runs down: positive downhill, negative uphill, 0 on the flat, about 1 straight down a 45 degree slope. Multiply it into a speed for a downhill boost.",
			Code = "local Boost = Api.DownhillFactor(Direction, Normal, Angle) * Api.Config.DownhillBoost\nlocal Velocity = Direction * (Api.Config.Speed + Boost)" },
		{ Key = "Api.WallHit(Origin, Direction)", Value = "-&gt; RaycastResult?",
			Summary = "A raycast that only counts a wall: a hit whose surface stands within about 30 degrees of upright, nil for floors, ceilings and thin air.",
			Code = "local Wall = Api.WallHit(Api.RootPart.Position, Api.RootPart.CFrame.LookVector * 3)\nif Wall and not Api.SurfaceRefused(Wall) then\n\t-- something to push off\nend" },
		{ Key = "Api.FloorHit(Origin, Depth)", Value = "-&gt; RaycastResult?",
			Summary = "Looks down Depth studs for a floor, a surface flat enough to stand on, nil otherwise.",
			Code = "local Floor = Api.FloorHit(Api.RootPart.Position, Api.StandHeight() + 2)\nif Floor then\n\tApi.RootPart.CFrame = CFrame.new(Floor.Position + Vector3.new(0, Api.StandHeight(), 0)) * Api.RootPart.CFrame.Rotation\nend" },
		{ Key = "Api.PathClear(From, To, Ignore)", Value = "-&gt; boolean",
			Summary = "Is the straight line between two points free of anything solid, with the kit's filter. Ignore lets one part through, the ledge you are about to grab.",
			Code = "if Api.PathClear(Api.RootPart.Position, Target, Ledge) then\n\t-- nothing in the way\nend" },
		{ Key = "Api.StandHeight()", Value = "-&gt; number",
			Summary = "How far the root sits above the feet on this rig, hip height plus half the root on R15 and 3 on R6. Add it to a floor position to place the character on it.",
			Code = "local Feet = Api.RootPart.Position - Vector3.new(0, Api.StandHeight(), 0)" },
		{ Key = "Api.SurfaceRefused(Hit)", Value = "-&gt; boolean",
			Summary = "Does the kit refuse this surface to your move: no hit at all, a part carrying a Core.UnclimbableTags tag whose Blocks is All or names your move, or terrain of a material in your block's BlockedTerrainMaterials.",
			Code = "local Wall = Api.WallHit(Api.RootPart.Position, Ahead)\nif Api.SurfaceRefused(Wall) then\n\treturn Api.Refuse(\"that surface is off limits\")\nend" },
		{ Key = "Api.IsRideSurface(Part)", Value = "-&gt; boolean",
			Summary = "Is this part a zipline, a rail or a bar by its tag, so a climbing or grabbing move leaves it to the move that rides it.",
			Code = "if Api.IsRideSurface(Hit.Instance) then return Api.Refuse(\"that is a rail\") end" },
		{ Key = "Api.RootEnclosed()", Value = "-&gt; boolean",
			Summary = "Are at least four of the six directions around the root blocked within 1.6 studs, the test the slide uses to know it is under something low.",
			Code = "if Api.RootEnclosed() then\n\t-- stay low, there is no room to stand\nend" },
		{ Key = "Api.OnLanded(Callback)", Value = "no return",
			Summary = "Calls you with how many seconds the air lasted every time the character lands, whatever move was running. Connect once in Init, the list is emptied at the next spawn.",
			Code = "function MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.OnLanded(function(Seconds)\n\t\tCharges = Api.Config.Charges\n\tend)\nend" },
		{ Key = "Api.Raycast(Origin, Direction)", Value = "-&gt; RaycastResult?",
			Summary = "A raycast with the kit's filter already applied. Direction carries the length, so multiply a unit vector by how far you want to look.",
			Code = "local Root = Api.RootPart\nlocal Hit = Api.Raycast(Root.Position, Root.CFrame.LookVector * 6)\n\nif Hit then\n\tprint(\"hit\", Hit.Instance.Name)\n\tprint(\"at\", Hit.Position)\n\tprint(\"surface faces\", Hit.Normal)\nend\n\n-- looking down for the floor\nlocal Floor = Api.Raycast(Root.Position, Vector3.new(0, -5, 0))" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
      <Item class="ModuleScript" referent="RBX66"><Properties><string name="Name">Names</string><ProtectedString name="Source">--// [Modules]
local ConfigScanner = require(script.Parent.Parent.Parent.ConfigScanner)

--// [Variables]
local States = { "Idle", "Walking", "Running", "Swimming", "Climbing", "Airborne" }

--// [Do not go past this point]

local function MovesInPlace()
	local Config = ConfigScanner.Module()
	local Main = Config and Config.Parent and Config.Parent:FindFirstChild("MovementMain")
	if not Main then
		return nil
	end
	local Found = {}
	for _, FolderName in { "Core", "Extras", "Custom" } do
		local Folder = Main:FindFirstChild(FolderName)
		local Names = {}
		if Folder then
			for _, Child in Folder:GetChildren() do
				if Child:IsA("ModuleScript") then
					table.insert(Names, Child.Name)
				end
			end
		end
		table.sort(Names)
		Found[FolderName] = Names
	end
	return Found
end

local function MovesRow()
	local Found = MovesInPlace()
	if not Found then
		return { Key = "The moves in this place", Value = "kit not installed",
			Summary = "Install the kit and open this page again: every module under MovementMain &gt; Core, Extras and Custom is listed here by name." }
	end
	local Lines = {}
	for _, FolderName in { "Core", "Extras", "Custom" } do
		table.insert(Lines, "-- " .. FolderName .. "\n" .. (#Found[FolderName] &gt; 0 and table.concat(Found[FolderName], "\n") or "(none)"))
	end
	return { Key = "The moves in this place", Value = (#Found.Core + #Found.Extras + #Found.Custom) .. " names, read off the place when this window opened",
		Summary = "Every ModuleScript under MovementMain &gt; Core, Extras and Custom. A custom move you add appears here next time the plugin opens.",
		Code = table.concat(Lines, "\n\n") }
end

local Page = {
	Name = "Names",
	Title = "Names the kit understands",
	Blurb = "One vocabulary for every list that names a move or a state",
	Summary = "Wherever MovementConfig asks for a move or a state the same words apply: a module name, or one of six words for what the body is doing. Anything else is warned about in the Output at spawn.",
	Notes = {
		"One name per entry, each in its own quotes. { \"WallJumpModule, Swimming\" } is one string and matches nothing.",
		"Api.ActiveMove() returns a move by the same name, and Api.OnMoveStarted hands your callback the same name, so a custom move can compare against them directly.",
		"Running means sprinting. Airborne means off the ground and not swimming or climbing. Idle and Walking are on the ground with no move running.",
	},
}

local Static = {
	{ Key = "A move", Value = "its module name",
		Summary = "DashModule, SlideModule, WallJumpModule, MovementTemplate, your own custom move: the name of the ModuleScript is the word, exactly as spelled.",
		Code = "BlockedDuring = { \"SlideModule\" }\nAlwaysDuring = { \"WallJumpModule\" }\nChainMoves = { \"DashModule\", \"SlideModule\" }" },
	{ Key = "What the body is doing", Value = table.concat(States, ", "),
		Summary = "Six states read off the humanoid. Running is sprinting, Airborne is off the ground and not in water or on a truss.",
		Code = "AlwaysDuring = { \"Swimming\", \"Airborne\" }\nBlockedDuring = { \"Swimming\" }" },
	{ Key = "Everything", Value = "always true",
		Summary = "Matches whatever the body is doing. ActiveDuring = { \"Everything\" } is the kit's own default for the speed effects.",
		Code = "ActiveDuring = { \"Everything\" }" },
	{ Key = "Default", Value = "CameraModule.Moves only",
		Summary = "The camera's base layer, the settings every other entry in Moves sits on top of. It is not a state and means nothing in the other lists.",
		Code = "Moves = {\n\tDefault = { Offset = Vector3.new(0, 0, 0) },\n\tRunning = { Smoothing = { BankDegrees = 4.5 } },\n\tSlideModule = { Offset = Vector3.new(0, -0.8, -0.5) },\n}" },
	{ Key = "Jump, Ground, All", Value = "StateTransitions.Map only",
		Summary = "StateTransitions says what may follow what. Its targets are move names plus Jump for the jump key, Ground for being back on the ground, and All for anything.",
		Code = "StateTransitions = {\n\tMap = {\n\t\tProneModule = { \"CrouchModule\", \"Jump\" },\n\t\tCrouchModule = { \"ProneModule\", \"Jump\" },\n\t},\n}" },
	{ Key = "A sub layer", Value = "CameraModule.Moves only",
		Summary = "A move that has camera layers of its own is addressed as the move name, a dot, and the layer, in brackets because of the dot.",
		Code = "[\"WallClimbModule.Sprint\"] = { Offset = Vector3.new(0, 1, 1) }" },
	{ Key = "In water and on a truss", Value = "Core.AllowedInWater, Core.AllowedWhileClimbing",
		Summary = "A move not named in these two lists is refused while swimming or climbing a truss. A custom move is safe by default; one name opts it in.",
		Code = "AllowedInWater = { \"MovementTemplate\" }\nAllowedWhileClimbing = { \"MovementTemplate\" }" },
	{ Key = "Where the names are used", Value = "every list that names a move",
		Summary = "AllowedInWater and AllowedWhileClimbing on Core, BlockedDuring on a move, ActiveDuring and AlwaysDuring on SpeedEffects, BobMoves and Moves on the camera, FallDamage.Reductions, StateTransitions.Map, PausedBy, MovePlaybackSpeeds and ChainMoves.",
		Code = "-- from a custom move\nfor _, Name in Api.Config.ChainMoves do\n\tif Api.ActiveMove() == Name then\n\t\treturn true\n\tend\nend" },
	{ Key = "What the check says", Value = "at spawn, in the Output",
		Summary = "A name the kit does not know, or two names in one string, is warned about with the entry it sits in. Nothing is switched off, that entry just never matches.",
		Code = "[ConfigValidator] SpeedEffects.AlwaysDuring[1]: \"WallJumpModule, Swimming\" is several names in one string, use { \"WallJumpModule\", \"Swimming\" }" },
}

return setmetatable(Page, {
	__index = function(_, Key)
		if Key == "Rows" then
			local Rows = table.clone(Static)
			table.insert(Rows, MovesRow())
			return Rows
		end
		return nil
	end,
})
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX72"><Properties><string name="Name">Block</string><ProtectedString name="Source">return {
	Name = "Block",
	Title = "What a block gives you",
	Blurb = "Keys the engine honours for any move, no code",
	Summary = "A config block is not only your tuning. The state machine, the effects, the input and the camera all read a move's block by its name, so a custom move gets the same treatment as a shipped one by writing the keys.",
	Notes = {
		"Every key here is optional. A block without it simply does not get that behaviour.",
		"The shipped blocks are the reference: copy a key from one, the name and the shape are the same for yours.",
	},
	Rows = {
		{ Key = "Cooldown, ManualCooldown", Value = "started for you",
			Summary = "Every start of your move starts its cooldown and a start during it is refused. ManualCooldown = true leaves the timing to Api.StartCooldown.",
			Code = "Config.MyMove = {\n\tEnabled = true,\n\tKeyCode = Enum.KeyCode.H,\n\tCooldown = 2,\n}" },
		{ Key = "StaminaCost, StaminaDrainPerSecond", Value = "spent for you, drained by you",
			Summary = "StaminaCost is taken at every start and the start is refused when it is not there. StaminaDrainPerSecond keeps the stamina service awake while your move runs, the draining itself is your Api.DrainStamina call in Update.",
			Code = "Config.MyMove = {\n\tStaminaCost = 15,\n\tStaminaDrainPerSecond = 6,\n}\n\nfunction MyMove:Update(DeltaTime)\n\tif not Api.DrainStamina(Api.Config.StaminaDrainPerSecond, DeltaTime) then Api.Stop() end\nend" },
		{ Key = "MinEntrySpeed, BlockedDuring, RequireClearance", Value = "checked before a start",
			Summary = "Too slow, during a move or state in the list, or without a clear box of that size around the root, and the start is refused with a reason Core.Debug prints.",
			Code = "Config.MyMove = {\n\tMinEntrySpeed = 12,\n\tBlockedDuring = { \"SlideModule\", \"Swimming\" },\n\tRequireClearance = Vector3.new(3, 5, 3),\n}" },
		{ Key = "EnterSoundId, FOV, Haptics, CameraShake", Value = "played at every start",
			Summary = "The enter sound, the field of view push, the rumble and the Start shake event all come from the block, nothing to call. Api.Shake plays the other shake events you name in CameraShake.",
			Code = "Config.MyMove = {\n\tEnterSoundId = 0,\n\tFOV = { Enabled = true, Change = 8, InTime = 0.15, OutTime = 0.3 },\n\tHaptics = { Enabled = true, Intensity = 0.4, Duration = 0.15 },\n\tCameraShake = { Enabled = true, Intensity = 0.3, Duration = 0.2 },\n}" },
		{ Key = "Vfx and the other effect slots", Value = "fire with the state",
			Summary = "An effect slot in your block plays when the move starts, is kept alive while it runs and stops when it ends, and with Core.ReplicateVfx on other players see it. Its body is written the way the Effects page describes.",
			Code = "Config.MyMove = {\n\tVfx = {\n\t\tEnabled = true, Time = \"Duration\",\n\t\tFunction = function(Context)\n\t\t\treturn Context.Default()\n\t\tend,\n\t},\n}" },
		{ Key = "R6, R15", Value = "the animation branches",
			Summary = "Api.Animation(\"Surge\") reads SurgeAnimationId from the branch of the rig you are on, so one block serves both rigs. The animation matcher in the Install tab fills these too.",
			Code = "Config.MyMove = {\n\tR6 = { SurgeAnimationId = 0 },\n\tR15 = { SurgeAnimationId = 0 },\n}" },
		{ Key = "KeyCode, ConsoleInput", Value = "bound for you",
			Summary = "A block with a KeyCode is bound at spawn and reaches your BindKey callback as Begin and End. On a phone it gets a touch button, in the slot TouchButtons.Actions names for it or the next free one.",
			Code = "Config.MyMove = {\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n}\n\n-- in the module\nApi.BindKey(function(_, InputState)\n\tif InputState == \"Begin\" then Api.Start() end\nend)" },
		{ Key = "OnEnter, OnExit", Value = "functions in the block",
			Summary = "Run with the manager right after the move starts and right after it has fully ended, the second one also gets how many seconds it lasted. A move's OnExit always runs before the next move's OnEnter. For a game to tune what happens around your move without touching the module.",
			Code = "Config.MyMove = {\n\tOnExit = function(Manager, Seconds)\n\t\tManager.Locomotion.Boost(1.3, 1)\n\tend,\n}" },
		{ Key = "Elsewhere in the config", Value = "by your module's name",
			Summary = "CameraModule.Moves.MyMove gives the move its own camera feel, Momentum.Deposits.MyMove lets it feed the chain, StateTransitions.Map decides what may follow it, Core.AllowedInWater and AllowedWhileClimbing let it start there, and any other move may name it in its BlockedDuring.",
			Code = "Config.CameraModule.Moves.MyMove = { Smoothing = { BankDegrees = 5, LungeStuds = 0.5 } }\nConfig.Momentum.Deposits.MyMove = 4\nConfig.StateTransitions.Map.MyMove = { \"DashModule\", \"Jump\" }" },
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">Outside</string><ProtectedString name="Source">return {
	Name = "Outside",
	Title = "Outside hooks",
	Blurb = "Holds, the manager, reloads and the config checks, for code that is not a move",
	Summary = "Code that is not a custom move can still work with the kit: hold it still while something else has the body, reach the manager, restart it, and ask the config checks what a value may be. A ragdoll, a cutscene, a stun or an editor of your own all go through these.",
	Notes = {
		"Every hold stops the running move and refuses every move until it lets go.",
		"The manager is built again at every spawn and every Reload, so fetch it when you need it rather than keeping it.",
	},
	Rows = {
		{ Key = "MovementHold", Value = "an attribute on the character", Accepts = "true, or any name",
			Summary = "Holds the kit while it is set. The server or the player's own client can set it, clearing it lets go.",
			Code = "-- when the ragdoll, stun or cutscene starts\nCharacter:SetAttribute(\"MovementHold\", \"Ragdoll\")\n\n-- when it ends\nCharacter:SetAttribute(\"MovementHold\", nil)" },
		{ Key = "PlatformStand and Physics", Value = "held by themselves",
			Summary = "While no move runs, a humanoid with PlatformStand on or in the Physics state holds the kit the same way, so most ragdolls need no code. One that starts in the middle of a move only holds once that move ends, set MovementHold for those.",
			Note = "The Ragdoll humanoid state is no hold, and Core.SuppressTripStates keeps the humanoid out of it. While Core.DisableCollisionOnDeath is on, every part but the root and the torso stops colliding on death, switch it off for a death ragdoll." },
		{ Key = "Manager:SetExternalOverride(Name)", Value = "no return", Accepts = "a name, or nil to let go",
			Summary = "The same hold from client code. The attribute and PlatformStand holds only start while no hold of yours is set, and only ever release their own.",
			Code = "local MovementMain = require(game.ReplicatedStorage.Modules.Movement.MovementMain)\nlocal Manager = MovementMain.GetManager()\nif Manager then\n\tManager:SetExternalOverride(\"Cutscene\")\n\ttask.wait(3)\n\tManager:SetExternalOverride(nil)\nend" },
		{ Key = "MovementMain.GetManager()", Value = "-&gt; Manager?",
			Summary = "The kit's manager for the local character. It is nil before the first spawn, and from the moment a dead character is removed until the next spawn has loaded the kit. Its States table holds every loaded move by name, custom ones included.",
			Code = "local MovementMain = require(game.ReplicatedStorage.Modules.Movement.MovementMain)\nlocal Manager = MovementMain.GetManager()\nif Manager and Manager.ActiveState then\n\tprint(\"running\", Manager.ActiveState)\nend" },
		{ Key = "MovementMain.Reload()", Value = "-&gt; Manager?",
			Summary = "Builds the kit again on the local character from MovementConfig as it is now, extras included, and returns the new manager once it is built, so it waits a moment. For the keys a move reads once at spawn, such as Enabled. The rebuild always runs on MovementController, so it is safe to call from a script that is destroyed right after.",
			Code = "local Movement = game.ReplicatedStorage.Modules.Movement\nlocal MovementConfig = require(Movement.MovementConfig)\nlocal MovementMain = require(Movement.MovementMain)\n\nMovementConfig.MovementTemplate.Enabled = true\nMovementMain.Reload()" },
		{ Key = "ConfigValidator.Validate(Config)", Value = "-&gt; { string }",
			Summary = "Runs the checks the kit runs at spawn and returns one line per problem, an empty list when the config is clean. A report that differs from the last one is also warned in the Output. The values in a Custom module's block are left to that module, only its name lists are checked.",
			Code = "local Movement = game.ReplicatedStorage.Modules.Movement\nlocal ConfigValidator = require(Movement.Engine.ConfigValidator)\nlocal MovementConfig = require(Movement.MovementConfig)\n\nlocal Problems = ConfigValidator.Validate(MovementConfig)\nprint(#Problems == 0 and \"clean\" or table.concat(Problems, \"\\n\"))" },
		{ Key = "ConfigValidator.Choices(Path, Key)", Value = "-&gt; { string }?",
			Summary = "The words a value may be: every move and state name for an entry of a name list, the allowed words for a mode. nil when any value goes. Path is the table the key sits in, written the way the Output writes it.",
			Code = "ConfigValidator.Choices(\"DashModule\", \"Mode\")\nConfigValidator.Choices(\"Core.AllowedInWater\", 1)" },
		{ Key = "ConfigValidator.KeyChoices(Path)", Value = "-&gt; { string }?",
			Summary = "The names a new key may take in a table keyed by move or state, such as StateTransitions.Map or CameraModule.Moves. nil for any other table.",
			Code = "ConfigValidator.KeyChoices(\"StateTransitions.Map\")" },
		{ Key = "ConfigValidator.Blank(Path)", Value = "-&gt; table?",
			Summary = "An empty entry for a list whose entries share one shape, every field at zero, false, an empty string or an empty table. nil for any other list.",
			Code = "table.insert(MovementConfig.VaultingModule.Variants, ConfigValidator.Blank(\"VaultingModule.Variants\"))" },
	},
}
</ProtectedString></Properties></Item></Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--// [Variables]
local Config = {
	GridTitle = "CONFIG BLOCKS",
	Search = "Filter blocks",
	Back = "Return",
	Facts = function(Settings: number): string return Settings .. " settings" end,
	NoDoc = "no description yet",
	NoSettingDoc = "No explanation written for this one yet.",
	Accepts = function(Takes: string): string return "Takes: " .. Takes end,
	OwnComment = function(Comment: string): string return "In the file: " .. Comment end,
	ExpandHint = "Click a setting to read what it does. Everything here is read straight out of "
		.. "MovementConfig, so editing the file updates this page as you type.",
	FunctionValue = "function(Context) ... end",
	LinePrefix = "line ",
	Notes = "WORTH KNOWING",
	Where = function(Block: string, First: number, Last: number): string return Block .. ", lines " .. First .. " to " .. Last .. " of MovementConfig" end,
	Summary = function(Shown: number, Blocks: number, Settings: number): string return Shown .. " of " .. Blocks .. " blocks  |  " .. Settings .. " settings in total" end,
	NoConfig = "MovementConfig not found. Install the folders first.",
}

--// [Do not go past this point]

Config.Blocks = require(script.Blocks)
Config.Settings = require(script.Settings)

return Config
</ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX23">
          <Properties>
            <string name="Name">Blocks</string>
            <ProtectedString name="Source">--// [Variables]
local ConfigDocs = {}

--// [Do not go past this point]

ConfigDocs.Blocks = {
	Core = {
		Title = "Core",
		Blurb = "Switches for the whole kit",
		Summary = "Switches for the whole kit rather than one move.",
		Notes = {
			"Extras loads the whole MovementMain &gt; Extras folder. Each module in it also has its own Enabled.",
			"UpdatesPerSecond is the main performance dial.",
			"Stamina, breath and fall damage are worked out on the player's side, the server only applies the fall and drowning damage.",
		},
	},
	CameraShake = {
		Title = "Camera Shake",
		Blurb = "The look of every camera shake",
		Summary = "The default look of every camera shake the moves play: how fast it vibrates, how much it rolls and whether it is smooth or a rattle.",
		Notes = {
			"Each move's own CameraShake table only sets the strength and length. The style lives here.",
		},
	},
	StateTransitions = {
		Title = "State Transitions",
		Blurb = "Which moves may follow which",
		Summary = "Which moves may follow which. A move not listed under another cannot start straight out of it.",
		Notes = {
			"Jump in a list means the jump key is allowed out of that move.",
			"Only the pairs you list are checked. Everything else follows the moves' own rules.",
		},
	},
	Stamina = {
		Title = "Stamina",
		Blurb = "The stamina pool and how it refills",
		Summary = "The stamina pool the moves spend from and how it comes back.",
		Notes = {
			"Every move's cost and drain is set in that move's own block.",
			"The bar in StarterGui reads the pool; restyle it freely, keep the Fill frame.",
		},
	},
	Momentum = {
		Title = "Momentum",
		Blurb = "A bonus for keeping speed or chaining moves",
		Summary = "A bonus for keeping up speed or linking moves: run and dash faster, launch further, shorter cooldowns.",
		Notes = {
			"Speed mode rewards not stopping. Chain mode rewards stringing moves together inside the window.",
			"The Affects switches say which moves get the bonus.",
		},
	},
	TouchButtons = {
		Title = "Mobile Buttons",
		Blurb = "On screen buttons for phones and tablets",
		Summary = "The on screen buttons phones and tablets get for the moves: which slot each move uses, where the slots sit, colours and size.",
		Notes = {
			"A move with a KeyCode gets a button by itself. Give it a slot in Actions or it takes the next free one.",
			"Anchor Jump places a slot relative to the jump button, Screen relative to the screen.",
		},
	},
	LocomotionModule = {
		Title = "Core Locomotion",
		Blurb = "Walk, run, jump, swim, climb, land, fall damage",
		Summary = "Walking, running, jumping, air jumps, swimming, drowning, truss climbing, landings, the landing roll and fall damage.",
		Notes = {
			"Never disable this block. Everything else builds on it.",
			"Landings is a list of tiers by fall height, each with its own animation and hold time.",
			"FallDamage.Reductions lets a move soften or cancel the damage while it runs.",
		},
	},
	DashModule = {
		Title = "Dashing",
		Blurb = "A burst of speed on the ground or in the air",
		Summary = "A burst of speed on the ground or in the air, with a speed and animation per direction.",
		Notes = {
			"Ground and Aerial hold the per direction settings. A key set there beats the shared one.",
			"CooldownMode decides whether all dashes share one cooldown, one per ground and air, or one each.",
			"With ChargeEnabled, MovementChargeBar in StarterGui shows the charge. FillFrom and Drains in its BarDriver pick the edge and whether it empties or fills.",
		},
	},
	LeapModule = {
		Title = "Edge Leap",
		Blurb = "A long jump off an edge while running",
		Summary = "A long jump off an edge or a tagged part while running.",
		Notes = {
			"EdgeMode says whether a real edge, a tag, either or anywhere counts.",
		},
	},
	GlideModule = {
		Title = "Glide",
		Blurb = "Glide on a held jump or a key of your own",
		Summary = "Glide forward and sink slowly. StartMode picks how it starts: holding jump in the air, a key that starts it on a press, or a key that glides only while held.",
		Notes = {
			"Gliding into a wall can turn into a wall slide.",
		},
	},
	WallRunModule = {
		Title = "Wall Running",
		Blurb = "Run along a wall and jump off it",
		Summary = "Run along a wall beside you and jump off it.",
		Notes = {
			"SurfaceMode TagOnly limits it to parts tagged WallRunnable.",
			"WrapAroundWalls lets a run follow a wall round a corner.",
		},
	},
	WallClimbModule = {
		Title = "Wall Climbing",
		Blurb = "Climb walls, ceilings and over the top",
		Summary = "Climb walls in any direction, sprint up them, cross ceilings and climb over the top.",
		Notes = {
			"Mode picks how free the climbing is, from any direction down to up and down only.",
			"SurfaceMode TagOnly limits it to parts tagged Climbable.",
		},
	},
	WallJumpModule = {
		Title = "Wall Jumping",
		Blurb = "Grip a wall in the air and jump off it",
		Summary = "Grip a wall in the air and jump off it, away or straight up.",
		Notes = {
			"WallGrip off makes it an instant bounce instead of a hang.",
		},
	},
	VaultingModule = {
		Title = "Vaulting",
		Blurb = "Ledges, hanging, mantling and vaults",
		Summary = "Grab ledges, hang, move along them, mantle low walls and vault over obstacles.",
		Notes = {
			"Variants is a list of vault styles by wall height and speed, each with its own animation.",
			"Mode AutoVault goes straight over instead of grabbing.",
			"MantleTrigger Auto also climbs a ledge your jump will not clear, and a press in the air climbs instead of hanging.",
		},
	},
	MonkeyBarsModule = {
		Title = "Monkey Bars",
		Blurb = "Hang, swing and launch from tagged bars",
		Summary = "Hang from tagged bars, swing harder with a press, launch off and chain bar to bar.",
		Notes = {
			"Bars are parts tagged MonkeyBar. Any shape works.",
		},
	},
	ZiplineModule = {
		Title = "Ziplines &amp; Poles",
		Blurb = "Ride tagged lines and climb tagged poles",
		Summary = "Ride tagged lines downhill and climb tagged poles.",
		Notes = {
			"A line is a part tagged Zipline. An upright one counts as a pole.",
			"Attributes on the part can fix its direction, speed mode and the next line in a chain.",
		},
	},
	RailGrindModule = {
		Title = "Rail Grinding",
		Blurb = "Grind along tagged rails",
		Summary = "Grind along tagged rails, lean, brake, speed up and switch onto crossing rails.",
		Notes = {
			"Rails are parts tagged RailGrind. Pieces close together count as one rail.",
		},
	},
	GrappleModule = {
		Title = "Grappling Hook",
		Blurb = "Fire a rope and swing or pull yourself in",
		Summary = "Fire a rope at a point and swing, pull yourself in, or get dragged to it.",
		Notes = {
			"Tagged parts are preferred targets; TaggedPointsOnly makes them the only ones.",
		},
	},
	ZoneEffectsModule = {
		Title = "Launch Pads &amp; Zones",
		Blurb = "Launch pads, updrafts and wind tunnels",
		Summary = "Tagged parts that throw you, lift you or blow you along: launch pads, updrafts and wind tunnels.",
		Notes = {
			"Tag a part with LaunchPad, Updraft or WindTunnel and it works. The part's size is the zone.",
		},
	},
	CrouchModule = {
		Title = "Crouching",
		Blurb = "Crouch, crawl and charge a bullet jump",
		Summary = "Crouch, crawl under low gaps, and charge a bullet jump by holding the crouch key, then let go or press jump.",
		Notes = {
			"AutoCrouch ducks by itself under a low ceiling.",
			"The bullet jump charge shows on MovementChargeBar in StarterGui, the same bar as the dash charge.",
		},
	},
	ProneModule = {
		Title = "Prone Crawl",
		Blurb = "Lie flat and crawl under low gaps",
		Summary = "Lie flat and crawl, under gaps a crouch cannot pass.",
		Notes = {
			"CrouchWhenBlocked drops you into a crouch when there is no room to go prone.",
		},
	},
	SlideModule = {
		Title = "Sliding",
		Blurb = "Slide along the ground, faster downhill",
		Summary = "Slide along the ground, faster downhill, steerable, with a jump out.",
		Notes = {
			"CarryEntrySpeed makes a running start into a faster slide.",
		},
	},
	DiveModule = {
		Title = "Diving",
		Blurb = "A dive forward, a short hop or a ground pound",
		Summary = "A dive forward in the air, a short hop, or a ground pound straight down.",
		Notes = {
			"Mode picks which of the three it is.",
			"LandingMode Momentum lets you run straight through the landing instead of being planted.",
		},
	},
	CameraModule = {
		Title = "Camera",
		Blurb = "Bob, idle breath, leans, landing dip, first person eye",
		Summary = "How the camera feels: a bob while you move and a slow breath while you stand, leans into turns, a dip on landing, first person eye placement, and a camera style per move.",
		Notes = {
			"Nothing here delays your aim.",
			"LookLeft, LookRight, LookUp and LookDown in a move's layer limit how far you can look while it runs, in degrees from where you face. LookYaw and LookPitch do the same for every move that sets none.",
			"Moves is a layer per move or state. It only needs the keys it changes.",
		},
	},
	Camera2DModule = {
		Title = "2D Camera",
		Blurb = "A fixed side or top down camera",
		Summary = "A fixed side or top down camera for 2D style games.",
		Notes = {
			"Replaces the normal camera feel while on.",
		},
	},
	ShiftLock = {
		Title = "Shift Lock",
		Blurb = "A shift lock of its own, smooth and on your keys",
		Summary = "Replaces the stock shift lock. Your own keys toggle it, the body turns to face the camera at a speed you set, and the camera eases over the shoulder and back instead of snapping.",
		Notes = {
			"The camera feel while locked lives under CameraModule.ShiftLock.",
		},
	},
	BodyLean = {
		Title = "Body Lean",
		Blurb = "The body leans into sideways moves and turns",
		Summary = "The R6 body leans into sideways moves and turns, the angles for every direction sit in Leans.",
		Notes = {
			"IntensityMultiplier scales every angle in Leans at once, 1 uses them as written.",
			"PausedBy lists the moves that straighten the body while they run.",
		},
	},
	HeadMovementModule = {
		Title = "Head Sway",
		Blurb = "The head follows the camera",
		Summary = "The head, and on R15 the body, turn to follow the camera.",
		Notes = {},
	},
	FirstPersonBodyModule = {
		Title = "First Person Body",
		Blurb = "Show the body parts you choose in first person",
		Summary = "Shows your own body in first person, only the parts you pick, so arms and legs are there and nothing sits in front of the eye.",
		Notes = {},
	},
	SpeedEffects = {
		Title = "Speed Effects",
		Blurb = "Wider field of view and trails at speed",
		Summary = "The field of view widens and trails appear on the limbs as you speed up.",
		Notes = {
			"ActiveDuring says when the effects may show, AlwaysDuring which moves always get them.",
			"TrailLimbs lists which limbs carry a trail for each rig, with how far sideways it sits and how wide it is.",
		},
	},
	FootstepsModule = {
		Title = "Footsteps",
		Blurb = "Footstep sounds and dust per material",
		Summary = "Footstep sounds and dust per ground material.",
		Notes = {
			"Sounds and particles are found by material name in the folders you point at.",
		},
	},
	WindController = {
		Title = "Wind",
		Blurb = "Wind streaks at speed, tagged parts sway",
		Summary = "Wind streaks past the camera when you move fast. Any part you tag WindShake sways with the same wind, trees, grass, flags, whatever you tag.",
		Notes = {
			"A tagged part can carry WindPower, WindSpeed and WindDirection attributes to override the block for itself.",
		},
	},
	MovementTemplate = {
		Title = "Custom Move Template",
		Blurb = "An example move that shows how to make your own",
		Summary = "A finished example move, a short forward surge, to copy when you write a move of your own.",
		Notes = {
			"Every key it reads is in this block. A custom move has no defaults inside it, no block means no move.",
			"The module, the block and the module's Name must all match.",
		},
	},
}

function ConfigDocs.For(Name)
	return ConfigDocs.Blocks[Name]
end

function ConfigDocs.Title(Name)
	local Entry = ConfigDocs.Blocks[Name]
	if Entry and Entry.Title then
		return Entry.Title
	end
	local Pretty = Name:gsub("Module$", "")
	Pretty = Pretty:gsub("(%l)(%u)", "%1 %2")
	return Pretty
end

return ConfigDocs
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX24">
          <Properties>
            <string name="Name">Settings</string>
            <ProtectedString name="Source">--// [Variables]
local ConfigSettingDocs = {}

--// [Do not go past this point]

ConfigSettingDocs.Entries = {
	["BodyLean.DirectionThreshold"] = { Summary = "How far you must push sideways before the body leans that way.", Accepts = "0 to 1" },
	["BodyLean.Enabled"] = { Summary = "The body leans into sideways moves and turns, R6 characters only.", Accepts = "true or false" },
	["BodyLean.IntensityMultiplier"] = { Summary = "Scales every lean at once.", Accepts = "a multiplier, 1 changes nothing" },
	["BodyLean.LeanTime"] = { Summary = "How long a lean takes to settle in.", Accepts = "seconds" },
	["BodyLean.Leans.*"] = { Summary = "The lean while moving this way, RootX tips forward and back, RootY turns, RootZ tips sideways, LeftHip and RightHip bend the legs.", Accepts = "five angles in degrees" },
	["BodyLean.PausedBy"] = { Summary = "Moves that stop the lean while they run.", Accepts = "a list of module names" },
	["BodyLean.ResetTime"] = { Summary = "How long the body takes to straighten up again.", Accepts = "seconds" },
	["BodyLean.SmoothingEnabled"] = { Summary = "Leans ease in and out instead of snapping.", Accepts = "true or false" },
	["BodyLean.TiltRootPart"] = { Summary = "Also tilts the whole character, not just the joints.", Accepts = "true or false" },
	["BodyLean.VelocityThreshold"] = { Summary = "How fast you must move before any lean shows.", Accepts = "studs per second" },
	["Camera2DModule.Distance"] = { Summary = "How far the side view camera sits from the character.", Accepts = "studs" },
	["Camera2DModule.Enabled"] = { Summary = "Replaces the camera with a fixed side view, for 2D style games.", Accepts = "true or false" },
	["Camera2DModule.Height"] = { Summary = "How high above the character the side view sits.", Accepts = "studs" },
	["Camera2DModule.LockMovementAxis"] = { Summary = "Movement is locked to the left and right axis only.", Accepts = "true or false" },
	["Camera2DModule.RemapDepthKeys"] = { Summary = "Forward and back keys move along the visible axis instead of into the screen.", Accepts = "true or false" },
	["Camera2DModule.Smoothness"] = { Summary = "How long the camera takes to catch up with the character.", Accepts = "seconds, 0 snaps" },
	["Camera2DModule.SnapFacing"] = { Summary = "The character snaps to face left or right instead of turning smoothly.", Accepts = "true or false" },
	["Camera2DModule.TopDown"] = { Summary = "Looks down from above instead of from the side.", Accepts = "true or false" },
	["Camera2DModule.TopDownAngle"] = { Summary = "How steep the top down view is.", Accepts = "degrees, 20 to 89" },
	["Camera2DModule.TopDownHeight"] = { Summary = "How high the top down camera sits.", Accepts = "studs" },
	["Camera2DModule.ViewAngleDegrees"] = { Summary = "Which side the camera looks from.", Accepts = "degrees, 0 to 360" },
	["CameraModule.BlendTime"] = { Summary = "How long the camera takes to glide into its new place when you start or stop moving, sprint, jump, land or start a move, a Moves layer can set its own.", Accepts = "seconds, 0 for instant" },
	["CameraModule.Enabled"] = { Summary = "The kit adds its own feel to the camera: bob, sway, leans and per move offsets.", Accepts = "true or false" },
	["CameraModule.FirstPerson.FollowHead"] = { Summary = "In first person the eye rides with your head as your animations move the body, so no lean leaves the eye behind or inside you. Where the head aims is left out.", Accepts = "true or false" },
	["CameraModule.FirstPerson.FollowHeadLook"] = { Summary = "The view also tilts with the head's own look, up and down only.", Accepts = "true or false" },
	["CameraModule.FirstPerson.Forward"] = { Summary = "How far ahead of your head the first person eye sits, along where you look. It stays there however far up or down you look and whichever way the body faces.", Accepts = "studs" },
	["CameraModule.FirstPerson.HeadAmount"] = { Summary = "How much of the head's up and down movement the eye follows.", Accepts = "0 to 1" },
	["CameraModule.FirstPerson.HeadForwardAmount"] = { Summary = "How much of the head's movement along where you look the eye follows, leaning into a run as well as leaning back into a slide.", Accepts = "0 to 1" },
	["CameraModule.FirstPerson.HeadLookAmount"] = { Summary = "How much of the head's look reaches the view.", Accepts = "0 to 1" },
	["CameraModule.FirstPerson.HeadLookFrom"] = { Summary = "Whether the head look is read from the neck or the whole body.", Accepts = "\"Neck\" or \"Body\"" },
	["CameraModule.FirstPerson.HeadLookHold"] = { Summary = "How long a head look keeps its hold on the view.", Accepts = "seconds" },
	["CameraModule.FirstPerson.HeadLookSmoothing"] = { Summary = "How softly the head look moves the view.", Accepts = "seconds" },
	["CameraModule.FirstPerson.HeadSideAmount"] = { Summary = "How much of the head's movement across your view the eye follows, which matters when the body stands side on, like on a rail.", Accepts = "0 to 1" },
	["CameraModule.FirstPerson.LookAheadAngle"] = { Summary = "How far down you can look before the look ahead nudge has faded away completely.", Accepts = "degrees, 1 to 90" },
	["CameraModule.FirstPerson.LookAheadOffset"] = { Summary = "An extra nudge of the first person eye that holds while you look ahead and fades out as you look down, relative to where you look: X right, Y up, Z back. The run uses it to pull the eye back so your arms come into view.", Accepts = "a Vector3 in studs" },
	["CameraModule.FirstPerson.Offset"] = { Summary = "A fixed nudge of the first person eye, relative to where you look: X right, Y up, Z back.", Accepts = "a Vector3 in studs" },
	["CameraModule.FirstPerson.OffsetSmoothing"] = { Summary = "How softly eye offset changes blend in.", Accepts = "seconds, 0 for instant" },
	["CameraModule.LookPitch"] = { Summary = "How far up or down you may look, for every move that sets no LookUp or LookDown of its own. 0 is no limit.", Accepts = "degrees" },
	["CameraModule.HideCursorInFirstPerson"] = { Summary = "The mouse cursor is hidden in first person, unless shift lock is on, a tool shows its own cursor or a menu frees the mouse. Turn it off if your game hides the cursor itself, since the kit shows it again when you leave first person.", Accepts = "true or false" },
	["CameraModule.LookLimitsInThirdPerson"] = { Summary = "A move's look limits also hold outside first person. A Moves entry can set it for one move.", Accepts = "true or false" },
	["CameraModule.LookSensitivity"] = { Summary = "Scales how fast the view turns with the mouse, touch or stick while a move limits the view, which is when the kit steers the camera itself, the rest of the time Roblox's camera turns at the player's own sensitivity; a Moves entry can set its own.", Accepts = "a multiplier, 1 changes nothing" },
	["CameraModule.LookYaw"] = { Summary = "How far sideways you may look from where you face, for every move that sets no LookLeft or LookRight of its own. 0 is no limit.", Accepts = "degrees" },
	["CameraModule.Moves.*"] = { Summary = "Camera feel for one move or state, layered over the defaults: Offset, Sway, Smoothing, FirstPerson, ThirdPerson, LookSensitivity, LookFrom, BlendTime (how long the camera glides into and out of this layer), and LookLeft, LookRight, LookUp and LookDown in degrees from where you face (in a LockFirstPerson game, a move that lets the body turn with the view counts from where you looked when it started), which limit the view in first person while the move runs, and in third person too when LookLimitsInThirdPerson is on; a view past a limit when the move starts eases back to it", Accepts = "a table with any of those keys" },
	["CameraModule.Moves.DashModule.Backward"] = { Summary = "Camera feel for the backward dash, layered over the dash's own.", Accepts = "a table like the one above" },
	["CameraModule.Moves.WallClimbModule.Ceiling"] = { Summary = "Camera feel while climbing along a ceiling, layered over the climb's own. The shipped one lets you look anywhere.", Accepts = "a table like the one above" },
	["CameraModule.Moves.WallClimbModule.Sprint"] = { Summary = "Camera feel for the sprint climb, layered over the climb's own.", Accepts = "a table like the one above" },
	["CameraModule.Offset"] = { Summary = "A fixed nudge of the first person eye, added to FirstPerson.Offset, X right, Y up, Z back, a Moves entry can set its own.", Accepts = "a Vector3 in studs" },
	["CameraModule.PitchCeiling"] = { Summary = "How far up or down the view may tilt at most while a move limits the view.", Accepts = "degrees, 1 to 89" },
	["CameraModule.ShiftLock.Smoothing"] = { Summary = "Smoothing used while shift lock is on.", Accepts = "a Smoothing table" },
	["CameraModule.ShiftLock.Sway"] = { Summary = "Sway used while shift lock is on.", Accepts = "a Sway table" },
	["CameraModule.Smoothing.BankDegrees"] = { Summary = "How far the horizon tips into a turn.", Accepts = "degrees" },
	["CameraModule.Smoothing.BankHalfDegrees"] = { Summary = "The turn speed at which the bank reaches half strength.", Accepts = "degrees per second, above 0" },
	["CameraModule.Smoothing.BankTime"] = { Summary = "How quickly the bank follows a turn.", Accepts = "seconds" },
	["CameraModule.Smoothing.CruiseTime"] = { Summary = "How long a change of speed takes to stop counting as sudden, the lunge reacts to sudden changes.", Accepts = "seconds" },
	["CameraModule.Smoothing.Damping"] = { Summary = "How quickly the camera settles after a nudge, close to 1 barely bounces, lower bounces more.", Accepts = "0.05 to 0.99" },
	["CameraModule.Smoothing.DragStuds"] = { Summary = "How far the camera slides sideways into a turn, third person only.", Accepts = "studs" },
	["CameraModule.Smoothing.DropFullSpeed"] = { Summary = "The landing speed that gives the full landing dip.", Accepts = "studs per second, above 0" },
	["CameraModule.Smoothing.DropSettle"] = { Summary = "How long the landing dip takes to recover.", Accepts = "seconds, 0.05 to 5" },
	["CameraModule.Smoothing.DropStuds"] = { Summary = "How far the camera dips on landing.", Accepts = "studs" },
	["CameraModule.Smoothing.Enabled"] = { Summary = "Turn swing, banking, drag, lunge and landing dip.", Accepts = "true or false" },
	["CameraModule.Smoothing.FirstPersonScale"] = { Summary = "Scales all smoothing while in first person.", Accepts = "0 to 1" },
	["CameraModule.Smoothing.Handback"] = { Summary = "How long the view takes to come back to you once a move stops limiting it.", Accepts = "seconds" },
	["CameraModule.Smoothing.HandbackRate"] = { Summary = "How fast the view returns after a look limit.", Accepts = "degrees per second, 0 to 10000" },
	["CameraModule.Smoothing.LookCatch"] = { Summary = "How quickly the view catches up after a limited look.", Accepts = "seconds" },
	["CameraModule.Smoothing.LungeSpeed"] = { Summary = "The speed change that gives the full lunge.", Accepts = "studs per second" },
	["CameraModule.Smoothing.LungeStuds"] = { Summary = "How far the camera lunges when your speed jumps.", Accepts = "studs" },
	["CameraModule.Smoothing.ThirdPersonScale"] = { Summary = "Scales all smoothing while in third person.", Accepts = "0 to 1" },
	["CameraModule.Smoothing.WhipDegrees"] = { Summary = "How far the view swings when a turn starts or stops. It always returns to your aim.", Accepts = "degrees, 0 for none" },
	["CameraModule.Smoothing.WhipHalfDegrees"] = { Summary = "The turn speed at which the swing reaches half strength.", Accepts = "degrees per second, above 0" },
	["CameraModule.Smoothing.WhipTime"] = { Summary = "How long the swing lasts.", Accepts = "seconds" },
	["CameraModule.Sway.BobDegrees"] = { Summary = "How much the view rocks with each step.", Accepts = "degrees" },
	["CameraModule.Sway.BobFullSpeed"] = { Summary = "The speed at which the bob is at full strength.", Accepts = "studs per second" },
	["CameraModule.Sway.BobMoves"] = { Summary = "Moves that keep the walking bob going.", Accepts = "a list of module names" },
	["CameraModule.Sway.BobRamp"] = { Summary = "How quickly the bob fades in and out.", Accepts = "seconds" },
	["CameraModule.Sway.BobStuds"] = { Summary = "How far the view rises and falls with each step.", Accepts = "studs" },
	["CameraModule.Sway.BobStudsPerStep"] = { Summary = "Distance covered per bob cycle.", Accepts = "studs" },
	["CameraModule.Sway.BreatheDegrees"] = { Summary = "The idle bob's roll, how much the view rocks while you stand still.", Accepts = "degrees" },
	["CameraModule.Sway.BreatheSpeed"] = { Summary = "How fast the idle bob breathes.", Accepts = "breaths per second, 0.25 is one every four seconds" },
	["CameraModule.Sway.BreatheStuds"] = { Summary = "The idle bob, how far the view drifts up and down while you stand still.", Accepts = "studs" },
	["CameraModule.Sway.Enabled"] = { Summary = "Bob, breath and the sideways roll.", Accepts = "true or false" },
	["CameraModule.Sway.FirstPersonScale"] = { Summary = "Scales the sway while in first person.", Accepts = "0 to 1" },
	["CameraModule.Sway.Smoothing"] = { Summary = "How softly the sway moves.", Accepts = "seconds" },
	["CameraModule.Sway.StrafeRollDegrees"] = { Summary = "How far the view rolls when you move sideways.", Accepts = "degrees" },
	["CameraModule.Sway.ThirdPersonScale"] = { Summary = "Scales the sway while in third person.", Accepts = "0 to 1" },
	["CameraModule.ThirdPerson.Offset"] = { Summary = "A fixed nudge of the third person camera.", Accepts = "a Vector3 in studs" },
	["CameraShake.Depth"] = { Summary = "How much a shake also pushes the camera forward and back.", Accepts = "0 to 1" },
	["CameraShake.Frequency"] = { Summary = "How fast a shake vibrates.", Accepts = "higher is faster" },
	["CameraShake.Rotation"] = { Summary = "How much a shake rolls the camera.", Accepts = "0 to 1" },
	["CameraShake.Style"] = { Summary = "Smooth is a soft wobble, Random a harsh rattle.", Accepts = "\"Smooth\" or \"Random\"" },
	["Core.ReplicatedSoundDistance"] = { Summary = "How close another player has to be to hear your move sounds. The server only sends a sound to players in range and it fades out toward this distance.", Accepts = "studs, 0 for no limit" },
