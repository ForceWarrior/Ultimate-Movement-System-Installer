</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">Docs</string><ProtectedString name="Source">--// [Variables]
local Content = script.Parent.Parent.Parent.Content.Config
local Settings = require(Content.Settings)
local Blocks = require(Content.Blocks)
local Docs = {}

--// [Do not go past this point]

local function Quote(Text)
	local Safe = Text:gsub("\\", "\\\\")
	Safe = Safe:gsub("\"", "\\\"")
	Safe = Safe:gsub("\n", "\\n")
	return "\"" .. Safe .. "\""
end

local function Sorted(Map)
	local Keys = {}
	for Key in Map do table.insert(Keys, Key) end
	table.sort(Keys)
	return Keys
end

function Docs.Source()
	local Lines = { "--[[", "Made by Force Warrior and Cookie.", "Thank you for purchasing!", "Reselling or distributing this product in any form or by any means is strictly prohibited.", "--]]", "", "return {", "\tSettings = {" }
	for _, Key in Sorted(Settings.Entries) do
		local Entry = Settings.Entries[Key]
		table.insert(Lines, "\t\t[" .. Quote(Key) .. "] = { Summary = " .. Quote(Entry.Summary) .. ", Accepts = " .. Quote(Entry.Accepts) .. " },")
	end
	table.insert(Lines, "\t},")
	table.insert(Lines, "\tBlocks = {")
	for _, Name in Sorted(Blocks.Blocks) do
		table.insert(Lines, "\t\t[" .. Quote(Name) .. "] = " .. Quote(Blocks.Blocks[Name].Summary) .. ",")
	end
	table.insert(Lines, "\t},")
	table.insert(Lines, "}")
	return table.concat(Lines, "\n") .. "\n"
end

return Docs
</ProtectedString></Properties></Item></Item></Item>
    <Item class="ModuleScript" referent="RBX42">
      <Properties>
        <string name="Name">AnimationMatcher</string>
        <ProtectedString name="Source">--// [Modules]
local Settings = require(script.Parent.Settings)

--// [Variables]
local AnimationMatcher = {}
local ModelOwners = {
	WallRun = { "WallRunModule" },
	WallClimb = { "WallClimbModule" },
	WallJump = { "WallJumpModule" },
	Grapple = { "GrappleModule" },
	Leap = { "LeapModule" },
	Glide = { "GlideModule" },
	Crouch = { "CrouchModule" },
	Prone = { "ProneModule" },
	Vaulting = { "VaultingModule" },
	Dash = { "DashModule" },
	Dive = { "DiveModule" },
	MonkeyBar = { "MonkeyBarsModule" },
	Slide = { "SlideModule" },
	Ziplining = { "ZiplineModule" },
	RailGrinding = { "RailGrindModule" },
	Core = { "LocomotionModule", "LandingRollModule" },
}
local Stem = { arial = "aerial", front = "forward", back = "backward" }
local Stop = { ground = true, animation = true, animations = true }
local Overrides = {
	LocomotionModule = {
		Death = { R6 = "DiedFall", R15 = "DiedFall" },
		DeathIdle = { R6 = "DiedLoop", R15 = "DiedLoop" },
	},
	ZiplineModule = {
		Ride = { R6 = "Ziplining", R15 = "Ziplining" },
		SteepRide = { R6 = "SteepZipline", R15 = "SteepZipline" },
		PoleUp = { R6 = "PoleZipliningUpward", R15 = "ZipliningUpward" },
		PoleDown = { R6 = "PoleZipliningDown", R15 = "ZipliningDownward" },
	},
	RailGrindModule = {
		RailGrind = { R6 = "RailGrind", R15 = "RailgrindingForward" },
		FastGrind = { R6 = "FastRailGrind", R15 = "RailgrindingFast" },
		LeanLeft = { R6 = "RailGrindLeft", R15 = "RailGrindLeft" },
		LeanRight = { R6 = "RailGrindRight", R15 = "RailgrindRight" },
	},
	DiveModule = {
		AirDiveLand = { R6 = "AirDiveLand", R15 = "DiveLanding" },
		GroundPoundLand = { R6 = "GroundPoundLand", R15 = "GroundPoundLanding" },
	},
	WallClimbModule = {
		SprintClimb = { R6 = "WallClimbRun", R15 = "ClimbRun" },
		Climb = { R6 = "Climb", R15 = "Climbing" },
		ClimbUp = { R6 = "Climb", R15 = "Climbing" },
		ClimbDown = { R6 = "DownClimb", R15 = "ClimbDown" },
		ClimbIdle = { R6 = "ClimbIdle", R15 = "ClimbingIdle" },
	},
	VaultingModule = {
		LedgeClimb = { R6 = "Vault", R15 = "Vault" },
	},
	WallJumpModule = {
		JumpOff = { R6 = "WallJump", R15 = "WallJump" },
		JumpOffLeft = { R6 = "LeftWallJump", R15 = "WallJumpLeft" },
		JumpOffRight = { R6 = "RightWallJump", R15 = "WallJumpRight" },
	},
	WallRunModule = {
		WallRunLeft = { R6 = "WallRunLeft", R15 = "LeftWallRun" },
		WallRunRight = { R6 = "WallRunRight", R15 = "RightWallRun" },
		JumpOffLeft = { R6 = "WalkRunJumpOffLeft", R15 = "JumpOffLeft" },
		JumpOffRight = { R6 = "WallRunJumpOffRight", R15 = "JumpOffRight" },
	},
}

--// [Do not go past this point]

local function Tokens(Text)
	local Spaced = Text:gsub("(%l)(%u)", "%1 %2"):gsub("(%u)(%u%l)", "%1 %2")
	local Seen, Out = {}, {}
	for Word in Spaced:gmatch("%a+") do

		local Low = Word:lower():gsub("s$", ""):gsub("ing$", ""):gsub("e$", "")
		Low = Low:gsub("(%a)%1", "%1")
		Low = Stem[Low] or Low
		if Low ~= "" and not Stop[Low] and not Seen[Low] then
			Seen[Low] = true
			table.insert(Out, Low)
		end
	end
	table.sort(Out)
	return table.concat(Out, "|")
end

function AnimationMatcher.FindSource()
	local Direct = workspace:FindFirstChild(Settings.AnimationSourceName)
	if Direct then
		return Direct
	end
	for _, Child in workspace:GetChildren() do
		local Nested = Child:FindFirstChild(Settings.AnimationSourceName, true)
		if Nested then
			return Nested
		end
	end
	return nil
end

function AnimationMatcher.Clips()
	local Root = AnimationMatcher.FindSource()
	local Clips = {}
	if not Root then
		return Clips
	end
	for _, Rig in Root:GetChildren() do
		for _, Model in Rig:GetChildren() do
			local Saves = Model:FindFirstChild("AnimSaves")
			if Saves then
				local Owners = {}
				for Word, List in ModelOwners do
					if Model.Name:find(Word, 1, true) then
						for _, Name in List do
							Owners[Name] = true
						end
					end
				end
				for _, Clip in Saves:GetChildren() do
					if Clip:IsA("KeyframeSequence") then
						table.insert(Clips, {
							Rig = Rig.Name,
							Name = Clip.Name,
							Model = Model.Name,
							Owners = Owners,
							Instance = Clip,
						})
					end
				end
			end
		end
	end
	return Clips
end

function AnimationMatcher.Describe(Row)
	local Rig = Row.Key:match("^(R1?[56])")
	for Piece in Row.Path:gmatch("[^%.]+") do
		if Piece == "R6" or Piece == "R15" then Rig = Piece end
	end
	if Rig ~= "R6" and Rig ~= "R15" then
		Rig = nil
	end
	local Base = Row.Key:gsub("^R1?[56]", ""):gsub("AnimationId$", "")
	local Context = {}
	for Piece in Row.Path:gmatch("[^%.]+") do
		if Piece ~= Row.Module and Piece ~= Row.Key and Piece ~= "R6" and Piece ~= "R15"
			and not Piece:match("^%[%d+%]$") then
			table.insert(Context, Piece)
		end
	end
	return Rig, Base, Context
end

local VariantClips = {
	Mantle = { R6 = "Mantling", R15 = "Mantle" },
	TrussVault = { R6 = "Vault", R15 = "Vault" },
	SideMantleRight = { R6 = "RightMantle", R15 = "RightMantle" },
	SideMantleLeft = { R6 = "LeftMantle", R15 = "LeftMantle" },
}

local function VariantPick(Row, Rig)
	local Name = Row.Text and Row.Text:match('Name%s*=%s*"([%w_]+)"')
	if not Name or not Rig then
		return nil
	end
	local Side = Row.Text:match('Side%s*=%s*"([%w_]+)"')
	local Variant = VariantClips[Name] or VariantClips[Name .. (Side or "")]
	return Variant and Variant[Rig]
end

local function TrailingNumber(Text)
	return tonumber(Text:match("(%d+)%s*$")) or 0
end

local function ListLength(Raw)
	if Raw:sub(1, 1) ~= "{" then
		return 1
	end
	local Count = 0
	for _ in Raw:gmatch("%d+") do
		Count += 1
	end
	return math.max(Count, 1)
end

function AnimationMatcher.Match(Rows, Clips, Manual)
	local ByRig = {}
	for _, Clip in Clips do
		ByRig[Clip.Rig] = ByRig[Clip.Rig] or {}
		ByRig[Clip.Rig][Clip.Name] = Clip
	end

	local Result = {}
	for _, Row in Rows do
		local Rig, Base, Context = AnimationMatcher.Describe(Row)
		local Entry = { Row = Row, Rig = Rig, Base = Base, Candidates = {}, Choices = {} }
		for _, Clip in Clips do
			if Clip.Rig == Rig and Clip.Owners[Row.Module] then table.insert(Entry.Choices, Clip) end
		end
		if #Entry.Choices == 0 then
			for _, Clip in Clips do
				if Clip.Rig == Rig then table.insert(Entry.Choices, Clip) end
			end
		end
		table.sort(Entry.Choices, function(Left, Right) return Left.Name &lt; Right.Name end)

		local Chosen = Manual and Manual[Row.Path]
		local Picked = VariantPick(Row, Rig)
		local Override = Overrides[Row.Module] and Overrides[Row.Module][Base]
		local Named = Override and Rig and Override[Rig]

		if Chosen and Rig and ByRig[Rig] and ByRig[Rig][Chosen] then
			Entry.Clip = ByRig[Rig][Chosen]
			Entry.How = "manual"
		elseif Picked and ByRig[Rig] and ByRig[Rig][Picked] then
			Entry.Clip = ByRig[Rig][Picked]
			Entry.How = "variant"
		elseif Named and ByRig[Rig] and ByRig[Rig][Named] then
			Entry.Clip = ByRig[Rig][Named]
			Entry.How = "named"
		else
			local Wanted = Tokens(Base .. " " .. table.concat(Context, " "))
			Entry.Wanted = Wanted
			local WithModule = Tokens(Base .. " " .. table.concat(Context, " ")
				.. " " .. Row.Module:gsub("Module$", ""))
			for _, Clip in Clips do
				if Clip.Rig == Rig and Clip.Owners[Row.Module] then
					local Key = Tokens(Clip.Name)
					if Key == Wanted or Key == WithModule then
						table.insert(Entry.Candidates, Clip)
					end
				end
			end
			if #Entry.Candidates == 1 then
				Entry.Clip = Entry.Candidates[1]
				Entry.How = "name"
			elseif #Entry.Candidates &gt; 1 then
				Entry.How = "ambiguous"
			else
				Entry.How = "none"
				for _, Clip in Clips do
					if Clip.Rig == Rig and Clip.Owners[Row.Module] then
						table.insert(Entry.Candidates, Clip)
					end
				end
			end
		end
		Entry.Slots = ListLength(Row.Raw)
		Result[Row.Path] = Entry
	end

	local Groups = {}
	for _, Row in Rows do
		local Entry = Result[Row.Path]
		if Entry.How == "ambiguous" then
			local Key = Row.Module .. "|" .. tostring(Entry.Rig) .. "|" .. tostring(Entry.Wanted)
			Groups[Key] = Groups[Key] or { Entries = {}, Pool = {} }
			table.insert(Groups[Key].Entries, Entry)
			for _, Clip in Entry.Candidates do
				Groups[Key].Pool[Clip.Name] = Clip
			end
		end
	end

	for _, Group in Groups do
		local Pool = {}
		for _, Clip in Group.Pool do
			table.insert(Pool, Clip)
		end
		table.sort(Pool, function(Left, Right)
			local A, B = TrailingNumber(Left.Name), TrailingNumber(Right.Name)
			if A ~= B then
				return A &lt; B
			end
			return Left.Name &lt; Right.Name
		end)
		table.sort(Group.Entries, function(Left, Right)
			return Left.Row.ValueStart &lt; Right.Row.ValueStart
		end)

		local Cursor = 0
		for _, Entry in Group.Entries do
			local Take = {}
			for _ = 1, Entry.Slots do
				if #Pool &gt; 0 then
					table.insert(Take, Pool[Cursor % #Pool + 1])
					Cursor += 1
				end
			end
			if #Take == Entry.Slots then
				Entry.Clip = Take[1]
				Entry.Clips = Take
				Entry.How = "ordered"
			end
		end
	end

	return Result
end

return AnimationMatcher
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX43">
      <Properties>
        <string name="Name">AnimationPanel</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local ConfigScanner = require(script.Parent.ConfigScanner)
local AnimationMatcher = require(script.Parent.AnimationMatcher)
local AnimationUploader = require(script.Parent.AnimationUploader)

--// [Variables]
local AnimationPanel = {}

--// [Do not go past this point]

AnimationPanel.__index = AnimationPanel

local RowHeight = 24

local function IsEmpty(Raw)
	return not tostring(Raw):match("[1-9]")
end

local function Pretty(Raw)
	if Raw:sub(1, 1) == "{" then
		local Parts = {}
		for Number in Raw:gmatch("%d+") do
			table.insert(Parts, Number)
		end
		return table.concat(Parts, ", ")
	end
	return Raw
end

local function Chip(Text, Width, Accent)
	return Theme.Button(Text, Width, 24, Accent)
end

local function Tick(Parent, Indent)
	local Box = Instance.new("TextButton")
	Box.Size = UDim2.fromOffset(14, 14)
	Box.Position = UDim2.new(0, Indent, 0, 4)
	Box.BackgroundColor3 = Theme.Background
	Box.BorderSizePixel = 0
	Box.Text = ""
	Box.AutoButtonColor = false
	Box.Parent = Parent
	Theme.Stroke(Box, Theme.Border)

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.fromScale(0.6, 0.6)
	Fill.Position = UDim2.fromScale(0.2, 0.2)
	Fill.BackgroundColor3 = Theme.Accent
	Fill.BorderSizePixel = 0
	Fill.Visible = false
	Fill.Parent = Box
	return Box, Fill
end

local ManualKey = "UMSInstaller_ManualClips"

local ConfirmColumns = {
	{ Title = "LINE", Left = 0, Right = 0.07 },
	{ Title = "CONFIG SLOT", Left = 0.07, Right = 0.54 },
	{ Title = "CURRENT ID", Left = 0.54, Right = 0.76 },
	{ Title = "REPLACED BY", Left = 0.76, Right = 1 },
}

function AnimationPanel.New(Parent, PluginHandle, Page)
	local self = setmetatable({}, AnimationPanel)
	self.Plugin = PluginHandle
	self.Page = Page or Parent
	self.Cancelled = false
	self.Selected = {}
	self.Expanded = {}
	self.Rows = {}
	self.Matches = {}
	self.Manual = (PluginHandle and PluginHandle:GetSetting(ManualKey)) or {}
	if typeof(self.Manual) ~= "table" then
		self.Manual = {}
	end
	self.Destinations = AnimationUploader.Destinations()
	self.Busy = false

	local Root = Instance.new("Frame")
	Root.Name = "Animations"
	Root.Size = UDim2.new(1, -10, 1, 0)
	Root.BackgroundTransparency = 1
	Root.Parent = Parent
	self.Root = Root

	local Bar = Instance.new("Frame")
	Bar.Size = UDim2.new(1, 0, 0, 26)
	Bar.BackgroundTransparency = 1
	Bar.Parent = Root

	local BarLayout = Instance.new("UIListLayout")
	BarLayout.FillDirection = Enum.FillDirection.Horizontal
	BarLayout.Padding = UDim.new(0, 6)
	BarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	BarLayout.Parent = Bar

	local Picks = {
		{ Content.Animations.SelectAll, 52, function()
			for _, Row in self.Rows do
				self.Selected[Row.Path] = true
			end
		end },
		{ Content.Animations.SelectUnfilled, 86, function()
			table.clear(self.Selected)
			for _, Row in self.Rows do
				if tonumber(Row.Raw) == 0 then
					self.Selected[Row.Path] = true
				end
			end
		end },
		{ Content.Animations.Clear, 52, function()
			table.clear(self.Selected)
		end },
	}
	for Index, Entry in Picks do
		local Button = Chip(Entry[1], Entry[2])
		Button.LayoutOrder = Index
		Button.Parent = Bar
		Button.Activated:Connect(function()
			if self.Busy then return end
			Entry[3]()
			self:Render()
		end)
	end

	local Action = Instance.new("Frame")
	Action.Position = UDim2.new(0, 0, 0, 30)
	Action.Size = UDim2.new(1, 0, 0, 26)
	Action.BackgroundTransparency = 1
	Action.Parent = Root

	local ActionLayout = Instance.new("UIListLayout")
	ActionLayout.FillDirection = Enum.FillDirection.Horizontal
	ActionLayout.Padding = UDim.new(0, 6)
	ActionLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ActionLayout.Parent = Action

	local Location = Theme.Dropdown(Action, self.Page, Content.Animations.UploadLocation, 240, 24)
	Location.Button.LayoutOrder = 1
	self.Location = Location

	local Upload = Chip(Content.Animations.Upload, 120, true)
	Upload.LayoutOrder = 2
	Upload.Parent = Action
	self.Upload = Upload
	Upload.Activated:Connect(function()
		if self.Busy or not self.Location.Get() then
			return
		end
		self:AskThenUpload()
	end)

	local Options = {}
	for Index, Entry in self.Destinations do
		Options[Index] = { Label = Entry.Label, Short = Entry.Short or Entry.Label }
	end
	Location.SetOptions(Options)
	Location.OnPick = function()
		self:Render()
	end

	local Summary = Theme.Label("", 12, Theme.MutedText)
	Summary.Position = UDim2.new(0, 0, 0, 58)
	Summary.Size = UDim2.new(1, 0, 0, 16)
	Summary.Parent = Root
	self.Summary = Summary

	local Header = Instance.new("Frame")
	Header.Position = UDim2.new(0, 0, 0, 78)
	Header.Size = UDim2.new(1, 0, 0, 16)
	Header.BackgroundTransparency = 1
	Header.Parent = Root

	local Columns = {
		{ Content.Animations.ColumnLine, UDim2.new(0, 60, 0, 0), UDim2.fromOffset(36, 16) },
		{ Content.Animations.ColumnKey, UDim2.new(0, 98, 0, 0), UDim2.new(0.36, -98, 1, 0) },
		{ Content.Animations.ColumnClip, UDim2.new(0.36, 0, 0, 0), UDim2.new(0.3, -6, 1, 0) },
		{ Content.Animations.ColumnId, UDim2.new(0.66, 0, 0, 0), UDim2.new(0.34, -8, 1, 0) },
	}
	for _, Column in Columns do
		local Label = Theme.Label(Column[1], 10, Theme.MutedText, Theme.TitleFont)
		Label.Position = Column[2]
		Label.Size = Column[3]
		Label.Parent = Header
	end

	local Shell, Pane = Theme.Group(Root, Content.Animations.TreeTitle)
	Shell.Position = UDim2.new(0, 0, 0, 108)
	Shell.Size = UDim2.new(1, 0, 1, -108)

	local Scroll = Instance.new("ScrollingFrame")
	Scroll.Size = UDim2.fromScale(1, 1)
	Scroll.BackgroundTransparency = 1
	Scroll.BorderSizePixel = 0
	Scroll.ScrollBarThickness = 4
	Scroll.ScrollBarImageColor3 = Theme.MutedText
	Scroll.CanvasSize = UDim2.new()
	Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scroll.Parent = Pane
	self.Scroll = Scroll

	local Layout = Instance.new("UIListLayout")
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Scroll

	self.Notice = Theme.Notice(self.Page, 70, Content.Animations.Ok)
	self:BuildConfirm(self.Page)
	self:BuildProgress(self.Page)
	return self
end

function AnimationPanel:BuildProgress(Parent)
	local Veil = Instance.new("TextButton")
	Veil.Name = "Progress"
	Veil.Size = UDim2.fromScale(1, 1)
	Veil.BackgroundColor3 = Theme.Background
	Veil.BackgroundTransparency = 0.02
	Veil.BorderSizePixel = 0
	Veil.Text = ""
	Veil.AutoButtonColor = false
	Veil.Modal = true
	Veil.Visible = false
	Veil.ZIndex = 50
	Veil.Parent = Parent
	self.ProgressVeil = Veil

	local Heading = Theme.Label(Content.Animations.Working, 15, Theme.Text, Theme.TitleFont)
	Heading.Position = UDim2.new(0, 0, 0.32, 0)
	Heading.Size = UDim2.new(1, 0, 0, 24)
	Heading.TextXAlignment = Enum.TextXAlignment.Center
	Heading.ZIndex = 51
	Heading.Parent = Veil

	local Detail = Theme.Label("", 13, Theme.Text)
	Detail.Position = UDim2.new(0, 0, 0.32, 28)
	Detail.Size = UDim2.new(1, 0, 0, 20)
	Detail.TextXAlignment = Enum.TextXAlignment.Center
	Detail.ZIndex = 51
	Detail.Parent = Veil
	self.ProgressDetail = Detail

	local Track = Instance.new("Frame")
	Track.Position = UDim2.new(0.2, 0, 0.32, 58)
	Track.Size = UDim2.new(0.6, 0, 0, 8)
	Track.BackgroundColor3 = Theme.Panel
	Track.BorderSizePixel = 0
	Track.ZIndex = 51
	Track.Parent = Veil

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.fromScale(0, 1)
	Fill.BackgroundColor3 = Theme.Accent
	Fill.BorderSizePixel = 0
	Fill.ZIndex = 52
	Fill.Parent = Track
	self.ProgressFill = Fill

	local Stop = Theme.Button(Content.Animations.Stop, 130, 30, false)
	Stop.Position = UDim2.new(0.5, -65, 0.32, 82)
	Stop.ZIndex = 51
	Stop.Parent = Veil
	Stop.Activated:Connect(function()
		self.Cancelled = true
		self.ProgressDetail.Text = Content.Animations.Stopping
	end)
end

function AnimationPanel:BuildConfirm(Parent)
	local Veil = Instance.new("TextButton")
	Veil.Name = "Confirm"
	Veil.Size = UDim2.fromScale(1, 1)
	Veil.BackgroundColor3 = Theme.Background
	Veil.BackgroundTransparency = 0.02
	Veil.BorderSizePixel = 0
	Veil.Text = ""
	Veil.AutoButtonColor = false
	Veil.Modal = true
	Veil.Visible = false
	Veil.ZIndex = 40
	Veil.Parent = Parent
	self.Veil = Veil

	local Title = Theme.Label("", 15, Theme.Warning, Theme.TitleFont)
	Title.Position = UDim2.new(0, 20, 0, 14)
	Title.Size = UDim2.new(1, -40, 0, 44)
	Title.ZIndex = 41
	Title.TextWrapped = true
	Title.TextYAlignment = Enum.TextYAlignment.Top
	Title.Parent = Veil
	self.ConfirmTitle = Title

	local Header = Instance.new("Frame")
	Header.Position = UDim2.new(0, 20, 0, 58)
	Header.Size = UDim2.new(1, -46, 0, 16)
	Header.BackgroundTransparency = 1
	Header.ZIndex = 41
	Header.Parent = Veil

	for _, Column in ConfirmColumns do
		local Label = Theme.Label(Column.Title, 10, Theme.MutedText, Theme.TitleFont)
		Label.Position = UDim2.new(Column.Left, 10, 0, 0)
		Label.Size = UDim2.new(Column.Right - Column.Left, -14, 1, 0)
		Label.ZIndex = 41
		Label.Parent = Header
	end

	local List = Instance.new("ScrollingFrame")
	List.Position = UDim2.new(0, 20, 0, 76)
	List.Size = UDim2.new(1, -40, 1, -130)
	List.BackgroundColor3 = Theme.Panel
	List.BorderSizePixel = 0
	List.ScrollBarThickness = 6
	List.ScrollBarImageColor3 = Theme.MutedText
	List.CanvasSize = UDim2.new()
	List.AutomaticCanvasSize = Enum.AutomaticSize.Y
	List.ZIndex = 41
	List.Parent = Veil
	Theme.Stroke(List)
	self.ConfirmList = List

	local ListLayout = Instance.new("UIListLayout")
	ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ListLayout.Parent = List

	local Apply = Theme.Button(Content.Animations.Apply, 220, 32, false)
	Apply.Position = UDim2.new(0, 20, 1, -44)
	Apply.BackgroundColor3 = Theme.Danger
	Apply:SetAttribute("BaseColor", Theme.Danger)
	Apply:SetAttribute("OverColor", Theme.Danger)
	Apply:SetAttribute("InkColor", Theme.Text)
	Apply.TextColor3 = Theme.Text
	Apply.Font = Theme.TitleFont
	Apply.ZIndex = 41
	Apply.Parent = Veil
	self.ConfirmApply = Apply

	local Cancel = Theme.Button(Content.Animations.Cancel, 110, 32, false)
	Cancel.Position = UDim2.new(0, 252, 1, -44)
	Cancel.ZIndex = 41
	Cancel.Parent = Veil
	Cancel.Activated:Connect(function()
		if self.ApplyConnection then self.ApplyConnection:Disconnect() end
		self.ApplyConnection = nil
		Veil.Visible = false
	end)
end

function AnimationPanel:Remember()
	if self.Plugin then
		self.Plugin:SetSetting(ManualKey, self.Manual)
	end
end

function AnimationPanel:Load()
	local Module = ConfigScanner.Module()
	self.Problem = nil
	if not Module then
		self.Rows, self.Matches = {}, {}
		self.Problem = Content.Animations.NoConfig
		return false, self.Problem
	end
	local Report = ConfigScanner.SelfTest(Module.Source)
	self.Rows = Report.Rows
	if not Report.Trustworthy then
		self.Matches = {}
		self.Problem = Content.Animations.Untrusted(Report.Count, tostring(Report.Identical))
		return false, self.Problem
	end
	self.Clips = AnimationMatcher.Clips()
	self.Matches = AnimationMatcher.Match(self.Rows, self.Clips, self.Manual)
	return true, nil
end

function AnimationPanel:Cycle(Row)
	local Entry = self.Matches[Row.Path]
	if not Entry or #Entry.Choices == 0 then
		return
	end
	local Current = self.Manual[Row.Path]
	local Index = 0
	for Position, Clip in Entry.Choices do
		if Clip.Name == Current then
			Index = Position
		end
	end
	local Next = Entry.Choices[Index + 1]
	self.Manual[Row.Path] = Next and Next.Name or nil
	self:Remember()
	self:Load()
	self:Render()
end

function AnimationPanel:Jobs()
	local Jobs = {}
	for _, Row in self.Rows do
		if self.Selected[Row.Path] then
			local Entry = self.Matches[Row.Path]
			if Entry and Entry.Clip then
				table.insert(Jobs, {
					Path = Row.Path,
					Row = Row,
					Clip = Entry.Clip,
					Clips = Entry.Clips or { Entry.Clip },
				})
			end
		end
	end
	return Jobs
end

function AnimationPanel:AskThenUpload()
	local Jobs = self:Jobs()
	if #Jobs == 0 then
		self.Summary.Text = Content.Animations.NothingToDo
		self.Summary.TextColor3 = Theme.Warning
		return
	end

	for _, Child in self.ConfirmList:GetChildren() do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end

	local Changing = {}
	for _, Job in Jobs do
		if not IsEmpty(Job.Row.Raw) then
			table.insert(Changing, Job)
		end
	end

	local Distinct = AnimationUploader.DistinctClips(Jobs)
	self.ConfirmTitle.Text = Content.Animations.ConfirmTitle(#Changing, #Jobs, Distinct, select(2, self.Location.Get()).Label, AnimationUploader.Estimate(Distinct, AnimationUploader.LaneCount(Jobs)))

	for Index, Job in Changing do
		local Row = Instance.new("Frame")
		Row.LayoutOrder = Index
		Row.Size = UDim2.new(1, 0, 0, 26)
		Row.BackgroundColor3 = Theme.Raised
		Row.BackgroundTransparency = Index % 2 == 0 and 1 or 0.5
		Row.BorderSizePixel = 0
		Row.ZIndex = 41
		Row.Parent = self.ConfirmList

		local Values = {
			{ tostring(Job.Row.Line), Theme.MutedText, Theme.BodyFont },
			{ Job.Row.Path, Theme.Text, Theme.MediumFont },
			{ Pretty(Job.Row.Raw), Theme.Danger, Theme.BodyFont },
			{ Job.Clip.Name, Theme.Success, Theme.MediumFont },
		}
		for Position, Column in ConfirmColumns do
			local Value = Values[Position]
			local Label = Theme.Label(Value[1], 12, Value[2], Value[3])
			Label.Position = UDim2.new(Column.Left, 10, 0, 0)
			Label.Size = UDim2.new(Column.Right - Column.Left, -14, 1, 0)
			Label.TextTruncate = Enum.TextTruncate.AtEnd
			Label.ZIndex = 42
			Label.Parent = Row
		end
	end

	if self.ApplyConnection then self.ApplyConnection:Disconnect() end
	self.ApplyConnection = self.ConfirmApply.Activated:Once(function()
		self.ApplyConnection = nil
		self.Veil.Visible = false
		self:RunUpload(Jobs)
	end)
	self.Veil.Visible = true
end

function AnimationPanel:RunUpload(Jobs)
	if self.Busy then return end
	self.Busy = true
	self.Cancelled = false
	self.Upload.Text = Content.Animations.Working
	Theme.SetLocked(self.Upload, true)
	self.Location.SetLocked(true)

	self.ProgressFill.Size = UDim2.fromScale(0, 1)
	self.ProgressDetail.Text = Content.Animations.Progress(0, #Jobs, "")
	self.ProgressVeil.Visible = true

	local Expected = {}
	for _, Job in Jobs do
		Expected[Job.Path] = Job.Row.Raw
	end

	task.spawn(function()
		local Uploaded, Assignments, Failures = pcall(AnimationUploader.Upload,
			Jobs,
			select(2, self.Location.Get()),
			function(Index, Total, ClipName)
				self.ProgressFill.Size = UDim2.fromScale(Index / math.max(Total, 1), 1)
				self.ProgressDetail.Text = Content.Animations.Progress(Index, Total, tostring(ClipName))
			end,
			function()
				return self.Cancelled
			end
		)
		if not Uploaded then
			Assignments, Failures = {}, { tostring(Assignments) }
		end

		local Count = 0
		for _ in Assignments do
			Count += 1
		end

		local Wrote, Reason, Skipped, Applied = false, Content.Animations.NothingWritten, {}, 0
		if Count &gt; 0 then
			self.ProgressDetail.Text = Content.Animations.Writing
			local Written, Done, Why, Left, Put = pcall(AnimationUploader.WriteBack, Assignments, Expected)
			if Written then
				Wrote, Reason, Skipped, Applied = Done, Why, Left or {}, Put
			else
				Wrote, Reason = false, tostring(Done)
			end
		end

		self.ProgressVeil.Visible = false
		self.Busy = false
		self.Upload.Text = Content.Animations.Upload
		Theme.SetLocked(self.Upload, false)
		self.Location.SetLocked(false)

		local Outcome = Content.Animations.Written
		if Wrote and #Skipped &gt; 0 then
			Outcome = Content.Animations.WrittenSome(Applied or 0, #Skipped)
		elseif not Wrote then
			Outcome = Reason or "not written"
		end

		local Why = #Failures &gt; 0 and ("  |  " .. tostring(Failures[1])) or ""
		local Told = Content.Animations.Done(Count, #Jobs, #Failures, Outcome) .. Why
		if #Skipped &gt; 0 then

			local Named = {}
			for Index = 1, math.min(#Skipped, 4) do
				table.insert(Named, Skipped[Index])
			end
			if #Skipped &gt; #Named then
				table.insert(Named, "and " .. (#Skipped - #Named) .. " more")
			end
			Told = Told .. Content.Animations.SkippedNote(table.concat(Named, "; "))
		end
		local Clean = #Failures == 0 and Wrote and #Skipped == 0 and Count == #Jobs
		table.clear(self.Selected)
		self:Load()
		self:Render()
		self.Summary.Text = Told
		self.Summary.TextColor3 = Clean and Theme.Success or Theme.Warning
		self.Notice.Show(
			Clean and Content.Animations.DoneTitle or Content.Animations.PartTitle,
			Told)
	end)
end

function AnimationPanel:Tree()
	local Modules, Order = {}, {}
	for _, Row in self.Rows do
		local Bucket = Modules[Row.Module]
		if not Bucket then
			Bucket = { Name = Row.Module, Branches = {}, Order = {} }
			Modules[Row.Module] = Bucket
			table.insert(Order, Bucket)
		end
		local BranchName = Row.Branch or "-"
		local Branch = Bucket.Branches[BranchName]
		if not Branch then
			Branch = { Name = BranchName, Rows = {} }
			Bucket.Branches[BranchName] = Branch
			table.insert(Bucket.Order, Branch)
		end
		table.insert(Branch.Rows, Row)
	end
	return Order
end

function AnimationPanel:SetGroup(Rows, State)
	for _, Row in Rows do
		self.Selected[Row.Path] = State or nil
	end
end

function AnimationPanel:AddRow(Order)
	local Row = Instance.new("Frame")
	Row.LayoutOrder = Order
	Row.Size = UDim2.new(1, 0, 0, RowHeight)
	Row.BackgroundTransparency = 1
	Row.Parent = self.Scroll
	return Row
end

local function ClipTextFor(Entry)
	if Entry and Entry.Clips and #Entry.Clips &gt; 1 then
		local Names = {}
		for _, One in Entry.Clips do
			table.insert(Names, One.Name)
		end
		return table.concat(Names, ", ")
	end
	if Entry and Entry.Clip then
		return Entry.Clip.Name
	end
	return Content.Animations.NoClip
end

function AnimationPanel:GroupRow(Order, Indent, Text, Font, Colour, Rows, Key, Raised)
	local Row = self:AddRow(Order)
	if Raised then
		Row.BackgroundColor3 = Theme.Raised
		Row.BackgroundTransparency = 0
	end

	local Ticked = 0
	for _, Leaf in Rows do
		if self.Selected[Leaf.Path] then
			Ticked += 1
		end
	end

	local Box, Fill = Tick(Row, Indent)
	Fill.Visible = Ticked &gt; 0
	Fill.BackgroundColor3 = Ticked == #Rows and Theme.Accent or Theme.MutedText
	Box.Activated:Connect(function()
		if self.Busy then return end
		self:SetGroup(Rows, Ticked &lt; #Rows)
		self:Render()
	end)

	local Toggle = Instance.new("TextButton")
	Toggle.Position = UDim2.new(0, Indent + 20, 0, 0)
	Toggle.Size = UDim2.new(1, -(Indent + 20), 1, 0)
	Toggle.BackgroundTransparency = 1
	Toggle.Text = (self.Expanded[Key] and "v" or "&gt;") .. "  " .. Text .. "  (" .. #Rows .. ")"
	Toggle.TextSize = Theme.Size(12)
	Toggle.Font = Font
	Toggle.TextColor3 = Colour
	Toggle.TextXAlignment = Enum.TextXAlignment.Left
	Toggle.AutoButtonColor = false
	Toggle.Parent = Row
	Toggle.Activated:Connect(function()
		if self.Busy then return end
		self.Expanded[Key] = not self.Expanded[Key] or nil
		self:Render()
	end)
	return Row
end

function AnimationPanel:LeafRow(Order, Leaf)
	local Row = self:AddRow(Order)

	local Box, Fill = Tick(Row, 40)
	Fill.Visible = self.Selected[Leaf.Path] == true
	Box.Activated:Connect(function()
		if self.Busy then return end
		self.Selected[Leaf.Path] = not self.Selected[Leaf.Path] or nil
		self:Render()
	end)

	local Empty = IsEmpty(Leaf.Raw)
	local Line = Theme.Label(tostring(Leaf.Line), 11, Theme.MutedText)
	Line.Position = UDim2.new(0, 60, 0, 0)
	Line.Size = UDim2.fromOffset(36, RowHeight)
	Line.Parent = Row

	local Name = Theme.Label(Leaf.Key, 12, Empty and Theme.Warning or Theme.Text)
	Name.Position = UDim2.new(0, 98, 0, 0)
	Name.Size = UDim2.new(0.36, -98, 1, 0)
	Name.Parent = Row

	local Entry = self.Matches[Leaf.Path]

	local Clip = Instance.new("TextButton")
	Clip.BackgroundTransparency = 1
	Clip.Text = ClipTextFor(Entry)
	Clip.TextSize = Theme.Size(11)
	Clip.Font = Theme.BodyFont
	Clip.TextXAlignment = Enum.TextXAlignment.Left
	Clip.TextTruncate = Enum.TextTruncate.AtEnd
	Clip.AutoButtonColor = false
	Clip.TextColor3 = Entry and Entry.Clip and Theme.Success or Theme.Danger
	Clip.Position = UDim2.new(0.36, 0, 0, 0)
	Clip.Size = UDim2.new(0.3, -6, 1, 0)
	Clip.Parent = Row
	Clip.Activated:Connect(function()
		if not self.Busy then
			self:Cycle(Leaf)
		end
	end)

	local Value = Theme.Label(Empty and Content.Animations.Unfilled or Pretty(Leaf.Raw), 11, Empty and Theme.Warning or Theme.MutedText)
	Value.Position = UDim2.new(0.66, 0, 0, 0)
	Value.Size = UDim2.new(0.34, -8, 1, 0)
	Value.Parent = Row
	return Row
end

function AnimationPanel:Summarise()
	local Chosen = 0
	for _ in self.Selected do
		Chosen += 1
	end

	local Filled, Empty, Ready = 0, 0, 0
	for _, Row in self.Rows do
		if IsEmpty(Row.Raw) then
			Empty += 1
		else
			Filled += 1
		end
		local Entry = self.Matches[Row.Path]
		if Entry and Entry.Clip then
			Ready += 1
		end
	end

	if not self.Busy then
		Theme.SetLocked(self.Upload, self.Location.Get() == nil)
	end
	if self.Problem then
		self.Summary.Text = self.Problem
		self.Summary.TextColor3 = Theme.Warning
		return
	end
	self.Summary.Text = Content.Animations.Summary(#self.Rows, Filled, Empty, Ready, Chosen)
end

function AnimationPanel:Render()
	for _, Child in self.Scroll:GetChildren() do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end

	local Order = 0
	for _, Block in self:Tree() do
		local Every = {}
		for _, Branch in Block.Order do
			for _, Leaf in Branch.Rows do
				table.insert(Every, Leaf)
			end
		end

		Order += 1
		self:GroupRow(Order, 6, Block.Name, Theme.TitleFont, Theme.Text, Every, Block.Name, true)
		if not self.Expanded[Block.Name] then
			continue
		end

		for _, Branch in Block.Order do
			local Key = Block.Name .. "." .. Branch.Name
			Order += 1
			self:GroupRow(Order, 22, Branch.Name, Theme.MediumFont, Theme.MutedText, Branch.Rows, Key, false)
			if not self.Expanded[Key] then
				continue
			end

			for _, Leaf in Branch.Rows do
				Order += 1
				self:LeafRow(Order, Leaf)
			end
		end
	end

	self:Summarise()
end

return AnimationPanel
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX44">
      <Properties>
        <string name="Name">AnimationUploader</string>
        <ProtectedString name="Source">--// [Services]
local AssetService = game:GetService("AssetService")
local GroupService = game:GetService("GroupService")
local ScriptEditorService = game:GetService("ScriptEditorService")
local ServerStorage = game:GetService("ServerStorage")
local StudioService = game:GetService("StudioService")

--// [Modules]
local ConfigScanner = require(script.Parent.ConfigScanner)

--// [Variables]
local AnimationUploader = {}
local BaseDelay = 0.1
local BackoffDelay = 2.2
local WorkersPerRig = 4
local Attempts = 4
local EaseAfter = 6
local UploadSeconds = 2
local RateLimitWords = { "limit", "too many", "429", "throttl", "rate exceeded", "try again" }

--// [Do not go past this point]

function AnimationUploader.LooksThrottled(Problem)
	if not Problem then
		return false
	end
	local Low = tostring(Problem):lower()
	for _, Word in RateLimitWords do
		if Low:find(Word, 1, true) then
			return true
		end
	end
	return false
end

local LooksThrottled = AnimationUploader.LooksThrottled

function AnimationUploader.DistinctClips(Jobs)
	local Seen, Total = {}, 0
	for _, Job in Jobs do
		for _, Clip in (Job.Clips or { Job.Clip }) do
			local Key = Clip.Rig .. "|" .. Clip.Name
			if not Seen[Key] then
				Seen[Key] = true
				Total += 1
			end
		end
	end
	return Total
end

function AnimationUploader.Destinations()

	local List = { { Label = "My account", Short = "my account", CreatorType = Enum.AssetCreatorType.User } }

	local Ok, UserId = pcall(function()
		return StudioService:GetUserId()
	end)
	if not Ok or not UserId or UserId == 0 then
		return List
	end

	local Fetched, Groups = pcall(function()
		return GroupService:GetGroupsAsync(UserId)
	end)
	if not Fetched or typeof(Groups) ~= "table" then
		return List
	end

	table.sort(Groups, function(Left, Right)
		return (Left.Rank or 0) &gt; (Right.Rank or 0)
	end)

	local OwnedRank = 255
	local StaffRank = 200

	for _, Group in Groups do
		local Rank = Group.Rank or 0
		local Owns = Rank &gt;= OwnedRank
		local Staff = Rank &gt;= StaffRank
		local RunsThisPlace = game.CreatorType == Enum.CreatorType.Group and Group.Id == game.CreatorId

		if Owns or Staff or RunsThisPlace then
			local Note = Owns and "owner" or (Group.Role or "staff")
			if RunsThisPlace then
				Note = Note .. ", owns this place"
			end
			table.insert(List, {
				Label = Group.Name .. "  (" .. Note .. ")",
				Short = Group.Name,
				CreatorType = Enum.AssetCreatorType.Group,
				CreatorId = Group.Id,
				Rank = Rank,
				RunsThisPlace = RunsThisPlace,
			})
		end
	end

	for Index, Entry in List do
		if Entry.RunsThisPlace then
			table.remove(List, Index)
			table.insert(List, 1, Entry)
			break
		end
	end
	return List
end

function AnimationUploader.LaneCount(Jobs)
	local Rigs, Total = {}, 0
	for _, Job in Jobs do
		for _, Clip in (Job.Clips or { Job.Clip }) do
			if not Rigs[Clip.Rig] then
				Rigs[Clip.Rig] = true
				Total += 1
			end
		end
	end
	return math.max(Total, 1)
end

function AnimationUploader.Estimate(Count, Lanes)
	return math.max(1, math.ceil(Count * (BaseDelay + UploadSeconds) / (WorkersPerRig * math.max(Lanes or 1, 1))))
end

function AnimationUploader.UploadOne(Clip, Destination)
	local Params = {
		Name = Clip.Name,
		Description = "Uploaded by the Ultimate Movement System installer",
		CreatorType = Destination.CreatorType,
	}
	if Destination.CreatorId then
		Params.CreatorId = Destination.CreatorId
	end

	local Ok, Result, Id = pcall(function()
		return AssetService:CreateAssetAsync(Clip.Instance, Enum.AssetType.Animation, Params)
	end)

	if not Ok then
		local Problem = tostring(Result)
		return nil, Problem, not LooksThrottled(Problem)
	end
	if Result ~= Enum.CreateAssetResult.Success then
		return nil, tostring(Id or Result), Result == Enum.CreateAssetResult.PermissionDenied
	end
	return Id, nil, false
end

function AnimationUploader.Upload(Jobs, Destination, OnStep, Cancelled)
	local Assignments, Failures = {}, {}

	local Queue, Seen = {}, {}
	for _, Job in Jobs do
		for _, Clip in (Job.Clips or { Job.Clip }) do
			local Key = Clip.Rig .. "|" .. Clip.Name
			if not Seen[Key] then
				Seen[Key] = true
				table.insert(Queue, { Key = Key, Clip = Clip })
			end
		end
	end

	local Lanes, LaneOrder = {}, {}
	for _, Entry in Queue do
		local Rig = Entry.Clip.Rig
		local Lane = Lanes[Rig]
		if not Lane then
			Lane = { Rig = Rig, Items = {}, Next = 1 }
			Lanes[Rig] = Lane
			table.insert(LaneOrder, Lane)
		end
		table.insert(Lane.Items, Entry)
	end

	local Cache = {}
	local Total = #Queue
	local Done, Running = 0, 0
	local Stop = false

	local Delay = BaseDelay
	local Clean = 0

	local function Slower()
		Delay = math.min(Delay &gt; BaseDelay and Delay * 2 or BackoffDelay, BackoffDelay * 4)
		Clean = 0
	end

	local function Faster()
		Clean += 1
		if Clean &gt;= EaseAfter and Delay &gt; BaseDelay then
			Delay = math.max(BaseDelay, Delay / 2)
			Clean = 0
		end
	end

	local function Publish(Clip)
		local Id, Problem, Fatal
		for Attempt = 1, Attempts do
			Id, Problem, Fatal = AnimationUploader.UploadOne(Clip, Destination)
			if Id or Fatal or not LooksThrottled(Problem) then
				break
			end
			Slower()
			if Attempt &lt; Attempts then
				task.wait(BackoffDelay * 2 ^ (Attempt - 1))
			end
			if Stop or (Cancelled and Cancelled()) then
				break
			end
		end
		return Id, Problem, Fatal
	end

	local function Work(Lane)
		while true do
			if Stop or (Cancelled and Cancelled()) then
				break
			end
			local Index = Lane.Next
			if Index &gt; #Lane.Items then
				break
			end
			Lane.Next += 1
			local Entry = Lane.Items[Index]

			local Id, Problem, Fatal = Publish(Entry.Clip)

			Cache[Entry.Key] = Id or false
			Done += 1
			if Id then
				Faster()
			else
				table.insert(Failures, Lane.Rig .. " " .. Entry.Clip.Name .. ": " .. Problem)
			end
			if OnStep then
				OnStep(Done, Total, Lane.Rig .. "  " .. Entry.Clip.Name, Id, Problem)
			end
			if Fatal then
				table.insert(Failures, "stopped there, the rest were not attempted")
				Stop = true
				break
			end

			task.wait(Delay)
		end
	end

	for _, Lane in LaneOrder do
		local Width = math.clamp(WorkersPerRig, 1, math.max(#Lane.Items, 1))
		Running += Width
		for _ = 1, Width do
			task.spawn(function()
				local Ok, Err = pcall(Work, Lane)
				if not Ok then
					table.insert(Failures, "worker stopped: " .. tostring(Err))
				end
				Running -= 1
			end)
		end
	end

	while Running &gt; 0 do
		task.wait(0.05)
	end

	for _, Job in Jobs do
		local Clips = Job.Clips or { Job.Clip }
		local Ids = {}
		for _, Clip in Clips do
			local Value = Cache[Clip.Rig .. "|" .. Clip.Name]
			if Value then
				table.insert(Ids, tostring(Value))
			end
		end

		if #Ids == #Clips then
			Assignments[Job.Path] = #Ids &gt; 1 and ("{ " .. table.concat(Ids, ", ") .. " }") or Ids[1]
		end
	end
	return Assignments, Failures, Total
end

function AnimationUploader.Backup(Module)
	local Copy = Module:Clone()
	Copy.Name = Module.Name .. "_InstallerBackup"
	local Previous = ServerStorage:FindFirstChild(Copy.Name)
	if Previous then
		Previous.Parent = nil
	end
	Copy.Parent = ServerStorage
	return Copy
end

function AnimationUploader.WriteBack(Assignments, Expected)
	local Module = ConfigScanner.Module()
	if not Module then
		return false, "MovementConfig not found."
	end

	local Before = ConfigScanner.SelfTest(Module.Source)
	if not Before.Trustworthy then
		return false, "Refused: the config scan does not round trip, so nothing was written."
	end

	AnimationUploader.Backup(Module)

	local Wrote, Reason = false, "the config changed under the edit, nothing was written"
	local Skipped, Applied, Sample = {}, 0, nil
	ScriptEditorService:UpdateSourceAsync(Module, function(Old)
		local Rows = ConfigScanner.Scan(Old)
		if #Rows ~= Before.Count then
			return nil
		end

		local ByPath, Values = {}, {}
		for _, Row in Rows do
			ByPath[Row.Path] = Row
			Values[Row.Path] = Row.Raw
		end

		table.clear(Skipped)
		Applied = 0

		for Path, NewValue in Assignments do
			local Row = ByPath[Path]
			local Value = NewValue
			local WantsList = Row and Row.Raw:sub(1, 1) == "{"
			local PlainNumber = Value:match("^%d+$") ~= nil
			local NumberList = Value:match("^{%s*%d[%d%s,]*}$") ~= nil

			if WantsList and PlainNumber then
				Value = "{ " .. Value .. " }"
				NumberList, PlainNumber = true, false
			end

			local Trouble
			if not Row then
				Trouble = "is not in the config any more"
			elseif Expected and Expected[Path] and Row.Raw ~= Expected[Path] then
				Trouble = "changed since you approved it"
			elseif not PlainNumber and not NumberList then
				Trouble = "got a value that is neither an id nor a list of ids"
			elseif WantsList ~= NumberList then
				Trouble = "holds a single id and the clips matched to it gave " .. select(2, Value:gsub("%d+", ""))
			end

			if Trouble then
				table.insert(Skipped, Path .. " " .. Trouble)
			else
				Values[Path] = Value
				Applied += 1
				Sample = Sample or Value:match("%d+")
			end
		end

		if Applied == 0 then
			Reason = #Skipped &gt; 0 and Skipped[1] or "nothing could be written"
			return nil
		end

		local Candidate = ConfigScanner.Splice(Old, Rows, Values)
		local Check = ConfigScanner.Scan(Candidate)
		if #Check ~= #Rows then
			return nil
		end
		for Index, Row in Check do
			if Row.Path ~= Rows[Index].Path then
				return nil
			end
		end
		local _, OldLines = Old:gsub("\n", "")
		local _, NewLines = Candidate:gsub("\n", "")
		if OldLines ~= NewLines then
			return nil
		end

		Wrote = true
		return Candidate
	end)

	if not Wrote then
		return false, Reason, Skipped
	end

	if Sample then
		for _ = 1, 60 do
			if Module.Source:find(Sample, 1, true) then
				break
			end
			task.wait(0.05)
		end
	end
	return true, nil, Skipped, Applied
end

return AnimationUploader
</ProtectedString>
