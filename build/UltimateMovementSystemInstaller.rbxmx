    <Item class="ModuleScript" referent="RBX46">
      <Properties>
        <string name="Name">ConfigReader</string>
        <ProtectedString name="Source">--// [Modules]
local ConfigScanner = require(script.Parent.ConfigScanner)
local Content = require(script.Parent.Content)

--// [Variables]
local ConfigReader = {}

--// [Do not go past this point]

local function Split(Text)
	local Lines = {}
	for Line in Text:gmatch("([^\n]*)\n?") do
		table.insert(Lines, Line)
	end
	return Lines
end

local function BlockDelta(Bare)
	local Delta = 0
	for Word in Bare:gmatch("[%a_][%w_]*") do
		if Word == "function" or Word == "if" or Word == "do" then
			Delta += 1
		elseif Word == "end" then
			Delta -= 1
		end
	end
	return Delta
end

function ConfigReader.Read()
	local Module = ConfigScanner.Module()
	if not Module then
		return nil
	end

	local Source = Module.Source
	local Masked = ConfigScanner.Mask(Source)
	local Plain, Code = Split(Source), Split(Masked)

	local Blocks, Current, Section = {}, nil, nil
	local Stack, Counters = {}, {}
	local InFunction = 0

	for Index, Raw in Plain do
		local Bare = (Code[Index] or ""):gsub("%s+$", "")
		local Trailing = Raw:sub(#Bare + 1):match("^%s*%-%-+%s*(.-)%s*$")

		if InFunction &gt; 0 then
			InFunction += BlockDelta(Bare)
			continue
		end

		local Name = Bare:match("^Config%.([%w_]+)%s*=%s*{")
		if Name then
			Current = {
				Name = Name,
				Line = Index,
				Sections = {},
				Order = {},
				Count = 0,
			}
			Section = nil
			table.clear(Stack)
			table.clear(Counters)
			table.insert(Blocks, Current)

		elseif Current and Bare:match("^}") then
			Current.LastLine = Index
			Current = nil
			Section = nil

		elseif Current then
			local Heading = Trailing and Trailing:match("^//%s*%[(.-)%]")
			if Heading then
				Section = { Name = Heading, Settings = {} }
				Current.Sections[Heading] = Section
				table.insert(Current.Order, Section)

			else

				local _, Opens = Bare:gsub("{", "")
				local _, Closes = Bare:gsub("}", "")
				local Net = Opens - Closes

				local Key = Bare:match("^%s*([%w_]+)%s*=")
				local Value
				if Key then
					local Equals = Bare:find("=", 1, true)
					Value = Raw:sub(Equals + 1, #Bare):match("^%s*(.-),?%s*$")
				end
				local Prefix = #Stack &gt; 0 and (table.concat(Stack, ".") .. ".") or ""

				local function Record(Name, Text)
					if not Section then
						Section = { Name = "Settings", Settings = {} }
						Current.Sections.Settings = Section
						table.insert(Current.Order, Section)
					end
					Current.Count += 1
					table.insert(Section.Settings, {
						Key = Name,
						Value = Text,

						Comment = Trailing or "",
						Line = Index,
					})
				end

				if Value and Value:match("^function%f[%W]") then
					Record(Prefix .. (Key or "Function"), Content.Config.FunctionValue)
					InFunction = BlockDelta(Bare)

				elseif Net == 0 then
					if Key and Value and Value ~= "" then
						Record(Prefix .. Key, Value)
					elseif Bare:match("^%s*{.*}%s*,?%s*$") then

						Current.Entries = Current.Entries or {}
						Current.Entries[Prefix] = (Current.Entries[Prefix] or 0) + 1
						Record(Prefix .. "[" .. Current.Entries[Prefix] .. "]",
							(Raw:match("^%s*(.-),?%s*$")))
					end
				elseif Net &gt; 0 then
					local Opened = Bare:match("^%s*([%w_]+)%s*=%s*{")
					for _ = 1, Net do
						local Name = Opened
						if not Name then

							local Depth = #Stack
							Counters[Depth] = (Counters[Depth] or 0) + 1
							Name = "[" .. Counters[Depth] .. "]"
						end
						table.insert(Stack, Name)
						Counters[#Stack] = 0
						Opened = nil
					end
				else
					for _ = 1, -Net do
						if #Stack &gt; 0 then
							table.remove(Stack)
						end
					end
				end
			end
		end
	end

	return Blocks
end

return ConfigReader
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX47">
      <Properties>
        <string name="Name">ConfigScanner</string>
        <ProtectedString name="Source">--// [Modules]
local Settings = require(script.Parent.Settings)

--// [Variables]
local ConfigScanner = {}

--// [Do not go past this point]

local function LongBracketLevel(Text, At)
	if Text:sub(At, At) ~= "[" then
		return nil
	end
	local Equals = Text:match("^%[(=*)%[", At)
	return Equals and #Equals or nil
end

function ConfigScanner.Mask(Text)
	local Out = table.create(#Text)
	local Index, Length = 1, #Text

	while Index &lt;= Length do
		local Char = Text:sub(Index, Index)

		if Char == "-" and Text:sub(Index + 1, Index + 1) == "-" then
			local Level = LongBracketLevel(Text, Index + 2)
			if Level then
				local Close = "]" .. string.rep("=", Level) .. "]"
				local Stop = Text:find(Close, Index, true)
				local Finish = Stop and (Stop + #Close - 1) or Length
				for Step = Index, Finish do
					Out[Step] = Text:sub(Step, Step) == "\n" and "\n" or " "
				end
				Index = Finish + 1
			else
				local Stop = Text:find("\n", Index, true) or (Length + 1)
				for Step = Index, Stop - 1 do
					Out[Step] = " "
				end
				Index = Stop
			end

		elseif Char == '"' or Char == "'" then
			local Quote = Char
			Out[Index] = "#"
			Index += 1
			while Index &lt;= Length do
				local Here = Text:sub(Index, Index)
				Out[Index] = Here == "\n" and "\n" or "#"
				if Here == "\\" then
					Index += 1
					if Index &lt;= Length then
						Out[Index] = Text:sub(Index, Index) == "\n" and "\n" or "#"
						Index += 1
					end
				elseif Here == Quote then
					Index += 1
					break
				else
					Index += 1
				end
			end

		elseif Char == "[" and LongBracketLevel(Text, Index) then
			local Level = LongBracketLevel(Text, Index)
			local Close = "]" .. string.rep("=", Level) .. "]"
			local Stop = Text:find(Close, Index, true)
			local Finish = Stop and (Stop + #Close - 1) or Length
			for Step = Index, Finish do
				Out[Step] = Text:sub(Step, Step) == "\n" and "\n" or "#"
			end
			Index = Finish + 1

		else
			Out[Index] = Char
			Index += 1
		end
	end

	return table.concat(Out)
end

local BlockOpeners = { ["function"] = true, ["if"] = true, ["do"] = true }

local function SkipFunction(Mask, Start)
	local Depth = 0
	local Index, Length = Start, #Mask
	while Index &lt;= Length do
		if Mask:sub(Index, Index):match("[%a_]") then
			local Word = Mask:match("^[%w_]+", Index)
			if BlockOpeners[Word] then
				Depth += 1
			elseif Word == "end" then
				Depth -= 1
				if Depth &lt;= 0 then
					return Index + #Word
				end
			end
			Index += #Word
		else
			Index += 1
		end
	end
	return Length + 1
end

local function Walk(Source, Accept, LeavesOnly)
	local Mask = ConfigScanner.Mask(Source)

	local LineAt = table.create(#Source)
	local LineStarts = { 1 }
	local Line = 1
	for Index = 1, #Source do
		LineAt[Index] = Line
		if Source:byte(Index) == 10 then
			Line += 1
			LineStarts[Line] = Index + 1
		end
	end

	local Rows = {}
	local Stack, Counters = {}, {}
	local Pending = nil
	local Paren = 0
	local Index, Length = 1, #Mask

	while Index &lt;= Length do
		local Char = Mask:sub(Index, Index)

		if Char:match("[%a_]") then
			local Word = Mask:match("^[%w_]+", Index)
			if Word == "function" then

				Index = SkipFunction(Mask, Index)
				Pending = nil
			else
				if Mask:match("^%s*=[^=]", Index + #Word) then
					Pending = Word
				end
				Index += #Word
			end

		elseif Char == "[" then

			local From, To = Mask:match("^%[()#+()%]%s*=[^=]", Index)
			if From then
				Pending = Source:sub(From + 1, To - 2)
				Index = To
			else
				Index += 1
			end

		elseif Char == "(" then
			Paren += 1
			Index += 1

		elseif Char == ")" then
			Paren -= 1
			Index += 1

		elseif Char == "{" then
			local Name = Pending
			if not Name then
				local Depth = #Stack
				Counters[Depth] = (Counters[Depth] or 0) + 1
				Name = "[" .. Counters[Depth] .. "]"
			end
			table.insert(Stack, Name)
			Counters[#Stack] = 0
			Pending = nil
			Index += 1

		elseif Char == "}" then
			table.remove(Stack)
			Pending = nil
			Index += 1

		elseif Char == "," then
			if Paren == 0 then
				Pending = nil
			end
			Index += 1

		elseif Char == "=" then
			if Pending and Accept(Pending, Stack) then
				local ValueStart = Index + 1
				while Mask:sub(ValueStart, ValueStart):match("[ \t]") do
					ValueStart += 1
				end

				local Depth, Round, Scan = 0, 0, ValueStart
				while Scan &lt;= Length do
					local Here = Mask:sub(Scan, Scan)
					if Here == "{" then
						Depth += 1
					elseif Here == "}" then
						if Depth == 0 then break end
						Depth -= 1
					elseif LeavesOnly and Here == "(" then
						Round += 1
					elseif LeavesOnly and Here == ")" then
						if Round == 0 then break end
						Round -= 1
					elseif Here == "," and Depth == 0 and Round == 0 then
						break
					elseif Here == "\n" and Depth == 0 then
						break
					end
					Scan += 1
				end
				local ValueEnd = Scan - 1
				while ValueEnd &gt; ValueStart and Mask:sub(ValueEnd, ValueEnd):match("%s") do
					ValueEnd -= 1
				end

				local Raw = Source:sub(ValueStart, ValueEnd)

				local IsFunction = Raw:match("^function%f[%W]") ~= nil
				if not IsFunction
					and not (LeavesOnly and (Raw:find("\n", 1, true) or #Stack == 0 or Raw == "")) then
					local LineStart = LineStarts[LineAt[ValueStart]] or 1
					local LineStop = Source:find("\n", ValueStart) or (#Source + 1)

					table.insert(Rows, {
						Path = table.concat(Stack, ".") .. "." .. Pending,
						Key = Pending,
						Module = Stack[1] or "?",
						Branch = Stack[2],
						Line = LineAt[Index],
						ValueStart = ValueStart,
						ValueEnd = ValueEnd,
						Raw = Raw,
						Text = Source:sub(LineStart, LineStop - 1),
					})
				end
			end
			Index += 1

		else
			Index += 1
		end
	end

	table.sort(Rows, function(Left, Right)
		return Left.ValueStart &lt; Right.ValueStart
	end)

	if LeavesOnly then
		local Kept, Reach = {}, 0
		for _, Row in Rows do
			if Row.ValueStart &gt; Reach then
				table.insert(Kept, Row)
				Reach = Row.ValueEnd
			end
		end
		return Kept
	end

	return Rows
end

local function IsAnimationSlot(Key)
	return Key:sub(-11) == "AnimationId"
end

local function Anything()
	return true
end

function ConfigScanner.Scan(Source)
	return Walk(Source, IsAnimationSlot, false)
end

function ConfigScanner.ScanAll(Source)
	return Walk(Source, Anything, true)
end

function ConfigScanner.Values(Source)
	local Values = {}
	for _, Row in ConfigScanner.ScanAll(Source) do
		Values[Row.Path] = Row.Raw
	end
	return Values
end

function ConfigScanner.Splice(Source, Rows, Values)
	local Ordered = table.clone(Rows)
	table.sort(Ordered, function(Left, Right)
		return Left.ValueStart &lt; Right.ValueStart
	end)

	local Pieces, Cursor = {}, 1
	for _, Row in Ordered do
		table.insert(Pieces, Source:sub(Cursor, Row.ValueStart - 1))
		table.insert(Pieces, Values and Values[Row.Path] or Row.Raw)
		Cursor = Row.ValueEnd + 1
	end
	table.insert(Pieces, Source:sub(Cursor))
	return table.concat(Pieces)
end

function ConfigScanner.SelfTest(Source)
	local Rows = ConfigScanner.Scan(Source)
	local Seen, Duplicates = {}, 0
	for _, Row in Rows do
		if Seen[Row.Path] then
			Duplicates += 1
		end
		Seen[Row.Path] = true
	end
	local Identical = ConfigScanner.Splice(Source, Rows) == Source
	return {
		Rows = Rows,
		Count = #Rows,
		Duplicates = Duplicates,
		Identical = Identical,
		Trustworthy = Identical and Duplicates == 0 and #Rows &gt; 0,
	}
end

function ConfigScanner.LeafSelfTest(Source)
	local Rows = ConfigScanner.ScanAll(Source)
	local Seen, Duplicates = {}, 0
	for _, Row in Rows do
		if Seen[Row.Path] then
			Duplicates += 1
		end
		Seen[Row.Path] = true
	end
	local Identical = ConfigScanner.Splice(Source, Rows) == Source
	return {
		Rows = Rows,
		Count = #Rows,
		Duplicates = Duplicates,
		Identical = Identical,
		Trustworthy = Identical and Duplicates == 0 and #Rows &gt; 0,
	}
end

function ConfigScanner.Module()
	local Node = game
	for Piece in Settings.ConfigPath:gmatch("[^%.]+") do
		Node = Node and Node:FindFirstChild(Piece)
	end
	return Node and Node:IsA("LuaSourceContainer") and Node or nil
end

function ConfigScanner.Value(Row)
	local Number = tonumber(Row.Raw)
	if Number then
		return Number, false
	end
	return nil, Row.Raw:sub(1, 1) == "{"
end

return ConfigScanner
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX48">
      <Properties>
        <string name="Name">DocPage</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)

--// [Variables]
local DocPage = {}
local CardWidth = 240
local CardHeight = 132
local CardInset = 12
local HeadHeight = 30

--// [Do not go past this point]

function DocPage.New(Page, Words)
	local Doc = {}

	local Search = Instance.new("TextBox")
	Search.Position = UDim2.fromOffset(16, 14)
	Search.Size = UDim2.fromOffset(260, 28)
	Search.BackgroundColor3 = Theme.Raised
	Search.BorderSizePixel = 0
	Search.Font = Theme.BodyFont
	Search.TextSize = Theme.Size(15)
	Search.TextColor3 = Theme.Text
	Search.PlaceholderText = Words.Search
	Search.PlaceholderColor3 = Theme.MutedText
	Search.Text = ""
	Search.ClearTextOnFocus = false
	Search.TextXAlignment = Enum.TextXAlignment.Left
	Search.Parent = Page
	Theme.Stroke(Search)
	Theme.Padding(Search, 6)
	Doc.Search = Search

	local Status = Theme.Label("", 13, Theme.MutedText)
	Status.Position = UDim2.fromOffset(288, 14)
	Status.Size = UDim2.new(1, -304, 0, 28)
	Status.Parent = Page
	Doc.Status = Status

	local Shell, Pane = Theme.Group(Page, Words.GridTitle)
	Shell.Position = UDim2.fromOffset(16, 58)
	Shell.Size = UDim2.new(1, -32, 1, -74)

	local Grid = Instance.new("ScrollingFrame")
	Grid.Size = UDim2.fromScale(1, 1)
	Grid.BackgroundTransparency = 1
	Grid.BorderSizePixel = 0
	Grid.ScrollBarThickness = 4
	Grid.ScrollBarImageColor3 = Theme.MutedText
	Grid.CanvasSize = UDim2.new()
	Grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Grid.Parent = Pane
	Theme.ScrollInset(Grid, 5)

	local GridLayout = Instance.new("UIGridLayout")
	GridLayout.CellSize = UDim2.fromOffset(CardWidth, CardHeight)
	GridLayout.CellPadding = UDim2.fromOffset(12, 12)
	GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	GridLayout.Parent = Grid

	local Detail = Instance.new("TextButton")
	Detail.Size = UDim2.fromScale(1, 1)
	Detail.BackgroundColor3 = Theme.Background
	Detail.BorderSizePixel = 0
	Detail.Text = ""
	Detail.AutoButtonColor = false
	Detail.Visible = false
	Detail.ZIndex = 20
	Detail.Parent = Page

	local function ShowGrid(State)
		Detail.Visible = not State
		Shell.Visible = State
		Search.Visible = State
		Status.Visible = State
	end

	local Back = Theme.Button(Words.Back, 96, 28, false)
	Back.Position = UDim2.fromOffset(16, 14)
	Back.ZIndex = 21
	Back.Parent = Detail

	local Heading = Theme.Label("", 20, Theme.Accent, Theme.TitleFont)
	Heading.Position = UDim2.fromOffset(124, 14)
	Heading.Size = UDim2.new(1, -140, 0, 28)
	Heading.ZIndex = 21
	Heading.Parent = Detail

	local ActionWidth = 150
	local PageAction = Theme.Button("", ActionWidth, 28, true)
	PageAction.AnchorPoint = Vector2.new(1, 0)
	PageAction.Position = UDim2.new(1, -16, 0, 14)
	PageAction.Visible = false
	PageAction.ZIndex = 22
	PageAction.Parent = Detail
	local ShownEntry = nil
	PageAction.Activated:Connect(function()
		if ShownEntry and ShownEntry.Action then
			ShownEntry.Action.Run(ShownEntry)
		end
	end)

	local Body = Instance.new("ScrollingFrame")
	Body.Position = UDim2.fromOffset(16, 52)
	Body.Size = UDim2.new(1, -32, 1, -68)
	Body.BackgroundTransparency = 1
	Body.BorderSizePixel = 0
	Body.ScrollBarThickness = 5
	Body.ScrollBarImageColor3 = Theme.MutedText
	Body.CanvasSize = UDim2.new()
	Body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Body.ZIndex = 21
	Body.Parent = Detail

	local Column = Instance.new("Frame")
	Column.Name = "Column"
	Column.Size = UDim2.new(1, -12, 0, 0)
	Column.AutomaticSize = Enum.AutomaticSize.Y
	Column.BackgroundTransparency = 1
	Column.ZIndex = 21
	Column.Parent = Body

	local ColumnLayout = Instance.new("UIListLayout")
	ColumnLayout.Padding = UDim.new(0, 6)
	ColumnLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ColumnLayout.Parent = Column

	local function Sized(Label, Base)
		Label.TextSize = Theme.Size(Base)
		return Label
	end

	Sized(Heading, 18)

	local Order = 0
	local OpenName = nil
	local Unfolded = {}

	local function Paragraph(Text, Size, Colour, Font)
		Order += 1
		local Label = Sized(Theme.Label(Text, Size, Colour, Font), Size)
		Label.LayoutOrder = Order
		Label.Size = UDim2.new(1, 0, 0, 0)
		Label.AutomaticSize = Enum.AutomaticSize.Y
		Label.TextWrapped = true
		Label.TextYAlignment = Enum.TextYAlignment.Top
		Label.ZIndex = 21
		Label.Parent = Column
		return Label
	end

	local function Bullet(Text)
		Order += 1
		local Row = Instance.new("Frame")
		Row.LayoutOrder = Order
		Row.Size = UDim2.new(1, 0, 0, 0)
		Row.AutomaticSize = Enum.AutomaticSize.Y
		Row.BackgroundTransparency = 1
		Row.ZIndex = 21
		Row.Parent = Column

		local Dot = Instance.new("Frame")
		Dot.Position = UDim2.fromOffset(4, 8)
		Dot.Size = UDim2.fromOffset(4, 4)
		Dot.BackgroundColor3 = Theme.Accent
		Dot.BorderSizePixel = 0
		Dot.ZIndex = 22
		Dot.Parent = Row

		local Label = Sized(Theme.Label(Text, 15, Theme.BodyText), 15)
		Label.Position = UDim2.fromOffset(18, 0)
		Label.Size = UDim2.new(1, -18, 0, 0)
		Label.AutomaticSize = Enum.AutomaticSize.Y
		Label.TextWrapped = true
		Label.TextYAlignment = Enum.TextYAlignment.Top
		Label.ZIndex = 22
		Label.Parent = Row
		return Label
	end

	local function Spacer(Height)
		Order += 1
		local Gap = Instance.new("Frame")
		Gap.LayoutOrder = Order
		Gap.Size = UDim2.new(1, 0, 0, Height)
		Gap.BackgroundTransparency = 1
		Gap.ZIndex = 21
		Gap.Parent = Column
		return Gap
	end

	local function CodeBlock(Parent, Slot, Text)
		local Shelf = Instance.new("Frame")
		Shelf.LayoutOrder = Slot
		Shelf.Size = UDim2.new(1, 0, 0, 0)
		Shelf.AutomaticSize = Enum.AutomaticSize.Y
		Shelf.BackgroundColor3 = Theme.Background
		Shelf.BorderSizePixel = 0
		Shelf.ZIndex = 23
		Shelf.Parent = Parent
		Theme.Stroke(Shelf, Theme.Border)
		Theme.Padding(Shelf, 8)

		local Code = Instance.new("TextBox")
		Code.Size = UDim2.new(1, 0, 0, 0)
		Code.AutomaticSize = Enum.AutomaticSize.Y
		Code.BackgroundTransparency = 1
		Code.BorderSizePixel = 0
		Code.MultiLine = true
		Code.TextEditable = false
		Code.ClearTextOnFocus = false
		Code.TextWrapped = true
		Code.Font = Enum.Font.Code
		Sized(Code, 13)
		Code.TextColor3 = Theme.BodyText
		Code.Text = Text
		Code.TextXAlignment = Enum.TextXAlignment.Left
		Code.TextYAlignment = Enum.TextYAlignment.Top
		Code.ZIndex = 24
		Code.Parent = Shelf
		return Shelf
	end

	local function UnfoldRow(Row, EntryName)
		Order += 1

		local Frame = Instance.new("Frame")
		Frame.LayoutOrder = Order
		Frame.Size = UDim2.new(1, 0, 0, 0)
		Frame.AutomaticSize = Enum.AutomaticSize.Y
		Frame.BackgroundColor3 = Theme.Panel
		Frame.BackgroundTransparency = 1
		Frame.BorderSizePixel = 0
		Frame.ZIndex = 21
		Frame.Parent = Column

		local Stack = Instance.new("UIListLayout")
		Stack.SortOrder = Enum.SortOrder.LayoutOrder
		Stack.Parent = Frame

		local Head = Instance.new("TextButton")
		Head.LayoutOrder = 1
		Head.Size = UDim2.new(1, 0, 0, HeadHeight)
		Head.BackgroundTransparency = 1
		Head.Text = ""
		Head.AutoButtonColor = false
		Head.ZIndex = 22
		Head.Parent = Frame

		local Caret = Sized(Theme.Label("&gt;", 11, Theme.MutedText, Theme.TitleFont), 11)
		Caret.Position = UDim2.fromOffset(8, 0)
		Caret.Size = UDim2.new(0, 12, 1, 0)
		Caret.ZIndex = 23
		Caret.Parent = Head

		local KeyShare = Row.Right and 0.44 or 0.52
		local ValueShare = Row.Right and 0.42 or 0.48

		local Key = Sized(Theme.Label(Row.Key, 15, Theme.Text, Theme.MediumFont), 15)
		Key.Position = UDim2.fromOffset(24, 0)
		Key.Size = UDim2.new(KeyShare, -24, 1, 0)
		Key.TextTruncate = Enum.TextTruncate.AtEnd
		Key.ZIndex = 23
		Key.Parent = Head

		local Value = Sized(Theme.Label(Row.Value or "", 15, Theme.Success), 15)
		Value.Position = UDim2.new(KeyShare, 0, 0, 0)
		Value.Size = UDim2.new(ValueShare, -12, 1, 0)
		Value.TextTruncate = Enum.TextTruncate.AtEnd
		Value.ZIndex = 23
		Value.Parent = Head

		if Row.Right then
			local Right = Sized(Theme.Label(Row.Right, 13, Theme.MutedText), 13)
			Right.Position = UDim2.new(KeyShare + ValueShare, 0, 0, 0)
			Right.Size = UDim2.new(1 - KeyShare - ValueShare, -10, 1, 0)
			Right.TextXAlignment = Enum.TextXAlignment.Right
			Right.ZIndex = 23
			Right.Parent = Head
		end

		local Fold = Instance.new("Frame")
		Fold.LayoutOrder = 2
		Fold.Size = UDim2.new(1, 0, 0, 0)
		Fold.AutomaticSize = Enum.AutomaticSize.Y
		Fold.BackgroundTransparency = 1
		Fold.Visible = false
		Fold.ZIndex = 22
		Fold.Parent = Frame

		local FoldLayout = Instance.new("UIListLayout")
		FoldLayout.Padding = UDim.new(0, 4)
		FoldLayout.SortOrder = Enum.SortOrder.LayoutOrder
		FoldLayout.Parent = Fold

		local FoldPad = Instance.new("UIPadding")
		FoldPad.PaddingLeft = UDim.new(0, 24)
		FoldPad.PaddingRight = UDim.new(0, 12)
		FoldPad.PaddingBottom = UDim.new(0, 8)
		FoldPad.Parent = Fold

		local Slot = 0
		for _, Line in Row.Lines or {} do
			Slot += 1
			local Label = Sized(Theme.Label(Line.Text, Line.Size, Line.Colour, Line.Font), Line.Size)
			Label.LayoutOrder = Slot
			Label.Size = UDim2.new(1, 0, 0, 0)
			Label.AutomaticSize = Enum.AutomaticSize.Y
			Label.TextWrapped = true
			Label.TextYAlignment = Enum.TextYAlignment.Top
			Label.ZIndex = 23
			Label.Parent = Fold
		end
		if Row.Code then
			Slot += 1
			CodeBlock(Fold, Slot, Row.Code)
		end

		local Slug = EntryName .. "." .. Row.Key
		local Open = Unfolded[Slug] == true

		local function Paint()
			Fold.Visible = Open
			Caret.Text = Open and "v" or "&gt;"
			Caret.TextColor3 = Open and Theme.Accent or Theme.MutedText
			Frame.BackgroundTransparency = Open and 0 or 1
			Key.TextColor3 = Open and Theme.Accent or Theme.Text
		end

		Head.Activated:Connect(function()
			Open = not Open
			Unfolded[Slug] = Open or nil
			Paint()
		end)
		Head.MouseEnter:Connect(function()
			if not Open then
				Frame.BackgroundTransparency = 0.5
			end
		end)
		Head.MouseLeave:Connect(function()
			if not Open then
				Frame.BackgroundTransparency = 1
			end
		end)
		Paint()
	end

	function Doc.Show(Entry, KeepPlace)
		for _, Child in Column:GetChildren() do
			if Child:IsA("GuiObject") then
				Child:Destroy()
			end
		end
		Order = 0
		OpenName = Entry.Name
		Sized(Heading, 18)

		Heading.Text = Entry.Title
		ShownEntry = Entry
		PageAction.Visible = Entry.Action ~= nil
		PageAction.Text = Entry.Action and Entry.Action.Text or ""
		Heading.Size = UDim2.new(1, Entry.Action and -(140 + ActionWidth + 12) or -140, 0, 28)

		if Entry.Where then
			Paragraph(Entry.Where, 13, Theme.MutedText)
		end
		if Entry.Summary then
			Paragraph(Entry.Summary, 16, Theme.BodyText)
		end
		if Entry.Notes and #Entry.Notes &gt; 0 then
			Spacer(2)
			Paragraph(Words.Notes, 15, Theme.Accent, Theme.TitleFont)
			for _, Note in Entry.Notes do
				Bullet(Note)
			end
		end

		local Any = false
		for _, Group in Entry.Groups or {} do
			if #Group.Rows &gt; 0 then
				Any = true
			end
		end
		if Any then
			Spacer(2)
			Paragraph(Words.ExpandHint, 13, Theme.MutedText)
			for _, Group in Entry.Groups do
				if #Group.Rows &gt; 0 then
					Spacer(4)
					if Group.Title then
						Paragraph(Group.Title:upper(), 12, Theme.Accent, Theme.TitleFont)
					end
					for _, Row in Group.Rows do
						UnfoldRow(Row, Entry.Name)
					end
				end
			end
		end

		if not KeepPlace then
			Body.CanvasPosition = Vector2.new(0, 0)
		end
		ShowGrid(false)
	end

	function Doc.Close()
		OpenName = nil
		ShowGrid(true)
	end

	function Doc.Open()
		return OpenName
	end

	Back.Activated:Connect(Doc.Close)

	local function Card(Entry, Position)
		local Frame = Instance.new("TextButton")
		Frame.LayoutOrder = Position
		Frame.BackgroundColor3 = Theme.Panel
		Frame.BorderSizePixel = 0
		Frame.Text = ""
		Frame.AutoButtonColor = false
		Frame.Parent = Grid
		Theme.Stroke(Frame, Theme.CardEdge)

		Frame.MouseEnter:Connect(function()
			Frame.BackgroundColor3 = Theme.Raised
		end)
		Frame.MouseLeave:Connect(function()
			Frame.BackgroundColor3 = Theme.Panel
		end)

		local function Place(Label, Top, Height)
			Label.Position = UDim2.fromScale(CardInset / CardWidth, Top / CardHeight)
			Label.Size = UDim2.fromScale(1 - CardInset * 2 / CardWidth, Height / CardHeight)
			Label.Parent = Frame
		end

		local Title = Sized(Theme.Label(Entry.Title, 15, Theme.Accent, Theme.TitleFont), 15)
		Title.TextTruncate = Enum.TextTruncate.AtEnd
		Place(Title, 10, 22)

		local Facts = Sized(Theme.Label(Entry.Facts or "", 13, Theme.MutedText), 13)
		Place(Facts, 34, 18)

		local Blurb = Sized(Theme.Label(Entry.Blurb or "", 14, Theme.BodyText), 14)
		Blurb.TextWrapped = true
		Blurb.TextYAlignment = Enum.TextYAlignment.Top
		Place(Blurb, 58, 64)

		if Entry.Action then
			local Button = Theme.Button(Entry.Action.Text, 84, 24, true)
			Button.TextSize = Theme.Size(12)
			Button.AnchorPoint = Vector2.new(1, 0)
			Button.Position = UDim2.new(1, -CardInset, 0, 30)
			Button.ZIndex = Frame.ZIndex + 1
			Button.Parent = Frame
			Button.Activated:Connect(function()
				Entry.Action.Run(Entry)
			end)
			Facts.Size = UDim2.fromScale(1 - (CardInset * 2 + 96) / CardWidth, 18 / CardHeight)
		end

		Frame.Activated:Connect(function()
			Doc.Show(Entry)
		end)
	end

	function Doc.Draw(Entries)
		for _, Child in Grid:GetChildren() do
			if Child:IsA("TextButton") then
				Child:Destroy()
			end
		end
		local Needle = Search.Text:lower()
		local Shown = 0
		for _, Entry in Entries do
			if Needle == "" or (Entry.Haystack or ""):lower():find(Needle, 1, true) then
				Shown += 1
				Card(Entry, Shown)
			end
		end
		return Shown
	end

	function Doc.Reopen(Entries)
		if not OpenName then
			return false
		end
		local Place = Body.CanvasPosition
		local Was = OpenName
		for _, Entry in Entries do
			if Entry.Name == Was then
				Doc.Show(Entry, true)
				Body.CanvasPosition = Place

				task.defer(function()
					if Detail.Visible and OpenName == Was then
						Body.CanvasPosition = Place
					end
				end)
				return true
			end
		end

		OpenName = nil
		ShowGrid(true)
		return false
	end

	ShowGrid(true)

	return Doc
end

return DocPage
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX49">
      <Properties>
        <string name="Name">Installer</string>
        <ProtectedString name="Source">--// [Services]
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local RunService = game:GetService("RunService")

--// [Modules]
local Settings = require(script.Parent.Settings)
local Requirements = require(script.Parent.Requirements)
local ConfigScanner = require(script.Parent.ConfigScanner)

--// [Variables]
local Installer = {}

--// [Do not go past this point]

function Installer.Installed()
	return ConfigScanner.Module() ~= nil
end

function Installer.Preview(Extras)
	local Package = Requirements.FindPackage()
	if not Package then
		return nil, {}
	end

	local Plan = Requirements.ReadPlan(Package, Extras)
	for _, Entry in Plan do
		Entry.Collisions = {}
		Entry.Fresh = {}
		for _, Child in Entry.Source:GetChildren() do
			if Entry.Target and Entry.Target:FindFirstChild(Child.Name) then
				table.insert(Entry.Collisions, Child.Name)
			else
				table.insert(Entry.Fresh, Child.Name)
			end
		end
	end
	return Package, Plan
end

function Installer.CollisionCount(Plan)
	local Total = 0
	for _, Entry in Plan do
		Total += #Entry.Collisions
	end
	return Total
end

function Installer.Run(Overwrite, Extras)
	local Package, Plan = Installer.Preview(Extras)
	local Log = {}

	if RunService:IsRunning() then
		return false, { "Refused: stop the playtest first, nothing moved during a run survives it." }
	end
	if not Package then
		return false, { "Nothing installed: no package found." }
	end
	if #Plan == 0 then
		return false, { "Nothing installed: the package holds no groups to unpack." }
	end

	local Recording = ChangeHistoryService:TryBeginRecording("UMSInstall", "Install Ultimate Movement System")

	local Moved, Kept, Replaced, Refused = 0, 0, 0, 0
	local Emptied = {}

	for _, Entry in Plan do
		if not Entry.Target then
			Refused += 1
			table.insert(Log, "refused " .. Entry.Path .. ", no such destination")
			continue
		end

		for _, Child in Entry.Source:GetChildren() do
			local Existing = Entry.Target:FindFirstChild(Child.Name)
			if Existing and not Overwrite then
				Kept += 1
			else
				if Existing then
					Existing.Parent = nil
					Replaced += 1
				end
				Child.Parent = Entry.Target
				Moved += 1
			end
		end

		if #Entry.Source:GetChildren() == 0 then
			table.insert(Emptied, Entry.Source)
		end
	end

	table.insert(Log, "moved " .. Moved .. ", left " .. Kept .. " of yours alone, replaced " .. Replaced .. ", refused " .. Refused)
	if Kept &gt; 0 then
		table.insert(Log, "your copies were kept; use Replace mine if you meant to overwrite them")
	end

	for _, Group in Emptied do
		Group.Parent = nil
	end
	if #Emptied &gt; 0 then
		table.insert(Log, "removed " .. #Emptied .. " emptied group(s)")
	end

	local Prefix = Settings.Get("UngroupPrefix")
	for _, Entry in Plan do
		local Group = Entry.Optional
		if Group and Group.Parent then
			local Left = 0
			for _, Child in Group:GetChildren() do
				if Child.Name:sub(1, #Prefix) == Prefix then
					Left += 1
				end
			end
			if Left == 0 then
				Group.Parent = nil
				table.insert(Log, Group.Name .. " is unpacked and removed")
			end
		end
	end

	local Left = #Package:GetChildren()
	if Left == 0 and not Package.Name:find(Settings.InstalledSuffix, 1, true) then
		Package.Name = Package.Name .. Settings.InstalledSuffix
		table.insert(Log, "the package is empty and renamed to \"" .. Package.Name .. "\", delete it when you are happy")
	elseif Left &gt; 0 then
		table.insert(Log, Left .. " item(s) still in the package, left untouched")
	end

	if Recording then
		ChangeHistoryService:FinishRecording(Recording, Enum.FinishRecordingOperation.Commit)
	end
	return Refused == 0, Log
end

return Installer
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX50">
      <Properties>
        <string name="Name">KitVersion</string>
        <ProtectedString name="Source">--// [Modules]
local ConfigScanner = require(script.Parent.ConfigScanner)

--// [Variables]
local KitVersion = {}

--// [Do not go past this point]

KitVersion.Attribute = "Version"
KitVersion.Unknown = "unknown"

local function ReadNode(Movement)
	if not Movement then
		return nil
	end

	local Stamp = Movement:GetAttribute(KitVersion.Attribute)
	if typeof(Stamp) == "string" and Stamp ~= "" then
		return Stamp, "attribute"
	end
	if typeof(Stamp) == "number" then
		return tostring(Stamp), "attribute"
	end

	local Config = Movement:FindFirstChild("MovementConfig")
	if Config and Config:IsA("LuaSourceContainer") then
		local OnConfig = Config:GetAttribute(KitVersion.Attribute)
		if typeof(OnConfig) == "string" and OnConfig ~= "" then
			return OnConfig, "attribute"
		end
		local Line = Config.Source:match("SystemVersion%s*=%s*\"([^\"]+)\"")
		if Line then
			return Line, "config"
		end
	end

	local Api = Movement:FindFirstChild("MovementApi")
	if Api and Api:IsA("LuaSourceContainer") then
		local Line = Api.Source:match("SystemVersion%s*=%s*\"([^\"]+)\"")
		if Line then
			return Line, "source"
		end
	end
	return nil
end

function KitVersion.Live()
	local Config = ConfigScanner.Module()
	local Version, How = ReadNode(Config and Config.Parent)
	return Version or KitVersion.Unknown, How
end

function KitVersion.Package(Package)
	local Config = Package and Package:FindFirstChild("MovementConfig", true)
	local Version, How = ReadNode(Config and Config.Parent)
	return Version or KitVersion.Unknown, How
end

function KitVersion.AtLeast(Have, Want)
	if typeof(Have) ~= "string" or typeof(Want) ~= "string" then
		return false
	end
	local Mine, Theirs = {}, {}
	for Piece in Have:gmatch("%d+") do
		table.insert(Mine, tonumber(Piece))
	end
	for Piece in Want:gmatch("%d+") do
		table.insert(Theirs, tonumber(Piece))
	end
	if #Mine == 0 or #Theirs == 0 then
		return false
	end
	for Index = 1, math.max(#Mine, #Theirs) do
		local A, B = Mine[Index] or 0, Theirs[Index] or 0
		if A ~= B then
			return A &gt; B
		end
	end
	return true
end

function KitVersion.Compare(Have, Want)
	if Have == nil or Want == nil or Have == KitVersion.Unknown or Want == KitVersion.Unknown then
		return "unknown"
	end
	if tostring(Have) == tostring(Want) then
		return "same"
	end
	return "different"
end

return KitVersion
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX51">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source">--// [Modules]
local Window = require(script.Parent.Window)
local Requirements = require(script.Parent.Requirements)
local Content = require(script.Parent.Content)
local MainScreen = require(script.Parent.MainScreen)
local Tabs = require(script.Parent.Tabs)
local TabAbout = require(script.Parent.TabAbout)
local TabInstall = require(script.Parent.TabInstall)
local TabPresets = require(script.Parent.TabPresets)
local TabConfig = require(script.Parent.TabConfig)
local TabApi = require(script.Parent.TabApi)
local TabLibrary = require(script.Parent.TabLibrary)

--// [Do not go past this point]

Requirements.Attach(plugin)

local Toolbar = plugin:CreateToolbar(Content.ToolbarName)
local ToggleButton = Toolbar:CreateButton(Content.ButtonLabel, Content.ButtonTooltip, "")
ToggleButton.ClickableWhenViewportHidden = true

local MainWindow = Window.New(plugin, Content.WindowTitle, Vector2.new(820, 560), Vector2.new(620, 460))
local Screen = MainScreen.New(MainWindow.Content, plugin)
local Pages = Tabs.New(MainWindow.Content, Content.TabOrder)

local RefreshAbout = TabAbout.Build(Pages:Page("About"))
local RefreshInstall = TabInstall.Build(Pages:Page("Install"), plugin)
local RefreshPresets = TabPresets.Build(Pages:Page("Presets"), plugin)
local RefreshConfig = TabConfig.Build(Pages:Page("Config"))
local RefreshApi = TabApi.Build(Pages:Page("API"))
local RefreshLibrary = TabLibrary.Build(Pages:Page("Library"))

Pages:SetRefresh("About", RefreshAbout)
Pages:SetRefresh("Install", RefreshInstall)
Pages:SetRefresh("Presets", RefreshPresets)
Pages:SetRefresh("Config", RefreshConfig)
Pages:SetRefresh("API", RefreshApi)
Pages:SetRefresh("Library", RefreshLibrary)

Screen.Ready:Connect(function()
	Pages:Show()
end)

ToggleButton.Click:Connect(function()
	MainWindow:Toggle()
end)

MainWindow.Changed:Connect(function()
	local Open = MainWindow:IsOpen()
	ToggleButton:SetActive(Open)
	if Open then
		Pages:Hide()
		Screen:Reset()
	end
end)

ToggleButton:SetActive(MainWindow:IsOpen())

plugin.Unloading:Connect(function()
	Pages:Destroy()
	Screen:Destroy()
	MainWindow:Destroy()
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
        <token name="RunContext">0</token>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX52">
      <Properties>
        <string name="Name">MainScreen</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Settings = require(script.Parent.Settings)
local Content = require(script.Parent.Content)
local Requirements = require(script.Parent.Requirements)

--// [Variables]
local MainScreen = {}

--// [Do not go past this point]

MainScreen.__index = MainScreen

local function AccentButton(Text, Width)
	local Button = Theme.Button(Text, Width or 150, 36, true)
	Button.TextSize = Theme.Size(14)
	return Button
end

local function QuietButton(Text, Width)
	return Theme.Button(Text, Width or 100, 30, false)
end

function MainScreen.New(Parent, PluginHandle)
	local self = setmetatable({}, MainScreen)

	self.ReadyEvent = Instance.new("BindableEvent")
	self.Ready = self.ReadyEvent.Event

	local Landing = Instance.new("Frame")
	Landing.Name = "Landing"
	Landing.Size = UDim2.fromScale(1, 1)
	Landing.BackgroundTransparency = 1
	Landing.Parent = Parent
	self.Landing = Landing

	local Heading = Theme.Label(Content.Landing.Heading, 22, Theme.Text, Theme.TitleFont)
	Heading.Position = UDim2.new(0, 0, 0.26, 0)
	Heading.Size = UDim2.new(1, 0, 0, 28)
	Heading.TextXAlignment = Enum.TextXAlignment.Center
	Heading.Parent = Landing

	local Subheading = Theme.Label(Content.Landing.Subheading, 13, Theme.MutedText)
	Subheading.Position = UDim2.new(0, 0, 0.26, 30)
	Subheading.Size = UDim2.new(1, 0, 0, 18)
	Subheading.TextXAlignment = Enum.TextXAlignment.Center
	Subheading.Parent = Landing

	local VersionLabel = Theme.Label(Content.Landing.VersionLabel, 13, Theme.MutedText)
	VersionLabel.Position = UDim2.new(0.5, -84, 0.6, -70)
	VersionLabel.Size = UDim2.new(0, 168, 0, 18)
	VersionLabel.TextXAlignment = Enum.TextXAlignment.Center
	VersionLabel.Parent = Landing

	local Picker = Theme.Dropdown(Landing, Parent, "", 168, 30, 60)
	Picker.Button.Position = UDim2.new(0.5, -84, 0.6, -48)
	local Options = {}
	for Index, Entry in Settings.Versions do
		Options[Index] = { Label = Entry.Label, Value = Entry.Value }
	end
	Picker.SetOptions(Options)
	local Saved = PluginHandle and PluginHandle:GetSetting("KitVersion")
	local Current = Settings.Choose(Saved) or Settings.Version
	for Index, Entry in Settings.Versions do
		if Entry == Current then
			Picker.Select(Index)
		end
	end
	Picker.OnPick = function(_, Item)
		Settings.Choose(Item.Value)
		if PluginHandle then
			PluginHandle:SetSetting("KitVersion", Item.Value)
		end
	end

	local Start = AccentButton(Content.Landing.Button, 168)
	Start.Position = UDim2.new(0.5, -84, 0.6, 0)
	Start.Parent = Landing

	local Gate = Instance.new("Frame")
	Gate.Name = "Gate"
	Gate.Size = UDim2.fromScale(1, 1)
	Gate.BackgroundTransparency = 1
	Gate.Visible = false
	Gate.Parent = Parent
	self.Gate = Gate

	local Column = Instance.new("Frame")
	Column.Name = "Column"
	Column.AnchorPoint = Vector2.new(0.5, 0)
	Column.Position = UDim2.fromScale(0.5, 0)
	Column.Size = UDim2.fromScale(1, 1)
	Column.BackgroundTransparency = 1
	Column.Parent = Gate
	Theme.Padding(Column, 20)

	local ColumnCap = Instance.new("UISizeConstraint")
	ColumnCap.MaxSize = Vector2.new(900, math.huge)
	ColumnCap.Parent = Column

	local ColumnLayout = Instance.new("UIListLayout")
	ColumnLayout.Padding = UDim.new(0, 8)
	ColumnLayout.SortOrder = Enum.SortOrder.LayoutOrder
	ColumnLayout.Parent = Column

	local GateHeading = Theme.Label(Content.Gate.Heading, 16, Theme.Text, Theme.TitleFont)
	GateHeading.LayoutOrder = 1
	GateHeading.Size = UDim2.new(1, 0, 0, 24)
	GateHeading.Parent = Column

	local List = Instance.new("ScrollingFrame")
	List.Name = "List"
	List.LayoutOrder = 2
	List.Size = UDim2.new(1, 0, 0, 0)
	List.BackgroundTransparency = 1
	List.BorderSizePixel = 0
	List.ScrollBarThickness = 4
	List.ScrollBarImageColor3 = Theme.MutedText
	List.CanvasSize = UDim2.new()
	List.AutomaticCanvasSize = Enum.AutomaticSize.Y
	List.Parent = Column
	self.List = List

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0, 8)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = List

	local function FitList()
		local Rows = Layout.AbsoluteContentSize.Y
		local PageHeight = Gate.AbsoluteSize.Y / Theme.ScaleOf(Gate)
		local Cap = PageHeight &gt; 0 and math.floor(PageHeight * 0.6) or Rows
		List.Size = UDim2.new(1, 0, 0, math.min(Rows, Cap))
	end
	Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(FitList)
	Gate:GetPropertyChangedSignal("AbsoluteSize"):Connect(FitList)
	FitList()

	local Buttons = Instance.new("Frame")
	Buttons.Name = "Buttons"
	Buttons.LayoutOrder = 3
	Buttons.Size = UDim2.new(1, 0, 0, 38)
	Buttons.BackgroundTransparency = 1
	Buttons.Parent = Column

	local Recheck = AccentButton(Content.Gate.Recheck, 136)
	Recheck.Position = UDim2.new(0, 0, 0, 1)
	Recheck.Parent = Buttons

	local Back = QuietButton(Content.Gate.Back, 88)
	Back.Position = UDim2.new(0, 146, 0, 4)
	Back.Parent = Buttons

	Start.Activated:Connect(function()
		self:Evaluate()
	end)
	Recheck.Activated:Connect(function()
		self:Evaluate()
	end)
	Back.Activated:Connect(function()
		self:Reset()
	end)

	return self
end

function MainScreen:BuildRow(Index, Entry)
	local Row = Instance.new("Frame")
	Row.Name = "Row" .. Index
	Row.LayoutOrder = Index
	Row.Size = UDim2.new(1, -6, 0, 60)
	Row.BackgroundColor3 = Theme.Panel
	Row.BorderSizePixel = 0
	Row.Parent = self.List
	Theme.Stroke(Row)

	local Number = Theme.Label(Index .. ".", 15, Theme.Accent, Theme.TitleFont)
	Number.Position = UDim2.new(0, 12, 0, 9)
	Number.Size = UDim2.fromOffset(22, 20)
	Number.Parent = Row

	local Title = Theme.Label(Entry.Title, 13, Theme.Text, Theme.MediumFont)
	Title.Position = UDim2.new(0, 36, 0, 9)
	Title.Size = UDim2.new(1, -150, 0, 18)
	Title.Parent = Row

	local Detail = Theme.Label(Entry.Detail, 12, Theme.MutedText)
	Detail.Position = UDim2.new(0, 36, 0, 28)
	Detail.Size = UDim2.new(1, -150, 0, 26)
	Detail.TextWrapped = true
	Detail.TextYAlignment = Enum.TextYAlignment.Top
	Detail.Parent = Row

	if Entry.Manual then
		local Tick = QuietButton(Content.Gate.Acknowledge, 96)
		Tick.Position = UDim2.new(1, -104, 0, 16)
		Tick.Parent = Row
		Tick.Activated:Connect(function()
			Requirements.AcknowledgeBeta(true)
			self:Evaluate()
		end)
	end
end

function MainScreen:Evaluate()
	local Failed = Requirements.Blocking(Requirements.Check())

	if #Failed == 0 then
		self.Gate.Visible = false
		self.Landing.Visible = false
		self.ReadyEvent:Fire()
		return
	end

	for _, Child in self.List:GetChildren() do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end
	for Index, Entry in Failed do
		self:BuildRow(Index, Entry)
	end

	self.Landing.Visible = false
	self.Gate.Visible = true
end

function MainScreen:Reset()
	self.Gate.Visible = false
	self.Landing.Visible = true
end

function MainScreen:Destroy()
	self.ReadyEvent:Destroy()
	self.Landing:Destroy()
	self.Gate:Destroy()
end

return MainScreen
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX53">
      <Properties>
        <string name="Name">PresetCodec</string>
        <ProtectedString name="Source">--// [Variables]
local PresetCodec = {}
local Marker = "UMSP1"
local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local Ceiling = 65535
local Reverse = {}

--// [Do not go past this point]

for Index = 1, #Alphabet do
	Reverse[Alphabet:sub(Index, Index)] = Index - 1
end

local function ToBase64(Data)
	local Out = table.create(math.ceil(#Data / 3) * 4)
	local Index = 1
	while Index &lt;= #Data do
		local First = string.byte(Data, Index)
		local Second = string.byte(Data, Index + 1)
		local Third = string.byte(Data, Index + 2)
		local Number = First * 65536 + (Second or 0) * 256 + (Third or 0)

		local One = math.floor(Number / 262144) % 64
		local Two = math.floor(Number / 4096) % 64
		local Three = math.floor(Number / 64) % 64
		local Four = Number % 64

		table.insert(Out, Alphabet:sub(One + 1, One + 1))
		table.insert(Out, Alphabet:sub(Two + 1, Two + 1))
		table.insert(Out, Second and Alphabet:sub(Three + 1, Three + 1) or "=")
		table.insert(Out, Third and Alphabet:sub(Four + 1, Four + 1) or "=")
		Index += 3
	end
	return table.concat(Out)
end

local function FromBase64(Text)
	Text = Text:gsub("[^A-Za-z0-9+/=]", "")
	if #Text % 4 ~= 0 then
		return nil
	end

	local Out = table.create(#Text / 4 * 3)
	for Index = 1, #Text, 4 do
		local One = Reverse[Text:sub(Index, Index)]
		local Two = Reverse[Text:sub(Index + 1, Index + 1)]
		local Three = Reverse[Text:sub(Index + 2, Index + 2)]
		local Four = Reverse[Text:sub(Index + 3, Index + 3)]
		if not One or not Two then
			return nil
		end

		local Number = One * 262144 + Two * 4096 + (Three or 0) * 64 + (Four or 0)
		table.insert(Out, string.char(math.floor(Number / 65536) % 256))
		if Three then
			table.insert(Out, string.char(math.floor(Number / 256) % 256))
		end
		if Four then
			table.insert(Out, string.char(Number % 256))
		end
	end
	return table.concat(Out)
end

local function Compress(Input)
	local Dictionary = {}
	for Index = 0, 255 do
		Dictionary[string.char(Index)] = Index
	end

	local Size = 256
	local Codes, Word = {}, ""
	for Index = 1, #Input do
		local Char = Input:sub(Index, Index)
		local Joined = Word .. Char
		if Dictionary[Joined] then
			Word = Joined
		else
			table.insert(Codes, Dictionary[Word])
			if Size &lt; Ceiling then
				Dictionary[Joined] = Size
				Size += 1
			end
			Word = Char
		end
	end
	if Word ~= "" then
		table.insert(Codes, Dictionary[Word])
	end
	return Codes
end

local function Decompress(Codes)
	if #Codes == 0 then
		return ""
	end

	local Dictionary = table.create(Ceiling)
	for Index = 0, 255 do
		Dictionary[Index] = string.char(Index)
	end

	local Size = 256
	local Previous = Dictionary[Codes[1]]
	if not Previous then
		return nil
	end

	local Out = { Previous }
	for Index = 2, #Codes do
		local Code = Codes[Index]
		local Entry
		if Dictionary[Code] then
			Entry = Dictionary[Code]
		elseif Code == Size then
			Entry = Previous .. Previous:sub(1, 1)
		else
			return nil
		end
		table.insert(Out, Entry)
		if Size &lt; Ceiling then
			Dictionary[Size] = Previous .. Entry:sub(1, 1)
			Size += 1
		end
		Previous = Entry
	end
	return table.concat(Out)
end

local function Pack(Codes)
	local Out = table.create(#Codes)
	for _, Code in Codes do
		table.insert(Out, string.char(math.floor(Code / 256), Code % 256))
	end
	return table.concat(Out)
end

local function Unpack(Data)
	if #Data % 2 ~= 0 then
		return nil
	end
	local Codes = table.create(#Data / 2)
	for Index = 1, #Data - 1, 2 do
		table.insert(Codes, string.byte(Data, Index) * 256 + string.byte(Data, Index + 1))
	end
	return Codes
end

local HexDigits = "0123456789abcdef"

local function Hex8(Value: number): string
	local Digits = table.create(8)
	for Place = 8, 1, -1 do
		local Digit = Value % 16
		Digits[Place] = HexDigits:sub(Digit + 1, Digit + 1)
		Value = (Value - Digit) // 16
	end
	return table.concat(Digits)
end

local function Checksum(Text)
	local Sum = 5381
	for Index = 1, #Text do
		Sum = (Sum * 33 + string.byte(Text, Index)) % 4294967296
	end
	return Sum
end

local function BuildPayload(Name, Description, Values, Order, Version)
	local Lines = { "NAME\t" .. Name, "DESC\t" .. Description }

	if Version ~= nil and Version ~= "" then
		table.insert(Lines, "VER\t" .. tostring(Version))
	end
	for _, Path in Order do
		table.insert(Lines, "S\t" .. Path .. "\t" .. Values[Path])
	end
	return table.concat(Lines, "\n")
end

local Constructors = {
	["Color3.new"] = true,
	["Color3.fromRGB"] = true,
	["Color3.fromHSV"] = true,
	["Vector2.new"] = true,
	["Vector3.new"] = true,
	["UDim.new"] = true,
	["UDim2.new"] = true,
	["UDim2.fromScale"] = true,
	["UDim2.fromOffset"] = true,
	["NumberRange.new"] = true,
	["CFrame.new"] = true,
	["CFrame.Angles"] = true,
}

local function TopLevelPieces(Text)
	local Pieces, Depth, Start = {}, 0, 1
	for Index = 1, #Text do
		local Char = Text:sub(Index, Index)
		if Char == "(" then
			Depth += 1
		elseif Char == ")" then
			Depth -= 1
		elseif Char == "," and Depth == 0 then
			table.insert(Pieces, Text:sub(Start, Index - 1))
			Start = Index + 1
		end
	end
	table.insert(Pieces, Text:sub(Start))
	return Pieces
end

local IsLiteral
IsLiteral = function(Text)
	if type(Text) ~= "string" then
		return false
	end

	local Trimmed = Text:match("^%s*(.-)%s*$")
	if Trimmed == "" or #Trimmed &gt; 400 or Trimmed:find("[\n\r]") then
		return false
	end

	if tonumber(Trimmed) then
		return true
	end
	if Trimmed == "true" or Trimmed == "false" or Trimmed == "nil" then
		return true
	end
	if Trimmed:match('^"[^"\\]*"$') or Trimmed:match("^'[^'\\]*'$") then
		return true
	end
	if Trimmed:match("^Enum%.[%w_]+%.[%w_]+$") then
		return true
	end

	local Constructor, Arguments = Trimmed:match("^([%u][%w]*%.[%w]+)%(([%-%d%.%s,e]*)%)$")
	if Constructor and Constructors[Constructor] and not Arguments:find("%a%a") then
		return true
	end

	local Inner = Trimmed:match("^{(.*)}$")
	if Inner then
		if Inner:find("[{}]") then
			return false
		end
		if Inner:match("^%s*$") then
			return true
		end
		for _, Piece in TopLevelPieces(Inner) do
			if Piece:match("%S") then
				local Assigned = Piece:match("^%s*[%w_]+%s*=%s*(.+)$")
				if not IsLiteral(Assigned or Piece) then
					return false
				end
			end
		end
		return true
	end

	return false
end

PresetCodec.IsLiteral = IsLiteral

local function ReadPayload(Text)
	local Name, Description, Values, Version = nil, "", {}, nil
	local Count = 0
	for Line in Text:gmatch("([^\n]+)") do
		local Kind, Rest = Line:match("^(%u+)\t(.*)$")
		if Kind == "NAME" then
			Name = Rest
		elseif Kind == "DESC" then
			Description = Rest
		elseif Kind == "VER" then
			Version = Rest ~= "" and Rest or nil
		elseif Kind == "S" then
			local Path, Value = Rest:match("^([^\t]+)\t(.*)$")
			if Path and Value then
				Values[Path] = Value
				Count += 1
			end
		end
	end
	return Name, Description, Values, Count, Version
end

function PresetCodec.Encode(Name, Description, Values, Order, Version)
	local Payload = BuildPayload(Name, Description, Values, Order, Version)
	local Body = ToBase64(Pack(Compress(Payload)))
	return Marker .. ":" .. Hex8(Checksum(Payload)) .. ":" .. Body, #Payload, #Body
end

function PresetCodec.Decode(Text)
	if type(Text) ~= "string" then
		return nil, "nothing to read"
	end

	local Stamp, Body = Text:match(Marker .. ":(%x%x%x%x%x%x%x%x):([%w%+/=%s]+)")
	if not Stamp then
		return nil, "no preset code found in that text"
	end

	local Packed = FromBase64(Body)
	if not Packed then
		return nil, "the preset code is damaged"
	end

	local Codes = Unpack(Packed)
	if not Codes then
		return nil, "the preset code is damaged"
	end

	local Payload = Decompress(Codes)
	if not Payload then
		return nil, "the preset code is damaged"
	end

	if Hex8(Checksum(Payload)) ~= Stamp then
		return nil, "the preset code did not survive the trip, some of it is missing"
	end

	local Name, Description, Values, Count, Version = ReadPayload(Payload)
	if not Name or Name == "" then
		return nil, "that code carries no preset name"
	end

	for Path, Value in Values do
		if not Path:match("^[%w_%.%[%]]+$") then
			return nil, "that code names a setting oddly (" .. Path:sub(1, 40) .. "), refusing it"
		end
		if not IsLiteral(Value) then
			return nil, Path .. " carries something that is not a plain value, refusing it"
		end
	end

	return {
		Name = Name,
		Description = Description,
		Values = Values,
		Count = Count,
		Version = Version,
	}, nil
end

function PresetCodec.SelfTest(Name, Description, Values, Order, Version)
	local Code = PresetCodec.Encode(Name, Description, Values, Order, Version)
	local Back, Problem = PresetCodec.Decode(Code)
	if not Back then
		return false, Problem
	end
	if Back.Name ~= Name or Back.Description ~= Description then
		return false, "the name or notes did not come back"
	end
	if (Version ~= nil and Version ~= "") and Back.Version ~= tostring(Version) then
		return false, "the version did not come back"
	end
	for _, Path in Order do
		if Back.Values[Path] ~= Values[Path] then
			return false, Path .. " came back as \"" .. tostring(Back.Values[Path]) .. "\""
		end
	end
	for Path in Back.Values do
		if Values[Path] == nil then
			return false, Path .. " appeared out of nowhere"
		end
	end
	return true, nil
end

return PresetCodec
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX54">
      <Properties>
        <string name="Name">Presets</string>
        <ProtectedString name="Source">--// [Services]
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ScriptEditorService = game:GetService("ScriptEditorService")
local ServerStorage = game:GetService("ServerStorage")
local Selection = game:GetService("Selection")

--// [Modules]
local Content = require(script.Parent.Content)
local ConfigScanner = require(script.Parent.ConfigScanner)
local ConfigDefaults = require(script.Parent.ConfigDefaults)
local PresetCodec = require(script.Parent.PresetCodec)
local KitVersion = require(script.Parent.KitVersion)

--// [Variables]
local Presets = {}
local StoreKey = "UMSInstaller_Presets"
local Handle = nil

--// [Do not go past this point]

local function Trim(Text)
	return (Text or ""):match("^%s*(.-)%s*$")
end

local Counter = 0

local function NewId()
	Counter += 1
	return os.time() .. "-" .. Counter .. "-" .. math.random(100000, 999999)
end

local function StableId(Index, Entry)
	return "kept-" .. Index .. "-" .. tostring(Entry.Name)
end

local function IsAnimationSlot(Path)
	return Path:sub(-11) == "AnimationId"
end

local function IsAddon(Path)
	return Content.Library.For(Path:match("^[%w_]+")) ~= nil
end

local function Size(Map)
	local Total = 0
	for _ in Map do
		Total += 1
	end
	return Total
end

function Presets.Attach(PluginHandle)
	Handle = PluginHandle
	Presets.Migrate()
end

local function Pack(Values)
	local Pairs = {}
	for Path, Value in Values do
		table.insert(Pairs, { Path, Value })
	end
	table.sort(Pairs, function(Left, Right)
		return Left[1] &lt; Right[1]
	end)
	return Pairs
end

local function Unmangle(Map)
	local Module = ConfigScanner.Module()
	local Real = {}
	if Module then
		for _, Row in ConfigScanner.ScanAll(Module.Source) do
			Real[(Row.Path:gsub("%.", "_"))] = Row.Path
		end
	end
	local Values = {}
	for Key, Value in Map do
		Values[Real[Key] or Key] = Value
	end
	return Values
end

local function Unpack(Stored)
	if typeof(Stored) ~= "table" then
		return {}
	end
	if Stored[1] ~= nil then
		local Values = {}
		for _, Pair in Stored do
			if typeof(Pair) == "table" and typeof(Pair[1]) == "string" then
				Values[Pair[1]] = Pair[2]
			end
		end
		return Values
	end
	return Unmangle(Stored)
end

local function Convert(Entry)
	if Entry.Source and not Entry.Values then
		local Values = ConfigScanner.Values(Entry.Source)
		return {
			Id = Entry.Id,
			Name = Entry.Name,
			Description = Entry.Description,
			Values = Values,
			Count = Size(Values),
			Partial = false,
		}
	end
	Entry.Values = Unpack(Entry.Values)
	return Entry
end

local function Read()
	local Stored = Handle and Handle:GetSetting(StoreKey)
	if typeof(Stored) ~= "table" then
		return {}
	end
	local List = {}
	for Index, Entry in Stored do
		if typeof(Entry) == "table" and Entry.Name then
			local Row = Convert(Entry)
			Row.Id = Row.Id or StableId(Index, Row)
			List[Index] = Row
		end
	end
	return List
end

local function Write(List)
	if not Handle then
		return false, "no plugin handle"
	end
	local Packed = {}
	for Index, Entry in List do
		local Copy = table.clone(Entry)
		Copy.Values = Pack(Entry.Values or {})
		Packed[Index] = Copy
	end
	Handle:SetSetting(StoreKey, Packed)

	local Back = Handle:GetSetting(StoreKey)
	if typeof(Back) ~= "table" or #Back ~= #List then
		return false, "the change did not reach the plugin's saved settings, so nothing was kept"
	end
	for Index, Entry in List do
		local Mirror = Back[Index]
		if not Mirror or Mirror.Id ~= Entry.Id or Size(Unpack(Mirror.Values)) ~= Size(Entry.Values or {}) then
			return false, "the save came back changed, nothing was kept"
		end
	end
	return true, nil
end

local function Store(Entry)
	local List = Read()
	Entry.Id = Entry.Id or NewId()
	table.insert(List, Entry)
	local Ok, Problem = Write(List)
	return Ok, Problem
end

function Presets.Migrate()
	if not Handle then
		return false
	end
	local Stored = Handle:GetSetting(StoreKey)
	if typeof(Stored) ~= "table" then
		return false
	end
	local Stale = 0
	for _, Entry in Stored do
		if typeof(Entry) == "table" and Entry.Name then
			if not Entry.Id then
				Entry.Id = NewId()
				Stale += 1
			end
			if typeof(Entry.Values) == "table" and Entry.Values[1] == nil and next(Entry.Values) ~= nil then
				Stale += 1
			end
		end
	end
	if Stale == 0 then
		return false
	end
	local List = {}
	for Index, Entry in Stored do
		if typeof(Entry) == "table" and Entry.Name then
			List[Index] = Convert(Entry)
		end
	end
	return Write(List)
end

function Presets.List()
	return Read()
end

function Presets.Find(Id)
	for _, Entry in Read() do
		if Entry.Id == Id then
			return Entry
		end
	end
	return nil
end

function Presets.Save(Name, Description)
	Name = Trim(Name)
	if Name == "" then
		return false, "give it a name first"
	end

	local Module = ConfigScanner.Module()
	if not Module then
		return false, "MovementConfig not found in this place"
	end

	local Report = ConfigScanner.LeafSelfTest(Module.Source)
	if not Report.Trustworthy then
		return false, "the config does not read back cleanly, refusing to store it"
	end

	local Values = {}
	for _, Row in Report.Rows do
		Values[Row.Path] = Row.Raw
	end

	local Ok, Problem = Store({
		Name = Name,
		Description = Trim(Description),
		Values = Values,
		Count = Report.Count,
		Partial = false,
		Version = KitVersion.Live(),
	})
	if not Ok then
		return false, Problem
	end
	return true, "saved"
end

function Presets.Delete(Id)
	local List = Read()
	for Index, Entry in List do
		if Entry.Id == Id then
			table.remove(List, Index)
			return Write(List)
		end
	end
	return false, "that preset is not in the list any more"
end

function Presets.Backup(Module)
	local Copy = Module:Clone()
	Copy.Name = Module.Name .. "_BeforePreset"
	local Previous = ServerStorage:FindFirstChild(Copy.Name)
	if Previous then
		Previous.Parent = nil
	end
	Copy.Parent = ServerStorage
	return Copy
end

local function Rewrite(Source, Wanted)
	local Rows = ConfigScanner.ScanAll(Source)
	if #Rows == 0 then
		return nil, "nothing readable in the config"
	end

	local Values, Known = {}, {}
	for _, Row in Rows do
		Values[Row.Path] = Row.Raw
		Known[Row.Path] = true
	end

	local Changed, Unknown, Animations = 0, 0, 0
	for Path, Value in Wanted do
		if not Known[Path] then
			Unknown += 1
		elseif Values[Path] ~= Value then
			Values[Path] = Value
			Changed += 1
			if IsAnimationSlot(Path) then
				Animations += 1
			end
		end
	end

	local Candidate = ConfigScanner.Splice(Source, Rows, Values)

	local Check = ConfigScanner.ScanAll(Candidate)
	if #Check ~= #Rows then
		return nil, "the rewrite changed how many settings the file holds"
	end
	for Index, Row in Check do
		if Row.Path ~= Rows[Index].Path then
			return nil, "the rewrite moved " .. Rows[Index].Path
		end
	end

	local _, Before = Source:gsub("\n", "")
	local _, After = Candidate:gsub("\n", "")
	if Before ~= After then
		return nil, "the rewrite changed the line count"
	end

	if type(loadstring) == "function" then
		local Chunk = loadstring(Candidate)
		if not Chunk then
			return nil, "the rewrite would not compile, nothing was written"
		end
	end

	return Candidate, nil, Changed, Unknown, Animations
end

local Markers = {
	"loadstring", "getfenv", "setfenv", "getgenv", "_G.", "_G[", "GetService", "HttpService",
	"MarketplaceService", "TeleportService", "InsertService", "game.", "game:", "script.",
	"string.char", "string.reverse",
}

local Shapes = {
	{ Pattern = "require%s*%(%s*%d", Marker = "require(id)" },
	{ Pattern = "\\%d%d%d", Marker = "escaped bytes" },
	{ Pattern = "%f[%w_]function%f[^%w_]", Marker = "function" },
}

local function MarkersIn(Text)
	local Found = {}
	if type(Text) ~= "string" then
		return Found
	end
	for _, Marker in Markers do
		if Text:find(Marker, 1, true) then
			table.insert(Found, Marker)
		end
	end
	for _, Shape in Shapes do
		if Text:find(Shape.Pattern) then
			table.insert(Found, Shape.Marker)
		end
	end
	return Found
end

function Presets.Inspect(Values)
	local Findings = {}
	if type(Values) ~= "table" then
		return Findings
	end
	local Rows = {}
	for Path, Value in Values do
		table.insert(Rows, { Path = tostring(Path), Value = Value })
	end

	table.sort(Rows, function(Left, Right)
		return Left.Path &lt; Right.Path
	end)
	for _, Row in Rows do
		for _, Marker in MarkersIn(Row.Value) do
			table.insert(Findings, Row.Path .. ": " .. Marker)
		end
	end
	return Findings
end

function Presets.InspectSource(Text, OnlyLines)
	local Findings = {}
	if type(Text) ~= "string" then
		return Findings
	end
	local Line, Start = 1, 1
	while true do
		local Stop = Text:find("\n", Start, true)
		local Row = Text:sub(Start, (Stop or (#Text + 1)) - 1)
		if not OnlyLines or OnlyLines[Line] then
			for _, Marker in MarkersIn(Row) do
				table.insert(Findings, "line " .. Line .. ": " .. Marker)
			end
		end
		if not Stop then
			break
		end
		Start = Stop + 1
		Line += 1
	end
	return Findings
end

local function ChangedLines(Before, After)
	local Old = {}
	for Row in (Before .. "\n"):gmatch("([^\n]*)\n") do
		table.insert(Old, Row)
	end
	local Lines, Index = {}, 0
	for Row in (After .. "\n"):gmatch("([^\n]*)\n") do
		Index += 1
		if Row ~= Old[Index] then
			Lines[Index] = true
		end
	end
	return Lines
end

function Presets.Preview(Id)
	local Entry = Presets.Find(Id)
	local Module = ConfigScanner.Module()
	if not Entry or not Module then
		return 0, 0, 0, {}
	end
	local Findings = Presets.Inspect(Entry.Values)
	local _, Problem, Changed, Unknown, Animations = Rewrite(Module.Source, Entry.Values)

	if Problem then
		return 0, 0, 0, Findings, Problem
	end
	return Changed, Unknown, Animations, Findings, nil
end

function Presets.PreviewInsert(Id)
	local Entry = Presets.Find(Id)
	local Live = ConfigScanner.Module()
	if not Entry or not Live then
		return 0, 0, 0, {}
	end
	local Candidate, Problem, Changed, Unknown, Animations = Rewrite(Live.Source, Entry.Values)
	if not Candidate then
		return 0, 0, 0, Presets.Inspect(Entry.Values), Problem
	end
	local Findings = Presets.InspectSource(Candidate, ChangedLines(Live.Source, Candidate))
	return Changed, Unknown, Animations, Findings, nil
end

function Presets.Compatibility(Entry)
	local Live = KitVersion.Live()
	local Made = Entry and Entry.Version or nil
	return KitVersion.Compare(Made, Live), Made, Live
end

function Presets.Apply(Id)
	local Entry = Presets.Find(Id)
	if not Entry then
		return false, "that preset is not in the list any more"
	end

	local Module = ConfigScanner.Module()
	if not Module then
		return false, "MovementConfig not found in this place"
	end

	Presets.Backup(Module)

	local Recording = ChangeHistoryService:TryBeginRecording("UMSPreset", "Apply movement config preset")
	local Wrote, Reason, Changed, Unknown = false, "the write was refused", 0, 0

	ScriptEditorService:UpdateSourceAsync(Module, function(Old)
		local Candidate, Problem, Did, Missed = Rewrite(Old, Entry.Values)
		if not Candidate then
			Reason = Problem
			return nil
		end
		Wrote, Changed, Unknown = true, Did, Missed
		return Candidate
	end)

	if Recording then
		ChangeHistoryService:FinishRecording(Recording, Enum.FinishRecordingOperation.Commit)
	end

	if not Wrote then
		return false, Reason
	end

	for _ = 1, 60 do
		local Now = ConfigScanner.Values(Module.Source)
		local Settled = true
		for Path, Value in Entry.Values do
			if Now[Path] ~= nil and Now[Path] ~= Value then
				Settled = false
				break
			end
		end
		if Settled then
			break
		end
		task.wait(0.05)
	end

	if Unknown &gt; 0 then
		return true, "applied \"" .. Entry.Name .. "\", " .. Changed .. " settings changed, " .. Unknown .. " not in this config"
	end
	return true, "applied \"" .. Entry.Name .. "\", " .. Changed .. " settings changed"
end

function Presets.InsertTarget()
	local Chosen = Selection:Get()[1]
	if Chosen and not Chosen:IsA("LuaSourceContainer") then
		return Chosen
	end
	if Chosen and Chosen.Parent then
		return Chosen.Parent
	end
	return game:GetService("ReplicatedStorage")
end

function Presets.Insert(Id, Target)
	local Entry = Presets.Find(Id)
	if not Entry then
		return false, "that preset is not in the list any more"
	end

	local Live = ConfigScanner.Module()
	if not Live then
		return false, "MovementConfig not found in this place, so there is nothing to build from"
	end

	local Candidate, Problem = Rewrite(Live.Source, Entry.Values)
	if not Candidate then
		return false, Problem
	end

	local Where = Target or Presets.InsertTarget()
	local Recording = ChangeHistoryService:TryBeginRecording("UMSPresetInsert", "Insert movement config preset")

	local Module = Instance.new("ModuleScript")
	Module.Name = "MovementConfig"
	Module.Parent = Where
	ScriptEditorService:UpdateSourceAsync(Module, function()
		return Candidate
	end)
	Selection:Set({ Module })

	if Recording then
		ChangeHistoryService:FinishRecording(Recording, Enum.FinishRecordingOperation.Commit)
	end
	return true, "inserted " .. Module.Name .. " into " .. Where:GetFullName()
end

function Presets.Changed(Entry, IncludeAnimations)
	local Paths, Values = {}, {}
	for Path, Value in Entry.Values do
		local Default = ConfigDefaults.Values[Path]
		local Skip = (IsAnimationSlot(Path) and not IncludeAnimations) or IsAddon(Path)
		if not Skip and Default ~= Value then
			table.insert(Paths, Path)
			Values[Path] = Value
		end
	end

	table.sort(Paths)
	return Paths, Values
end

function Presets.Code(Id, IncludeAnimations)
	local Entry = Presets.Find(Id)
	if not Entry then
		return nil, "that preset is not in the list any more"
	end

	local Paths, Values = Presets.Changed(Entry, IncludeAnimations)
	if #Paths == 0 then
		return nil, "this preset matches the shipped defaults, there is nothing to share"
	end

	local Ok, Problem = PresetCodec.SelfTest(Entry.Name, Entry.Description, Values, Paths, Entry.Version)
	if not Ok then
		return nil, "the code did not survive its own round trip: " .. tostring(Problem)
	end

	local Code = PresetCodec.Encode(Entry.Name, Entry.Description, Values, Paths, Entry.Version)
	return Code, nil, #Paths
end

function Presets.Adopt(Text)
	local Read, Problem = PresetCodec.Decode(Text)
	if not Read then
		return false, nil, Problem
	end

	local Entry = {
		Name = Read.Name,
		Description = Read.Description,
		Values = Read.Values,
		Count = Read.Count,
		Partial = true,
		Version = Read.Version,
	}

	local Ok, Trouble = Store(Entry)
	if not Ok then
		return false, Read.Name, Trouble
	end
	return true, Read.Name, nil
end

return Presets
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX55">
      <Properties>
        <string name="Name">Requirements</string>
        <ProtectedString name="Source">--// [Services]
local RunService = game:GetService("RunService")

--// [Modules]
local Settings = require(script.Parent.Settings)
local Content = require(script.Parent.Content)
local ConfigScanner = require(script.Parent.ConfigScanner)
local KitVersion = require(script.Parent.KitVersion)

--// [Variables]
local Requirements = {}
local AcknowledgeKey = "UMSInstaller_BetaAcknowledged"
local PluginHandle = nil
local Aliases = {
	StarterPlayerScripts = { "StarterPlayer", "StarterPlayerScripts" },
	StarterCharacterScripts = { "StarterPlayer", "StarterCharacterScripts" },
	PlayerScripts = { "StarterPlayer", "StarterPlayerScripts" },
	CharacterScripts = { "StarterPlayer", "StarterCharacterScripts" },
}

--// [Do not go past this point]

function Requirements.Attach(Handle)
	PluginHandle = Handle
end

function Requirements.ResolvePath(Path)
	local Steps = Aliases[Path]
	if not Steps then
		Steps = {}
		for Piece in Path:gmatch("[^%.]+") do
			Steps[#Steps + 1] = Piece
		end
	end

	local Node = game
	for Index, Name in Steps do
		local Next = Node:FindFirstChild(Name)
		if Next == nil and Index == 1 then
			local Ok, Service = pcall(function()
				return game:GetService(Name)
			end)
			Next = Ok and Service or nil
		end
		if Next == nil then
			return nil, Name
		end
		Node = Next
	end
	return Node
end

function Requirements.FindPackage()
	local Wanted = Settings.Get("PackageName")
	local Prefix = Settings.Get("UngroupPrefix")

	local function Qualifies(Node)
		if Node.Name:sub(1, #Wanted) ~= Wanted then
			return false
		end
		for _, Child in Node:GetChildren() do
			if Child.Name:sub(1, #Prefix) == Prefix then
				return true
			end
		end
		return false
	end

	for _, ServiceName in Settings.Get("SearchIn") do
		local Container = Requirements.ResolvePath(ServiceName)
		if Container then
			for _, Child in Container:GetChildren() do
				if Qualifies(Child) then
					return Child
				end
			end
		end
	end
	return nil
end

function Requirements.Optionals(Package)
	local Prefix = Settings.Get("UngroupPrefix")
	local Found = {}
	if Package == nil then
		return Found
	end
	for _, Child in Package:GetChildren() do
		if Child.Name:sub(1, #Prefix) ~= Prefix then
			local Count = 0
			for _, Inner in Child:GetChildren() do
				if Inner.Name:sub(1, #Prefix) == Prefix then
					Count += 1
				end
			end
			if Count &gt; 0 then
				table.insert(Found, { Name = Child.Name, Group = Child, Count = Count })
			end
		end
	end
	return Found
end

local function Entry(Child, Prefix, Optional)
	local Path = Child.Name:sub(#Prefix + 1)
	local Target, Missing = Requirements.ResolvePath(Path)
	return {
		Source = Child,
		Path = Path,
		Target = Target,
		Missing = Missing,
		Count = #Child:GetChildren(),
		Optional = Optional,
	}
end

function Requirements.ReadPlan(Package, Extras)
	local Prefix = Settings.Get("UngroupPrefix")
	local Plan = {}
	if Package == nil then
		return Plan
	end

	for _, Child in Package:GetChildren() do
		if Child.Name:sub(1, #Prefix) == Prefix then
			Plan[#Plan + 1] = Entry(Child, Prefix, nil)
		end
	end
	for _, Optional in Requirements.Optionals(Package) do
		if Extras and Extras[Optional.Name] then
			for _, Child in Optional.Group:GetChildren() do
				if Child.Name:sub(1, #Prefix) == Prefix then
					Plan[#Plan + 1] = Entry(Child, Prefix, Optional.Group)
				end
			end
		end
	end
	return Plan
end

function Requirements.BetaAcknowledged()
	return PluginHandle ~= nil and PluginHandle:GetSetting(AcknowledgeKey) == true
end

function Requirements.AcknowledgeBeta(State)
	if PluginHandle then
		PluginHandle:SetSetting(AcknowledgeKey, State and true or false)
	end
end

function Requirements.Check()
	local Where = table.concat(Settings.Get("SearchIn"), ", ")
	local Results = {}

	Results[#Results + 1] = {
		Title = Content.Requirements.EditMode.Title,
		Detail = Content.Requirements.EditMode.Detail,
		Passed = not RunService:IsRunning(),
		Manual = false,
	}

	local Package = Requirements.FindPackage()
	local Plan = Requirements.ReadPlan(Package)
	local Unresolved = {}
	for _, Entry in Plan do
		if Entry.Target == nil then
			Unresolved[#Unresolved + 1] = Entry.Path
		end
	end

	local Installed = ConfigScanner.Module() ~= nil
	local Detail
	if Package then
		Detail = Content.Requirements.Package.Found(Package:GetFullName(), #Plan)
	elseif Installed then
		Detail = Content.Requirements.Package.Installed((KitVersion.Live()))
	else
		Detail = Content.Requirements.Package.Missing(Settings.Get("PackageName"), Settings.Get("UngroupPrefix"), Where)
	end
	Results[#Results + 1] = {
		Title = Content.Requirements.Package.Title(Settings.Get("PackageName"), Where),
		Detail = Detail,
		Passed = Installed or (Package ~= nil and #Plan &gt; 0),
		Manual = false,
	}

	if Package ~= nil and #Unresolved &gt; 0 then
		Results[#Results + 1] = {
			Title = Content.Requirements.Destinations.Title,
			Detail = Content.Requirements.Destinations.Detail(table.concat(Unresolved, ", ")),
			Passed = false,
			Manual = false,
		}
	end

	local SandboxRead, Sandboxed = pcall(function()
		return workspace.Sandboxed
	end)
	Results[#Results + 1] = {
		Title = Content.Requirements.Sandbox.Title,
		Detail = Content.Requirements.Sandbox.Detail,
		Passed = not SandboxRead or Sandboxed == false,
		Manual = false,
	}

	Results[#Results + 1] = {
		Title = Content.Requirements.Beta.Title,
		Detail = Content.Requirements.Beta.Detail,
		Passed = Requirements.BetaAcknowledged(),
		Manual = true,
	}

	return Results
end

function Requirements.Blocking(Results)
	local Failed = {}
	for _, Entry in Results do
		if not Entry.Passed then
			Failed[#Failed + 1] = Entry
		end
	end
	return Failed
end

return Requirements
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX56">
      <Properties>
        <string name="Name">Settings</string>
        <ProtectedString name="Source">--// [Variables]
local Settings = {}

--// [Do not go past this point]

Settings.Versions = {
	{ Value = "1", Label = "V1", PackageName = "Ultimate Movement System V1" },
}
Settings.Version = Settings.Versions[1]

Settings.PackageName = "Ultimate Movement System"
Settings.UngroupPrefix = "UNGROUP IN "
Settings.SearchIn = { "Workspace" }
Settings.ConfigPath = "ReplicatedStorage.Modules.Movement.MovementConfig"
Settings.AnimationFolderName = "UploadedAnimations"

Settings.InstalledSuffix = " (installed, safe to delete)"
Settings.AnimationSourceName = "Animations (Delete after use)"
Settings.AnimationRigs = { "R6", "R15" }
Settings.ExcludeSources = { "RBX_ANIMSAVES", "MoonAnimator2Saves" }

function Settings.Choose(Value)
	for _, Entry in Settings.Versions do
		if Entry.Value == Value then
			Settings.Version = Entry
			return Entry
		end
	end
	return nil
end

function Settings.Get(Key)
	local Own = Settings.Version[Key]
	if Own ~= nil then
		return Own
	end
	return Settings[Key]
end

return Settings
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX57">
      <Properties>
        <string name="Name">TabAbout</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)

--// [Variables]
local TabAbout = {}
local ReadableWidth = 900
local Margin = 24
local BarWidth = 4

--// [Do not go past this point]

function TabAbout.Build(Page)
	local Scroll = Instance.new("ScrollingFrame")
	Scroll.Name = "AboutScroll"
	Scroll.Size = UDim2.fromScale(1, 1)
	Scroll.BackgroundTransparency = 1
	Scroll.BorderSizePixel = 0
	Scroll.ScrollBarThickness = BarWidth
	Scroll.ScrollBarImageColor3 = Theme.MutedText
	Scroll.CanvasSize = UDim2.new()
	Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scroll.Parent = Page
	Theme.Padding(Scroll, Margin)

	local Column = Instance.new("Frame")
	Column.Name = "Column"
	Column.Size = UDim2.new(1, -(Margin * 2 + BarWidth), 0, 0)
	Column.AutomaticSize = Enum.AutomaticSize.Y
	Column.BackgroundTransparency = 1
	Column.Parent = Scroll

	local Cap = Instance.new("UISizeConstraint")
	Cap.MaxSize = Vector2.new(ReadableWidth, math.huge)
	Cap.Parent = Column

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0, 14)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Column

	for Index, Entry in Content.About do
		local Block = Instance.new("Frame")
		Block.Name = "Block" .. Index
		Block.LayoutOrder = Index
		Block.Size = UDim2.new(1, 0, 0, 0)
		Block.AutomaticSize = Enum.AutomaticSize.Y
		Block.BackgroundTransparency = 1
		Block.Parent = Column

		local BlockLayout = Instance.new("UIListLayout")
		BlockLayout.Padding = UDim.new(0, 5)
		BlockLayout.SortOrder = Enum.SortOrder.LayoutOrder
		BlockLayout.Parent = Block

		local Heading = Theme.Label(Entry.Heading, 15, Theme.Text, Theme.TitleFont)
		Heading.LayoutOrder = 1
		Heading.Size = UDim2.new(1, 0, 0, 0)
		Heading.AutomaticSize = Enum.AutomaticSize.Y
		Heading.Parent = Block

		local Body = Theme.Label(Entry.Body, 13, Theme.BodyText)
		Body.LayoutOrder = 2
		Body.Size = UDim2.new(1, 0, 0, 0)
		Body.AutomaticSize = Enum.AutomaticSize.Y
		Body.TextWrapped = true
		Body.TextYAlignment = Enum.TextYAlignment.Top
		Body.Parent = Block
	end

	return function() end
end

return TabAbout
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX58">
      <Properties>
        <string name="Name">TabApi</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local DocPage = require(script.Parent.DocPage)

--// [Variables]
local ApiDocs = Content.Api
local TabApi = {}

--// [Do not go past this point]

local function RowFor(Row)
	local Lines = {}
	table.insert(Lines, {
		Text = Row.Summary or Content.Api.NoEntryDoc,
		Size = 13,
		Colour = Row.Summary and Theme.BodyText or Theme.MutedText,
	})
	if Row.Accepts and Row.Accepts ~= "" then
		table.insert(Lines, { Text = Content.Api.Accepts(Row.Accepts), Size = 12, Colour = Theme.MutedText })
	end
	if Row.Note then
		table.insert(Lines, { Text = Row.Note, Size = 12, Colour = Theme.MutedText })
	end
	return {
		Key = Row.Key,
		Value = Row.Value,
		Lines = Lines,
		Code = Row.Code,
	}
end

local function EntryFor(Section)
	local Rows, Pieces = {}, { Section.Title, Section.Blurb or "", Section.Summary or "" }
	for _, Row in Section.Rows or {} do
		table.insert(Rows, RowFor(Row))
		table.insert(Pieces, Row.Key)
		table.insert(Pieces, Row.Summary or "")
	end
	return {
		Name = Section.Name,
		Title = Section.Title,
		Facts = Content.Api.Facts(ApiDocs.Count(Section)),
		Blurb = Section.Blurb,
		Haystack = table.concat(Pieces, " "),
		Summary = Section.Summary,
		Notes = Section.Notes,
		Groups = { { Rows = Rows } },
		Count = #Rows,
	}
end

function TabApi.Build(Page)
	local Doc = DocPage.New(Page, {
		GridTitle = Content.Api.GridTitle,
		Search = Content.Api.Search,
		Back = Content.Api.Back,
		Notes = Content.Api.Notes,
		ExpandHint = Content.Api.ExpandHint,
	})

	local Entries = {}
	for _, Section in ApiDocs.Sections do
		table.insert(Entries, EntryFor(Section))
	end

	local function Draw()
		local Shown = Doc.Draw(Entries)
		if Doc.Search.Text == "" then
			Doc.Status.Text = ApiDocs.Version
		else
			local Total = 0
			for _, Entry in Entries do
				Total += Entry.Count
			end
			Doc.Status.Text = Content.Api.Summary(Shown, #Entries, Total)
		end
	end

	local function Refresh()
		Draw()
		if not Doc.Reopen(Entries) then
			Doc.Close()
		end
	end

	Doc.Search:GetPropertyChangedSignal("Text"):Connect(Draw)
	Refresh()
	return Refresh
end

return TabApi
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX59">
      <Properties>
        <string name="Name">TabConfig</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local ConfigReader = require(script.Parent.ConfigReader)
local ConfigScanner = require(script.Parent.ConfigScanner)
local DocPage = require(script.Parent.DocPage)

--// [Variables]
local ConfigDocs = Content.Config.Blocks
local ConfigSettingDocs = Content.Config.Settings
local TabConfig = {}

--// [Do not go past this point]

local function RowFor(Setting, BlockName)
	local Doc = ConfigSettingDocs.For(BlockName .. "." .. Setting.Key) or Content.Library.Setting(BlockName, Setting.Key)
	local HasDoc = Doc ~= nil and Doc.Summary ~= nil and Doc.Summary ~= ""
	local Lines = {}

	if HasDoc then
		table.insert(Lines, { Text = Doc.Summary, Size = 15, Colour = Theme.BodyText })
	elseif Setting.Comment ~= "" then
		table.insert(Lines, { Text = Setting.Comment, Size = 15, Colour = Theme.BodyText })
	else
		table.insert(Lines, { Text = Content.Config.NoSettingDoc, Size = 15, Colour = Theme.MutedText })
	end
	if Doc and Doc.Accepts and Doc.Accepts ~= "" then
		table.insert(Lines, { Text = Content.Config.Accepts(Doc.Accepts), Size = 13, Colour = Theme.MutedText })
	end
	if HasDoc and Setting.Comment ~= "" then
		table.insert(Lines, { Text = Content.Config.OwnComment(Setting.Comment), Size = 13, Colour = Theme.MutedText })
	end

	return {
		Key = Setting.Key,
		Value = Setting.Value,
		Right = Content.Config.LinePrefix .. tostring(Setting.Line),
		Lines = Lines,
	}
end

local function EntryFor(Block)
	local Doc = ConfigDocs.For(Block.Name) or Content.Library.For(Block.Name)
	local Title = Doc and Doc.Title or ConfigDocs.Title(Block.Name)

	local Groups = {}
	for _, Section in Block.Order do
		local Rows = {}
		for _, Setting in Section.Settings do
			table.insert(Rows, RowFor(Setting, Block.Name))
		end
		table.insert(Groups, { Title = Section.Name, Rows = Rows })
	end

	return {
		Name = Block.Name,
		Title = Title,
		Facts = Content.Config.Facts(Block.Count),
		Blurb = Doc and (Doc.Blurb or Doc.Summary) or Content.Config.NoDoc,
		Haystack = Block.Name .. " " .. Title .. " " .. ((Doc and Doc.Summary) or ""),
		Where = Content.Config.Where(Block.Name, Block.Line, Block.LastLine or Block.Line),
		Summary = Doc and Doc.Summary or nil,
		Notes = Doc and Doc.Notes or nil,
		Groups = Groups,
		Count = Block.Count,
	}
end

function TabConfig.Build(Page)
	local Doc = DocPage.New(Page, {
		GridTitle = Content.Config.GridTitle,
		Search = Content.Config.Search,
		Back = Content.Config.Back,
		Notes = Content.Config.Notes,
		ExpandHint = Content.Config.ExpandHint,
	})

	local Entries = {}
	local Refresh

	local function Draw()
		if #Entries == 0 then
			Doc.Draw(Entries)
			Doc.Status.Text = Content.Config.NoConfig
			Doc.Status.TextColor3 = Theme.Warning
			return
		end
		local Shown = Doc.Draw(Entries)
		local Settings = 0
		for _, Entry in Entries do
			Settings += Entry.Count
		end
		Doc.Status.TextColor3 = Theme.MutedText
		Doc.Status.Text = Content.Config.Summary(Shown, #Entries, Settings)
	end

	local Watching, Watch = nil, nil
	local Waiting = false

	Refresh = function()
		Entries = {}
		for _, Block in ConfigReader.Read() or {} do
			table.insert(Entries, EntryFor(Block))
		end
		Draw()
		if not Doc.Reopen(Entries) then
			Doc.Close()
		end

		local Module = ConfigScanner.Module()
		if Module ~= Watching then
			if Watch then
				Watch:Disconnect()
				Watch = nil
			end
			Watching = Module
			if Module then
				Watch = Module:GetPropertyChangedSignal("Source"):Connect(function()

					if Waiting or not Page.Visible then
						return
					end
					Waiting = true
					task.delay(0.35, function()
						Waiting = false
						if Page.Visible then
							Refresh()
						end
					end)
				end)
			end
		end
	end

	Doc.Search:GetPropertyChangedSignal("Text"):Connect(Draw)
	Refresh()
	return Refresh
end

return TabConfig
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX60">
      <Properties>
        <string name="Name">TabInstall</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local Settings = require(script.Parent.Settings)
local Installer = require(script.Parent.Installer)
local Requirements = require(script.Parent.Requirements)
local KitVersion = require(script.Parent.KitVersion)
local AnimationPanel = require(script.Parent.AnimationPanel)

--// [Variables]
local TabInstall = {}

--// [Do not go past this point]

local function Button(Text, Width, Accent)
	return Theme.Button(Text, Width, 32, Accent)
end

local function Heading(Parent, Order, Text)
	local Label = Theme.Label(Text, 14, Theme.Text, Theme.TitleFont)
	Label.LayoutOrder = Order
	Label.Size = UDim2.new(1, -10, 0, 22)
	Label.Parent = Parent
	return Label
end

function TabInstall.Build(Page, PluginHandle)

	local Overwrite = true

	local Extras = {}

	local Scroll = Instance.new("ScrollingFrame")
	Scroll.Size = UDim2.new(1, 0, 1, -46)
	Scroll.BackgroundTransparency = 1
	Scroll.BorderSizePixel = 0
	Scroll.ScrollBarThickness = 4
	Scroll.ScrollBarImageColor3 = Theme.MutedText
	Scroll.CanvasSize = UDim2.new()
	Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scroll.Parent = Page
	Theme.Padding(Scroll, 16)

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0, 6)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Scroll

	local FolderHeading = Heading(Scroll, 1, Content.Install.FolderHeading)

	local PlanHolder = Instance.new("Frame")
	PlanHolder.Name = "Plan"
	PlanHolder.LayoutOrder = 3
	PlanHolder.Size = UDim2.new(1, -10, 0, 0)
	PlanHolder.AutomaticSize = Enum.AutomaticSize.Y
	PlanHolder.BackgroundTransparency = 1
	PlanHolder.Parent = Scroll

	local PlanLayout = Instance.new("UIListLayout")
	PlanLayout.Padding = UDim.new(0, 6)
	PlanLayout.SortOrder = Enum.SortOrder.LayoutOrder
	PlanLayout.Parent = PlanHolder

	local Mine = Theme.Checkbox(Content.Install.Overwrite, 240)
	Mine.LayoutOrder = 4
	Mine.Parent = Scroll
	Theme.SetChecked(Mine, Overwrite)

	local MineNote = Theme.Label(Content.Install.OverwriteNote, 12, Theme.MutedText)
	MineNote.LayoutOrder = 5
	MineNote.Size = UDim2.new(1, -10, 0, 0)
	MineNote.AutomaticSize = Enum.AutomaticSize.Y
	MineNote.TextWrapped = true
	MineNote.TextYAlignment = Enum.TextYAlignment.Top
	MineNote.Parent = Scroll

	local AnimationHeading = Heading(Scroll, 10, Content.Install.AnimationHeading)

	local Holder = Instance.new("Frame")
	Holder.LayoutOrder = 12
	Holder.Size = UDim2.new(1, -10, 0, 440)
	Holder.BackgroundTransparency = 1
	Holder.Parent = Scroll

	local Panel = AnimationPanel.New(Holder, PluginHandle, Page)

	local Footer = Instance.new("Frame")
	Footer.Size = UDim2.new(1, 0, 0, 46)
	Footer.Position = UDim2.new(0, 0, 1, -46)
	Footer.BackgroundColor3 = Theme.Panel
	Footer.BorderSizePixel = 0
	Footer.Parent = Page

	local Status = Theme.Label("", 12, Theme.MutedText)
	Status.Position = UDim2.new(0, 160, 0, 0)
	Status.Size = UDim2.new(1, -172, 1, 0)
	Status.TextWrapped = true
	Status.Parent = Footer

	Footer:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local Room = Footer.AbsoluteSize.X / Theme.ScaleOf(Footer) - 160
		Status.Visible = Room &gt; 120
	end)

	local Install = Button(Content.Install.Button, 132, true)
	Install.Position = UDim2.new(0, 16, 0.5, -16)
	Install.Parent = Footer

	local Confirm = Theme.Confirm(Page, 72, Content.Install.ReplaceYes, Content.Install.ReplaceNo)

	local function DrawPlan()
		for _, Child in PlanHolder:GetChildren() do
			if Child:IsA("Frame") then
				Child:Destroy()
			end
		end

		local Package, Plan = Installer.Preview(Extras)
		if not Package then

			local Done = Installer.Installed()
			FolderHeading.Visible = not Done
			PlanHolder.Visible = not Done
			AnimationHeading.Text = Done and Content.Install.AnimationHeadingOnly
				or Content.Install.AnimationHeading
			Status.Text = Done and Content.Install.AlreadyInstalled
				or Content.Install.NoPackage(Settings.Get("PackageName"), table.concat(Settings.SearchIn, ", "))
			Status.TextColor3 = Done and Theme.Success or Theme.Warning
			Install.Visible = false
			Mine.Visible = false
			MineNote.Visible = false
			return
		end
		FolderHeading.Visible = true
		PlanHolder.Visible = true
		AnimationHeading.Text = Content.Install.AnimationHeading
		Install.Visible = true

		local Colliding = Installer.CollisionCount(Plan)
		Mine.Visible = Colliding &gt; 0
		MineNote.Visible = Mine.Visible
		Theme.SetChecked(Mine, Overwrite)

		for Index, Entry in Plan do
			local Row = Instance.new("Frame")
			Row.LayoutOrder = Index
			Row.Size = UDim2.new(1, 0, 0, 40)
			Row.BackgroundColor3 = Theme.Panel
			Row.BorderSizePixel = 0
			Row.Parent = PlanHolder
			Theme.Stroke(Row, Entry.Target and Theme.Border or Theme.Danger)

			local Home = Entry.Optional and (Entry.Path .. ", from " .. Entry.Optional.Name) or Entry.Path
			local Where = Theme.Label(Home, 13, Entry.Target and Theme.Text or Theme.Danger, Theme.MediumFont)
			Where.Position = UDim2.new(0, 10, 0, 5)
			Where.Size = UDim2.new(1, -20, 0, 16)
			Where.Parent = Row

			local Detail = Content.Install.PlanUnresolved
			if Entry.Target then
				Detail = Content.Install.PlanRow(Entry.Count, #Entry.Collisions &gt; 0 and Content.Install.PlanCollides(#Entry.Collisions) or "")
			end
			local Info = Theme.Label(Detail, 12, Theme.MutedText)
			Info.Position = UDim2.new(0, 10, 0, 21)
			Info.Size = UDim2.new(1, -20, 0, 14)
			Info.Parent = Row
		end

		local Extra = #Plan
		for _, Optional in Requirements.Optionals(Package) do
			Extra += 1
			local Row = Instance.new("Frame")
			Row.LayoutOrder = Extra
			Row.Size = UDim2.new(1, 0, 0, 44)
			Row.BackgroundColor3 = Theme.Panel
			Row.BorderSizePixel = 0
			Row.Parent = PlanHolder
			Theme.Stroke(Row, Theme.Border)

			local Pretty = Optional.Name:gsub("_Optional$", ""):gsub("_", " ")
			local Tick = Theme.Checkbox(Content.Install.OptionalTick(Pretty), 300)
			Tick.Position = UDim2.new(0, 10, 0, 4)
			Tick.Size = UDim2.new(1, -20, 0, 20)
			Tick.Parent = Row
			Theme.SetChecked(Tick, Extras[Optional.Name] == true)
			Tick.Activated:Connect(function()
				Extras[Optional.Name] = not Extras[Optional.Name] or nil
				DrawPlan()
			end)

			local Info = Theme.Label(Content.Install.OptionalNote(Optional.Count), 12, Theme.MutedText)
			Info.Position = UDim2.new(0, 32, 0, 25)
			Info.Size = UDim2.new(1, -42, 0, 14)
			Info.Parent = Row
		end

		Status.Text = Content.Install.Ready(Package:GetFullName(), #Plan, Colliding)
		if Installer.Installed() then
			Status.Text = Status.Text .. "  |  " .. Content.Install.Versions((KitVersion.Live()), (KitVersion.Package(Package)))
		end
		Status.TextColor3 = Colliding &gt; 0 and Theme.Warning or Theme.Success
	end

	local function DrawAnimations()
		local Ok, Problem = Panel:Load()
		if not Ok then
			Panel.Summary.Text = Problem
			Panel.Summary.TextColor3 = Theme.Warning
			Panel.Rows = {}
		else
			Panel.Summary.TextColor3 = Theme.MutedText
		end
		Panel:Render()
	end

	local function RunInstall(Trailer)
		local Ok, Log = Installer.Run(Overwrite, Extras)
		if Trailer then
			table.insert(Log, Trailer)
		end
		Status.Text = table.concat(Log, "  |  ")
		Status.TextColor3 = Ok and Theme.Success or Theme.Warning
		DrawPlan()
		DrawAnimations()
	end

	local function AskThenInstall(Trailer)
		local Package = Installer.Preview(Extras)
		if not (Package and Installer.Installed()) then
			RunInstall(Trailer)
			return
		end

		local Have = KitVersion.Live()
		local Want = KitVersion.Package(Package)
		local Verdict = KitVersion.Compare(Have, Want)
		local Question = Content.Install.ReplaceUnknown
		if Verdict == "different" then
			Question = Content.Install.ReplaceDifferent(Have, Want)
		elseif Verdict == "same" then
			Question = Content.Install.ReplaceSame(Have)
		end

		Confirm.Show(Content.Install.ReplaceHeading, Question, function()
			RunInstall(Trailer)
		end)
	end

	Mine.Activated:Connect(function()
		Overwrite = not Overwrite
		DrawPlan()
	end)
	Install.Activated:Connect(function()
		AskThenInstall(nil)
	end)

	local function Refresh()

		if Panel.Busy then
			return
		end
		DrawPlan()
		DrawAnimations()
	end

	Refresh()
	return Refresh
end

return TabInstall
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX61">
      <Properties>
        <string name="Name">TabLibrary</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local DocPage = require(script.Parent.DocPage)
local Library = require(script.Parent.Library)

--// [Variables]
local TabLibrary = {}

--// [Do not go past this point]

local function RowFor(Row)
	local Lines = { { Text = Row.Summary, Size = 13, Colour = Theme.BodyText } }
	if Row.Note then
		table.insert(Lines, { Text = Row.Note, Size = 12, Colour = Theme.MutedText })
	end
	return {
		Key = Row.Key,
		Value = Row.Value,
		Lines = Lines,
		Code = Row.Code,
	}
end

local function SettingsGroup(Settings)
	local Keys = {}
	for Key in Settings do
		table.insert(Keys, Key)
	end
	table.sort(Keys)
	local Rows = {}
	for _, Key in Keys do
		table.insert(Rows, RowFor({ Key = Key, Value = Settings[Key].Accepts, Summary = Settings[Key].Summary }))
	end
	return { Title = Content.Library.SettingsTitle, Rows = Rows }
end

local function EntryFor(Entry, Plan, Action)
	local Groups, Pieces = {}, { Entry.Title, Entry.Blurb or "", Entry.Summary or "" }
	for _, Group in Entry.Groups or {} do
		local Rows = {}
		for _, Row in Group.Rows do
			table.insert(Rows, RowFor(Row))
			table.insert(Pieces, Row.Key)
			table.insert(Pieces, Row.Summary or "")
		end
		table.insert(Groups, { Title = Group.Title, Rows = Rows })
	end
	if Entry.Settings then
		local Group = SettingsGroup(Entry.Settings)
		for _, Row in Group.Rows do
			table.insert(Pieces, Row.Key)
		end
		table.insert(Groups, Group)
	end
	return {
		Name = Entry.Name,
		Title = Entry.Title,
		Facts = if Plan then Content.Library.Facts(Plan.Count) else Content.Library.BuiltIn,
		Blurb = Entry.Blurb,
		Haystack = table.concat(Pieces, " "),
		Summary = Entry.Summary,
		Notes = Entry.Notes,
		Groups = Groups,
		Action = Action,
	}
end

function TabLibrary.Build(Page)
	local Doc = DocPage.New(Page, {
		GridTitle = Content.Library.GridTitle,
		Search = Content.Library.Search,
		Back = Content.Library.Back,
		Notes = Content.Library.Notes,
		ExpandHint = Content.Library.ExpandHint,
	})

	local InsertConfirm = Theme.Confirm(Page, 84, Content.Library.InsertYes, Content.Library.ConfirmNo)
	local RemoveConfirm = Theme.Confirm(Page, 84, Content.Library.RemoveYes, Content.Library.ConfirmNo)
	local Done = Theme.Notice(Page, 86, Content.Library.DoneClose)
	local Refresh

	local function Run(Entry)
		local Plan = Library.Plan(Entry.Name)
		if Plan.Problem then
			Done.Show(Content.Library.FailedTitle, Plan.Problem)
			return
		end
		local Removing = Plan.Present
		local Confirm = if Removing then RemoveConfirm else InsertConfirm
		local Title = if Removing then Content.Library.RemoveTitle(Entry.Title) else Content.Library.InsertTitle(Entry.Title)
		local Warning = if #Plan.Warnings &gt; 0 then table.concat(Plan.Warnings, "\n") else nil
		Confirm.Show(Title, table.concat(Plan.Lines, "\n"), function()
			local Change = if Removing then Library.Remove else Library.Insert
			local Ok, Said = Change(Plan)
			if Ok then
				Done.Show(if Removing then Content.Library.RemovedTitle else Content.Library.DoneTitle, table.concat(Said, "\n"))
			else
				Done.Show(Content.Library.FailedTitle, Said)
			end
			Refresh()
		end, Warning)
	end

	local InsertAction = { Text = Content.Library.Insert, Run = Run }
	local RemoveAction = { Text = Content.Library.Remove, Run = Run }

	local Entries = {}
	local function Draw()
		local Shown = Doc.Draw(Entries)
		if Doc.Search.Text == "" then
			Doc.Status.Text = Content.Library.Status
		else
			Doc.Status.Text = Content.Library.Summary(Shown, #Entries)
		end
	end

	Refresh = function()
		table.clear(Entries)
		for _, Entry in Content.Library.Entries do
			local Plan = Library.Plan(Entry.Name)
			local Action = if not Plan then nil elseif Plan.Present then RemoveAction else InsertAction
			table.insert(Entries, EntryFor(Entry, Plan, Action))
		end
		Draw()
		if not Doc.Reopen(Entries) then
			Doc.Close()
		end
	end

	Doc.Search:GetPropertyChangedSignal("Text"):Connect(Draw)
	Refresh()
	return Refresh
end

return TabLibrary
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX62">
      <Properties>
        <string name="Name">TabPresets</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)
local Content = require(script.Parent.Content)
local Presets = require(script.Parent.Presets)

--// [Variables]
local TabPresets = {}
local CardWidth = 306
local CardHeight = 124

--// [Do not go past this point]

local function Field(Parent, Placeholder, Width, Order)
	local Box = Instance.new("TextBox")
	Box.LayoutOrder = Order
	Box.Size = UDim2.fromOffset(Width, 28)
	Box.BackgroundColor3 = Theme.Raised
	Box.BorderSizePixel = 0
	Box.Font = Theme.BodyFont
	Box.TextSize = Theme.Size(13)
	Box.TextColor3 = Theme.Text
	Box.PlaceholderText = Placeholder
	Box.PlaceholderColor3 = Theme.MutedText
	Box.Text = ""
	Box.ClearTextOnFocus = false
	Box.TextXAlignment = Enum.TextXAlignment.Left
	Box.Parent = Parent
	Theme.Stroke(Box)
	Theme.Padding(Box, 6)
	return Box
end

local function Chip(Text, Width, Order, Accent)
	local Button = Theme.Button(Text, Width, 28, Accent)
	Button.LayoutOrder = Order
	return Button
end

local function CodeBox(Parent, Layer, Editable)
	local Scroll = Instance.new("ScrollingFrame")
	Scroll.Size = UDim2.fromScale(1, 1)
	Scroll.BackgroundColor3 = Theme.Background
	Scroll.BorderSizePixel = 0
	Scroll.ScrollBarThickness = 5
	Scroll.ScrollBarImageColor3 = Theme.MutedText
	Scroll.CanvasSize = UDim2.new()
	Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scroll.ZIndex = Layer
	Scroll.Parent = Parent
	Theme.Stroke(Scroll)
	Theme.Padding(Scroll, 8)

	local Box = Instance.new("TextBox")
	Box.Size = UDim2.new(1, -21, 1, -16)
	Box.AutomaticSize = Enum.AutomaticSize.Y
	Box.BackgroundTransparency = 1
	Box.BorderSizePixel = 0
	Box.MultiLine = true
	Box.ClearTextOnFocus = false
	Box.TextEditable = Editable ~= false
	Box.TextWrapped = true
	Box.Font = Enum.Font.Code
	Box.TextSize = Theme.Size(12)
	Box.TextColor3 = Theme.Text
	Box.PlaceholderColor3 = Theme.MutedText
	Box.Text = ""
	Box.TextXAlignment = Enum.TextXAlignment.Left
	Box.TextYAlignment = Enum.TextYAlignment.Top
	Box.ZIndex = Layer + 1
	Box.Parent = Scroll

	Scroll.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 and Editable ~= false then
			Box:CaptureFocus()
		end
	end)

	return Box
end

function TabPresets.Build(Page, PluginHandle)
	Presets.Attach(PluginHandle)

	local Bar = Instance.new("Frame")
	Bar.Size = UDim2.new(1, -32, 0, 30)
	Bar.Position = UDim2.fromOffset(16, 14)
	Bar.BackgroundTransparency = 1
	Bar.Parent = Page

	local BarLayout = Instance.new("UIListLayout")
	BarLayout.FillDirection = Enum.FillDirection.Horizontal
	BarLayout.Padding = UDim.new(0, 6)
	BarLayout.SortOrder = Enum.SortOrder.LayoutOrder
	BarLayout.Parent = Bar

	local NameBox = Field(Bar, Content.Presets.NamePlaceholder, 190, 1)
	NameBox.Size = UDim2.new(0.24, 0, 0, 28)
	local NoteBox = Field(Bar, Content.Presets.NotePlaceholder, 330, 2)
	NoteBox.Size = UDim2.new(0.3, 0, 0, 28)

	local Save = Chip(Content.Presets.Save, 120, 3, true)
	Save.Parent = Bar

	local Paste = Chip(Content.Presets.Paste, 130, 4, false)
	Paste.Parent = Bar

	local Status = Theme.Label("", 12, Theme.MutedText)
	Status.Position = UDim2.fromOffset(16, 48)
	Status.Size = UDim2.new(1, -32, 0, 16)
	Status.TextTruncate = Enum.TextTruncate.AtEnd
	Status.Parent = Page

	local Shell, Pane = Theme.Group(Page, Content.Presets.GridTitle)
	Shell.Position = UDim2.fromOffset(16, 78)
	Shell.Size = UDim2.new(1, -32, 1, -94)

	local Grid = Instance.new("ScrollingFrame")
	Grid.Size = UDim2.fromScale(1, 1)
	Grid.BackgroundTransparency = 1
	Grid.BorderSizePixel = 0
	Grid.ScrollBarThickness = 4
	Grid.ScrollBarImageColor3 = Theme.MutedText
	Grid.CanvasSize = UDim2.new()
	Grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Grid.Parent = Pane
	Theme.ScrollInset(Grid, 5)

	local GridLayout = Instance.new("UIGridLayout")
	GridLayout.CellSize = UDim2.fromOffset(CardWidth, CardHeight)
	GridLayout.CellPadding = UDim2.fromOffset(12, 12)
	GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	GridLayout.Parent = Grid

	local function Say(Text, Colour)
		Status.Text = Text
		Status.TextColor3 = Colour or Theme.MutedText
	end

	local Share = Theme.Sheet(Page, 30, Content.Presets.ShareTitle)
	local ShareFor = nil
	local WithAnimations = false

	local Animations = Theme.Checkbox(Content.Presets.IncludeAnimations, 220)
	Animations.Position = UDim2.fromOffset(0, 0)
	Animations.ZIndex = Share.Layer + 3
	Animations.Parent = Share.Body

	local Facts = Theme.Label("", 11, Theme.MutedText)
	Facts.Position = UDim2.fromOffset(230, 0)
	Facts.Size = UDim2.new(1, -230, 0, 22)
	Facts.ZIndex = Share.Layer + 3
	Facts.Parent = Share.Body

	local Holder = Instance.new("Frame")
	Holder.Position = UDim2.fromOffset(0, 30)
	Holder.Size = UDim2.new(1, 0, 1, -66)
	Holder.BackgroundTransparency = 1
	Holder.ZIndex = Share.Layer + 3
	Holder.Parent = Share.Body

	local CodeOut = CodeBox(Holder, Share.Layer + 4, true)

	local Hint = Theme.Label(Content.Presets.CopyHint, 11, Theme.MutedText)
	Hint.Position = UDim2.new(0, 120, 1, -32)
	Hint.Size = UDim2.new(1, -120, 0, 32)
	Hint.TextWrapped = true
	Hint.ZIndex = Share.Layer + 3
	Hint.Parent = Share.Body

	local SelectAll = Theme.Button(Content.Presets.SelectAll, 110, 26, true)
	SelectAll.Position = UDim2.new(0, 0, 1, -28)
	SelectAll.ZIndex = Share.Layer + 3
	SelectAll.Parent = Share.Body

	local function HighlightCode()
		if CodeOut.Text == "" then
			return
		end
		CodeOut:CaptureFocus()
		task.defer(function()
			CodeOut.CursorPosition = #CodeOut.Text + 1
			CodeOut.SelectionStart = 1
		end)
	end

	local function DrawCode()
		if not ShareFor then
			return
		end
		local Code, Problem, Changed = Presets.Code(ShareFor, WithAnimations)
		Theme.SetChecked(Animations, WithAnimations)
		if not Code then
			CodeOut.Text = ""
			Facts.Text = tostring(Problem)
			Facts.TextColor3 = Theme.Warning
			return
		end
		CodeOut.Text = Code
		Facts.Text = Content.Presets.CodeFacts(Changed, #Code)
		Facts.TextColor3 = #Code &gt; 1900 and Theme.Warning or Theme.MutedText
	end

	Animations.Activated:Connect(function()
		WithAnimations = not WithAnimations
		DrawCode()
	end)
	SelectAll.Activated:Connect(HighlightCode)

	local Paster = Theme.Sheet(Page, 34, Content.Presets.PasteTitle)

	local PasteHint = Theme.Label(Content.Presets.PasteHint, 12, Theme.MutedText)
	PasteHint.Position = UDim2.fromOffset(0, 0)
	PasteHint.Size = UDim2.new(1, 0, 0, 20)
	PasteHint.TextWrapped = true
	PasteHint.ZIndex = Paster.Layer + 3
	PasteHint.Parent = Paster.Body

	local PasteHolder = Instance.new("Frame")
	PasteHolder.Position = UDim2.fromOffset(0, 26)
	PasteHolder.Size = UDim2.new(1, 0, 1, -62)
	PasteHolder.BackgroundTransparency = 1
	PasteHolder.ZIndex = Paster.Layer + 3
	PasteHolder.Parent = Paster.Body

	local CodeIn = CodeBox(PasteHolder, Paster.Layer + 4, true)
	CodeIn.PlaceholderText = Content.Presets.PastePlaceholder

	local ReadIt = Theme.Button(Content.Presets.ReadIt, 120, 28, true)
	ReadIt.Position = UDim2.new(0, 0, 1, -30)
	ReadIt.ZIndex = Paster.Layer + 3
	ReadIt.Parent = Paster.Body

	local PasteSaid = Theme.Label("", 12, Theme.MutedText)
	PasteSaid.Position = UDim2.new(0, 130, 1, -30)
	PasteSaid.Size = UDim2.new(1, -130, 0, 28)
	PasteSaid.TextWrapped = true
	PasteSaid.ZIndex = Paster.Layer + 3
	PasteSaid.Parent = Paster.Body

	local Refresh

	ReadIt.Activated:Connect(function()
		local Ok, Name, Problem = Presets.Adopt(CodeIn.Text)
		if Ok then
			PasteSaid.Text = Content.Presets.Imported(Name)
			PasteSaid.TextColor3 = Theme.Success
			CodeIn.Text = ""
			Say(Content.Presets.Imported(Name), Theme.Success)
			Refresh()
		else
			PasteSaid.Text = tostring(Problem)
			PasteSaid.TextColor3 = Theme.Danger
		end
	end)

	Paste.Activated:Connect(function()
		CodeIn.Text = ""
		PasteSaid.Text = ""
		Paster.Show()
	end)

	local Sure = Theme.Confirm(Page, 78, Content.Presets.DeleteYes, Content.Presets.DeleteNo)
	local Change = Theme.Confirm(Page, 80, Content.Presets.ReplaceYes, Content.Presets.ConfirmNo)
	local Add = Theme.Confirm(Page, 82, Content.Presets.InsertYes, Content.Presets.ConfirmNo)

	local function Describe(Entry, Summary, Findings)
		local Lines = { Summary }
		local Verdict, Made, Live = Presets.Compatibility(Entry)
		if Verdict == "same" then
			table.insert(Lines, Content.Presets.VersionSame(tostring(Made)))
		elseif Verdict == "different" then
			table.insert(Lines, Content.Presets.VersionDifferent(tostring(Made), tostring(Live)))
		else
			table.insert(Lines, Content.Presets.VersionUnknown)
		end

		local Warning = nil
		if #Findings &gt; 0 then
			local Named = {}
			for Index = 1, math.min(#Findings, 6) do
				table.insert(Named, Findings[Index])
			end
			local Listed = table.concat(Named, ", ")
			if #Findings &gt; 6 then
				Listed ..= Content.Presets.CodeWarningMore(#Findings - 6)
			end
			Warning = Content.Presets.CodeWarning(Listed)
		end
		return table.concat(Lines, "\n"), Warning
	end

	local function Card(Entry, Order)
		local Frame = Instance.new("Frame")
		Frame.LayoutOrder = Order
		Frame.BackgroundColor3 = Theme.Panel
		Frame.BorderSizePixel = 0
		Frame.Parent = Grid
		Theme.Stroke(Frame, Theme.CardEdge)

		local Title = Theme.Label(Entry.Name, 14, Theme.Accent, Theme.TitleFont)
		Title.Position = UDim2.fromOffset(12, 9)
		Title.Size = UDim2.new(1, -42, 0, 18)
		Title.TextTruncate = Enum.TextTruncate.AtEnd
		Title.Parent = Frame

		local Bin = Theme.TrashButton(Frame, 16)
		Bin.AnchorPoint = Vector2.new(1, 0)
		Bin.Position = UDim2.new(1, -10, 0, 10)
		Bin.Activated:Connect(function()
			Sure.Show(
				Content.Presets.DeleteTitle(Entry.Name),
				Content.Presets.DeleteBody(Entry.Name),
				function()
					local Ok, Problem = Presets.Delete(Entry.Id)
					Say(Ok and Content.Presets.Deleted(Entry.Name) or tostring(Problem),
						Ok and Theme.MutedText or Theme.Danger)
					Refresh()
				end)
		end)

		local Note = Theme.Label(Entry.Description ~= "" and Entry.Description or Content.Presets.NoNote,
			12, Theme.MutedText)
		Note.Position = UDim2.fromOffset(12, 29)
		Note.Size = UDim2.new(1, -24, 0, 32)
		Note.TextWrapped = true
		Note.TextYAlignment = Enum.TextYAlignment.Top
		Note.Parent = Frame

		local Scope = Entry.Partial and Content.Presets.PartialFacts or Content.Presets.FullFacts
		local Made = Entry.Version
			and Content.Presets.MadeOn(tostring(Entry.Version))
			or Content.Presets.MadeOnUnknown
		local Reach = Theme.Label(Scope(Entry.Count or 0) .. "  |  " .. Made,
			11, Theme.MutedText)
		Reach.Position = UDim2.fromOffset(12, 64)
		Reach.Size = UDim2.new(1, -24, 0, 14)
		Reach.Parent = Frame

		local Row = Instance.new("Frame")
		Row.Position = UDim2.fromOffset(12, 84)
		Row.Size = UDim2.new(1, -24, 0, 24)
		Row.BackgroundTransparency = 1
		Row.Parent = Frame

		local RowLayout = Instance.new("UIListLayout")
		RowLayout.FillDirection = Enum.FillDirection.Horizontal
		RowLayout.Padding = UDim.new(0, 5)
		RowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		RowLayout.Parent = Row

		local function Small(Text, Width, Order, Accent)
			local Button = Theme.Button(Text, Width, 24, Accent)
			Button.TextSize = Theme.Size(11)
			Button.LayoutOrder = Order
			Button.Parent = Row
			return Button
		end

		local Replace = Small(Content.Presets.Replace, 92, 1, true)
		Replace.Activated:Connect(function()
			local Changed, Unknown, Animations, Findings, Refused = Presets.Preview(Entry.Id)

			local Summary = Refused
				and Content.Presets.RefusedFacts(tostring(Refused))
				or Content.Presets.ReplaceFacts(Changed, Animations, Unknown)
			local Body, Warning = Describe(Entry, Summary, Findings)
			Change.Show(Content.Presets.ReplaceTitle(Entry.Name), Body, function()
				local Ok, Problem = Presets.Apply(Entry.Id)
				Say(tostring(Problem), Ok and Theme.Success or Theme.Danger)
				Refresh()
			end, Warning)
		end)

		local Insert = Small(Content.Presets.Insert, 76, 2)
		Insert.Activated:Connect(function()

			local Where = Presets.InsertTarget()
			local Changed, Unknown, Animations, Findings, Refused = Presets.PreviewInsert(Entry.Id)
			local Summary = Refused
				and Content.Presets.RefusedFacts(tostring(Refused))
				or Content.Presets.InsertFacts(Changed, Animations, Unknown, Where:GetFullName())
			local Body, Warning = Describe(Entry, Summary, Findings)
			Add.Show(Content.Presets.InsertTitle(Entry.Name), Body, function()
				local Ok, Problem = Presets.Insert(Entry.Id, Where)
				Say(tostring(Problem), Ok and Theme.Success or Theme.Danger)
			end, Warning)
		end)

		local Send = Small(Content.Presets.Share, 60, 3)
		Send.Activated:Connect(function()
			ShareFor = Entry.Id
			WithAnimations = false
			Share.Heading.Text = Content.Presets.ShareOne(Entry.Name)
			DrawCode()
			Share.Show()
			HighlightCode()
		end)
	end

	Refresh = function()
		for _, Child in Grid:GetChildren() do
			if Child:IsA("Frame") then
				Child:Destroy()
			end
		end
		local List = Presets.List()
		for Index, Entry in List do
			Card(Entry, Index)
		end
		if #List == 0 and Status.Text == "" then
			Say(Content.Presets.Empty)
		end
	end

	Save.Activated:Connect(function()
		local Ok, Problem = Presets.Save(NameBox.Text, NoteBox.Text)
		if Ok then
			Say(Content.Presets.Saved(NameBox.Text, Problem), Theme.Success)
			NameBox.Text = ""
			NoteBox.Text = ""
		else
			Say(tostring(Problem), Theme.Danger)
		end
		Refresh()
	end)

	Refresh()
	return Refresh
end

return TabPresets
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX63">
      <Properties>
        <string name="Name">Tabs</string>
        <ProtectedString name="Source">--// [Modules]
local Theme = require(script.Parent.Theme)

--// [Variables]
local Tabs = {}

--// [Do not go past this point]

Tabs.__index = Tabs

local BarHeight = 36

function Tabs.New(Parent, Names)
	local self = setmetatable({}, Tabs)
	self.Buttons = {}
	self.Pages = {}
	self.Refreshers = {}
	self.Order = Names
	self.Active = nil

	local Root = Instance.new("Frame")
	Root.Name = "Tabs"
	Root.Position = UDim2.fromOffset(0, 0)
	Root.Size = UDim2.fromScale(1, 1)
	Root.BackgroundTransparency = 1
	Root.ClipsDescendants = true
	Root.Visible = false
	Root.Parent = Parent
	self.Root = Root

	local Bar = Instance.new("Frame")
	Bar.Name = "Bar"
	Bar.Position = UDim2.fromOffset(0, 0)
	Bar.Size = UDim2.new(1, 0, 0, BarHeight)
	Bar.BackgroundColor3 = Theme.Background
	Bar.BorderSizePixel = 0
	Bar.ClipsDescendants = true
	Bar.Parent = Root

	local Underline = Instance.new("Frame")
	Underline.Name = "Underline"
	Underline.Size = UDim2.new(1, 0, 0, 1)
	Underline.Position = UDim2.new(0, 0, 0, BarHeight - 1)
	Underline.BackgroundColor3 = Theme.Border
	Underline.BorderSizePixel = 0
	Underline.ZIndex = 2
	Underline.Parent = Root

	local Layout = Instance.new("UIListLayout")
	Layout.FillDirection = Enum.FillDirection.Horizontal
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Bar

	local Body = Instance.new("Frame")
	Body.Name = "Body"
	Body.Position = UDim2.new(0, 0, 0, BarHeight)
	Body.Size = UDim2.new(1, 0, 1, -BarHeight)
	Body.BackgroundTransparency = 1
	Body.Parent = Root
	self.Body = Body

	for Index, Name in Names do
		local Button = Instance.new("TextButton")
		Button.Name = Name
		Button.LayoutOrder = Index
		Button.Size = UDim2.fromOffset(110, BarHeight)
		Button.BackgroundTransparency = 1
		Button.BackgroundColor3 = Theme.Panel
		Button.BorderSizePixel = 0
		Button.Text = Name
		Button.TextSize = Theme.Size(13)
		Button.Font = Theme.MediumFont
		Button.TextColor3 = Theme.MutedText
		Button.AutoButtonColor = false
		Button.Parent = Bar

		local Marker = Instance.new("Frame")
		Marker.Name = "Marker"
		Marker.Size = UDim2.new(1, 0, 0, 2)
		Marker.Position = UDim2.new(0, 0, 1, -2)
		Marker.BackgroundColor3 = Theme.Accent
		Marker.BorderSizePixel = 0
		Marker.Visible = false
		Marker.ZIndex = 2
		Marker.Parent = Button

		local Page = Instance.new("Frame")
		Page.Name = Name .. "Page"
		Page.Size = UDim2.fromScale(1, 1)
		Page.BackgroundTransparency = 1
		Page.Visible = false
		Page.Parent = Body

		self.Buttons[Name] = Button
		self.Pages[Name] = Page

		Button.MouseEnter:Connect(function()
			if self.Active ~= Name then
				Button.TextColor3 = Theme.Accent
			end
		end)
		Button.MouseLeave:Connect(function()
			if self.Active ~= Name then
				Button.TextColor3 = Theme.MutedText
			end
		end)
		Button.Activated:Connect(function()
			self:Select(Name)
		end)
	end

	return self
end

function Tabs:SetRefresh(Name, Fn)
	self.Refreshers[Name] = Fn
end

function Tabs:Select(Name)
	if self.Pages[Name] == nil then return end
	self.Active = Name
	for Other, Button in self.Buttons do
		local IsActive = Other == Name
		Button.BackgroundTransparency = IsActive and 0 or 1
		Button.BackgroundColor3 = Theme.Panel
		Button.TextColor3 = IsActive and Theme.Accent or Theme.MutedText
		Button.Font = IsActive and Theme.TitleFont or Theme.MediumFont
		Button.Marker.Visible = IsActive
		self.Pages[Other].Visible = IsActive
	end

	local Refresh = self.Refreshers[Name]
	if Refresh then
		local Ok, Problem = pcall(Refresh)
		if not Ok then
			warn("[Ultimate Movement System Installer] " .. Name .. " tab: " .. tostring(Problem))
		end
	end
end

function Tabs:Page(Name)
	return self.Pages[Name]
end

function Tabs:Show()
	self.Root.Visible = true
	self:Select(self.Active or self.Order[1])
end

function Tabs:Hide()
	self.Root.Visible = false
end

function Tabs:Destroy()
	self.Root:Destroy()
end

return Tabs
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX64">
      <Properties>
        <string name="Name">Theme</string>
        <ProtectedString name="Source">--// [Variables]
local Theme = {}

--// [Do not go past this point]

Theme.Background = Color3.fromRGB(46, 46, 46)
Theme.Panel = Color3.fromRGB(37, 37, 37)
Theme.Raised = Color3.fromRGB(56, 56, 56)
Theme.Hover = Color3.fromRGB(66, 66, 66)
Theme.Border = Color3.fromRGB(26, 26, 26)
Theme.CardEdge = Color3.fromRGB(26, 26, 26)

Theme.Accent = Color3.fromRGB(240, 130, 20)
Theme.AccentHover = Color3.fromRGB(255, 155, 60)
Theme.AccentPressed = Color3.fromRGB(200, 100, 10)
Theme.AccentFill = Color3.fromRGB(90, 55, 25)
Theme.AccentInk = Color3.fromRGB(20, 20, 20)

Theme.Text = Color3.fromRGB(234, 234, 234)
Theme.BodyText = Color3.fromRGB(218, 218, 218)
Theme.MutedText = Color3.fromRGB(178, 178, 178)
Theme.Danger = Color3.fromRGB(214, 104, 96)
Theme.Success = Color3.fromRGB(124, 186, 110)
Theme.Warning = Color3.fromRGB(220, 176, 84)

Theme.TitleFont = Enum.Font.SourceSansSemibold
Theme.BodyFont = Enum.Font.SourceSans
Theme.MediumFont = Enum.Font.SourceSans

Theme.Sizes = { [10] = 13, [11] = 13, [12] = 14, [13] = 15, [14] = 16, [15] = 17, [16] = 18, [17] = 19, [20] = 22, [22] = 24 }

function Theme.Size(Size)
	return Theme.Sizes[Size] or Size
end

function Theme.Fit(Content, Size)
	local Scale = Content:FindFirstChildOfClass("UIScale")
	if not Scale then
		Scale = Instance.new("UIScale")
		Scale.Parent = Content
	end
	local Factor = math.clamp(math.min(Size.X / 820, Size.Y / 560), 1, 2.2)
	Scale.Scale = Factor
	Content.Size = UDim2.fromScale(1 / Factor, 1 / Factor)
end

function Theme.ScaleOf(Item)
	local Node = Item
	while Node do
		local Scale = Node:FindFirstChildOfClass("UIScale")
		if Scale then
			return Scale.Scale
		end
		Node = Node.Parent
	end
	return 1
end

function Theme.Stroke(Target, Color, Thickness)
	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color or Theme.Border
	Stroke.Thickness = Thickness or 1
	Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	Stroke.Parent = Target
	return Stroke
end

function Theme.Padding(Target, All)
	local Padding = Instance.new("UIPadding")
	Padding.PaddingTop = UDim.new(0, All)
	Padding.PaddingBottom = UDim.new(0, All)
	Padding.PaddingLeft = UDim.new(0, All)
	Padding.PaddingRight = UDim.new(0, All)
	Padding.Parent = Target
	return Padding
end

function Theme.Button(Text, Width, Height, Accent)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(Width, Height or 26)
	Button.BorderSizePixel = 0
	Button.Text = Text
	Button.TextSize = Theme.Size(14)
	Button.AutoButtonColor = false
	Button.Font = Accent and Theme.TitleFont or Theme.BodyFont

	local Base = Accent and Theme.Accent or Theme.Raised
	local Over = Accent and Theme.AccentHover or Theme.Hover
	local Down = Accent and Theme.AccentPressed or Theme.Panel
	local Ink = Accent and Theme.AccentInk or Theme.Text

	Button.BackgroundColor3 = Base
	Button.TextColor3 = Ink
	local Edge = Theme.Stroke(Button, Theme.Border)

	Button:SetAttribute("BaseColor", Base)
	Button:SetAttribute("OverColor", Over)
	Button:SetAttribute("InkColor", Ink)
	Button:SetAttribute("EdgeColor", Edge.Color)

	Button.MouseEnter:Connect(function()
		if Button:GetAttribute("Locked") then return end
		Button.BackgroundColor3 = Over
	end)
	Button.MouseLeave:Connect(function()
		if Button:GetAttribute("Locked") then return end
		Button.BackgroundColor3 = Base
	end)
	Button.MouseButton1Down:Connect(function()
		if Button:GetAttribute("Locked") then return end
		Button.BackgroundColor3 = Down
	end)
	Button.MouseButton1Up:Connect(function()
		if Button:GetAttribute("Locked") then return end
		Button.BackgroundColor3 = Over
	end)

	return Button
end

function Theme.ScrollInset(Scroll, Room)
	local Inset = Instance.new("UIPadding")
	local Gap = UDim.new(0, Room or 4)
	Inset.PaddingTop = Gap
	Inset.PaddingBottom = Gap
	Inset.PaddingLeft = Gap

	Inset.PaddingRight = UDim.new(0, (Room or 4) + Scroll.ScrollBarThickness)
	Inset.Parent = Scroll
	return Inset
end

function Theme.TrashButton(Parent, Span)
	local Size = Span or 18
	local Button = Instance.new("TextButton")
	Button.Name = "Trash"
	Button.Size = UDim2.fromOffset(Size, Size)
	Button.BackgroundTransparency = 1
	Button.Text = "X"
	Button.TextSize = Size
	Button.Font = Theme.TitleFont
	Button.TextColor3 = Theme.MutedText
	Button.AutoButtonColor = false
	Button.Parent = Parent

	Button.MouseEnter:Connect(function()
		Button.TextColor3 = Theme.Danger
	end)
	Button.MouseLeave:Connect(function()
		Button.TextColor3 = Theme.MutedText
	end)

	return Button
end

function Theme.Confirm(Parent, Depth, YesText, NoText)
	local Layer = Depth or 74
	local Confirm = {}
	local Answer = nil

	local Veil = Instance.new("TextButton")
	Veil.Name = "Confirm"
	Veil.Size = UDim2.fromScale(1, 1)
	Veil.BackgroundColor3 = Theme.Background
	Veil.BackgroundTransparency = 0.15
	Veil.BorderSizePixel = 0
	Veil.Text = ""
	Veil.AutoButtonColor = false
	Veil.Modal = true
	Veil.Visible = false
	Veil.ZIndex = Layer
	Veil.Parent = Parent

	local Card = Instance.new("Frame")
	Card.AnchorPoint = Vector2.new(0.5, 0.5)
	Card.Position = UDim2.fromScale(0.5, 0.5)
	Card.Size = UDim2.fromOffset(540, 168)
	Card.BackgroundColor3 = Theme.Panel
	Card.BorderSizePixel = 0
	Card.ZIndex = Layer + 1
	Card.Parent = Veil
	Theme.Stroke(Card, Theme.Accent)

	local Title = Theme.Label("", 17, Theme.Accent, Theme.TitleFont)
	Title.Position = UDim2.fromOffset(20, 18)
	Title.Size = UDim2.new(1, -40, 0, 22)
	Title.ZIndex = Layer + 2
	Title.Parent = Card

	local PickerRow = Instance.new("Frame")
	PickerRow.Position = UDim2.fromOffset(20, 46)
	PickerRow.Size = UDim2.new(1, -40, 0, 26)
	PickerRow.BackgroundTransparency = 1
	PickerRow.Visible = false
	PickerRow.ZIndex = Layer + 2
	PickerRow.Parent = Card

	local PickerLabel = Theme.Label("", 13, Theme.MutedText)
	PickerLabel.Size = UDim2.new(0, 150, 1, 0)
	PickerLabel.ZIndex = Layer + 2
	PickerLabel.Parent = PickerRow

	local PickerHolder = Instance.new("Frame")
	PickerHolder.Position = UDim2.fromOffset(150, 0)
	PickerHolder.Size = UDim2.new(1, -150, 1, 0)
	PickerHolder.BackgroundTransparency = 1
	PickerHolder.ZIndex = Layer + 2
	PickerHolder.Parent = PickerRow

	local Picker = Theme.Dropdown(PickerHolder, Parent, "", 270, 26, Layer + 6)
	Picker.Button.ZIndex = Layer + 3
	for _, Child in Picker.Button:GetChildren() do
		if Child:IsA("GuiObject") then
			Child.ZIndex = Layer + 4
		end
	end

	local Body = Theme.Label("", 15, Theme.BodyText)
	Body.LineHeight = 1.2
	Body.Position = UDim2.fromOffset(20, 46)
	Body.Size = UDim2.new(1, -40, 0, 0)
	Body.AutomaticSize = Enum.AutomaticSize.Y
	Body.TextWrapped = true
	Body.TextYAlignment = Enum.TextYAlignment.Top
	Body.ZIndex = Layer + 2
	Body.Parent = Card

	local Alert = Theme.Label("", 15, Theme.Danger)
	Alert.LineHeight = 1.2
	Alert.Position = UDim2.fromOffset(20, 46)
	Alert.Size = UDim2.new(1, -40, 0, 0)
	Alert.AutomaticSize = Enum.AutomaticSize.Y
	Alert.TextWrapped = true
	Alert.TextYAlignment = Enum.TextYAlignment.Top
	Alert.Visible = false
	Alert.ZIndex = Layer + 2
	Alert.Parent = Card

	local Yes = Theme.Button(YesText or "Yes, delete it", 168, 28, true)
	Yes.AnchorPoint = Vector2.new(1, 0)
	Yes.Position = UDim2.new(1, -20, 1, -44)
	Yes.ZIndex = Layer + 2
	Yes.Parent = Card

	local No = Theme.Button(NoText or "Keep it", 100, 28, false)
	No.AnchorPoint = Vector2.new(1, 0)
	No.Position = UDim2.new(1, -196, 1, -44)
	No.ZIndex = Layer + 2
	No.Parent = Card

	local function Fit()
		local Top = PickerRow.Visible and 82 or 46
		Body.Position = UDim2.fromOffset(20, Top)
		local Factor = Theme.ScaleOf(Body)
		local Under = Top + Body.AbsoluteSize.Y / Factor
		local Extra = 0
		if Alert.Visible then
			Alert.Position = UDim2.fromOffset(20, Under + 10)
			Extra = 10 + Alert.AbsoluteSize.Y / Factor
		end
		Card.Size = UDim2.fromOffset(540, math.clamp(Under + Extra + 56, 168, 560))
	end
	Body:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)
	Alert:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)

	function Confirm.SetText(Text, Warning)
		Body.Text = Text
		Alert.Visible = type(Warning) == "string" and Warning ~= ""
		Alert.Text = Alert.Visible and Warning or ""
		Fit()
	end

	function Confirm.Show(Heading, Text, OnYes, Warning, Choice)
		Title.Text = Heading
		PickerRow.Visible = Choice ~= nil
		if Choice then
			PickerLabel.Text = Choice.Label or ""
			Picker.OnPick = nil
			Picker.SetOptions(Choice.Options or {})
			Picker.Index = Choice.Index or 1
			Picker.SetLocked(false)
			Picker.OnPick = Choice.OnPick
		end
		Answer = OnYes
		Veil.Visible = true
		Confirm.SetText(Text, Warning)
	end

	function Confirm.Hide()
		Veil.Visible = false
		Answer = nil
		Picker.SetLocked(true)
		Picker.SetLocked(false)
	end

	Yes.Activated:Connect(function()
		local Run = Answer
		Confirm.Hide()
		if Run then
			Run()
		end
	end)
	No.Activated:Connect(Confirm.Hide)

	Confirm.Veil = Veil
	return Confirm
end

function Theme.SetLocked(Button, State)
	if not Button then return end
	Button:SetAttribute("Locked", State or nil)
	Button.BackgroundColor3 = State and Theme.Background or (Button:GetAttribute("BaseColor") or Theme.Raised)
	Button.TextColor3 = State and Theme.MutedText or (Button:GetAttribute("InkColor") or Theme.Text)
	local Edge = Button:FindFirstChildOfClass("UIStroke")
	if Edge then
		Edge.Color = State and Theme.Border or (Button:GetAttribute("EdgeColor") or Theme.Border)
	end
end

function Theme.Checkbox(Text, Width)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(Width or 160, 22)
	Button.BackgroundTransparency = 1
	Button.Text = ""
	Button.AutoButtonColor = false

	local Box = Instance.new("Frame")
	Box.Name = "Box"
	Box.Size = UDim2.fromOffset(14, 14)
	Box.Position = UDim2.fromOffset(0, 4)
	Box.BackgroundColor3 = Theme.Background
	Box.BorderSizePixel = 0
	Box.Parent = Button
	Theme.Stroke(Box, Theme.Border)

	local Fill = Instance.new("Frame")
	Fill.Name = "Fill"
	Fill.Size = UDim2.fromScale(0.6, 0.6)
	Fill.Position = UDim2.fromScale(0.2, 0.2)
	Fill.BackgroundColor3 = Theme.Accent
	Fill.BorderSizePixel = 0
	Fill.Visible = false
	Fill.Parent = Box

	local Label = Theme.Label(Text, 12, Theme.MutedText)
	Label.Name = "Label"
	Label.Position = UDim2.fromOffset(22, 0)
	Label.Size = UDim2.new(1, -22, 1, 0)
	Label.Parent = Button

	return Button
end

function Theme.SetChecked(Button, State)
	local Box = Button and Button:FindFirstChild("Box")
	local Fill = Box and Box:FindFirstChild("Fill")
	local Label = Button and Button:FindFirstChild("Label")
	if Fill then
		Fill.Visible = State == true
	end
	if Label then
		Label.TextColor3 = State and Theme.Text or Theme.MutedText
	end
end

function Theme.Group(Parent, Title, Inset)
	local Frame = Instance.new("Frame")
	Frame.BackgroundColor3 = Theme.Panel
	Frame.BorderSizePixel = 0
	Frame.Parent = Parent
	Theme.Stroke(Frame, Theme.Border)

	local Legend = Theme.Label(Title, 12, Theme.MutedText, Theme.TitleFont)
	Legend.Name = "Legend"
	Legend.BackgroundTransparency = 1
	Legend.Position = UDim2.fromOffset(10, 5)
	Legend.Size = UDim2.new(1, -20, 0, 17)
	Legend.ZIndex = 3
	Legend.Parent = Frame

	local Body = Instance.new("Frame")
	Body.Name = "Body"
	Body.Position = UDim2.fromOffset(0, 22)
	Body.Size = UDim2.new(1, 0, 1, -22)
	Body.BackgroundTransparency = 1
	Body.Parent = Frame
	Theme.Padding(Body, Inset or 10)

	return Frame, Body
end

function Theme.Dropdown(Parent, Overlay, Placeholder, Width, Height, Depth)
	local Control = {}
	Control.Options = {}
	Control.Index = nil

	local Tall = Height or 26

	local Layer = Depth or 60

	local Button = Theme.Button(Placeholder, Width, Tall, false)
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.TextColor3 = Theme.MutedText
	Button.Parent = Parent
	Control.Button = Button

	local Inset = Instance.new("UIPadding")
	Inset.PaddingLeft = UDim.new(0, 9)
	Inset.PaddingRight = UDim.new(0, 22)
	Inset.Parent = Button

	local Caret = Theme.Label("v", 10, Theme.Accent, Theme.TitleFont)
	Caret.Size = UDim2.fromOffset(14, Tall)
	Caret.Position = UDim2.new(1, 8, 0, 0)
	Caret.TextXAlignment = Enum.TextXAlignment.Center
	Caret.Parent = Button

	local Blocker = Instance.new("TextButton")
	Blocker.Name = "DropdownBlocker"
	Blocker.Size = UDim2.fromScale(1, 1)
	Blocker.BackgroundTransparency = 1
	Blocker.Text = ""
	Blocker.AutoButtonColor = false
	Blocker.Modal = true
	Blocker.Visible = false
	Blocker.ZIndex = Layer
	Blocker.Parent = Overlay

	local List = Instance.new("ScrollingFrame")
	List.Name = "DropdownList"
	List.BackgroundColor3 = Theme.Panel
	List.BorderSizePixel = 0
	List.ScrollBarThickness = 4
	List.ScrollBarImageColor3 = Theme.MutedText
	List.CanvasSize = UDim2.new()
	List.AutomaticCanvasSize = Enum.AutomaticSize.Y
	List.Visible = false
	List.ZIndex = Layer + 1
	List.Parent = Overlay
	Theme.Stroke(List, Theme.Accent)

	local Layout = Instance.new("UIListLayout")
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = List

	local Rim = Instance.new("UIPadding")
	Rim.PaddingTop = UDim.new(0, 4)
	Rim.PaddingBottom = UDim.new(0, 4)
	Rim.Parent = List

	local function Close()
		List.Visible = false
		Blocker.Visible = false
	end

	local function Open()
		if #Control.Options == 0 then
			return
		end
		local Factor = Theme.ScaleOf(Overlay)
		local At = (Button.AbsolutePosition - Overlay.AbsolutePosition) / Factor
		local Shown = math.clamp(#Control.Options, 1, 8)
		local High = Shown * 24 + 8
		local Top = At.Y + Button.AbsoluteSize.Y / Factor + 2

		if Top + High &gt; Overlay.AbsoluteSize.Y / Factor and At.Y - High - 2 &gt;= 0 then
			Top = At.Y - High - 2
		end

		List.Position = UDim2.fromOffset(At.X, Top)
		List.Size = UDim2.fromOffset(math.max(Button.AbsoluteSize.X / Factor, 220), High)
		Blocker.Visible = true
		List.Visible = true
	end

	Blocker.Activated:Connect(Close)
	Button.Activated:Connect(function()
		if Button:GetAttribute("Locked") then
			return
		end
		if List.Visible then
			Close()
		else
			Open()
		end
	end)

	local function Paint()
		local Item = Control.Index and Control.Options[Control.Index]
		Button.Text = Item and (Item.Short or Item.Label) or Placeholder
		Button.TextColor3 = Item and Theme.Accent or Theme.MutedText
		Button:SetAttribute("InkColor", Button.TextColor3)
	end

	function Control.SetOptions(Items)
		Control.Options = Items or {}
		Control.Index = nil
		for _, Child in List:GetChildren() do
			if Child:IsA("TextButton") then
				Child:Destroy()
			end
		end
		for Index, Item in Control.Options do
			local Row = Instance.new("TextButton")
			Row.LayoutOrder = Index
			Row.Size = UDim2.new(1, 0, 0, 24)
			Row.BackgroundColor3 = Theme.Raised
			Row.BackgroundTransparency = 1
			Row.BorderSizePixel = 0
			Row.Text = "   " .. Item.Label
			Row.TextSize = Theme.Size(12)
			Row.Font = Theme.BodyFont
			Row.TextColor3 = Theme.Text
			Row.TextXAlignment = Enum.TextXAlignment.Left
			Row.TextTruncate = Enum.TextTruncate.AtEnd
			Row.AutoButtonColor = false
			Row.Parent = List
			Row.MouseEnter:Connect(function()
				Row.BackgroundTransparency = 0
				Row.TextColor3 = Theme.Accent
			end)
			Row.MouseLeave:Connect(function()
				Row.BackgroundTransparency = 1
				Row.TextColor3 = Theme.Text
			end)
			Row.Activated:Connect(function()
				Close()
				Control.Index = Index
				Paint()
				if Control.OnPick then
					Control.OnPick(Index, Item)
				end
			end)
		end
		Paint()
	end

	function Control.Get()
		return Control.Index, Control.Index and Control.Options[Control.Index] or nil
	end

	function Control.Select(Index)
		Control.Index = Control.Options[Index] and Index or nil
		Paint()
	end

	function Control.SetLocked(State)
		Theme.SetLocked(Button, State)
		if State then
			Close()
		else
			Paint()
		end
	end

	Paint()
	return Control
end

function Theme.Sheet(Parent, Depth, Title)
	local Layer = Depth or 30
	local Sheet = {}

	local Veil = Instance.new("TextButton")
	Veil.Name = "Sheet"
	Veil.Size = UDim2.fromScale(1, 1)
	Veil.BackgroundColor3 = Theme.Background
	Veil.BackgroundTransparency = 0.08
	Veil.BorderSizePixel = 0
	Veil.Text = ""
	Veil.AutoButtonColor = false
	Veil.Modal = true
	Veil.Visible = false
	Veil.ZIndex = Layer
	Veil.Parent = Parent

	local Card = Instance.new("Frame")
	Card.AnchorPoint = Vector2.new(0.5, 0.5)
	Card.Position = UDim2.fromScale(0.5, 0.5)
	Card.Size = UDim2.new(1, -70, 1, -50)
	Card.BackgroundColor3 = Theme.Panel
	Card.BorderSizePixel = 0
	Card.ZIndex = Layer + 1
	Card.Parent = Veil
	Theme.Stroke(Card, Theme.Accent)

	local Cap = Instance.new("UISizeConstraint")
	Cap.MaxSize = Vector2.new(760, 480)
	Cap.Parent = Card

	local Heading = Theme.Label(Title, 15, Theme.Accent, Theme.TitleFont)
	Heading.Position = UDim2.fromOffset(18, 14)
	Heading.Size = UDim2.new(1, -130, 0, 22)
	Heading.ZIndex = Layer + 2
	Heading.Parent = Card

	local Shut = Theme.Button("Close", 84, 26, false)
	Shut.AnchorPoint = Vector2.new(1, 0)
	Shut.Position = UDim2.new(1, -18, 0, 12)
	Shut.ZIndex = Layer + 2
	Shut.Parent = Card

	local Body = Instance.new("Frame")
	Body.Name = "Body"
	Body.Position = UDim2.fromOffset(18, 48)
	Body.Size = UDim2.new(1, -36, 1, -66)
	Body.BackgroundTransparency = 1
	Body.ZIndex = Layer + 2
	Body.Parent = Card

	Sheet.Veil = Veil
	Sheet.Card = Card
	Sheet.Body = Body
	Sheet.Heading = Heading
	Sheet.Layer = Layer

	function Sheet.Show()
		Veil.Visible = true
	end

	function Sheet.Hide()
		Veil.Visible = false
	end

	Shut.Activated:Connect(Sheet.Hide)
	return Sheet
end

function Theme.Notice(Parent, Depth, Dismiss)
	local Layer = Depth or 70
	local Notice = {}

	local Veil = Instance.new("TextButton")
	Veil.Name = "Notice"
	Veil.Size = UDim2.fromScale(1, 1)
	Veil.BackgroundColor3 = Theme.Background
	Veil.BackgroundTransparency = 0.15
	Veil.BorderSizePixel = 0
	Veil.Text = ""
	Veil.AutoButtonColor = false
	Veil.Modal = true
	Veil.Visible = false
	Veil.ZIndex = Layer
	Veil.Parent = Parent

	local Card = Instance.new("Frame")
	Card.AnchorPoint = Vector2.new(0.5, 0.5)
	Card.Position = UDim2.fromScale(0.5, 0.5)
	Card.Size = UDim2.fromOffset(380, 168)
	Card.BackgroundColor3 = Theme.Panel
	Card.BorderSizePixel = 0
	Card.ZIndex = Layer + 1
	Card.Parent = Veil
	Theme.Stroke(Card, Theme.Accent)

	local Title = Theme.Label("", 17, Theme.Accent, Theme.TitleFont)
	Title.Position = UDim2.fromOffset(20, 18)
	Title.Size = UDim2.new(1, -40, 0, 22)
	Title.ZIndex = Layer + 2
	Title.Parent = Card

	local Body = Theme.Label("", 14, Theme.BodyText)
	Body.Position = UDim2.fromOffset(20, 46)
	Body.Size = UDim2.new(1, -40, 0, 0)
	Body.AutomaticSize = Enum.AutomaticSize.Y
	Body.TextWrapped = true
	Body.TextYAlignment = Enum.TextYAlignment.Top
	Body.ZIndex = Layer + 2
	Body.Parent = Card

	local Ok = Theme.Button(Dismiss or "OK", 96, 28, true)
	Ok.AnchorPoint = Vector2.new(1, 0)
	Ok.Position = UDim2.new(1, -20, 1, -44)
	Ok.ZIndex = Layer + 2
	Ok.Parent = Card

	local function Fit()
		Card.Size = UDim2.fromOffset(400, math.clamp(46 + Body.AbsoluteSize.Y / Theme.ScaleOf(Body) + 56, 168, 460))
	end
	Body:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)

	function Notice.Show(Heading, Text)
		Title.Text = Heading
		Body.Text = Text
		Veil.Visible = true
		Fit()
	end

	function Notice.Hide()
		Veil.Visible = false
	end

	Ok.Activated:Connect(Notice.Hide)
	Notice.Veil = Veil
	return Notice
end

function Theme.Label(Text, Size, Color, Font)
	local Label = Instance.new("TextLabel")
	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextSize = Theme.Size(Size or 14)
	Label.TextColor3 = Color or Theme.Text
	Label.Font = Font or Theme.MediumFont
	Label.TextXAlignment = Enum.TextXAlignment.Left
	return Label
end

return Theme
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX65">
      <Properties>
        <string name="Name">Window</string>
        <ProtectedString name="Source">local Theme = require(script.Parent.Theme)

local Window = {}
Window.__index = Window

local WidgetId = "UMSInstallerWindow"

function Window.New(PluginHandle, Title, DefaultSize, MinimumSize)
	local self = setmetatable({}, Window)

	local Info = DockWidgetPluginGuiInfo.new(
		Enum.InitialDockState.Float,
		false,
		false,
		DefaultSize.X,
		DefaultSize.Y,
		MinimumSize.X,
		MinimumSize.Y
	)

	local Widget = PluginHandle:CreateDockWidgetPluginGui(WidgetId, Info)
	Widget.Name = WidgetId
	Widget.Title = Title
	Widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local Background = Instance.new("Frame")
	Background.Name = "Background"
	Background.Size = UDim2.fromScale(1, 1)
	Background.BackgroundColor3 = Theme.Background
	Background.BorderSizePixel = 0
	Background.ClipsDescendants = true
	Background.Parent = Widget

	local Content = Instance.new("Frame")
	Content.Name = "Content"
	Content.Size = UDim2.fromScale(1, 1)
	Content.BackgroundTransparency = 1
	Content.ClipsDescendants = true
	Content.Parent = Background

	--// Studio does not always honour the minimum
	local TooSmall = Instance.new("Frame")
	TooSmall.Name = "TooSmall"
	TooSmall.Size = UDim2.fromScale(1, 1)
	TooSmall.BackgroundColor3 = Theme.Background
	TooSmall.BorderSizePixel = 0
	TooSmall.Visible = false
	TooSmall.ZIndex = 40
	TooSmall.Parent = Background

	local Notice = Theme.Label("", 12, Theme.Accent, Theme.MediumFont)
	Notice.Size = UDim2.new(1, -24, 1, -24)
	Notice.Position = UDim2.fromOffset(12, 12)
	Notice.TextWrapped = true
	Notice.TextXAlignment = Enum.TextXAlignment.Center
	Notice.TextYAlignment = Enum.TextYAlignment.Center
	Notice.ZIndex = 41
	Notice.Parent = TooSmall

	local function Measure()
		local Size = Background.AbsoluteSize
		local Small = Size.X &lt; MinimumSize.X or Size.Y &lt; MinimumSize.Y
		TooSmall.Visible = Small
		Content.Visible = not Small
		Theme.Fit(Content, Size)
		if Small then
			Notice.Text = math.floor(Size.X) .. " x " .. math.floor(Size.Y) .. "\n\nDrag the window out to at least " .. MinimumSize.X .. " x " .. MinimumSize.Y
		end
	end

	self.Widget = Widget
	self.Content = Content
	self.Background = Background
	self.Minimum = MinimumSize
	self.Changed = Widget:GetPropertyChangedSignal("Enabled")

	Background:GetPropertyChangedSignal("AbsoluteSize"):Connect(Measure)
	Measure()

	return self
end

function Window:IsOpen()
	return self.Widget.Enabled
end

function Window:Toggle()
	self.Widget.Enabled = not self.Widget.Enabled
end

function Window:Destroy()
	self.Widget:Destroy()
end

return Window
</ProtectedString>
      </Properties>
    </Item>
  </Item>
