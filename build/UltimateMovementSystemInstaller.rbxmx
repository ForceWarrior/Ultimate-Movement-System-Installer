      <Item class="ModuleScript" referent="RBX36">
        <Properties>
          <string name="Name">EmoteSupport</string>
          <ProtectedString name="Source">--// [Services]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// [Modules]
local Content = require(script.Parent.Parent.Content)
local KitVersion = require(script.Parent.Parent.KitVersion)

--// [Variables]
local EmoteSupport = {}

--// [Do not go past this point]

EmoteSupport.Folder = "UltimateEmoteSystem Support"
EmoteSupport.NeedsFrom = "1.1"

EmoteSupport.ConfigBlock = { Name = "EmoteSupport", Source = [==[
Config.EmoteSupport = {
	--// [Toggles]
	Enabled = true,
	StopEmoteOnMove = true,
	--// [Lists]
	IgnoredMoves = {},
}]==] }

local function EmoteVersion(Folder)
	local Stamp = Folder and Folder:GetAttribute(KitVersion.Attribute)
	if typeof(Stamp) == "number" then
		return tostring(Stamp)
	end
	if typeof(Stamp) == "string" and Stamp ~= "" then
		return Stamp
	end
	return nil
end

local function RedAt(FolderName)
	local Modules = ReplicatedStorage:FindFirstChild("Modules")
	local Folder = Modules and Modules:FindFirstChild(FolderName)
	local Red = Folder and Folder:FindFirstChild("Red")
	if Red and Red:IsA("ModuleScript") then
		return Red
	end
	return nil
end

local function IsRedirect(Module)
	if not Module then
		return false
	end
	local Code = Module.Source:gsub("%-%-[^\n]*", "")
	return Code:match("^%s*return%s+require%(") ~= nil
end

function EmoteSupport.Detect()

	local Modules = ReplicatedStorage:FindFirstChild("Modules")
	local Folder = (Modules and Modules:FindFirstChild("EmoteSystem")) or ReplicatedStorage:FindFirstChild("EmoteSystem")
	local Version = EmoteVersion(Folder)
	local Emote = {
		Present = Folder ~= nil,
		Version = Version,
		Recent = Version ~= nil and KitVersion.AtLeast(Version, EmoteSupport.NeedsFrom),
	}

	local EmoteRed, KitRed = RedAt("Util"), RedAt("Utils")
	local Red = {
		Twice = EmoteRed ~= nil and KitRed ~= nil and not IsRedirect(EmoteRed) and not IsRedirect(KitRed),
	}

	return { Emote = Emote, Red = Red }
end

function EmoteSupport.Files(Facts)
	local Files = {
		{ Name = "EmoteSupport", Class = "ModuleScript", Source = require(script.Module), Where = Facts.Kit.Custom },
	}
	if Facts.Red.Twice then

		table.insert(Files, { Name = "Red", Class = "ModuleScript", Source = require(script.RedRedirect) })
	end
	return Files
end

function EmoteSupport.Describe(Facts)
	local Plan = Content.Library.Plan
	local Lines, Warnings = {}, {}
	if not Facts.Emote.Present then
		table.insert(Warnings, Plan.EmoteMissing(EmoteSupport.NeedsFrom))
	elseif Facts.Emote.Recent then
		table.insert(Lines, Plan.EmoteFound(tostring(Facts.Emote.Version)))
	elseif Facts.Emote.Version then
		table.insert(Warnings, Plan.EmoteOld(tostring(Facts.Emote.Version), EmoteSupport.NeedsFrom))
	else
		table.insert(Warnings, Plan.EmoteUnstamped(EmoteSupport.NeedsFrom))
	end

	if Facts.Red.Twice then
		table.insert(Warnings, Plan.RedTwice)
	end
	return Lines, Warnings
end

return EmoteSupport
</ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX38">
          <Properties>
            <string name="Name">Module</string>
            <ProtectedString name="Source">return [==[
--[[
Made by Force Warrior and Cookie.
Thank you for purchasing!
Reselling or distributing this product in any form or by any means is strictly prohibited.
--]]

--// [Services]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// [Modules]
local MovementTypes = require(script:FindFirstAncestor("Movement").MovementTypes)
local Trove = require(ReplicatedStorage.Modules.Utils.Trove)

--// [Variables]
local Api = nil
local Mode = nil
local Red = nil
local Lifetime = Trove.new()

local EmoteSupport = {}
EmoteSupport.Name = script.Name
EmoteSupport.RequiresApi = 1
EmoteSupport.LocksMovement = true

--// [Do not go past this point]

local function Emote()
	local Character = Api.Character
	local EmoteId = Character:GetAttribute("EmoteId")
	if typeof(EmoteId) ~= "string" then return nil end
	return EmoteId, Character:GetAttribute("EmoteMovement") or "Locked"
end

local function StopEmote()
	if Red == nil then
		local Ok, Module = pcall(require, ReplicatedStorage.Modules.Utils.Red)
		Red = Ok and Module or false
	end
	if Red then
		Red.Client("Emotes"):Fire("Stop")
	end
end

local function Follow()
	if not Api.Character.Parent then return end
	local EmoteId, Movement = Emote()
	if not EmoteId or Movement == "Free" then
		Mode = nil
		if Api.IsActive() then Api.Stop() end
		return
	end
	Mode = Movement
	if Api.IsActive() or Api.Start() then return end

	Api.StopAll()
	if not Api.Start() then
		StopEmote()
	end
end

type Settings = { Enabled: boolean, StopEmoteOnMove: boolean, IgnoredMoves: { string } }

function EmoteSupport:Init(NewApi: MovementTypes.Api&lt;Settings&gt;)
	self:Cleanup()
	Api = NewApi
	for _, Attribute in { "EmoteId", "EmoteMovement" } do
		Lifetime:Add(Api.Character:GetAttributeChangedSignal(Attribute):Connect(Follow))
	end

	Lifetime:Add(Api.OnMoveStarted(function(Name)
		if Name == EmoteSupport.Name or not Api.Config.StopEmoteOnMove then return end
		if Emote() and not table.find(Api.Config.IgnoredMoves, Name) then
			StopEmote()
		end
	end))
	task.defer(Follow)
end

function EmoteSupport:CanEnter(): boolean
	if not Emote() then return Api.Refuse("no emote is playing") end
	return true
end

function EmoteSupport:Enter()
	local Speed = Api.Character:GetAttribute("EmoteSpeed")
	if typeof(Speed) == "number" then Api.Claim("WalkSpeed", Speed) end
end

function EmoteSupport:Exit()
	if Mode and Emote() and Api.Config.StopEmoteOnMove then
		StopEmote()
	end
	Mode = nil
end

function EmoteSupport:OwnsFacing(): boolean
	return Mode == "AutoForward"
end

function EmoteSupport:Cleanup()
	Lifetime:Clean()
	Mode = nil
end

return EmoteSupport
]==]
