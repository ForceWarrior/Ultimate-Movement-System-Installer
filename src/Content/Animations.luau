return {
	SelectAll = "All",
	SelectUnfilled = "Unfilled",
	Clear = "Clear",
	Unfilled = "not set",
	NoClip = "no clip, click to pick",
	TreeTitle = "ANIMATION SLOTS",
	ColumnLine = "LINE",
	ColumnKey = "CONFIG KEY",
	ColumnClip = "SOURCE ANIMATION",
	ColumnId = "ANIMATION ID",
	Upload = "Upload",
	UploadLocation = "Upload location",
	Ok = "OK",
	DoneTitle = "Done uploading animations!",
	PartTitle = "Upload finished with problems",
	Working = "Uploading...",
	Summary = function(Slots: number, Filled: number, Unfilled: number, Matched: number, Selected: number): string return Slots .. " slots  |  " .. Filled .. " filled, " .. Unfilled .. " unfilled  |  " .. Matched .. " matched  |  " .. Selected .. " selected" end,
	NothingWritten = "nothing came back, the config was not touched",
	NothingToDo = "Nothing selected that has a clip matched to it.",
	ConfirmTitle = function(Overwritten: number, Slots: number, Uploads: number, Where: string, Seconds: number): string return Overwritten .. " of these " .. Slots .. " slots already hold an id and will be overwritten.\n" .. Uploads .. " animations to publish (slots sharing a clip upload once) to " .. Where .. ", roughly " .. Seconds .. " seconds." end,
	Apply = "Upload and overwrite",
	Cancel = "Cancel",
	Stop = "Stop",
	Stopping = "stopping after this one...",
	Writing = "writing the new ids into MovementConfig...",
	Progress = function(Done: number, Total: number, Clip: string): string return "uploading " .. Done .. " of " .. Total .. "   " .. Clip end,
	Done = function(Uploaded: number, Total: number, Failed: number, Outcome: string): string return Uploaded .. " of " .. Total .. " uploaded, " .. Failed .. " failed. Config: " .. Outcome end,
	Written = "written",
	WrittenSome = function(Written: number, LeftAlone: number): string return Written .. " slots written, " .. LeftAlone .. " left alone" end,
	SkippedNote = function(Skipped: string): string return "\n\nLeft alone: " .. Skipped end,
	NoConfig = "MovementConfig not found. Install the folders first.",
	Untrusted = function(Slots: number, Identical: string): string return "Refusing to touch the config: the scan found " .. Slots .. " slots and the identity check returned " .. Identical .. ". Nothing will be written until that passes." end,
}
