	CodeFacts = function(Changed: number, Characters: number): string return Changed .. " settings differ from the shipped defaults  |  " .. Characters .. " characters" end,
	CopyHint = "Ctrl+C copies it. Over about 1900 characters it will not fit in one chat message, send it as a file.",
	SelectAll = "Select all",

	PasteTitle = "Paste a preset code",
