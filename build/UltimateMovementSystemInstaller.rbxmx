	["ConfigMenu.Enabled"] = { Summary = "Loads the in game config menu.", Accepts = "true or false" },
	["ConfigMenu.OpenButton"] = { Summary = "The controller button that opens the menu.", Accepts = "an Enum.KeyCode" },
	["ConfigMenu.OpenKey"] = { Summary = "The key that opens the menu.", Accepts = "an Enum.KeyCode" },
	["ConfigMenu.Scale"] = { Summary = "Makes the window bigger or smaller.", Accepts = "a multiplier, 1 is normal size" },
	["ConfigMenu.StudioOnly"] = { Summary = "The menu only exists in Studio play sessions.", Accepts = "true or false" },
	["EmoteSupport.Enabled"] = { Summary = "Emotes and moves stop fighting over the body.", Accepts = "true or false" },
	["EmoteSupport.IgnoredMoves"] = { Summary = "Moves that may start without ending the emote.", Accepts = "a list of module names" },
	["EmoteSupport.StopEmoteOnMove"] = { Summary = "Starting a move ends the emote.", Accepts = "true or false" },
}

function ConfigSettingDocs.For(Path)
	local Entries = ConfigSettingDocs.Entries
	local Shape = Path:gsub("%[%d+%]", "[]")
	local Found = Entries[Path] or Entries[Shape]
	if Found then
		return Found
	end
	local Head, Last = Shape:match("^(.*)%.([^%.]+)$")
	if not Head then
		return nil
	end
	return Entries["*." .. Last] or Entries[Head .. ".*"]
end

function ConfigSettingDocs.Count()
	local Total = 0
	for _ in ConfigSettingDocs.Entries do
		Total += 1
	end
	return Total
end

return ConfigSettingDocs
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX25">
        <Properties>
          <string name="Name">Library</string>
          <ProtectedString name="Source">--// [Variables]
local Library = {
	GridTitle = "MODULE LIBRARY",
	Search = "Filter modules",
	Back = "Return",
	Notes = "WORTH KNOWING",
	ExpandHint = "Click an entry to read more.",
	Insert = "Insert",
	Remove = "Remove",
	Facts = function(Files: number): string return Files .. (if Files == 1 then " file" else " files") end,
	BuiltIn = "Built into the kit",
	SettingsTitle = "Settings",
	Status = "Optional modules. Insert puts each file where it goes, Remove takes them out again.",
	Summary = function(Shown: number, Modules: number): string return Shown .. " of " .. Modules .. " modules" end,
	InsertTitle = function(Title: string): string return "Insert " .. Title .. "?" end,
	RemoveTitle = function(Title: string): string return "Remove " .. Title .. "?" end,
	InsertYes = "Yes, insert it",
	RemoveYes = "Yes, remove it",
	ConfirmNo = "Not now",
	DoneTitle = "Inserted",
	RemovedTitle = "Removed",
	DonePlaced = function(Name: string, Into: string): string return Name .. " is in " .. Into .. "." end,
	DoneWaits = function(Name: string, Folder: string): string return Name .. " is in the Workspace folder \"" .. Folder .. "\"." end,
	DoneDeleted = function(Name: string, From: string): string return Name .. " was deleted from " .. From .. "." end,
	DoneClose = "OK",
	DoneConfig = {
		Added = function(Block: string): string return Block .. " was added to MovementConfig with every key at its shipped value." end,
		Present = function(Block: string): string return Block .. " was already in MovementConfig and was left exactly as it is." end,
		Merged = function(Block: string, Keys: string): string return Block .. " was already in MovementConfig and got the keys it lacked: " .. Keys .. "." end,
		Deleted = function(Block: string): string return Block .. " was deleted from MovementConfig." end,
		Kept = function(Block: string): string return Block .. " holds your own values, so it stayed in MovementConfig." end,
		Unreadable = function(Block: string): string return Block .. " is written in a shape the plugin cannot read, so it was left exactly as it is." end,
	},
	FailedTitle = "Nothing was changed",
	Playtest = "Stop the playtest first, nothing inserted or removed during a run survives it.",
	KitMissing = "Install the kit first, the files go into its folders.",
	NoReturn = "MovementConfig has no return Config line, so the block has nowhere to go. Put return Config back at the end of the file.",
	WriteFailed = "MovementConfig could not be written, someone else may have it open in Team Create.",
	BuildFailed = function(Name: string, Problem: string): string return Name .. " could not be built: " .. Problem end,
}

--// [Do not go past this point]

Library.Plan = {
	Placed = function(Name: string, Where: string): string return Name .. " goes into " .. Where end,
	Waits = function(Name: string, Folder: string): string return Name .. " waits in a Workspace folder \"" .. Folder .. "\"" end,
	Deleted = function(Name: string, Where: string): string return Name .. " is deleted from " .. Where end,
	KitFound = function(Version: string): string return "Kit V" .. Version .. " is installed" end,
	BlockAdded = function(Block: string): string return Block .. " is added to MovementConfig with every key at its shipped value" end,
	BlockPresent = function(Block: string): string return Block .. " is already in MovementConfig and stays as it is" end,
	BlockMerged = function(Block: string, Keys: string): string return Block .. " is already in MovementConfig and gets the keys it lacks: " .. Keys end,
	BlockDeleted = function(Block: string): string return Block .. " is deleted from MovementConfig" end,
	BlockKept = function(Block: string): string return Block .. " holds your own values and stays in MovementConfig" end,
	BlockUnreadable = function(Block: string): string return Block .. " is written in a shape the plugin cannot read, it stays exactly as it is and nothing is added to it" end,
	OldFolder = function(Name: string): string return "The Workspace folder \"" .. Name .. "\" from an earlier insert is deleted" end,
	EmoteFound = function(Version: string): string return "Ultimate Emote System V" .. Version .. " is installed" end,
	EmoteUnstamped = function(Needs: string): string return "An Ultimate Emote System without a version stamp is installed, the move needs V" .. Needs .. " or newer" end,
	EmoteOld = function(Version: string, Needs: string): string return "Ultimate Emote System V" .. Version .. " is installed, the move needs V" .. Needs .. " or newer, update it first" end,
	EmoteMissing = function(Needs: string): string return "No Ultimate Emote System found here, the move needs V" .. Needs .. " or newer" end,
	RedTwice = "Red is here twice, under Modules.Util and Modules.Utils, and two copies break the events. The Red in the folder is a one line redirect to the kit's copy, put it in place of Modules &gt; Util &gt; Red",
}

Library.Entries = {
	require(script.EmoteSupport),
	require(script.RagdollSupport),
	require(script.ConfigMenu),
}

function Library.For(Name)
	for _, Entry in Library.Entries do
		if Entry.Name == Name then
			return Entry
		end
	end
	return nil
end

function Library.Setting(Block, Key)
	local Entry = Library.For(Block)
	if Entry and Entry.Settings then
		return Entry.Settings[Key]
	end
	return nil
end

return Library
</ProtectedString>
        </Properties>
        <Item class="ModuleScript" referent="RBX26">
          <Properties>
            <string name="Name">EmoteSupport</string>
            <ProtectedString name="Source">return {
	Name = "EmoteSupport",
	Title = "Emote system support",
	Blurb = "Emotes and moves that agree on who has the body",
	Summary = "Made for the Ultimate Emote System by Force Warrior and Cookie. One custom move that follows the "
		.. "emote: while a stand still emote plays no move can start, and a real move during a free emote ends it. "
		.. "Another emote system has to write the EmoteId and EmoteMovement attributes on the character itself, and EmoteSpeed if the emote sets a walk speed.",
	Notes = {
		"The module needs no key. It watches the EmoteId and EmoteMovement attributes the emote system writes on your character from V1.1 on, and EmoteSpeed from V1.2 on.",
		"A stand still or walking emote cannot hold the body while swimming or on a truss, so the module ends it, unless Core.AllowedInWater or Core.AllowedWhileClimbing names EmoteSupport. A free emote never holds the body, so those lists leave it alone.",
	},

	Groups = {
		{
			Title = "What goes where",
			Rows = {
				{ Key = "EmoteSupport", Value = "ReplicatedStorage &gt; Modules &gt; Movement &gt; MovementMain &gt; Custom",
					Summary = "The custom move. Loads at the next spawn." },
				{ Key = "Red", Value = "a Workspace folder, then ReplicatedStorage &gt; Modules &gt; Util",
					Summary = "Only when Red is in the place twice. A one line redirect to the kit's copy that waits in the folder until you put it in place of the emote system's copy." },
				{ Key = "Config.EmoteSupport", Value = "MovementConfig",
					Summary = "Added when MovementConfig has no block of that name. A block already there keeps its values and only gets the keys it lacks." },
			},
		},
		{
			Title = "How it behaves",
			Rows = {
				{ Key = "A stand still emote", Value = "holds the body",
					Summary = "No move can start and the speed is the emote's." },
				{ Key = "A walking emote", Value = "walks",
					Summary = "You keep control, at the emote's own speed." },
				{ Key = "A move during a free emote", Value = "ends the emote",
					Summary = "That is StopEmoteOnMove. IgnoredMoves lists the moves that may run without ending it." },
			},
		},
		{
			Title = "If something is off",
			Rows = {
				{ Key = "Emotes still get interrupted", Value = "module not loaded",
					Summary = "It has to sit in MovementMain &gt; Custom and be named EmoteSupport. The Output at spawn names what failed." },
				{ Key = "The emote never holds", Value = "no attributes",
					Summary = "Select your character while an emote plays and look for EmoteId in its attributes. If it is missing your emote system is older than V1.1, update it." },
			},
		},
	},

	Settings = {
		Enabled = { Summary = "Emotes and moves stop fighting over the body.", Accepts = "true or false" },
		IgnoredMoves = { Summary = "Moves that may start without ending the emote.", Accepts = "a list of module names" },
		StopEmoteOnMove = { Summary = "Starting a move ends the emote.", Accepts = "true or false" },
	},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX27">
          <Properties>
            <string name="Name">RagdollSupport</string>
            <ProtectedString name="Source">return {
	Name = "RagdollSupport",
	Title = "Ragdoll support",
	Blurb = "The kit holds still while a ragdoll has the body",
	Summary = "Made for the ragdoll system by Force Warrior and Cookie, and built into the kit, so there is nothing to insert. While the character carries a MovementHold attribute the kit stops the running move "
		.. "and refuses every move until it clears. With no move running, PlatformStand or the Physics humanoid state holds it the same way, "
		.. "so a ragdoll built on either needs no code at all.",
	Notes = {
		"A ragdoll that can start in the middle of a move should set MovementHold, PlatformStand and Physics only count once no move is running.",
		"The same attribute holds the kit for a cutscene, a stun or a knockback. true or any name works.",
		"The API tab's Outside hooks page has the same hold from client code.",
	},

	Groups = {
		{
			Title = "From your own code",
			Rows = {
				{ Key = "The attribute", Value = "MovementHold, on the character",
					Summary = "Set it when the ragdoll starts, clear it when it ends. The server or the player's own client can set it.",
					Code = "-- when the ragdoll starts\nCharacter:SetAttribute(\"MovementHold\", \"Ragdoll\")\n\n-- when it ends\nCharacter:SetAttribute(\"MovementHold\", nil)" },
			},
		},
		{
			Title = "Settings that meet a ragdoll",
			Rows = {
				{ Key = "Core.SuppressTripStates", Value = "no Ragdoll state",
					Summary = "While it is on, the humanoid can never enter the Ragdoll or FallingDown state. The Ragdoll state is no hold either way, so use Physics or PlatformStand, or set MovementHold." },
				{ Key = "Core.DisableCollisionOnDeath", Value = "limbs on death",
					Summary = "While it is on, every part but the root and the torso stops colliding on death, so the limbs of a death ragdoll sink through the floor. Switch it off if your ragdoll runs on death." },
			},
		},
		{
			Title = "If something is off",
			Rows = {
				{ Key = "Moves still start while ragdolled", Value = "no signal",
					Summary = "Your ragdoll sets neither MovementHold nor PlatformStand nor the Physics state. Set the attribute, two lines." },
			},
		},
	},
}
</ProtectedString>
          </Properties>
        </Item>
      <Item class="ModuleScript" referent="RBX70"><Properties><string name="Name">ConfigMenu</string><ProtectedString name="Source">return {
	Name = "ConfigMenu",
	Title = "Config menu",
	Blurb = "Change any config value while you play",
	Summary = "A window you open while playing that lists every block and key of MovementConfig and lets you change them on the spot. "
		.. "Search finds any setting by name, value or description, and the strip under the list says what the setting does and what it takes. "
		.. "Changes last for the play session, Export writes them as lines you paste into MovementConfig to keep them.",

	Notes = {
		"The MovementConfigMenu window in StarterGui and the row templates under the module are plain instances laid out in scale, so they fit any screen. Restyle them, keep the names.",
		"Remove deletes the module with its templates and the MovementConfigMenu window, so copy a restyle out first.",
		"With StudioOnly on, a published game never builds the window.",
		"Docs under the module holds the descriptions the strip and search use. It is about 180 KB and ships to every player of a published game, delete it to save that, the menu works without it.",
	},

	Groups = {
		{
			Title = "What goes where",
			Rows = {
				{ Key = "ConfigMenu", Value = "ReplicatedStorage &gt; Modules &gt; Movement &gt; MovementMain &gt; Custom",
					Summary = "The module, with a Templates folder of the rows it shows and the Docs module under it. Loads at the next spawn like any custom move." },
				{ Key = "MovementConfigMenu", Value = "StarterGui",
					Summary = "The window, a ScreenGui you can see and restyle in the Explorer. Your first spawn copies it into PlayerGui like any StarterGui item." },
				{ Key = "Config.ConfigMenu", Value = "MovementConfig",
					Summary = "Added when MovementConfig has no block of that name. A block already there keeps its values and only gets the keys it lacks." },
			},
		},
		{
			Title = "Using it",
			Rows = {
				{ Key = "Opening it", Value = "OpenKey or OpenButton",
					Summary = "Either one opens and closes the window. On a phone or tablet a CONFIG button sits with the move buttons." },
				{ Key = "Finding a setting", Value = "Search",
					Summary = "Type part of a name, a value such as a sound name, or a word from its description. The results are the real controls, Enter or a result's heading opens its table." },
				{ Key = "Knowing a setting", Value = "the strip under the list",
					Summary = "Point at or click a row to see its full path, the range it takes, what it was before you changed it and what it does. A value outside the range is clamped and the strip says so." },
				{ Key = "Numbers", Value = "field, minus and plus",
					Summary = "Type and press Enter, or step it. Hold minus or plus to keep stepping, right click them for ten steps at once." },
				{ Key = "Keys", Value = "press the new one",
					Summary = "Click the key, press the one you want, click it again to keep the old one. The strip warns when another setting already uses that key." },
				{ Key = "Tables", Value = "step into them",
					Summary = "Open shows the keys inside, Back goes up a level." },
				{ Key = "Lists", Value = "+ Add and x",
					Summary = "Add puts a copy of the last entry at the end, or asks which move where the kit wants a name, x takes one out." },
				{ Key = "Choices", Value = "pick from a list",
					Summary = "Modes, move and state names and enum values drop down, so no name has to be guessed." },
				{ Key = "Undoing", Value = "Revert and Changes",
					Summary = "Revert in the strip puts one setting back. Changes lists everything you changed with what it was, Revert all asks once more before putting it all back." },
				{ Key = "Keeping changes", Value = "Changes, then Export",
					Summary = "Export writes one line per change, selected so Ctrl+C copies them, and prints them to Output too. Paste them above return Config in MovementConfig." },
				{ Key = "Problems", Value = "Validate",
					Summary = "Lists every problem with the setting's row right under it, so you fix it where it is reported. Fixed problems drop out as you type." },
				{ Key = "Reload", Value = "restarts the kit",
					Summary = "For the keys a move reads once at spawn. It turns orange when you changed something since the last one, and the menu reopens where you left it." },
				{ Key = "From a script", Value = "Manager.States.ConfigMenu:Toggle()",
					Summary = "The module sits on the manager like a move.",
					Code = "local MovementMain = require(game.ReplicatedStorage.Modules.Movement.MovementMain)\nlocal Menu = MovementMain.GetManager().States.ConfigMenu\nif Menu then Menu:Toggle() end" },
			},
		},
	},

	Settings = {
		Enabled = { Summary = "Loads the in game config menu.", Accepts = "true or false" },
		OpenButton = { Summary = "The controller button that opens the menu.", Accepts = "an Enum.KeyCode" },
		OpenKey = { Summary = "The key that opens the menu.", Accepts = "an Enum.KeyCode" },
		Scale = { Summary = "Makes the window bigger or smaller.", Accepts = "a multiplier, 1 is normal size" },
		StudioOnly = { Summary = "The menu only exists in Studio play sessions.", Accepts = "true or false" },
	},
}
</ProtectedString></Properties></Item></Item>
      <Item class="ModuleScript" referent="RBX28">
        <Properties>
          <string name="Name">About</string>
          <ProtectedString name="Source">return {
	{
		Heading = "Built with AI assistance",
		Body = "This installer was built with AI assistance and tested by hand.",
	},
	{
		Heading = "How the install works",
		Body = "Put the package in Workspace. Every model in it is named UNGROUP IN &lt;destination&gt; and its contents go there. "
			.. "Anything of yours with the same name is kept unless you tick Replace mine. The whole install is one undo step.",
	},
	{
		Heading = "Animations",
		Body = "The Install tab lists every animation id in your config and matches it to a clip in the package. "
			.. "Tick what you want, pick where to publish, press Upload. Clips go through AssetService, no login involved. "
			.. "Each clip uploads once and the new ids are written into the config. Slots that already hold an id are shown for approval first.",
	},
	{
		Heading = "Presets",
		Body = "A preset is your whole MovementConfig saved under a name. It lives with the plugin, so it follows you between places. "
			.. "Share one as a code: it holds only what differs from the shipped defaults, so most fit in a chat message. "
			.. "Pasting it applies those values and touches nothing else. Animation ids stay out unless you tick them in.",
	},
	{
		Heading = "Config",
		Body = "Every block and every setting, what it does, what it accepts and the comment next to it in the file. It reads the live config.",
	},
	{
		Heading = "API",
		Body = "How to write your own move: one ModuleScript in MovementMain &gt; Custom and the Api the kit hands it. "
			.. "Every function and field, and a worked example you can copy.",
	},
}
</ProtectedString>
        </Properties>
      </Item>
