	["*.SprintLimbs"] = { Summary = "Which limbs get the effect while sprinting.", Accepts = "\"Both\", \"Hands\" or \"Feet\"" },
	["*.OnSurface"] = { Summary = "The effect sits on the wall instead of the body.", Accepts = "true or false" },
