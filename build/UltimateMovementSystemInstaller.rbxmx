	["Core.DisableCollisionOnDeath"] = { Summary = "The body stops colliding when it dies.", Accepts = "true or false" },
	["Core.DisableTorsoCollision"] = { Summary = "The torso stops colliding while a move owns the body.", Accepts = "true or false" },
	["Core.Extras"] = { Summary = "Loads everything in MovementMain &gt; Extras.", Accepts = "true or false" },
	["Core.JumpDebounceTime"] = { Summary = "The shortest gap between two jumps.", Accepts = "seconds" },
	["Core.MaxRideStepDistance"] = { Summary = "The furthest a moving part may carry you in one step before the kit lets go.", Accepts = "studs" },
	["Core.RemoteBurstTime"] = { Summary = "How long a burst of replicated effects may last.", Accepts = "seconds" },
	["Core.ReplicateSounds"] = { Summary = "Other players hear your movement sounds.", Accepts = "true or false" },
	["Core.ReplicateVfx"] = { Summary = "Other players see your movement effects.", Accepts = "true or false" },
	["Core.ReplicatedEffects"] = { Summary = "Only these effects are sent to other players, empty for all.", Accepts = "a list of effect names" },
	["Core.ReplicatedSoundLifetime"] = { Summary = "How long a replicated sound may play on other clients.", Accepts = "seconds" },
	["Core.ReplicatedSounds"] = { Summary = "Only these sounds are sent to other players, empty for all.", Accepts = "a list of sound names" },
	["Core.Replication"] = { Summary = "Other players see and hear your movement.", Accepts = "true or false" },
	["Core.ReplicationDistance"] = { Summary = "How far away other players still see your effects. Sounds use ReplicatedSoundDistance.", Accepts = "studs, 0 for no limit" },
	["Core.ReplicationRate"] = { Summary = "How often movement effects are sent out.", Accepts = "seconds" },
