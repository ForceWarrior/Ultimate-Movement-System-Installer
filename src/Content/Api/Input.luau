return {
	Name = "Input",
	Title = "Input",
	Blurb = "Winning a key press, and sharing one",
	Summary = "A key can only go to one move. Claims carry a priority, and the highest one whose CanClaim says yes gets the press.",
	Notes = {
		"A KeyCode in your config also gets a touch button on mobile, at no extra work.",
		"Higher priority wins. The shipped air jump sits at 10 and is deliberately last, so a claim above it eats every double jump.",
		"The action name is your module name with a trailing \"Module\" stripped. That is what BindKey and IsHeld answer to.",
	},
	Rows = {
		{ Key = "Api.BindKey(Callback)", Value = "no return",
			Summary = "Fires on the key named in your config. The callback receives the action name and the input state, which is either Begin or End. With DoublePressEnabled in your block, a press only reaches you when it is the second of two quick presses, or while your move is running.",
			Code = "-- with Config.MyMove = { KeyCode = Enum.KeyCode.H, ConsoleInput = Enum.KeyCode.DPadRight }\nApi.BindKey(function(ActionName, InputState)\n\tif InputState == \"Begin\" then\n\t\tApi.Start()\n\telseif InputState == \"End\" then\n\t\tApi.Stop()\n\tend\nend)" },
		{ Key = "Api.IsHeld(Name)", Value = "-> boolean",
			Summary = "Is that action's key or touch button down right now. Defaults to your own action. In Toggle mode it is still the key, ask the move itself whether it is on, Api.Locomotion.IsSprinting() for the run.",
			Code = "function MyMove:Update(DeltaTime)\n\tif not Api.IsHeld() then\n\t\tApi.Stop()\n\t\treturn\n\tend\nend\n\n-- someone else's key\nif Api.IsHeld(\"Crouch\") then end" },
		{ Key = "Api.ShiftLocked()", Value = "-> boolean",
			Summary = "Is shift lock on, the kit's own or Roblox's.",
			Code = "if Api.ShiftLocked() then\n\t-- the body already faces the camera\nend" },
		{ Key = "Api.MoveVector()", Value = "-> Vector3",
			Summary = "The movement input as the controls report it, X sideways and Z forward on the screen, before the camera turns it into a world direction. For a move that cares which way the stick is pushed.",
			Code = "local Input = Api.MoveVector()\nif Input.Z < -0.5 then\n\t-- pushing forward\nend" },
		{ Key = "Api.JumpHeld()", Value = "-> boolean",
			Summary = "Is the jump key down right now, keyboard, controller or the touch button alike. For a move that lasts as long as jump is held, the way the glide does.",
			Code = "function MyMove:Update(DeltaTime)\n\tif not Api.JumpHeld() then\n\t\tApi.Stop()\n\tend\nend" },
		{ Key = "Api.ClaimJump(Priority, CanClaim, Claim)", Value = "no return",
			Summary = "Take the jump button at a priority. CanClaim is asked at the moment of the press, and Claim runs only if you won it. With DoublePressEnabled in your block, it takes two quick jump presses while your move is not running.",
			Code = "-- jump out of the move, but only while the move is running\nApi.ClaimJump(40,\n\tfunction()\n\t\treturn Api.IsActive()\n\tend,\n\tfunction()\n\t\tApi.RootPart.AssemblyLinearVelocity += Vector3.new(0, 60, 0)\n\t\tApi.Stop()\n\tend)" },
		{ Key = "Api.ClaimKey(Key, Priority, CanClaim, Claim)", Value = "no return",
			Summary = "The same thing for any other KeyCode, for when your key is shared with a shipped move. DoublePressEnabled counts here too.",
			Code = "-- share C with the crouch, and win it only while sliding\nApi.ClaimKey(Enum.KeyCode.C, 60,\n\tfunction()\n\t\treturn Api.IsActive()\n\tend,\n\tfunction()\n\t\tApi.Stop()\n\tend)" },
	},
}
