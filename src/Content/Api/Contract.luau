return {
	Name = "Contract",
	Title = "The module contract",
	Blurb = "The fields and hooks the engine looks for",
	Summary = "Your module is a plain table with a few fields and methods. Everything is optional except Name and RequiresApi. A hook you do not write is never called.",
	Notes = {
		"Init runs once at spawn. The rest are called only while your move is relevant.",
		"Update only runs while your move owns the body.",
		"Every hook is called through pcall, so a mistake in yours does not take the movement system down with it.",
	},
	Rows = {
		{ Key = "Name", Value = "string", Accepts = "the script's own name",
			Summary = "The name the kit and the config know your move by. Using script.Name keeps it in step with the script.",
			Code = "MyMove.Name = script.Name" },
		{ Key = "RequiresApi", Value = "number", Accepts = "1",
			Summary = "The Api version this module was written for. A version this build does not have refuses to load.",
			Note = "Read by MovementMain when the module loads.",
			Code = "MyMove.RequiresApi = 1" },
		{ Key = "Config.<Name>", Value = "a block in MovementConfig", Accepts = "every key your code reads",
			Summary = "Your tuning lives in MovementConfig, in a block named after your module. No block, no move, and a key your code reads that is not there is nil. Api.Config is that block.",
			Note = "Checked by MovementMain.CustomAdmits. Enabled = false switches the move off without removing it.",
			Code = "-- in MovementConfig, after the shipped blocks\nConfig.MyMove = {\n\tEnabled = true,\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n\tSpeed = 70,\n\tCooldown = 2,\n}\n\n-- in the module\nlocal Speed = Api.Config.Speed" },
		{ Key = "Requires", Value = "table", Accepts = "Grounded, Moving, Free, JumpHeld, FallSpeed",
			Summary = "Declaring this makes your move start by itself when these cheap conditions hold, after which Confirm is asked. Leave it out and your move starts only when you ask.",
			Note = "Read by EligibilitySignals. Grounded, Moving, Free and JumpHeld take booleans, FallSpeed takes a number.",
			Code = "-- \"start looking at me only while airborne, moving, and falling fast\"\nMyMove.Requires = {\n\tGrounded = false,\n\tMoving = true,\n\tFree = true,\n\tFallSpeed = 5,\n}" },
		{ Key = "StepWhileAirborne", Value = "boolean", Accepts = "true",
			Summary = "Runs your Update while the body is in the air and once more on landing, without owning the body. For watching a fall rather than owning it.",
			Code = "MyMove.StepWhileAirborne = true\n\nlocal Fell = 0\n\nfunction MyMove:Update(DeltaTime)\n\tFell += DeltaTime\n\tif Api.OnGround() then\n\t\tprint(\"was in the air for\", Fell)\n\t\tFell = 0\n\tend\nend" },
		{ Key = "Init", Value = "function(self, Api)", Accepts = "your setup",
			Summary = "Called once at startup with the Api. Bind keys and stash the Api here. Do not assume any other module has loaded yet.",
			Note = "Called by MovementMain when the module loads.",
			Code = "local Api = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.BindKey(function(_, InputState)\n\t\tif InputState == \"Begin\" then\n\t\t\tApi.Start()\n\t\tend\n\tend)\nend" },
		{ Key = "CanEnter", Value = "function(self) -> boolean", Accepts = "true, or Api.Refuse(...)",
			Summary = "Asked before your move is allowed to start. Return false, or better, return Api.Refuse with a reason so you can see why it did not happen.",
			Note = "Called from StateMachine.CanStartState, after the cooldown and the transition table said yes.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\treturn true\nend" },
		{ Key = "Confirm", Value = "function(self) -> boolean", Accepts = "true or false",
			Summary = "The expensive check, asked only after the cheap Requires gates pass. A raycast belongs here, not in CanEnter, because this runs far less often.",
			Code = "function MyMove:Confirm()\n\t-- only now is it worth paying for a raycast\n\tlocal Ahead = Api.RootPart.CFrame.LookVector * 4\n\tlocal Hit = Api.Raycast(Api.RootPart.Position, Ahead)\n\treturn Hit ~= nil\nend" },
		{ Key = "Sample", Value = "function(self)", Accepts = "no arguments",
			Summary = "Called on the tick so a gated move can keep a cheap reading current between events, without owning the body.",
			Code = "local Speed = 0\n\nfunction MyMove:Sample()\n\tSpeed = Api.RootPart.AssemblyLinearVelocity.Magnitude\nend\n\nfunction MyMove:Confirm()\n\treturn Speed > 30\nend" },
		{ Key = "Enter", Value = "function(self)", Accepts = "no arguments",
			Summary = "Your move has started. Spend the stamina, start the cooldown, set up whatever Update needs. Calling Api.Stop() in here refuses the start after all: the block's cooldown and stamina cost are not charged and nothing reports it as started.",
			Note = "Called from StateMachine.StartState.",
			Code = "local TimeLeft = 0\n\nfunction MyMove:Enter()\n\tTimeLeft = Api.Config.Duration\n\tApi.SpendStamina(Api.Config.StaminaCost)\n\tApi.StartCooldown(Api.Config.Cooldown)\nend" },
		{ Key = "Update", Value = "function(self, DeltaTime)", Accepts = "seconds since the last tick",
			Summary = "Every tick, but only while your move owns the body. Drive the movement here and call Api.Stop() when it is finished.",
			Code = "function MyMove:Update(DeltaTime)\n\tTimeLeft -= DeltaTime\n\tif TimeLeft <= 0 then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Root = Api.RootPart\n\tRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * Api.Config.Speed + Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)\nend" },
		{ Key = "Exit", Value = "function(self)", Accepts = "no arguments",
			Summary = "Your move has stopped, for any reason including one it did not choose. Put back everything Enter borrowed. This runs even when another move interrupted you.",
			Note = "Called from StateMachine.StopState.",
			Code = "function MyMove:Exit()\n\tTimeLeft = 0\n\tApi.RestoreWalkSpeed()\n\tApi.SetCameraOffset(nil)\n\tApi.Humanoid.AutoRotate = true\nend" },
		{ Key = "QuietExit", Value = "function(self) -> boolean", Accepts = "true to keep the exit sound quiet",
			Summary = "Asked right after Exit. Return true when this stop was not a real end, the way a wall run that only hit a gap does, and your block's ExitSoundId does not play.",
			Note = "Called from StateMachine.StopState.",
			Code = "local HandedOn = false\n\nfunction MyMove:QuietExit()\n\treturn HandedOn\nend" },
		{ Key = "AnimationSpeedTrack", Value = "function(self) -> (settings, track, sideways)", Accepts = "a setting from your block and the looping track playing now",
			Summary = "Makes your move's looping clip play faster the faster the body moves. Return a setting table from your block (Enabled, MinSpeed, MaxSpeed, MaxMultiplier), the track playing now, and true to count sideways speed only. Return nil when nothing should speed up.",
			Note = "Asked by the engine every tick while your move runs.",
			Code = "-- in the block: SurgeAnimationSpeed = { Enabled = true, MinSpeed = 70, MaxSpeed = 92, MaxMultiplier = 1.3 },\nlocal Loop = nil\n\nfunction MyMove:AnimationSpeedTrack()\n\treturn Api.Config.SurgeAnimationSpeed, Loop, true\nend" },
		{ Key = "Cleanup", Value = "function(self)", Accepts = "no arguments",
			Summary = "The character is going away, usually because the player died or respawned. Disconnect anything you connected and destroy anything you made.",
			Note = "Called by MovementLifecycle when the character goes.",
			Code = "local Trail = nil\n\nfunction MyMove:Cleanup()\n\tif Trail then\n\t\tTrail:Destroy()\n\t\tTrail = nil\n\tend\nend" },
	},
}
