return {
	Name = "Block",
	Title = "What a block gives you",
	Blurb = "Keys the engine honours for any move, no code",
	Summary = "A config block is not only your tuning. The state machine, the effects, the input and the camera all read a move's block by its name, so a custom move gets the same treatment as a shipped one by writing the keys.",
	Notes = {
		"Every key here is optional. A block without it simply does not get that behaviour.",
		"The shipped blocks are the reference: copy a key from one, the name and the shape are the same for yours.",
	},
	Rows = {
		{ Key = "Cooldown, ManualCooldown", Value = "started for you",
			Summary = "Every start of your move starts its cooldown and a start during it is refused. ManualCooldown = true leaves the timing to Api.StartCooldown.",
			Code = "Config.MyMove = {\n\tEnabled = true,\n\tKeyCode = Enum.KeyCode.H,\n\tCooldown = 2,\n}" },
		{ Key = "StaminaCost, StaminaDrainPerSecond", Value = "spent for you, drained by you",
			Summary = "StaminaCost is taken at every start and the start is refused when it is not there. StaminaDrainPerSecond keeps the stamina service awake while your move runs, the draining itself is your Api.DrainStamina call in Update.",
			Code = "Config.MyMove = {\n\tStaminaCost = 15,\n\tStaminaDrainPerSecond = 6,\n}\n\nfunction MyMove:Update(DeltaTime)\n\tif not Api.DrainStamina(Api.Config.StaminaDrainPerSecond, DeltaTime) then Api.Stop() end\nend" },
		{ Key = "MinEntrySpeed, BlockedDuring, RequireClearance", Value = "checked before a start",
			Summary = "Too slow, during a move or state in the list, or without a clear box of that size around the root, and the start is refused with a reason Core.Debug prints.",
			Code = "Config.MyMove = {\n\tMinEntrySpeed = 12,\n\tBlockedDuring = { \"SlideModule\", \"Swimming\" },\n\tRequireClearance = Vector3.new(3, 5, 3),\n}" },
		{ Key = "EnterSoundId, FOV, Haptics, CameraShake", Value = "played at every start",
			Summary = "The enter sound, the field of view push, the rumble and the Start shake event all come from the block, nothing to call. Api.Shake plays the other shake events you name in CameraShake.",
			Code = "Config.MyMove = {\n\tEnterSoundId = 0,\n\tFOV = { Enabled = true, Change = 8, InTime = 0.15, OutTime = 0.3 },\n\tHaptics = { Enabled = true, Intensity = 0.4, Duration = 0.15 },\n\tCameraShake = { Enabled = true, Intensity = 0.3, Duration = 0.2 },\n}" },
		{ Key = "Vfx and the other effect slots", Value = "fire with the state",
			Summary = "An effect slot in your block plays when the move starts, is kept alive while it runs and stops when it ends, and with Core.ReplicateVfx on other players see it. Its body is written the way the Effects page describes.",
			Code = "Config.MyMove = {\n\tVfx = {\n\t\tEnabled = true, Time = \"Duration\",\n\t\tFunction = function(Context)\n\t\t\treturn Context.Default()\n\t\tend,\n\t},\n}" },
		{ Key = "R6, R15", Value = "the animation branches",
			Summary = "Api.Animation(\"Surge\") reads SurgeAnimationId from the branch of the rig you are on, so one block serves both rigs. The animation matcher in the Install tab fills these too.",
			Code = "Config.MyMove = {\n\tR6 = { SurgeAnimationId = 0 },\n\tR15 = { SurgeAnimationId = 0 },\n}" },
		{ Key = "KeyCode, ConsoleInput", Value = "bound for you",
			Summary = "A block with a KeyCode is bound at spawn and reaches your BindKey callback as Begin and End. On a phone it gets a touch button, in the slot TouchButtons.Actions names for it or the next free one.",
			Code = "Config.MyMove = {\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n}\n\n-- in the module\nApi.BindKey(function(_, InputState)\n\tif InputState == \"Begin\" then Api.Start() end\nend)" },
		{ Key = "OnEnter, OnExit", Value = "functions in the block",
			Summary = "Run with the manager right after the move starts and right after it has fully ended, the second one also gets how many seconds it lasted. A move's OnExit always runs before the next move's OnEnter. For a game to tune what happens around your move without touching the module.",
			Code = "Config.MyMove = {\n\tOnExit = function(Manager, Seconds)\n\t\tManager.Locomotion.Boost(1.3, 1)\n\tend,\n}" },
		{ Key = "Elsewhere in the config", Value = "by your module's name",
			Summary = "CameraModule.Moves.MyMove gives the move its own camera feel, Momentum.Deposits.MyMove lets it feed the chain, StateTransitions.Map decides what may follow it, Core.AllowedInWater and AllowedWhileClimbing let it start there, and any other move may name it in its BlockedDuring.",
			Code = "Config.CameraModule.Moves.MyMove = { Smoothing = { BankDegrees = 5, LungeStuds = 0.5 } }\nConfig.Momentum.Deposits.MyMove = 4\nConfig.StateTransitions.Map.MyMove = { \"DashModule\", \"Jump\" }" },
	},
}
