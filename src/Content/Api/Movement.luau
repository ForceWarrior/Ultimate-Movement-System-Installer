return {
	Name = "Movement",
	Title = "Speed and momentum",
	Blurb = "Borrowing humanoid properties without a fight",
	Summary = "Anything that writes a humanoid property goes through here, because two writers on WalkSpeed is the usual way to make movement twitch. The kit remembers what it borrowed and puts it back.",
	Notes = {
		"Always pair a borrow with RestoreWalkSpeed in Exit, including the Exit you did not choose.",
		"SetDefaultAnimations(false) turns off Roblox's own Animate script, which you want while your move drives the body itself.",
	},
	Rows = {
		{ Key = "Api.Momentum(FeatureKey, BaseSpeed)", Value = "-> number",
			Summary = "The speed your move should run at, with the game's momentum settings applied. Pass your feature key so the right tuning is used.",
			Code = "function MyMove:Update(DeltaTime)\n\tlocal Speed = Api.Momentum(\"MyMove\", Api.Config.Speed)\n\tlocal Root = Api.RootPart\n\tRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * Speed\n\t\t+ Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)\nend" },
		{ Key = "Api.BaseWalkSpeed()", Value = "-> number",
			Summary = "The walk speed the character had before anything borrowed it. Scale from this, not from the current value.",
			Code = "function MyMove:Enter()\n\tApi.Humanoid.WalkSpeed = Api.BaseWalkSpeed() * 0.4\nend" },
		{ Key = "Api.RestoreWalkSpeed()", Value = "no return",
			Summary = "Puts the walkspeed back to that baseline. Call it in Exit, every time. Once your move has stopped, the kit eases the player from their current speed back up to it.",
			Code = "function MyMove:Exit()\n\tApi.RestoreWalkSpeed()\nend" },
		{ Key = "Api.Boost(Multiplier, Seconds)", Value = "no return",
			Summary = "Scales the walk and run speed for a while, then lets it fall back on its own. Nothing to restore and no landing window, the same call a config hook makes through Manager.Locomotion.Boost.",
			Code = "function MyMove:Exit()\n\t-- a second and a half of extra pace after the move\n\tApi.Boost(1.4, 1.5)\nend" },
		{ Key = "Api.SetJumpEnabled(Enabled)", Value = "no return",
			Summary = "Turns jumping off and on. The kit tracks who turned it off, so your move cannot leave a player permanently unable to jump.",
			Code = "function MyMove:Enter()\n\tApi.SetJumpEnabled(false)\nend\n\nfunction MyMove:Exit()\n\tApi.SetJumpEnabled(true)\nend" },
		{ Key = "Api.SetDefaultAnimations(Enabled)", Value = "no return",
			Summary = "Enables or disables Roblox's stock Animate script. Turn it off while your own animation is playing, or the two fight over the same joints.",
			Code = "function MyMove:Enter()\n\tApi.SetDefaultAnimations(false)\n\tif Track then Track:Play(0.1) end\nend\n\nfunction MyMove:Exit()\n\tif Track then Track:Stop(0.1) end\n\tApi.SetDefaultAnimations(true)\nend" },
		{ Key = "Api.Claim(Property, Value)", Value = "no return",
			Summary = "Takes one body property for your move: AutoRotate, Anchored, WalkSpeed, Jump, CameraOffset or Animate. The kit remembers the old value and puts it back when your move stops.",
			Code = "function MyMove:Enter()\n\tApi.Claim(\"AutoRotate\", false)\n\tApi.Claim(\"WalkSpeed\", 6)\nend" },
		{ Key = "Api.Release(Property)", Value = "no return",
			Summary = "Gives a claimed property back while your move is still running. When the move stops the kit gives back everything it claimed anyway.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.Humanoid.FloorMaterial ~= Enum.Material.Air then Api.Release(\"AutoRotate\") end\nend" },
		{ Key = "Api.Push(Force)", Value = "-> LinearVelocity",
			Summary = "A velocity mover on the root part that the kit deletes when your move stops. Force is the most force it may use on each axis, set VectorVelocity to drive it.",
			Code = "function MyMove:Enter()\n\tlocal Push = Api.Push(Vector3.new(50000, 0, 50000))\n\tPush.VectorVelocity = Api.RootPart.CFrame.LookVector * 60\nend" },
		{ Key = "Api.Outro(Seconds)", Value = "no return",
			Summary = "Keeps everything your move claimed for a few more seconds after it stops, for a recovery animation or a slide out. Moves with a BlockedDuring list wait for it, any move that does start ends it early.",
			Code = "function MyMove:Exit()\n\tApi.Outro(0.3)\nend" },
	},
}
