		{ Key = "Api.Utils", Value = "table",
			Summary = "The shared helpers the engine publishes, by module: MovementUtil carries RootStandHeight, GetTagged, LongestAxis, NewThrottle, NewTickContext, NewHoldRig, NewSurfaceTracker and ResolvePath, MovementVFXManager carries Play, GetEffect and SetEffectEmitting. Frozen, nothing in it can be replaced.",
			Code = "local Util = Api.Utils.MovementUtil\nlocal Probe = Util.RootStandHeight(Api.IsR6, Api.Humanoid, Api.RootPart) + Api.Config.GroundCheckDistance\n\nfor _, Part in Util.GetTagged(\"Climbable\") do\n\tprint(Part.Name)\nend" },
	},
