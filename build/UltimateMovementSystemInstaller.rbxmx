	["Core.TouchJumpHoldGrace"] = { Summary = "How long a touch jump counts as held after the finger lifts.", Accepts = "seconds" },
	["Core.TouchJumpReleaseDelay"] = { Summary = "How long after a touch jump the button counts as released.", Accepts = "seconds" },
	["Core.UnclimbableTags.[].Blocks"] = { Summary = "Which moves this tag blocks.", Accepts = "\"All\" or a list of module names" },
	["Core.UnclimbableTags.[].Tag"] = { Summary = "Parts with this tag cannot be climbed, run on or grabbed.", Accepts = "a tag name" },
	["Core.UpdatesPerSecond"] = { Summary = "How many times a second the moves update. Lower costs less, higher notices walls, ledges and landings sooner.", Accepts = "20 to 60, 0 for every frame" },
	["Core.VfxBurstBudget"] = { Summary = "How many effects may start in the same frame.", Accepts = "a whole number" },
	["Core.VfxBurstQueueLimit"] = { Summary = "How many effects may wait their turn before extra ones are dropped.", Accepts = "a whole number" },
	["Core.VfxDebrisPoolLimit"] = { Summary = "How many debris pieces are kept ready.", Accepts = "a whole number" },
	["Core.VfxPoolLimit"] = { Summary = "How many copies of each effect are kept ready.", Accepts = "a whole number" },
	["CrouchModule.AutoCrouch"] = { Summary = "Crouches by itself under a low ceiling.", Accepts = "true or false" },
	["CrouchModule.AutoCrouchCheckDistance"] = { Summary = "How far above the head the auto crouch looks.", Accepts = "studs" },
	["CrouchModule.BlendTime"] = { Summary = "How long getting into and out of the crouch takes, the animations blend and your speed eases down to Speed.", Accepts = "seconds, 0 for a cut" },
	["CrouchModule.BlockInConfinedSpaces"] = { Summary = "Refuses to crouch where there is no room.", Accepts = "true or false" },
	["CrouchModule.BlockTrussClimb"] = { Summary = "No truss climbing while crouched.", Accepts = "true or false" },
	["CrouchModule.BlockedDuring"] = { Summary = "Moves that stop a crouch from starting.", Accepts = "a list of module names" },
	["CrouchModule.BodyRadius"] = { Summary = "How wide the body counts as when checking for room.", Accepts = "studs" },
	["CrouchModule.BulletJump"] = { Summary = "Holding the crouch key while crouched charges a long jump, let go or press jump to fire it. MovementChargeBar in StarterGui shows the charge.", Accepts = "true or false" },
	["CrouchModule.BulletJumpMaxCharge"] = { Summary = "How long the charge takes to reach full power.", Accepts = "seconds" },
	["CrouchModule.BulletJumpMaxSpeed"] = { Summary = "The speed of a fully charged bullet jump.", Accepts = "studs per second" },
	["CrouchModule.BulletJumpMinHold"] = { Summary = "How long the crouch key must be held before a bullet jump counts, shorter presses just crouch or stand.", Accepts = "seconds" },
	["CrouchModule.BulletJumpMinSpeed"] = { Summary = "The speed of the weakest bullet jump.", Accepts = "studs per second" },
	["CrouchModule.BulletJumpReleaseAtFull"] = { Summary = "Only with Mode Toggle: a full charge launches the bullet jump by itself instead of waiting for you to let go or press jump.", Accepts = "true or false" },
	["CrouchModule.BulletJumpSoundId"] = { Summary = "The sound of a bullet jump.", Accepts = "a path to its Sound, a sound id, or 0 for none" },
	["CrouchModule.BulletJumpStaminaCost"] = { Summary = "Stamina taken by a bullet jump.", Accepts = "stamina points, 0 for free" },
	["CrouchModule.BulletJumpStopTime"] = { Summary = "How long the bullet jump animation plays before it fades out.", Accepts = "seconds" },
	["CrouchModule.BulletJumpUpShare"] = { Summary = "How much of the bullet jump goes upward rather than forward.", Accepts = "0 to 1" },
	["CrouchModule.CameraOffset"] = { Summary = "Where the third person camera sits while crouched, first person follows your head instead.", Accepts = "a Vector3 in studs" },
	["CrouchModule.CameraOffsetInTime"] = { Summary = "How long the third person camera takes to settle into CameraOffset when the move starts.", Accepts = "seconds, 0 for instant" },
	["CrouchModule.CameraOffsetOutTime"] = { Summary = "How long the third person camera takes to rise back when the move ends.", Accepts = "seconds, 0 for instant" },
	["CrouchModule.CameraShake"] = { Summary = "A camera shake when the crouch starts.", Accepts = "{ Enabled, Intensity, Duration }" },
