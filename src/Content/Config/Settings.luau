function ConfigSettingDocs.For(Path)
	local Entries = ConfigSettingDocs.Entries
	local Shape = Path:gsub("%[%d+%]", "[]")
	local Found = Entries[Path] or Entries[Shape]
	if Found then
		return Found
	end
	local Head, Last = Shape:match("^(.*)%.([^%.]+)$")
	if not Head then
		return nil
	end
	return Entries["*." .. Last] or Entries[Head .. ".*"]
end

function ConfigSettingDocs.Count()
	local Total = 0
	for _ in ConfigSettingDocs.Entries do
		Total += 1
	end
	return Total
end

return ConfigSettingDocs
