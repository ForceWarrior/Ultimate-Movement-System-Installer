return {
	Name = "Outside",
	Title = "Outside hooks",
	Blurb = "Holds, the manager, reloads and the config checks, for code that is not a move",
	Summary = "Code that is not a custom move can still work with the kit: hold it still while something else has the body, reach the manager, restart it, and ask the config checks what a value may be. A ragdoll, a cutscene, a stun or an editor of your own all go through these.",
	Notes = {
		"Every hold stops the running move and refuses every move until it lets go.",
		"The manager is built again at every spawn and every Reload, so fetch it when you need it rather than keeping it.",
	},
	Rows = {
		{ Key = "MovementHold", Value = "an attribute on the character", Accepts = "true, or any name",
			Summary = "Holds the kit while it is set. The server or the player's own client can set it, clearing it lets go.",
			Code = "-- when the ragdoll, stun or cutscene starts\nCharacter:SetAttribute(\"MovementHold\", \"Ragdoll\")\n\n-- when it ends\nCharacter:SetAttribute(\"MovementHold\", nil)" },
		{ Key = "PlatformStand and Physics", Value = "held by themselves",
			Summary = "While no move runs, a humanoid with PlatformStand on or in the Physics state holds the kit the same way, so most ragdolls need no code. One that starts in the middle of a move only holds once that move ends, set MovementHold for those.",
			Note = "The Ragdoll humanoid state is no hold, and Core.SuppressTripStates keeps the humanoid out of it. While Core.DisableCollisionOnDeath is on, every part but the root and the torso stops colliding on death, switch it off for a death ragdoll." },
		{ Key = "Manager:SetExternalOverride(Name)", Value = "no return", Accepts = "a name, or nil to let go",
			Summary = "The same hold from client code. The attribute and PlatformStand holds only start while no hold of yours is set, and only ever release their own.",
			Code = "local MovementMain = require(game.ReplicatedStorage.Modules.Movement.MovementMain)\nlocal Manager = MovementMain.GetManager()\nif Manager then\n\tManager:SetExternalOverride(\"Cutscene\")\n\ttask.wait(3)\n\tManager:SetExternalOverride(nil)\nend" },
		{ Key = "MovementMain.GetManager()", Value = "-> Manager?",
			Summary = "The kit's manager for the local character. It is nil before the first spawn, and from the moment a dead character is removed until the next spawn has loaded the kit. Its States table holds every loaded move by name, custom ones included.",
			Code = "local MovementMain = require(game.ReplicatedStorage.Modules.Movement.MovementMain)\nlocal Manager = MovementMain.GetManager()\nif Manager and Manager.ActiveState then\n\tprint(\"running\", Manager.ActiveState)\nend" },
		{ Key = "MovementMain.Reload()", Value = "-> Manager?",
			Summary = "Builds the kit again on the local character from MovementConfig as it is now, extras included, and returns the new manager once it is built, so it waits a moment. For the keys a move reads once at spawn, such as Enabled. The rebuild always runs on MovementController, so it is safe to call from a script that is destroyed right after.",
			Code = "local Movement = game.ReplicatedStorage.Modules.Movement\nlocal MovementConfig = require(Movement.MovementConfig)\nlocal MovementMain = require(Movement.MovementMain)\n\nMovementConfig.MovementTemplate.Enabled = true\nMovementMain.Reload()" },
		{ Key = "ConfigValidator.Validate(Config)", Value = "-> { string }",
			Summary = "Runs the checks the kit runs at spawn and returns one line per problem, an empty list when the config is clean. A report that differs from the last one is also warned in the Output. The values in a Custom module's block are left to that module, only its name lists are checked.",
			Code = "local Movement = game.ReplicatedStorage.Modules.Movement\nlocal ConfigValidator = require(Movement.Engine.ConfigValidator)\nlocal MovementConfig = require(Movement.MovementConfig)\n\nlocal Problems = ConfigValidator.Validate(MovementConfig)\nprint(#Problems == 0 and \"clean\" or table.concat(Problems, \"\\n\"))" },
		{ Key = "ConfigValidator.Choices(Path, Key)", Value = "-> { string }?",
			Summary = "The words a value may be: every move and state name for an entry of a name list, the allowed words for a mode. nil when any value goes. Path is the table the key sits in, written the way the Output writes it.",
			Code = "ConfigValidator.Choices(\"DashModule\", \"Mode\")\nConfigValidator.Choices(\"Core.AllowedInWater\", 1)" },
		{ Key = "ConfigValidator.KeyChoices(Path)", Value = "-> { string }?",
			Summary = "The names a new key may take in a table keyed by move or state, such as StateTransitions.Map or CameraModule.Moves. nil for any other table.",
			Code = "ConfigValidator.KeyChoices(\"StateTransitions.Map\")" },
		{ Key = "ConfigValidator.Blank(Path)", Value = "-> table?",
			Summary = "An empty entry for a list whose entries share one shape, every field at zero, false, an empty string or an empty table. nil for any other list.",
			Code = "table.insert(MovementConfig.VaultingModule.Variants, ConfigValidator.Blank(\"VaultingModule.Variants\"))" },
	},
}
