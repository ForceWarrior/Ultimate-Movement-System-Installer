return {
	Name = "State",
	Title = "Starting and stopping",
	Blurb = "Asking for the body",
	Summary = "Your move does not simply run. It asks, and the answer depends on what is already active, the transition rules and your own CanEnter. A refusal is normal.",
	Rows = {
		{ Key = "Api.Start()", Value = "-> boolean",
			Summary = "Ask to start your move. Returns false if it was refused.",
			Code = "if not Api.Start() then\n\tApi.Log.Debug(\"could not start:\", Api.Config.Name)\nend" },
		{ Key = "Api.Stop()", Value = "-> boolean",
			Summary = "Stop your move and hand the body back. Your Exit is called for you.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.Stamina() <= 0 then\n\t\tApi.Stop()\n\tend\nend" },
		{ Key = "Api.IsActive()", Value = "-> boolean",
			Summary = "Is your move the one that currently owns the body. Worth checking at the top of Update if you also do work from a key binding.",
			Code = "Api.BindKey(function(_, InputState)\n\tif InputState ~= \"Begin\" then return end\n\tif Api.IsActive() then\n\t\tApi.Stop()\n\telse\n\t\tApi.Start()\n\tend\nend)" },
		{ Key = "Api.ActiveMove()", Value = "-> string?",
			Summary = "The name of whichever move owns the body, or nil when none does.",
			Code = "if Api.ActiveMove() == \"SlideModule\" then\n\t-- do not fight the slide\n\treturn\nend" },
		{ Key = "Api.HasFlag(Name)", Value = "-> boolean",
			Summary = "Does the ACTIVE move declare that capability flag. Use it to stand down while something else has taken over the facing or the head.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Api.HasFlag(\"OwnsFacing\") then\n\t\treturn -- something else is steering, leave it alone\n\tend\nend" },
		{ Key = "Api.Refuse(Reason)", Value = "-> false",
			Summary = "Records why your move said no and returns false, so CanEnter reads as one line per condition. The reason lands in Manager.LastRefusalReason.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\tif Api.Stamina() < 10 then return Api.Refuse(\"not enough stamina\") end\n\treturn true\nend" },
		{ Key = "Api.OnMoveStarted(Callback)", Value = "-> RBXScriptConnection",
			Summary = "Calls you with the name of every move that starts, your own included. Connect in Init, disconnect in Cleanup.",
			Code = "local Connection = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tConnection = Api.OnMoveStarted(function(Name)\n\t\tif Name ~= Api.Name then\n\t\t\tApi.Log.Debug(Name, \"started\")\n\t\tend\n\tend)\nend\n\nfunction MyMove:Cleanup()\n\tif Connection then Connection:Disconnect() end\nend" },
		{ Key = "Api.OnMoveStopped(Callback)", Value = "-> RBXScriptConnection",
			Summary = "The other half: the name of every move that ends, your own included. The same rule, connect in Init, disconnect in Cleanup.",
			Code = "local Connection = nil\n\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tConnection = Api.OnMoveStopped(function(Name)\n\t\tif Name == \"DashModule\" then\n\t\t\t-- the dash just ended, a follow up may start now\n\t\tend\n\tend)\nend\n\nfunction MyMove:Cleanup()\n\tif Connection then Connection:Disconnect() end\nend" },
		{ Key = "Api.Move(Name)", Value = "-> table?",
			Summary = "A frozen copy of another move, for the questions it answers about itself: IsGliding, IsDashing, IsCrouching and the like. Its methods work, writing to it errors. nil when no such move is loaded.",
			Code = "local Glide = Api.Move(\"GlideModule\")\nif Glide and Glide:IsGliding() then\n\treturn Api.Refuse(\"not while gliding\")\nend" },
		{ Key = "Api.StopAll()", Value = "-> nothing",
			Summary = "Stops whichever move owns the body, for when something outside the kit already decided.",
			Code = "if not Api.Start() then\n\tApi.StopAll()\n\tApi.Start()\nend" },
	},
}
