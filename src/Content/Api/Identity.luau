return {
	Name = "Identity",
	Title = "Identity and character",
	Blurb = "The fields the Api carries",
	Summary = "Plain fields, set once when the Api is built for your module. The character fields are safe to hold onto for the life of the module.",
	Rows = {
		{ Key = "Api.Version", Value = "number",
			Summary = "The contract version this build provides. Compare it if you want your module to behave differently on a newer kit.",
			Code = "if Api.Version >= 2 then\n\t-- something only a newer kit has\nend" },
		{ Key = "Api.SystemVersion", Value = "string",
			Summary = "The kit's own version, currently 1.0. Kept separate from the Api version on purpose, so the kit can move without the contract breaking.",
			Code = "Api.Log.Debug(\"running on movement system\", Api.SystemVersion)" },
		{ Key = "Api.Name", Value = "string",
			Summary = "Your module's name, the same one the config uses.",
			Code = "if Api.ActiveMove() == Api.Name then\n\t-- the same thing Api.IsActive() answers\nend" },
		{ Key = "Api.Config", Value = "table",
			Summary = "Your block in MovementConfig, exactly as written. Read it live rather than copying values at startup, or editing the config mid game does nothing.",
			Code = "-- good, reads the value every time\nfunction MyMove:Update(DeltaTime)\n\tMove(Api.Config.Speed * DeltaTime)\nend\n\n-- bad, frozen at whatever it was when the file loaded\nlocal Speed = Api.Config.Speed" },
		{ Key = "Api.Character", Value = "Model",
			Summary = "The character this Api was built for. Use it to find parts and accessories.",
			Code = "local Head = Api.Character:FindFirstChild(\"Head\")\nlocal Left = Api.Character:FindFirstChild(\n\tApi.IsR6 and \"Left Leg\" or \"LeftFoot\")" },
		{ Key = "Api.Humanoid", Value = "Humanoid",
			Summary = "Its humanoid. Prefer the Api's own helpers for walkspeed and jumping, so two writers do not fight over the same property.",
			Code = "if Api.Humanoid:GetState() == Enum.HumanoidStateType.Freefall then\n\t-- in the air\nend" },
		{ Key = "Api.RootPart", Value = "BasePart",
			Summary = "The HumanoidRootPart. Writing AssemblyLinearVelocity on it is the simplest way to move a body, and it leaves nothing behind to clean up.",
			Code = "local Root = Api.RootPart\n\n-- push forward, keep whatever vertical speed gravity gave us\nRoot.AssemblyLinearVelocity = Root.CFrame.LookVector * 80\n\t+ Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)" },
		{ Key = "Api.IsR6", Value = "boolean",
			Summary = "Which rig this is. Offsets, part names and animation ids all differ between R6 and R15, so most moves need it somewhere.",
			Code = "local Offset = Api.IsR6\n\tand Vector3.new(0, -2.8, 0)\n\tor Vector3.new(0, -2.5, 0)" },
		{ Key = "Api.Blocks", Value = "table",
			Summary = "Every block of MovementConfig, live and read only all the way down: another move's numbers can be read, writing any of them errors. Api.Config is yours. Loop it with for Name, Block in Api.Blocks do, pairs() sees nothing through it.",
			Code = "local Run = Api.Blocks.LocomotionModule.RunSpeed\nlocal Debugging = Api.Blocks.Core.Debug" },
		{ Key = "Api.Tick", Value = "table",
			Summary = "The frame snapshot the engine works from: Grounded, FloorMaterial, MoveDirection, Active for the move that owns the body, Held, OwnsFacing, OwnsHead. Read only, writing to it errors. Loop it with for in, pairs() sees nothing through it.",
			Code = "function MyMove:Confirm()\n\treturn Api.Tick.Grounded and Api.Tick.MoveDirection.Magnitude > 0.1\nend" },
		{ Key = "Api.Tracks", Value = "table",
			Summary = "Your block's animations, loaded once at spawn from the branch of the rig you are on: SurgeAnimationId becomes Api.Tracks.Surge. The same tracks Api.Animation hands out, without the call.",
			Code = "local Surge = Api.Tracks.Surge\nif Surge then Surge:Play(0.1) end" },
		{ Key = "Api.Locomotion", Value = "table",
			Summary = "The walk, run and landing queries and controls the shipped moves share: IsSprinting, IsJumping, IsFalling, IsLanding, InAirState, HasAirJumpsLeft, FloorPart, AmbientForce, IsRollArmed, RollWillStart, IsRolling, IsWallSliding, HoldsFacing, CancelLanding, CancelJumpAnimation, PlayJumpAnimation, TriggerLanding, TriggerCustomLanding, Boost, SlowForCharge. A frozen copy, writing to it errors.",
			Code = "if Api.Locomotion.IsSprinting() then\n\tApi.Locomotion.CancelLanding()\nend" },
		{ Key = "Api.Vision", Value = "table",
			Summary = "The look ahead the wall moves share, one raycast per direction per frame however many moves ask: Ahead(Distance), AheadFlat(Distance), Side(Sign, Distance), SideWide(Sign, Distance, Radius). Cheaper than a raycast of your own in Confirm. A frozen copy, writing to it errors.",
			Code = "function MyMove:Confirm()\n\tlocal Wall = Api.Vision.Ahead(4)\n\treturn Wall ~= nil and not Api.SurfaceRefused(Wall)\nend" },
		{ Key = "Api.Log", Value = "{ Debug, Warn }",
			Summary = "A logger tagged with your module name. Debug only prints while Core.Debug is on, so you can leave the calls in.",
