return {
	Name = "Camera",
	Title = "Camera and feel",
	Blurb = "Offset, shake, field of view, rumble and what the camera is doing",
	Summary = "Several moves can ask for a camera offset without overwriting each other. Shakes are named in the config, so a game can retune them without touching your module.",
	Rows = {
		{ Key = "Api.SetCameraOffset(Offset, Seconds)", Value = "no return",
			Summary = "Sets a camera offset for your move. Seconds is optional: give it and the third person camera glides there over that time, leave it out and it moves at once. Pass nil to give it back. Always give it back in Exit.",
			Code = "function MyMove:Enter()\n\t-- drop the camera as if the player crouched\n\tApi.SetCameraOffset(Vector3.new(0, -1.5, 0), 0.15)\nend\n\nfunction MyMove:Exit()\n\tApi.SetCameraOffset(nil, 0.3)\nend" },
		{ Key = "Api.SetCharge(Seconds)", Value = "no return",
			Summary = "Shows your move's charge on MovementChargeBar, given the seconds left until it is full. Pass nil to hide it. It also hides when your move stops or the character resets.",
			Code = "function MyMove:Enter()\n\tApi.SetCharge(Api.Config.ChargeTime)\nend\n\nfunction MyMove:Exit()\n\tApi.SetCharge(nil)\nend" },
		{ Key = "Api.ApplyFOV(Settings)", Value = "no return",
			Summary = "A field of view push held while your move runs, from a table shaped like the FOV block: Enabled, Change, InTime, OutTime. The kit already does this at start from your block's FOV, this is for a push that depends on what the move is doing.",
			Code = "function MyMove:Update(DeltaTime)\n\tif Speed > 40 then\n\t\tApi.ApplyFOV({ Enabled = true, Change = 10, InTime = 0.2, OutTime = 0.4 })\n\tend\nend" },
		{ Key = "Api.ReleaseFOV()", Value = "no return",
			Summary = "Lets the field of view go. Call it in Exit when you applied one yourself.",
			Code = "function MyMove:Exit()\n\tApi.ReleaseFOV()\nend" },
		{ Key = "Api.Haptic(Intensity, Duration)", Value = "no return",
			Summary = "A controller rumble, 0 to 1 for Duration seconds, on the pad that is playing. Nothing happens on keyboard or touch.",
			Code = "function MyMove:Enter()\n\tApi.Haptic(0.5, 0.2)\nend" },
		{ Key = "Api.FirstPerson()", Value = "-> boolean",
			Summary = "Is the camera in first person right now, as the kit's camera sees it.",
			Code = "if Api.FirstPerson() then\n\tApi.SetCameraOffset(Vector3.new(0, -0.3, 0))\nend" },
		{ Key = "Api.CameraSteers()", Value = "-> boolean",
			Summary = "Should the camera direction steer the move rather than the move input: true under shift lock or in first person, the rule the glide and the slide follow.",
			Code = "local Direction = Api.CameraSteers() and workspace.CurrentCamera.CFrame.LookVector or Api.Humanoid.MoveDirection" },
		{ Key = "Api.Shake(EventName)", Value = "-> boolean",
			Summary = "Fires a named shake from your module's own shake config. Returns false when that event is not configured or shake is off, so it is safe to call blindly.",
			Code = "-- with Config.MyMove = { CameraShake = { Enabled = true, Intensity = 0.3, Duration = 0.2, Land = { Intensity = 0.6, Duration = 0.4 } } }\nfunction MyMove:Enter()\n\tApi.Shake(\"Land\")\nend" },
	},
}
