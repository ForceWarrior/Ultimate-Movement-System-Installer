return {
	Name = "Example",
	Title = "The template, end to end",
	Blurb = "What MovementTemplate does and every Api call it makes",
	Summary = "MovementTemplate is a working move: a short surge forward on H. It refuses in the air, on cooldown, without stamina or with a wall ahead, holding the key extends it, jumping or the cancel key ends it. It needs no animation or sound and ships off. Copy it, rename it, give the new name a block, strip what you do not need.",
	Notes = {
		"Every value it reads is in Config.MovementTemplate. A custom move has no defaults inside it: no block, no move, and a key missing from the block is nil.",
		"The three animation calls are the only Api members it does not use, so it ships no animation slot. The Animation page shows them.",
		"Api.Log.Debug lines only print while Core.Debug is true, so the template is silent in a shipped game.",
	},
	Rows = {
		{ Key = "1. Identity", Value = "Name, RequiresApi, four flags",
			Summary = "Name follows the script. RequiresApi is the Api version. The four flags say what the move takes over: here it steers the body and nothing else.",
			Code = "local MovementTemplate = {}\nMovementTemplate.Name = script.Name\nMovementTemplate.RequiresApi = 1\nMovementTemplate.LocksMovement = false\nMovementTemplate.OwnsFacing = true\nMovementTemplate.OwnsHead = false" },
		{ Key = "2. Its block", Value = "Config.MovementTemplate",
			Summary = "The block is the whole of its tuning: toggles, keys, speeds and times, the chain settings, the camera offset and shake, and two sound slots at 0.",
			Code = "Config.MovementTemplate = {\n\t--// [Toggles]\n\tEnabled = false,\n\tHoldToExtend = true,\n\tFollowSlopes = true,\n\tAllowJumpOut = true,\n\tEndInAir = true,\n\t--// [Keys]\n\tKeyCode = Enum.KeyCode.H,\n\tConsoleInput = Enum.KeyCode.DPadRight,\n\tCancelKey = Enum.KeyCode.X,\n\t--// [Values]\n\tSurgeSpeed = 70,\n\tSurgeDuration = 0.25,\n\tCooldown = 2,\n\tSurgeStaminaCost = 10,\n\tChainMoves = { \"DashModule\", \"SlideModule\" },\n\t--// [Sounds]\n\tSurgeSoundId = 0,\n\tEndSoundId = 0,\n}" },
		{ Key = "3. Init", Value = "Sound, Utils, OnMoveStarted, BindKey, ClaimJump, ClaimKey",
			Summary = "Runs once per spawn. It resolves the sounds, watches which moves start so a dash or slide can arm the chain bonus, binds the key, and claims the jump and cancel presses by priority.",
			Code = "function MovementTemplate:Init(NewApi: MovementTypes.Api)\n\tself:Cleanup()\n\tApi = NewApi\n\tApi.Log.Debug(Api.Name, \"on Api v\" .. Api.Version, \"system\", Api.SystemVersion)\n\n\tSurgeSound = Api.Sound(Api.Config.SurgeSoundId, \"Surge\")\n\tEndSound = Api.Sound(Api.Config.EndSoundId, \"End\")\n\tProbeDistance = Api.Utils.MovementUtil.RootStandHeight(Api.IsR6, Api.Humanoid, Api.RootPart) + Api.Config.GroundCheckDistance\n\n\tLifetime = Api.OnMoveStarted(OnMoveStarted)\n\tApi.BindKey(OnInput)\n\tApi.ClaimJump(Api.Config.JumpOutPriority, CanJumpOut, JumpOut)\n\tApi.ClaimKey(Api.Config.CancelKey, Api.Config.CancelPriority, Api.IsActive, Api.Stop)\nend" },
		{ Key = "4. The key press", Value = "Start, ActiveMove, HasFlag, StopAll",
			Summary = "Tries Api.Start. If another move refused it and InterruptOtherMoves is on, a move that locks the body is left alone and anything else is stopped so the surge can start.",
			Code = "local function OnInput(_, InputState: string)\n\tif InputState ~= \"Begin\" then return end\n\tif Api.Start() then return end\n\tlocal Active = Api.ActiveMove()\n\tif Active == nil or not Api.Config.InterruptOtherMoves then return end\n\tif Api.HasFlag(\"LocksMovement\") then\n\t\tApi.Log.Debug(Active, \"is holding the body\")\n\t\treturn\n\tend\n\tApi.StopAll()\n\tApi.Start()\nend" },
		{ Key = "5. CanEnter", Value = "OnGround, OnCooldown, StaminaEnabled, Stamina, Raycast, Refuse",
			Summary = "Every refusal names itself through Api.Refuse, so the debug output says why a press did nothing. WallAhead is one raycast ahead.",
			Code = "function MovementTemplate:CanEnter(): boolean\n\tif not Api.OnGround() then return Api.Refuse(\"in the air\") end\n\tif Api.OnCooldown() then return Api.Refuse(\"on cooldown\") end\n\tif Api.StaminaEnabled() and Api.Stamina() < Api.Config.SurgeStaminaCost then return Api.Refuse(\"not enough stamina\") end\n\tif WallAhead() then return Api.Refuse(\"wall ahead\") end\n\treturn true\nend" },
		{ Key = "6. Enter", Value = "BaseWalkSpeed, Momentum, SpendStamina, SetJumpEnabled, SetDefaultAnimations, SetCameraOffset, PlaySound, Shake",
			Summary = "Works out the speed from the surge speed, momentum and the chain boost, spends the stamina, takes the body over, applies the camera offset, plays the sound and fires the shake.",
			Code = "function MovementTemplate:Enter()\n\tlocal Base = Api.BaseWalkSpeed()\n\tSpeed = math.max(Api.Config.SurgeSpeed, Base) + Api.Momentum(Api.Config.MomentumFeature, Base)\n\tif os.clock() < ChainUntil then\n\t\tSpeed += Api.Config.ChainSpeedBoost\n\tend\n\tTimeLeft = Api.Config.SurgeDuration\n\tHeldFor = 0\n\n\tApi.SpendStamina(Api.Config.SurgeStaminaCost)\n\tApi.Humanoid.WalkSpeed = 0\n\tApi.Humanoid.AutoRotate = false\n\tApi.SetJumpEnabled(Api.Config.AllowJumpOut)\n\tApi.SetDefaultAnimations(not Api.Config.StopDefaultAnimations)\n\tApi.SetCameraOffset(Api.Config.CameraOffset)\n\tApi.Character:SetAttribute(Api.Name, true)\n\n\tApi.PlaySound(SurgeSound)\n\tApi.Shake(\"Start\")\nend" },
		{ Key = "7. Update", Value = "IsActive, IsHeld, DrainStamina, GroundInfo, ProjectOntoSlope, DownhillFactor, Stop",
			Summary = "Runs while the surge owns the body: counts the time down unless the key is held and extending, ends in the air, on a steep slope or at a wall, and drives the body along the ground.",
			Code = "function MovementTemplate:Update(DeltaTime: number)\n\tif not Api.IsActive() then return end\n\tif Api.Config.HoldToExtend and Api.IsHeld() and HeldFor < Api.Config.MaxHoldDuration and Api.DrainStamina(Api.Config.HoldDrainPerSecond, DeltaTime) then\n\t\tHeldFor += DeltaTime\n\telse\n\t\tTimeLeft -= DeltaTime\n\tend\n\tif TimeLeft <= 0 then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, ProbeDistance)\n\tif not Grounded and Api.Config.EndInAir then\n\t\tApi.Stop()\n\t\treturn\n\tend\n\tlocal Direction = SurgeDirection(Normal, Angle)\n\tlocal Velocity = Direction * (Speed + Api.DownhillFactor(Direction, Normal, Angle) * Api.Config.DownhillBoost)\n\tApi.RootPart.AssemblyLinearVelocity = Vector3.new(Velocity.X, math.min(Velocity.Y, Api.Config.MaxVerticalSpeed), Velocity.Z)\nend" },
		{ Key = "8. Exit and Cleanup", Value = "StartCooldown, RestoreWalkSpeed, StopSound",
			Summary = "Exit runs however the surge ended and puts back everything Enter borrowed: cooldown, walk speed, jump, animations, camera, sound. Cleanup runs when the character goes.",
			Code = "function MovementTemplate:Exit()\n\tTimeLeft = 0\n\tHeldFor = 0\n\tApi.StartCooldown(Api.Config.Cooldown)\n\n\tApi.RestoreWalkSpeed()\n\tApi.Humanoid.AutoRotate = true\n\tApi.SetJumpEnabled(true)\n\tApi.SetDefaultAnimations(true)\n\tApi.SetCameraOffset(nil)\n\tApi.Character:SetAttribute(Api.Name, nil)\n\n\tApi.StopSound(SurgeSound)\n\tApi.PlaySound(EndSound)\n\tApi.Shake(\"End\")\nend\n\nfunction MovementTemplate:Cleanup()\n\tif Lifetime then\n\t\tLifetime:Disconnect()\n\t\tLifetime = nil\n\tend\n\tSurgeSound = nil\n\tEndSound = nil\n\tChainUntil = 0\nend" },
		{ Key = "9. Jump out and cancel", Value = "ClaimJump, ClaimKey, IsActive, Stop",
			Summary = "Both claims only answer while the surge is active. Jump ends the surge and jumps, the cancel key just ends it. The higher priority wins a shared press.",
			Code = "local function CanJumpOut(): boolean\n\treturn Api.IsActive() and Api.Config.AllowJumpOut\nend\n\nlocal function JumpOut()\n\tApi.Stop()\n\tApi.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)\nend\n\n-- in Init\nApi.ClaimJump(Api.Config.JumpOutPriority, CanJumpOut, JumpOut)\nApi.ClaimKey(Api.Config.CancelKey, Api.Config.CancelPriority, Api.IsActive, Api.Stop)" },
		{ Key = "10. Making it yours", Value = "copy, rename, block, strip",
			Summary = "Duplicate the ModuleScript, rename it, add a block of that name with Enabled = true. Delete the keys your move does not read, and keep every key it does.",
			Code = "-- MovementMain > Custom > MyMove (a copy of MovementTemplate)\nMyMove.Name = script.Name\n\n-- MovementConfig\nConfig.MyMove = {\n\tEnabled = true,\n\t-- the keys MyMove still reads\n}" },
	},
}
