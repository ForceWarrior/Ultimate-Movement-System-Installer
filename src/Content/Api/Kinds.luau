return {
	Name = "Kinds",
	Title = "When a move may start",
	Blurb = "The four kinds of module, and how one is chosen",
	Summary = "Nothing polls. A key or a humanoid event wakes only the moves that care, and then your move is asked. Which kind your module is comes from the fields it declares.",
	Notes = {
		"Standing still, the only per-frame work in the whole system is the ambient lane. The engine step is not even scheduled.",
		"MovementConfig.StateTransitions decides what may follow what. A move that never seems to start is often filtered there rather than refusing in CanEnter.",
		"Manager.LastRefusalReason holds the last reason a move said no, which is why Api.Refuse takes a string.",
	},
	Rows = {
		{ Key = "Triggered", Value = "declares neither", Accepts = "no extra fields",
			Summary = "Runs only when you ask it to, usually from a key. This is what the template is, and what most custom moves want. Start here unless you have a reason not to.",
			Note = "Dash and Slide are triggered.",
			Code = "-- no Requires, no StepWhileAirborne\nfunction MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.BindKey(function(_, InputState)\n\t\tif InputState == \"Begin\" then\n\t\t\tApi.Start()\n\t\tend\n\tend)\nend" },
		{ Key = "Gated", Value = "declares Requires", Accepts = "a Requires table",
			Summary = "Starts itself when the world is right, no key involved. The cheap conditions are checked first and Confirm only once they pass.",
			Note = "WallRun, Vault and Glide are gated.",
			Code = "MyMove.Requires = { Grounded = false, Moving = true }\n\nfunction MyMove:Confirm()\n\tlocal Side = Api.RootPart.CFrame.RightVector * 3\n\treturn Api.Raycast(Api.RootPart.Position, Side) ~= nil\nend\n\n-- no Api.Start() anywhere: the kit starts it for you" },
		{ Key = "Airborne", Value = "declares StepWhileAirborne", Accepts = "true",
			Summary = "Runs while the body is in the air and once on landing, without owning the body. For watching a fall.",
			Note = "FallDamage is airborne.",
			Code = "MyMove.StepWhileAirborne = true\n\nlocal Lowest = 0\n\nfunction MyMove:Update(DeltaTime)\n\tLowest = math.min(Lowest, Api.RootPart.AssemblyLinearVelocity.Y)\nend" },
		{ Key = "Ambient", Value = "named in the dispatcher", Accepts = "core modules only",
			Summary = "Runs all the time, for things that animate rather than move. Never owns the body. Custom modules cannot join this kind.",
			Note = "Locomotion, Footsteps, SpeedEffects, BodyLean, ZoneEffects, WindController, FirstPersonBody.",
			Code = "-- you cannot opt in from Custom. If you need work every frame,\n-- bind it yourself instead:\nlocal FrameLoop = require(\n\tscript:FindFirstAncestor(\"Movement\").Engine.FrameLoop)" },
		{ Key = "Requires keys", Value = "the whole vocabulary", Accepts = "Grounded, Moving, Free, JumpHeld, FallSpeed",
			Summary = "These five are all a Requires table may use. Grounded, Moving, Free and JumpHeld take true or false. FallSpeed takes a number the fall has to exceed.",
			Code = "-- on the ground and moving\nMyMove.Requires = { Grounded = true, Moving = true }\n\n-- in the air, holding jump, not busy with another move\nMyMove.Requires = { Grounded = false, JumpHeld = true, Free = true }\n\n-- falling faster than 5 studs a second\nMyMove.Requires = { Grounded = false, FallSpeed = 5 }" },
	},
