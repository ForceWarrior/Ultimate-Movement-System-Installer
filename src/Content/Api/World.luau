return {
	Name = "World",
	Title = "The world",
	Blurb = "Ground, slopes and raycasts, through the shared filter",
	Summary = "The raycasts carry the kit's own collision filter: your character, other players and the kit's effects are excluded for you. The slope calls are the maths every ground move in the kit runs on.",
	Notes = {
		"Use these instead of workspace:Raycast, or your move will happily hit the very effect parts the kit spawned for it.",
		"An expensive raycast belongs in Confirm, not CanEnter. Confirm is only asked once the cheap gates already passed.",
	},
	Rows = {
		{ Key = "Api.OnGround()", Value = "-> boolean",
			Summary = "Is the body standing on something. The same ground test the rest of the kit uses.",
			Code = "function MyMove:CanEnter()\n\tif not Api.OnGround() then\n\t\treturn Api.Refuse(\"needs to be on the ground\")\n\tend\n\treturn true\nend" },
		{ Key = "Api.AirTime()", Value = "-> number",
			Summary = "How many seconds the body has been off the ground, 0 while it stands. The glide and the dive gate themselves on it, an air move of yours can too.",
			Code = "function MyMove:CanEnter()\n\tif Api.AirTime() < Api.Config.MinAirTime then\n\t\treturn Api.Refuse(\"not in the air long enough\")\n\tend\n\treturn true\nend" },
		{ Key = "Api.GroundInfo(Origin, Distance)", Value = "-> boolean, Vector3, number, RaycastResult?",
			Summary = "Looks down from a point: whether there is ground within Distance, its normal, its angle in degrees, and the hit itself. The normal is straight up and the angle 0 when nothing is found, so the values are always safe to use.",
			Code = "local Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, 6)\nif not Grounded then\n\tApi.Stop()\n\treturn\nend\nif Angle > Api.Config.MaxSlopeAngle then\n\tApi.Stop()\nend" },
		{ Key = "Api.ProjectOntoSlope(Direction, Normal, Angle, MaxAngle)", Value = "-> Vector3",
			Summary = "Turns a flat direction into one that runs along the ground it is on, so a push does not dig into a ramp or lift off it. Past MaxAngle the flat direction comes back untouched.",
			Code = "local Grounded, Normal, Angle = Api.GroundInfo(Api.RootPart.Position, 6)\nlocal Along = Api.ProjectOntoSlope(Api.RootPart.CFrame.LookVector, Normal, Angle, Api.Config.SlopeProjectionLimit)\nApi.RootPart.AssemblyLinearVelocity = Along * Api.Config.Speed" },
		{ Key = "Api.DownhillFactor(Direction, Normal, Angle)", Value = "-> number",
			Summary = "How much of a slope a direction runs down: positive downhill, negative uphill, 0 on the flat, about 1 straight down a 45 degree slope. Multiply it into a speed for a downhill boost.",
			Code = "local Boost = Api.DownhillFactor(Direction, Normal, Angle) * Api.Config.DownhillBoost\nlocal Velocity = Direction * (Api.Config.Speed + Boost)" },
		{ Key = "Api.WallHit(Origin, Direction)", Value = "-> RaycastResult?",
			Summary = "A raycast that only counts a wall: a hit whose surface stands within about 30 degrees of upright, nil for floors, ceilings and thin air.",
			Code = "local Wall = Api.WallHit(Api.RootPart.Position, Api.RootPart.CFrame.LookVector * 3)\nif Wall and not Api.SurfaceRefused(Wall) then\n\t-- something to push off\nend" },
		{ Key = "Api.FloorHit(Origin, Depth)", Value = "-> RaycastResult?",
			Summary = "Looks down Depth studs for a floor, a surface flat enough to stand on, nil otherwise.",
			Code = "local Floor = Api.FloorHit(Api.RootPart.Position, Api.StandHeight() + 2)\nif Floor then\n\tApi.RootPart.CFrame = CFrame.new(Floor.Position + Vector3.new(0, Api.StandHeight(), 0)) * Api.RootPart.CFrame.Rotation\nend" },
		{ Key = "Api.PathClear(From, To, Ignore)", Value = "-> boolean",
			Summary = "Is the straight line between two points free of anything solid, with the kit's filter. Ignore lets one part through, the ledge you are about to grab.",
			Code = "if Api.PathClear(Api.RootPart.Position, Target, Ledge) then\n\t-- nothing in the way\nend" },
		{ Key = "Api.StandHeight()", Value = "-> number",
			Summary = "How far the root sits above the feet on this rig, hip height plus half the root on R15 and 3 on R6. Add it to a floor position to place the character on it.",
			Code = "local Feet = Api.RootPart.Position - Vector3.new(0, Api.StandHeight(), 0)" },
		{ Key = "Api.SurfaceRefused(Hit)", Value = "-> boolean",
			Summary = "Does the kit refuse this surface to your move: no hit at all, a part carrying a Core.UnclimbableTags tag whose Blocks is All or names your move, or terrain of a material in your block's BlockedTerrainMaterials.",
			Code = "local Wall = Api.WallHit(Api.RootPart.Position, Ahead)\nif Api.SurfaceRefused(Wall) then\n\treturn Api.Refuse(\"that surface is off limits\")\nend" },
		{ Key = "Api.IsRideSurface(Part)", Value = "-> boolean",
			Summary = "Is this part a zipline, a rail or a bar by its tag, so a climbing or grabbing move leaves it to the move that rides it.",
			Code = "if Api.IsRideSurface(Hit.Instance) then return Api.Refuse(\"that is a rail\") end" },
		{ Key = "Api.RootEnclosed()", Value = "-> boolean",
			Summary = "Are at least four of the six directions around the root blocked within 1.6 studs, the test the slide uses to know it is under something low.",
			Code = "if Api.RootEnclosed() then\n\t-- stay low, there is no room to stand\nend" },
		{ Key = "Api.OnLanded(Callback)", Value = "no return",
			Summary = "Calls you with how many seconds the air lasted every time the character lands, whatever move was running. Connect once in Init, the list is emptied at the next spawn.",
			Code = "function MyMove:Init(NewApi)\n\tApi = NewApi\n\tApi.OnLanded(function(Seconds)\n\t\tCharges = Api.Config.Charges\n\tend)\nend" },
		{ Key = "Api.Raycast(Origin, Direction)", Value = "-> RaycastResult?",
			Summary = "A raycast with the kit's filter already applied. Direction carries the length, so multiply a unit vector by how far you want to look.",
			Code = "local Root = Api.RootPart\nlocal Hit = Api.Raycast(Root.Position, Root.CFrame.LookVector * 6)\n\nif Hit then\n\tprint(\"hit\", Hit.Instance.Name)\n\tprint(\"at\", Hit.Position)\n\tprint(\"surface faces\", Hit.Normal)\nend\n\n-- looking down for the floor\nlocal Floor = Api.Raycast(Root.Position, Vector3.new(0, -5, 0))" },
	},
}
